// mymod — Weft module
// Consumers: use mymod   then  mymod.hello("world")
// Publish: git tag v0.1.0 → weft get mymod github.com/you/mymod@v0.1.0

// Only pub symbols are exported when any pub is present.
pub fn hello(name) {
    "hello, " + name + " from mymod"
}

// Private helper (not imported by consumers)
fn shout(s) {
    s + "!"
}

pub fn greet(name) {
    shout(hello(name))
}
