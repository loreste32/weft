use "../../packages/warp/lib.weft" as warp
use json

fn main -> Result {
    base := warp.array_typed([1, 2, 3, 4, 5, 6, 7, 8, 9], [3, 3], "int64")
    transposed := warp.transpose_view(base, null)
    rows := warp.index(base, [[2, 0], null])
    cols := warp.index(base, [null, [-1, 0]])
    masked := warp.index(base, [[true, false, true], null])
    reversed := warp.view(base, [3], [-1], 2)
    vector := warp.arange(0, 10, 1)
    even_slice := warp.slice_step(vector, 1, 8, 2)
    reverse_slice := warp.slice_step(vector, null, null, -1)
    axis_slice := warp.slice_axis(base, null, null, -1, 1)
 indexed_slice := warp.index(vector, [warp.slice_selector(1, null, 2)])
 paired := warp.index(base, [[0, 2], [1, 0]])
 broadcasted := warp.index(base, [[[0], [2]], [0, 2]])
 assigned := warp.set(base, [[[0], [2]], [0, 2]], warp.array([40, 50], [2, 1]))
    say(json.stringify({
        "transposed_shape": transposed.shape,
        "transposed_element_strides": warp.element_strides(transposed),
        "transposed_strides": warp.strides(transposed),
        "transposed": warp.to_list(transposed),
        "rows": rows.data,
        "cols": cols.data,
        "masked": masked.data,
        "reversed": warp.to_list(reversed),
        "negative_get": warp.get(transposed, [-1, -1]),
        "is_contiguous": warp.is_contiguous(transposed),
        "even_slice": warp.to_list(even_slice),
        "reverse_slice": warp.to_list(reverse_slice),
        "axis_slice": warp.to_list(axis_slice),
 "indexed_slice": warp.to_list(indexed_slice),
 "paired": warp.to_list(paired),
 "broadcasted": warp.to_list(broadcasted),
 "assigned": warp.to_list(assigned),
    }))
}
