use "../../packages/dataframe/lib.weft" as df
use json

fn main -> Result {
    source := df.from_rows([
        {"name": "Alice", "age": 30, "dept": "eng", "salary": 90000},
        {"name": "Bob", "age": 25, "dept": "eng", "salary": 75000},
        {"name": "Carol", "age": 35, "dept": "sales", "salary": 85000},
        {"name": "Dan", "age": 28, "dept": "sales", "salary": 70000},
        {"name": "Eve", "age": 32, "dept": "eng", "salary": 95000},
    ])
    sorted := df.sort_by(source, "age", false)
    indexed := df.set_index(source, "name", null)
    filtered_indexed := df.query(indexed, "age", ">", 28)
    sorted_indexed := df.sort_by(filtered_indexed, "age", true)
    selected_indexed := df.iloc(indexed, [3, 0, -1])
    grouped := df.group_by(source, "dept", {
        "salary_sum": {"col": "salary", "op": "sum"},
        "age_mean": {"col": "age", "op": "mean"},
        "count": {"col": "name", "op": "count"},
    })
    left := df.from_rows([{"id": 1, "name": "a"}, {"id": 2, "name": "b"}, {"id": 3, "name": "c"}])
    right := df.from_rows([{"id": 1, "score": 90}, {"id": 3, "score": 80}])
    joined := df.join(left, right, "id", "left")
    pivot_source := df.from_rows([
        {"date": "Mon", "metric": "cpu", "value": 45},
        {"date": "Mon", "metric": "mem", "value": 70},
        {"date": "Tue", "metric": "cpu", "value": 50},
        {"date": "Tue", "metric": "mem", "value": 65},
    ])
    pivoted := df.pivot(pivot_source, "date", "metric", "value")
    left_series := df.series([10, 20], "value", ["a", "b"])
    right_series := df.series([1, 3], "other", ["b", "c"])
    aligned := df.series_add(left_series, right_series, null)
    ew_source := df.from_rows([
        {"x": 1}, {"x": 2}, {"x": null}, {"x": 4}, {"x": 5},
    ])
    ewma_adjust := df.ewm_mean(ew_source, "x", {"alpha": 0.5})
    ewma_recursive := df.ewm_mean(ew_source, "x", {"alpha": 0.5, "adjust": false, "ignore_na": true})
    ewmv := df.ewm_var(ew_source, "x", {"span": 3})
    ewms := df.ewm_sum(ew_source, "x", {"halflife": 1})
    say(json.stringify({
        "columns": df.columns(source),
        "sorted_names": df.col(sorted, "name"),
        "filtered_index": df.index(filtered_indexed),
        "sorted_index": df.index(sorted_indexed),
        "iloc_index": df.index(selected_indexed),
        "grouped": df.rows(grouped),
        "joined": df.rows(joined),
        "pivot_columns": df.columns(pivoted),
        "pivot": df.rows(pivoted),
        "aligned_index": df.series_index(aligned),
        "aligned_values": df.series_values(aligned),
        "ewma_adjust": df.col(ewma_adjust, "x"),
        "ewma_recursive": df.col(ewma_recursive, "x"),
        "ewm_var": df.col(ewmv, "x"),
        "ewm_sum": df.col(ewms, "x"),
    }))
}
