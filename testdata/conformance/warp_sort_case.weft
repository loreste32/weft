use "../../packages/warp/lib.weft" as warp
use json

// put / axis-aware sorting / unique options vs NumPy.
fn main -> Result {
    a := warp.array([1.0, 2.0, 3.0, 4.0], [4])
    m := warp.array([3.0, 1.0, 2.0, 0.0, 4.0, 1.0], [2, 3])
    uniq_src := warp.array([3, 1, 3, 2, 1, 3], [6])
    u := warp.unique_opts(uniq_src, true, true)
    say(json.stringify({
        "put_basic": warp.to_list(warp.put(a, [0, 3], [10.0, 40.0])),
        "put_duplicate_last_wins": warp.to_list(warp.put(a, [1, 1], [7.0, 9.0])),
        "put_cycle": warp.to_list(warp.put(a, [0, 1, 2, 3], [0.0])),
        "put_negative": warp.to_list(warp.put(a, [-1], [99.0])),
        "put_oob_raises": !warp.put(a, [4], [0.0]).ok,
        "put_preserves_shape": warp.shape(warp.put(warp.array([1, 2, 3, 4], [2, 2]), [0], [9])),
        "put_source_unchanged": warp.to_list(a),
        "sort_axis0": warp.to_list(warp.sort_axis(m, 0)),
        "sort_axis1": warp.to_list(warp.sort_axis(m, 1)),
        "sort_axis_neg": warp.to_list(warp.sort_axis(m, -2)),
        "argsort_axis0": warp.to_list(warp.argsort_axis(m, 0)),
        "argsort_axis1": warp.to_list(warp.argsort_axis(m, 1)),
        "unique_values": warp.to_list(u.values),
        "unique_index": warp.to_list(u.index),
        "unique_counts": warp.to_list(u.counts),
    }))
}
