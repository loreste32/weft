use "./fields.weft" as F


use "./validate.weft" as V


use "./emit.weft" as E


pub fn field(name, typ, opts) -> Result[any] {
    f := F.base_open(typ, opts)?
    f["name"] = name
    Ok(f)
}


pub fn string(opts) -> Result[any] { F.f_str(opts) }


pub fn integer(opts) -> Result[any] { F.f_int(opts) }


pub fn float(opts) -> Result[any] { F.f_float(opts) }


pub fn boolean(opts) -> Result[any] { F.f_bool(opts) }


pub fn any(opts) -> Result[any] { F.f_any(opts) }


pub fn list(item, opts) -> Result[any] { F.f_list(item, opts) }


pub fn object(fields, opts) -> Result[any] { F.f_object(fields, opts) }


pub fn str(opts) -> Result[any] { F.f_str(opts) }


pub fn int(opts) -> Result[any] { F.f_int(opts) }


pub fn bool(opts) -> Result[any] { F.f_bool(opts) }


pub fn model(fields) -> Result[any] {
    expanded := F.expand_fields(fields)?
    Ok({"kind": "mold.model", "fields": expanded})
}


pub fn validate(model, data) -> Result[any] { V.validate_mut(model, data) }


pub fn parse(model, raw) -> Result[any] { V.parse(model, raw) }


pub fn extract(model, text) -> Result[any] { V.extract(model, text) }


pub fn errors(result) { V.errors(result) }


pub fn ok(result) { V.ok(result) }


pub fn json_schema(model, title) { E.json_schema(model, title) }


pub fn tool_params(model) { E.tool_params(model) }


pub fn tool_spec(name, model, desc) {
    mut d := ""
    if desc != null {
        d = "" + desc
    }
    {
        "type": "function",
        "function": {
            "name": name,
            "description": d,
            "parameters": E.tool_params(model),
        },
    }
}


pub fn input_schema_tool(name, model, desc) {
    mut d := ""
    if desc != null {
        d = "" + desc
    }
    {
        "name": name,
        "description": d,
        "input_schema": E.tool_params(model),
    }
}

