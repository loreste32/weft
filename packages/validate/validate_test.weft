use "./lib.weft" as v

fn test_email_valid {
    test.is_true(v.email("user@example.com"))
}

fn test_email_empty {
    test.is_false(v.email(""))
}

fn test_in_range {
    test.is_true(v.in_range(5, 1, 10))
    test.is_true(v.in_range(1, 1, 10))
    test.is_false(v.in_range(0, 1, 10))
    test.is_false(v.in_range(11, 1, 10))
}

fn test_length {
    test.is_true(v.length("abc", 1, 5))
    test.is_false(v.length("", 1, 5))
    test.is_false(v.length("toolong", 1, 3))
}

fn test_url {
    test.is_true(v.url("https://example.com"))
    test.is_false(v.url("notaurl"))
}
