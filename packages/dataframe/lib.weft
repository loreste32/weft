// dataframe — pandas-inspired tabular data for Weft.
// Row-list storage with explicit column order and predictable null handling.

use warp

// ──────────────────────────────────────────────
// Creation
// ──────────────────────────────────────────────

pub fn from_rows(rows) {
    if _kind(rows) != "list" { return Err("dataframe.from_rows expects a list of row maps") }
    for row in rows {
        if _kind(row) != "map" { return Err("dataframe.from_rows expects a list of row maps") }
    }
    if len(rows) == 0 {
        return {"_df": true, "columns": [], "rows": []}
    }

    // Derive a stable union schema instead of silently dropping fields that
    // appear after the first row.
    let mut columns = []
    let mut seen = {}
    for row in rows {
        for c in keys(row) {
            if seen[c] == null {
                seen[c] = true
                columns = push(columns, c)
            }
        }
    }
    let mut normalized = []
    for row in rows {
        let mut result = {}
        for column in columns {
            result[column] = if contains(keys(row), column) { row[column] } else { null }
        }
        normalized = push(normalized, result)
    }
    {"_df": true, "columns": columns, "rows": normalized}
}

pub fn from_columns(col_map) -> Result[any] {
    if _kind(col_map) != "map" { return Err("dataframe.from_columns expects a column map") }
    cols := keys(col_map)
    n := if len(cols) > 0 { len(col_map[cols[0]]) } else { 0 }
    for c in cols {
        if _kind(col_map[c]) != "list" {
            return Err("dataframe.from_columns column '" + c + "' must be a list")
        }
        if len(col_map[c]) != n {
            return Err("dataframe.from_columns columns must have equal lengths")
        }
    }
    let mut rows = []
    let mut i = 0
    while i < n {
        let mut row = {}
        for c in cols {
            row[c] = col_map[c][i]
        }
        rows = push(rows, row)
        i = i + 1
    }
    Ok({"_df": true, "columns": cols, "rows": rows})
}

pub fn from_csv(text, sep) -> Result[any] {
    _from_csv_impl(text, sep, null)
}

// from_csv_opts(text, sep, opts) — from_csv with explicit type/null policies.
//   opts.dtypes: map of column name to "int" | "float" | "str" | "bool".
//     Columns listed are parsed strictly: a value that does not parse as the
//     declared type is an error naming the row and column. "str" keeps the
//     raw text (quoted numerals such as "123" stay strings).
//   opts.null_values: list of extra sentinel strings that map to null
//     (applied to unquoted cells, before dtype parsing).
//   opts.keep_default_null_values: when false, the default sentinels
//     ("", "null", "NULL", "None") no longer map to null — only the custom
//     null_values do. Default true.
//   Quoted cells are explicit strings: null sentinels never apply to them.
pub fn from_csv_opts(text, sep, opts) -> Result[any] {
    _from_csv_impl(text, sep, opts)
}

fn _from_csv_impl(text, sep, opts) -> Result[any] {
    delimiter := if sep == null { "," } else { sep }
    if _kind(text) != "str" || _kind(delimiter) != "str" || len(delimiter) != 1 {
        return Err("dataframe.from_csv expects a string and a one-character separator")
    }
    records := _csv_records(text, delimiter)?
    if len(records) == 0 { return Ok(empty([])) }
    headers := records[0]
    let mut cols = []
    let mut seen_cols = {}
    for cell in headers {
        name := str.trim(cell.text)
        if name == "" { return Err("dataframe.from_csv header names cannot be empty") }
        if seen_cols[name] != null { return Err("dataframe.from_csv has duplicate column: " + name) }
        seen_cols[name] = true
        cols = push(cols, name)
    }
    policy := _csv_policy_check(opts, cols)
    if _kind(policy) == "result" { return policy }
    let mut rows = []
    let mut i = 1
    while i < len(records) {
        record := records[i]
        if len(record) == 1 && record[0].text == "" && record[0].quoted == false {
            i = i + 1
            continue
        }
        if len(record) != len(cols) {
            return Err("dataframe.from_csv row " + (i + 1) + " has " + len(record) + " fields; expected " + len(cols))
        }
        let mut row = {}
        let mut j = 0
        while j < len(cols) {
            v := _csv_value_policy(record[j], cols[j], i + 1, opts)
            if _kind(v) == "result" { return v }
            row[cols[j]] = v
            j = j + 1
        }
        rows = push(rows, row)
        i = i + 1
    }
    Ok({"_df": true, "columns": cols, "rows": rows})
}

pub fn from_json(text) -> Result[any] {
    data := json.parse(text)?
    if _kind(data) != "list" { return Err("dataframe.from_json expects a JSON array") }
    for row in data {
        if _kind(row) != "map" { return Err("dataframe.from_json expects an array of objects") }
    }
    Ok(from_rows(data))
}

pub fn from_jsonl(text) -> Result[any] {
    lines := str.split(str.trim(text), "\n")
    let mut rows = []
    for line in lines {
        trimmed := str.trim(line)
        if trimmed == "" { continue }
        row := json.parse(trimmed)?
        if _kind(row) != "map" { return Err("dataframe.from_jsonl expects one JSON object per line") }
        rows = push(rows, row)
    }
    Ok(from_rows(rows))
}

pub fn read_csv(path, sep) -> Result[any] {
    text := fs.read(path)?
    from_csv(text, sep)
}

// read_csv_opts(path, sep, opts) — read_csv with the same dtype/null policies
// as from_csv_opts.
pub fn read_csv_opts(path, sep, opts) -> Result[any] {
    text := fs.read(path)?
    from_csv_opts(text, sep, opts)
}

pub fn read_json(path) -> Result[any] {
    text := fs.read(path)?
    from_json(text)
}

pub fn read_jsonl(path) -> Result[any] {
    text := fs.read(path)?
    from_jsonl(text)
}

pub fn empty(cols) {
    {"_df": true, "columns": cols, "rows": []}
}

// ──────────────────────────────────────────────
// Shape / info
// ──────────────────────────────────────────────

pub fn columns(t) { t.columns }

pub fn rows(t) { t.rows }

pub fn nrows(t) { len(t.rows) }

pub fn ncols(t) { len(t.columns) }

pub fn shape(t) { [len(t.rows), len(t.columns)] }

pub fn dtypes(t) {
    let mut result = {}
    for c in t.columns {
        let mut found = "null"
        for r in t.rows {
            v := r[c]
            if v == null { continue }
            k := _kind(v)
            if found == "null" {
                found = k
            } else if found != k {
                if (found == "int" && k == "float") || (found == "float" && k == "int") {
                    found = "float"
                } else {
                    found = "mixed"
                }
            }
        }
        result[c] = found
    }
    result
}

pub fn info(t) {
    let mut memory = len(t.rows) * len(t.columns) * 8 + len(t.rows) * 24 + len(t.columns) * 16
    for c in t.columns { memory = memory + len(c) }
    for r in t.rows {
        for c in t.columns {
            v := r[c]
            if _kind(v) == "str" { memory = memory + len(v) }
        }
    }
    {
        "rows": len(t.rows),
        "columns": len(t.columns),
        "column_names": t.columns,
        "memory_est": memory,
        "memory_est_bytes": memory,
    }
}

// ──────────────────────────────────────────────
// Selection / indexing
// ──────────────────────────────────────────────

pub fn col(t, name) {
    if !contains(t.columns, name) { return Err("dataframe.col: unknown column " + name) }
    let mut vals = []
    for r in t.rows { vals = push(vals, r[name]) }
    vals
}

// Convert selected numeric columns into a packed Warp matrix. DataFrame
// storage is row-list based, so this boundary always copies; null and
// non-numeric values are rejected instead of being silently coerced.
pub fn to_warp(t, column_names, dtype_name) -> Result[any] {
    if _kind(t) != "map" || t._df != true {
        return Err("dataframe.to_warp expects a DataFrame")
    }
    selected := if column_names == null { t.columns } else { column_names }
    if _kind(selected) != "list" {
        return Err("dataframe.to_warp column_names must be a list or null")
    }
    target_dtype := if dtype_name == null { "float64" } else { dtype_name }
    if _kind(target_dtype) != "str" {
        return Err("dataframe.to_warp dtype_name must be a string or null")
    }
    let mut values = []
    for name in selected {
        if _kind(name) != "str" || !contains(t.columns, name) {
            return Err("dataframe.to_warp received an unknown column")
        }
    }
    for row in t.rows {
        for name in selected {
            value := row[name]
            if value == null || (_kind(value) != "int" && _kind(value) != "float") {
                return Err("dataframe.to_warp requires non-null numeric columns")
            }
            values = push(values, value)
        }
    }
    packed := warp.array_typed(values, [len(t.rows), len(selected)], target_dtype)
    if _kind(packed) == "result" { return packed }
    Ok(packed)
}

// Build a DataFrame from a one- or two-dimensional Warp array. The values are
// copied into row-list storage; generated names are column_0, column_1, ... .
pub fn from_warp(a, column_names) -> Result[any] {
    if _kind(a) != "map" || !contains(keys(a), "_warp") {
        return Err("dataframe.from_warp expects a Warp array")
    }
    s := warp.shape(a)
    if _kind(s) != "list" || (len(s) != 1 && len(s) != 2) {
        return Err("dataframe.from_warp expects a one- or two-dimensional array")
    }
    row_count := s[0]
    col_count := if len(s) == 1 { 1 } else { s[1] }
    let mut names = []
    if column_names == null {
        let mut i = 0
        while i < col_count {
            names = push(names, "column_" + json.stringify(i))
            i = i + 1
        }
    } else {
        if _kind(column_names) != "list" || len(column_names) != col_count {
            return Err("dataframe.from_warp column_names must match array columns")
        }
        for name in column_names {
            if _kind(name) != "str" { return Err("dataframe.from_warp column names must be strings") }
            names = push(names, name)
        }
    }
    flat_array := warp.ravel(a)
    if _kind(flat_array) == "result" { return flat_array }
    flat := warp.to_list(flat_array)
    if _kind(flat) == "result" { return flat }
    let mut rows = []
    let mut i = 0
    while i < row_count {
        let mut row = {}
        let mut j = 0
        while j < col_count {
            row[names[j]] = flat[i * col_count + j]
            j = j + 1
        }
        rows = push(rows, row)
        i = i + 1
    }
    Ok(from_rows(rows))
}

// Series is the column-oriented companion to DataFrame. The existing col()
// function intentionally remains a plain-list API for compatibility.
pub fn series(values, name, index_values) {
    if _kind(values) != "list" { return Err("dataframe.series expects a value list") }
    if name != null && _kind(name) != "str" { return Err("dataframe.series name must be a string or null") }
    idx := if index_values == null { _range(len(values)) } else { index_values }
    if _kind(idx) != "list" || len(idx) != len(values) {
        return Err("dataframe.series index must have the same length as values")
    }
    {"_series": true, "values": values, "name": name, "index": idx}
}

pub fn series_from(t, name) {
    series(col(t, name), name, null)
}

pub fn as_series(t, name) { series_from(t, name) }

pub fn series_values(s) {
    if !_is_series(s) { return Err("dataframe.series_values expects a Series") }
    s.values
}

pub fn series_name(s) {
    if !_is_series(s) { return Err("dataframe.series_name expects a Series") }
    s.name
}

pub fn series_index(s) {
    if !_is_series(s) { return Err("dataframe.series_index expects a Series") }
    s.index
}

pub fn series_shape(s) {
    if !_is_series(s) { return Err("dataframe.series_shape expects a Series") }
    [len(s.values)]
}

pub fn series_dtype(s) {
    if !_is_series(s) { return Err("dataframe.series_dtype expects a Series") }
    _series_dtype(s.values)
}

pub fn series_map(s, f) {
    if !_is_series(s) { return Err("dataframe.series_map expects a Series") }
    let mut values = []
    for value in s.values { values = push(values, f(value)) }
    series(values, s.name, s.index)
}

pub fn series_apply(s, f) { series_map(s, f) }

pub fn series_fillna(s, value) {
    if !_is_series(s) { return Err("dataframe.series_fillna expects a Series") }
    let mut values = []
    for item in s.values { values = push(values, if item == null { value } else { item }) }
    series(values, s.name, s.index)
}

pub fn series_dropna(s) {
    if !_is_series(s) { return Err("dataframe.series_dropna expects a Series") }
    let mut values = []
    let mut idx = []
    let mut i = 0
    while i < len(s.values) {
        if s.values[i] != null {
            values = push(values, s.values[i])
            idx = push(idx, s.index[i])
        }
        i = i + 1
    }
    series(values, s.name, idx)
}

pub fn series_unique(s) {
    if !_is_series(s) { return Err("dataframe.series_unique expects a Series") }
    let mut values = []
    let mut seen = {}
    for value in s.values {
        key := _value_key(value)
        if seen[key] == null {
            seen[key] = true
            values = push(values, value)
        }
    }
    values
}

pub fn series_value_counts(s) {
    if !_is_series(s) { return Err("dataframe.series_value_counts expects a Series") }
    let mut counts = {}
    for value in s.values {
        key := _value_key(value)
        counts[key] = if counts[key] == null { 1 } else { counts[key] + 1 }
    }
    counts
}

pub fn series_reindex(s, labels, fill_value) {
    if !_is_series(s) { return Err("dataframe.series_reindex expects a Series") }
    if _kind(labels) != "list" { return Err("dataframe.series_reindex expects a label list") }
    let mut values = []
    for label in labels {
        found := _series_lookup(s, label)
        values = push(values, if found.found { found.value } else { fill_value })
    }
    series(values, s.name, labels)
}

pub fn series_add(left, right, fill_value) { _series_binary(left, right, fill_value, fn(a, b) { a + b }) }

pub fn series_sub(left, right, fill_value) { _series_binary(left, right, fill_value, fn(a, b) { a - b }) }

pub fn series_mul(left, right, fill_value) { _series_binary(left, right, fill_value, fn(a, b) { a * b }) }

pub fn series_div(left, right, fill_value) { _series_binary(left, right, fill_value, fn(a, b) { a / b }) }

pub fn index(t) {
    if !(contains(keys(t), "_index") && t._index != null) { _range(len(t.rows)) } else { t._index }
}

pub fn index_name(t) { if t._index_name == null { null } else { t._index_name } }

// Number of index levels. Default / single-level frames return 1.
// Minimal MultiIndex: levels stored in `_index_levels`, labels as lists in `_index`.
pub fn index_nlevels(t) {
    if contains(keys(t), "_index_levels") && t._index_levels != null && _kind(t._index_levels) == "list" {
        n := len(t._index_levels)
        if n > 0 { return n }
    }
    1
}

// Level names. Multi-level → `_index_levels`; single named → `[name]`; default → `[null]`.
pub fn index_levels(t) {
    if contains(keys(t), "_index_levels") && t._index_levels != null && _kind(t._index_levels) == "list" && len(t._index_levels) > 0 {
        return t._index_levels
    }
    if contains(keys(t), "_index_name") && t._index_name != null { return [t._index_name] }
    [null]
}

pub fn loc_labels(t, labels) {
    if _kind(labels) != "list" { return Err("dataframe.loc_labels expects a label list") }
    idx := index(t)
    nlevels := index_nlevels(t)
    let mut selected = []
    let mut selected_index = []
    for label in labels {
        let mut i = 0
        while i < len(t.rows) {
            if _index_label_matches(idx[i], label, nlevels) {
                selected = push(selected, t.rows[i])
                selected_index = push(selected_index, idx[i])
            }
            i = i + 1
        }
    }
    _frame_with_index(t.columns, selected, selected_index, t)
}

pub fn reindex(t, labels, fill_value) {
    if _kind(labels) != "list" { return Err("dataframe.reindex expects a label list") }
    idx := index(t)
    nlevels := index_nlevels(t)
    let mut result = []
    for label in labels {
        let mut matched = false
        let mut i = 0
        while i < len(t.rows) {
            // reindex requires exact label equality (full multi-key when multi-level)
            if _index_label_exact(idx[i], label, nlevels) {
                result = push(result, t.rows[i])
                matched = true
                break
            }
            i = i + 1
        }
        if !matched {
            let mut row = {}
            for c in t.columns { row[c] = fill_value }
            result = push(result, row)
        }
    }
    _frame_with_index(t.columns, result, labels, t)
}

// align returns two frames indexed by the same label sequence. It mirrors
// the common pandas DataFrame.align contract for the supported unique-label
// profile and preserves MultiIndex metadata through reindex().
pub fn align(left, right, join, fill_value) {
    if _kind(left) != "map" || left._df != true || _kind(right) != "map" || right._df != true {
        return Err("dataframe.align expects two DataFrames")
    }
    mode := if join == null { "outer" } else { join }
    if mode != "outer" && mode != "inner" && mode != "left" && mode != "right" {
        return Err("dataframe.align join must be outer, inner, left, or right")
    }
    labels := if mode == "outer" { index_union(left, right) } else if mode == "inner" { index_intersection(left, right) } else if mode == "left" { index(left) } else { index(right) }
    if _kind(labels) == "result" { return labels }
    left_aligned := reindex(left, labels, fill_value)
    if _kind(left_aligned) == "result" { return left_aligned }
    right_aligned := reindex(right, labels, fill_value)
    if _kind(right_aligned) == "result" { return right_aligned }
    Ok({"left": left_aligned, "right": right_aligned})
}

fn _resample_interval(rule) -> Result[any] {
    if _kind(rule) == "int" || _kind(rule) == "float" {
        if rule <= 0 || rule != rule || math.isinf(rule) { return Err("dataframe.resample rule must be finite positive") }
        return Ok(rule + 0.0)
    }
    if _kind(rule) != "str" || len(rule) < 2 { return Err("dataframe.resample rule must be seconds or a positive interval") }
    suffix := str.slice(rule, len(rule) - 1, len(rule))
    multiplier := if suffix == "s" { 1.0 } else if suffix == "m" { 60.0 } else if suffix == "h" { 3600.0 } else if suffix == "d" { 86400.0 } else { 0.0 }
    if multiplier == 0.0 { return Err("dataframe.resample rule suffix must be s, m, h, or d") }
    parsed := json.parse(str.slice(rule, 0, len(rule) - 1))
    if !parsed.ok || (_kind(parsed.value) != "int" && _kind(parsed.value) != "float") || parsed.value <= 0 {
        return Err("dataframe.resample rule interval must be finite positive")
    }
    interval := parsed.value * multiplier
    if interval != interval || math.isinf(interval) { return Err("dataframe.resample rule is too large") }
    Ok(interval)
}

// resample groups numeric timestamp values into fixed-width bins. Timestamps
// are seconds from the numeric origin; string rules accept Ns/Nm/Nh/Nd. This
// explicit numeric profile avoids pretending that Weft has pandas' timezone
// and datetime extension dtypes before those types are implemented.
pub fn resample(t, time_column, rule, aggs, origin) -> Result[any] {
    if _kind(t) != "map" || t._df != true { return Err("dataframe.resample expects a DataFrame") }
    if _kind(time_column) != "str" || !contains(t.columns, time_column) { return Err("dataframe.resample unknown time column") }
    if _kind(aggs) != "map" { return Err("dataframe.resample expects an aggregation map") }
    interval := _resample_interval(rule)?
    base := if origin == null { 0.0 } else { origin }
    if (_kind(base) != "int" && _kind(base) != "float") || base != base || math.isinf(base) { return Err("dataframe.resample origin must be finite numeric") }
    if len(t.rows) == 0 {
        let mut columns = [time_column]
        for agg_name in keys(aggs) {
            spec := aggs[agg_name]
            if _kind(spec) == "map" {
                if !contains(t.columns, spec.col) || !_valid_agg(spec.op) { return Err("dataframe.resample invalid aggregation") }
                columns = push(columns, agg_name)
            } else if _kind(spec) == "list" || _kind(spec) == "str" {
                ops := if _kind(spec) == "list" { spec } else { [spec] }
                if !contains(t.columns, agg_name) { return Err("dataframe.resample unknown aggregation column") }
                for op in ops {
                    if !_valid_agg(op) { return Err("dataframe.resample invalid aggregation") }
                    columns = push(columns, agg_name + "_" + op)
                }
            } else {
                return Err("dataframe.resample invalid aggregation spec")
            }
        }
        return Ok({"_df": true, "columns": columns, "rows": []})
    }
    let mut rows = []
    for row in t.rows {
        timestamp := row[time_column]
        if (_kind(timestamp) != "int" && _kind(timestamp) != "float") || timestamp != timestamp || math.isinf(timestamp) {
            return Err("dataframe.resample timestamps must be finite numeric seconds")
        }
        bucket := math.floor((timestamp - base) / interval) * interval + base
        let mut next = {}
        for column in t.columns { next[column] = row[column] }
        next["__weft_resample_bucket"] = bucket
        rows = push(rows, next)
    }
    temp := from_rows(rows)
    grouped := group_by(temp, "__weft_resample_bucket", aggs)
    if _kind(grouped) == "result" { return grouped }
    renamed := rename(grouped, {"__weft_resample_bucket": time_column})
    if _kind(renamed) == "result" { return renamed }
    sorted := sort_by(renamed, time_column, false)
    if _kind(sorted) == "result" { return sorted }
    Ok(sorted)
}

pub fn set_index(t, column, drop) {
    if !contains(t.columns, column) { return Err("dataframe.set_index: unknown column " + column) }
    remove := if drop == null { true } else { drop }
    if _kind(remove) != "bool" { return Err("dataframe.set_index drop must be boolean or null") }
    let mut new_columns = []
    for c in t.columns {
        if !remove || c != column { new_columns = push(new_columns, c) }
    }
    let mut new_rows = []
    let mut new_index = []
    for row in t.rows {
        new_index = push(new_index, row[column])
        let mut next = {}
        for c in new_columns { next[c] = row[c] }
        new_rows = push(new_rows, next)
    }
    {"_df": true, "columns": new_columns, "rows": new_rows, "_index": new_index, "_index_name": column}
}

// Minimal multi-level index: store each row label as a list of values and
// level names in `_index_levels`. Not a full pandas MultiIndex.
// One column delegates to set_index. drop defaults to true.
pub fn set_multi_index(t, columns, drop) {
    if _kind(columns) != "list" || len(columns) == 0 {
        return Err("dataframe.set_multi_index expects a non-empty list of column names")
    }
    if len(columns) == 1 {
        return set_index(t, columns[0], drop)
    }
    let mut seen = {}
    for c in columns {
        if _kind(c) != "str" { return Err("dataframe.set_multi_index column names must be strings") }
        if !contains(t.columns, c) { return Err("dataframe.set_multi_index: unknown column " + c) }
        if seen[c] != null { return Err("dataframe.set_multi_index: duplicate column " + c) }
        seen[c] = true
    }
    remove := if drop == null { true } else { drop }
    if _kind(remove) != "bool" { return Err("dataframe.set_multi_index drop must be boolean or null") }
    let mut new_columns = []
    for c in t.columns {
        if !remove || !contains(columns, c) { new_columns = push(new_columns, c) }
    }
    let mut new_rows = []
    let mut new_index = []
    for row in t.rows {
        let mut label = []
        for c in columns { label = push(label, row[c]) }
        new_index = push(new_index, label)
        let mut next = {}
        for c in new_columns { next[c] = row[c] }
        new_rows = push(new_rows, next)
    }
    {"_df": true, "columns": new_columns, "rows": new_rows, "_index": new_index, "_index_levels": columns}
}

// Resolve multi-index level by int (incl. negative) or name.
fn _resolve_level(t, level) {
    nlevels := index_nlevels(t)
    if nlevels < 2 { return Err("dataframe multi-index level ops require index_nlevels >= 2") }
    if _kind(level) == "int" {
        let mut idx = level
        if idx < 0 { idx = nlevels + idx }
        if idx < 0 || idx >= nlevels { return Err("dataframe level index out of range") }
        return idx
    }
    if _kind(level) == "str" {
        levels := t._index_levels
        let mut i = 0
        while i < len(levels) {
            if levels[i] == level { return i }
            i = i + 1
        }
        return Err("dataframe unknown index level name: " + level)
    }
    Err("dataframe level must be int or str")
}

pub fn swaplevel(t, i, j) {
    nlevels := index_nlevels(t)
    if nlevels < 2 { return Err("dataframe.swaplevel requires a multi-level index") }
    a := _resolve_level(t, i)
    if is_err(a) { return a }
    b := _resolve_level(t, j)
    if is_err(b) { return b }
    if a == b { return t }
    levels := t._index_levels
    let mut new_levels = []
    let mut li = 0
    while li < nlevels {
        if li == a { new_levels = push(new_levels, levels[b]) }
        else if li == b { new_levels = push(new_levels, levels[a]) }
        else { new_levels = push(new_levels, levels[li]) }
        li = li + 1
    }
    idx := index(t)
    let mut new_index = []
    for label in idx {
        if _kind(label) != "list" || len(label) != nlevels {
            return Err("dataframe.swaplevel: malformed multi-index label")
        }
        let mut nl = []
        let mut k = 0
        while k < nlevels {
            if k == a { nl = push(nl, label[b]) }
            else if k == b { nl = push(nl, label[a]) }
            else { nl = push(nl, label[k]) }
            k = k + 1
        }
        new_index = push(new_index, nl)
    }
    {
        "_df": true,
        "columns": t.columns,
        "rows": t.rows,
        "_index": new_index,
        "_index_levels": new_levels,
    }
}

pub fn droplevel(t, level) {
    nlevels := index_nlevels(t)
    if nlevels < 2 { return Err("dataframe.droplevel requires a multi-level index") }
    drop_i := _resolve_level(t, level)
    if is_err(drop_i) { return drop_i }
    levels := t._index_levels
    let mut new_levels = []
    let mut li = 0
    while li < nlevels {
        if li != drop_i { new_levels = push(new_levels, levels[li]) }
        li = li + 1
    }
    idx := index(t)
    let mut new_index = []
    for label in idx {
        if _kind(label) != "list" || len(label) != nlevels {
            return Err("dataframe.droplevel: malformed multi-index label")
        }
        if len(new_levels) == 1 {
            new_index = push(new_index, label[if drop_i == 0 { 1 } else { 0 }])
        } else {
            let mut nl = []
            let mut k = 0
            while k < nlevels {
                if k != drop_i { nl = push(nl, label[k]) }
                k = k + 1
            }
            new_index = push(new_index, nl)
        }
    }
    if len(new_levels) == 1 {
        {
            "_df": true,
            "columns": t.columns,
            "rows": t.rows,
            "_index": new_index,
            "_index_name": new_levels[0],
        }
    } else {
        {
            "_df": true,
            "columns": t.columns,
            "rows": t.rows,
            "_index": new_index,
            "_index_levels": new_levels,
        }
    }
}

pub fn reset_index(t, name) {
    nlevels := index_nlevels(t)
    if nlevels > 1 {
        levels := t._index_levels
        for lv in levels {
            if contains(t.columns, lv) {
                return Err("dataframe.reset_index: index level name conflicts with a column: " + lv)
            }
        }
        idx := index(t)
        let mut new_columns = []
        for lv in levels { new_columns = push(new_columns, lv) }
        for c in t.columns { new_columns = push(new_columns, c) }
        let mut new_rows = []
        let mut i = 0
        while i < len(t.rows) {
            let mut next = {}
            label := idx[i]
            let mut li = 0
            while li < nlevels {
                next[levels[li]] = if _kind(label) == "list" { label[li] } else { null }
                li = li + 1
            }
            for c in t.columns { next[c] = t.rows[i][c] }
            new_rows = push(new_rows, next)
            i = i + 1
        }
        return {"_df": true, "columns": new_columns, "rows": new_rows}
    }
    index_name := if name == null { "index" } else { name }
    if _kind(index_name) != "str" { return Err("dataframe.reset_index name must be a string or null") }
    if contains(t.columns, index_name) { return Err("dataframe.reset_index: index name conflicts with a column") }
    idx := index(t)
    let mut new_columns = [index_name]
    for c in t.columns { new_columns = push(new_columns, c) }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut next = {}
        next[index_name] = idx[i]
        for c in t.columns { next[c] = t.rows[i][c] }
        new_rows = push(new_rows, next)
        i = i + 1
    }
    {"_df": true, "columns": new_columns, "rows": new_rows}
}

// ──────────────────────────────────────────────
// Index set operations, index sorting, cross-sections
// ──────────────────────────────────────────────
//
// pandas-matching semantics (pandas 3.0.1), verified against the oracle:
//   union:        sorted unique values; when either side has duplicates the
//                 result keeps max(left, right) multiplicity per label. A
//                 union with an empty side returns the other side AS-IS
//                 (unsorted, duplicates preserved). Nulls are ordinary
//                 labels (present if present in an input) and sort last.
//   intersection: sorted unique labels present in both sides (nulls match
//                 nulls). Duplicates are always collapsed.
//   difference:   sorted unique labels of the left side not on the right.
// Mixed-type labels use pandas' "safe" ordering: numbers/bools first
// (bools compare as 0/1), then strings, then other values by JSON encoding;
// null always last. All three accept DataFrames (current index) or plain
// label lists, and always return a plain list of labels.

pub fn index_union(a, b) {
    la := _as_label_list(a, "index_union")
    if _kind(la) == "result" { return la }
    lb := _as_label_list(b, "index_union")
    if _kind(lb) == "result" { return lb }
    // pandas shortcut: empty side returns the other unchanged.
    if len(la) == 0 { return _copy_rows(lb) }
    if len(lb) == 0 { return _copy_rows(la) }
    let mut seen = {}
    let mut reps = {}
    let mut order = []
    let mut count_a = {}
    let mut count_b = {}
    for v in la {
        k := _value_key(v)
        if seen[k] == null {
            seen[k] = true
            reps[k] = v
            order = push(order, k)
            count_a[k] = 0
            count_b[k] = 0
        }
        count_a[k] = count_a[k] + 1
    }
    for v in lb {
        k := _value_key(v)
        if seen[k] == null {
            seen[k] = true
            reps[k] = v
            order = push(order, k)
            count_a[k] = 0
            count_b[k] = 0
        }
        count_b[k] = count_b[k] + 1
    }
    let mut out = []
    for k in order {
        n := if count_a[k] > count_b[k] { count_a[k] } else { count_b[k] }
        let mut i = 0
        while i < n {
            out = push(out, reps[k])
            i = i + 1
        }
    }
    _sort_labels(out)
}

pub fn index_intersection(a, b) {
    la := _as_label_list(a, "index_intersection")
    if _kind(la) == "result" { return la }
    lb := _as_label_list(b, "index_intersection")
    if _kind(lb) == "result" { return lb }
    let mut in_b = {}
    for v in lb { in_b[_value_key(v)] = true }
    let mut seen = {}
    let mut out = []
    for v in la {
        k := _value_key(v)
        if in_b[k] != null && seen[k] == null {
            seen[k] = true
            out = push(out, v)
        }
    }
    _sort_labels(out)
}

pub fn index_difference(a, b) {
    la := _as_label_list(a, "index_difference")
    if _kind(la) == "result" { return la }
    lb := _as_label_list(b, "index_difference")
    if _kind(lb) == "result" { return lb }
    let mut in_b = {}
    for v in lb { in_b[_value_key(v)] = true }
    let mut seen = {}
    let mut out = []
    for v in la {
        k := _value_key(v)
        if in_b[k] == null && seen[k] == null {
            seen[k] = true
            out = push(out, v)
        }
    }
    _sort_labels(out)
}

// sort_index(t, desc) — stable sort of rows by index label. desc truthy →
// descending (every level, for multi-level indexes); null/default →
// ascending. Null labels sort last in both directions (pandas
// na_position="last"); use sort_index_opts for na_position="first".
// Ties (duplicate labels) keep their original row order.
// A frame without an explicit index sorts by its positional range, which
// is the identity, so it is returned unchanged.
pub fn sort_index(t, desc) {
    _sort_index_impl(t, desc == true, false)
}

// sort_index_opts(t, opts) — sort_index with options.
//   opts.ascending:   bool, default true.
//   opts.na_position: "last" (default) | "first".
pub fn sort_index_opts(t, opts) {
    let mut desc = false
    let mut na_position = "last"
    if opts != null {
        if _kind(opts) != "map" { return Err("dataframe.sort_index: opts must be a map") }
        if opts["ascending"] != null {
            if _kind(opts["ascending"]) != "bool" {
                return Err("dataframe.sort_index: ascending must be boolean")
            }
            desc = !opts["ascending"]
        }
        if opts["na_position"] != null { na_position = opts["na_position"] }
    }
    if na_position != "first" && na_position != "last" {
        return Err("dataframe.sort_index: na_position must be \"first\" or \"last\"")
    }
    _sort_index_impl(t, desc, na_position == "first")
}

fn _sort_index_impl(t, desc, na_first) {
    if !(contains(keys(t), "_index") && t._index != null) { return t }
    idx := index(t)
    nlevels := index_nlevels(t)
    let mut pairs = []
    let mut i = 0
    while i < len(t.rows) {
        pairs = push(pairs, {"label": idx[i], "row": t.rows[i]})
        i = i + 1
    }
    sorted := _label_sort_pairs(pairs, desc, na_first, nlevels)
    let mut new_rows = []
    let mut new_index = []
    for p in sorted {
        new_rows = push(new_rows, p.row)
        new_index = push(new_index, p.label)
    }
    _frame_with_index(t.columns, new_rows, new_index, t)
}

// is_monotonic(t, desc) — whether the current index is monotonically
// increasing (desc truthy → decreasing), non-strict like pandas (duplicate
// labels are monotonic). Any null label (or null level component) makes
// the index non-monotonic, matching pandas. Empty indexes are monotonic.
pub fn is_monotonic(t, desc) {
    idx := index(t)
    nlevels := index_nlevels(t)
    for label in idx {
        if _label_has_null(label, nlevels) { return false }
    }
    let mut i = 1
    while i < len(idx) {
        if _label_cmp_dir_n(idx[i - 1], idx[i], desc == true, false, nlevels) > 0 { return false }
        i = i + 1
    }
    true
}

// xs(t, key, level) — cross-section: select rows where one index level
// equals key and the other levels are free. key may be a scalar (with
// level naming the level, default 0) or a map {level: key} matching
// several levels at once (map keys are level names or numeric strings;
// level must be null in that form). Matching pandas xs:
//   - the selected levels are DROPPED from the result index by default
//     (use xs_opts with drop_level=false to keep them);
//   - selecting every level leaves a default positional index;
//   - a key absent from its level is an Err (pandas raises KeyError).
pub fn xs(t, key, level) {
    _xs_impl(t, key, level, true)
}

// xs_opts(t, key, opts) — xs with options.
//   opts.level:      int or str level for a scalar key (default 0).
//   opts.drop_level: bool, default true (pandas xs default).
pub fn xs_opts(t, key, opts) {
    let mut level = null
    let mut drop_level = true
    if opts != null {
        if _kind(opts) != "map" { return Err("dataframe.xs: opts must be a map") }
        level = opts["level"]
        if opts["drop_level"] != null {
            if _kind(opts["drop_level"]) != "bool" {
                return Err("dataframe.xs: drop_level must be boolean")
            }
            drop_level = opts["drop_level"]
        }
    }
    _xs_impl(t, key, level, drop_level)
}

fn _xs_impl(t, key, level, drop_level) {
    nlevels := index_nlevels(t)
    idx := index(t)
    let mut sel_levels = []
    let mut sel_keys = []
    if _kind(key) == "map" {
        if level != null {
            return Err("dataframe.xs: level must be null when key is a map")
        }
        if len(keys(key)) == 0 { return Err("dataframe.xs: key map cannot be empty") }
        for name in keys(key) {
            lv := _xs_resolve_level(t, name)
            if _kind(lv) == "result" { return lv }
            sel_levels = push(sel_levels, lv)
            sel_keys = push(sel_keys, key[name])
        }
    } else {
        lv := _xs_resolve_level(t, if level == null { 0 } else { level })
        if _kind(lv) == "result" { return lv }
        sel_levels = [lv]
        sel_keys = [key]
    }
    let mut sel_rows = []
    let mut sel_index = []
    let mut i = 0
    while i < len(t.rows) {
        label := idx[i]
        if nlevels > 1 && (_kind(label) != "list" || len(label) != nlevels) {
            return Err("dataframe.xs: malformed multi-index label")
        }
        let mut matched = true
        let mut s = 0
        while s < len(sel_levels) {
            lv_val := if nlevels > 1 { label[sel_levels[s]] } else { label }
            if _value_key(lv_val) != _value_key(sel_keys[s]) {
                matched = false
                break
            }
            s = s + 1
        }
        if matched {
            sel_rows = push(sel_rows, t.rows[i])
            sel_index = push(sel_index, label)
        }
        i = i + 1
    }
    if len(sel_rows) == 0 {
        return Err("dataframe.xs: key not found in index level")
    }
    if !drop_level {
        return _frame_with_index(t.columns, sel_rows, sel_index, t)
    }
    let mut remaining = []
    let mut li = 0
    while li < nlevels {
        if !contains(sel_levels, li) { remaining = push(remaining, li) }
        li = li + 1
    }
    if len(remaining) == 0 {
        // Every level selected → default positional index.
        return {"_df": true, "columns": t.columns, "rows": sel_rows}
    }
    if len(remaining) == 1 {
        r := remaining[0]
        name := if nlevels > 1 { t._index_levels[r] } else { t._index_name }
        let mut new_index = []
        for label in sel_index {
            new_index = push(new_index, if nlevels > 1 { label[r] } else { label })
        }
        result := {"_df": true, "columns": t.columns, "rows": sel_rows, "_index": new_index}
        if name != null { result["_index_name"] = name }
        return result
    }
    let mut new_levels = []
    for r in remaining { new_levels = push(new_levels, t._index_levels[r]) }
    let mut new_index = []
    for label in sel_index {
        let mut nl = []
        for r in remaining { nl = push(nl, label[r]) }
        new_index = push(new_index, nl)
    }
    {"_df": true, "columns": t.columns, "rows": sel_rows, "_index": new_index, "_index_levels": new_levels}
}

// Resolve an xs level: int position (incl. negative), level name, or a
// numeric string (map keys are always strings). Works for single-level
// frames too, unlike _resolve_level.
fn _xs_resolve_level(t, level) {
    nlevels := index_nlevels(t)
    if _kind(level) == "int" {
        let mut li = level
        if li < 0 { li = nlevels + li }
        if li < 0 || li >= nlevels { return Err("dataframe.xs: level index out of range") }
        return li
    }
    if _kind(level) == "str" {
        if nlevels > 1 {
            let mut i = 0
            while i < nlevels {
                if t._index_levels[i] == level { return i }
                i = i + 1
            }
        } else if index_name(t) == level {
            return 0
        }
        let mut i = 0
        while i < nlevels {
            if ("" + i) == level { return i }
            i = i + 1
        }
        return Err("dataframe.xs: unknown index level " + level)
    }
    Err("dataframe.xs: level must be int or str")
}

// Labels from a DataFrame's current index or a plain list.
fn _as_label_list(v, fname) {
    if _kind(v) == "map" && v["_df"] == true {
        if contains(keys(v), "_index") && v._index != null { return v._index }
        return _range(len(v.rows))
    }
    if _kind(v) == "list" { return v }
    Err("dataframe." + fname + " expects a DataFrame or a list of labels")
}

// Type rank for pandas' "safe" ordering of mixed-type labels:
// numbers/bools first, strings next, everything else last. Null is handled
// separately by _label_cmp_dir (na_position), never ranked here.
fn _label_rank(v) {
    k := _kind(v)
    if k == "int" || k == "float" || k == "bool" { return 0 }
    if k == "str" { return 1 }
    2
}

fn _label_num(v) {
    if _kind(v) == "bool" { return if v { 1 } else { 0 } }
    v
}

// Compare two non-null labels: numbers/bools numerically (bools as 0/1),
// strings lexicographically, other values by JSON encoding. Type groups
// order by _label_rank. Returns <0, 0, or >0.
fn _label_cmp_values(a, b) {
    ra := _label_rank(a)
    rb := _label_rank(b)
    if ra != rb { return ra - rb }
    if ra == 0 {
        na := _label_num(a)
        nb := _label_num(b)
        if na < nb { return -1 }
        if na > nb { return 1 }
        return 0
    }
    if ra == 2 {
        ka := json.stringify(a)
        kb := json.stringify(b)
        if ka < kb { return -1 }
        if ka > kb { return 1 }
        return 0
    }
    if a < b { return -1 }
    if a > b { return 1 }
    0
}

// Full label compare with null placement (na_first) and direction (desc).
// Null placement is independent of direction, like pandas na_position.
fn _label_cmp_dir(a, b, desc, na_first) {
    if a == null {
        if b == null { return 0 }
        return if na_first { -1 } else { 1 }
    }
    if b == null { return if na_first { 1 } else { -1 } }
    c := _label_cmp_values(a, b)
    if desc { -c } else { c }
}

// Level-by-level compare for multi-level labels; scalars compare directly.
fn _label_cmp_dir_n(a, b, desc, na_first, nlevels) {
    if nlevels <= 1 || _kind(a) != "list" || _kind(b) != "list" {
        return _label_cmp_dir(a, b, desc, na_first)
    }
    n := if len(a) < len(b) { len(a) } else { len(b) }
    let mut i = 0
    while i < n {
        c := _label_cmp_dir(a[i], b[i], desc, na_first)
        if c != 0 { return c }
        i = i + 1
    }
    0
}

fn _label_has_null(label, nlevels) {
    if label == null { return true }
    if nlevels > 1 && _kind(label) == "list" {
        for v in label { if v == null { return true } }
    }
    false
}

// Stable ascending merge sort of label lists (nulls last).
fn _sort_labels(values) {
    if len(values) <= 1 { return _copy_rows(values) }
    mid := len(values) / 2
    left := _sort_labels(_value_range(values, 0, mid))
    right := _sort_labels(_value_range(values, mid, len(values)))
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _label_cmp_dir(left[li], right[ri], false, false) > 0 {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) { result = push(result, left[li]) li = li + 1 }
    while ri < len(right) { result = push(result, right[ri]) ri = ri + 1 }
    result
}

// Stable merge sort of {"label", "row"} pairs by label. Ties keep the
// original row order (pandas sort_index stability).
fn _label_sort_pairs(pairs, desc, na_first, nlevels) {
    if len(pairs) <= 1 { return _copy_rows(pairs) }
    mid := len(pairs) / 2
    left := _label_sort_pairs(_value_range(pairs, 0, mid), desc, na_first, nlevels)
    right := _label_sort_pairs(_value_range(pairs, mid, len(pairs)), desc, na_first, nlevels)
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _label_cmp_dir_n(left[li].label, right[ri].label, desc, na_first, nlevels) > 0 {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) { result = push(result, left[li]) li = li + 1 }
    while ri < len(right) { result = push(result, right[ri]) ri = ri + 1 }
    result
}

pub fn head(t, n) {
    let mut cnt = if n == null { 5 } else { n }
    if _kind(cnt) != "int" || cnt < 0 { return Err("dataframe.head requires a non-negative integer row count") }
    if cnt > len(t.rows) { cnt = len(t.rows) }
    let mut rows = []
    let mut i = 0
    while i < cnt {
        rows = push(rows, t.rows[i])
        i = i + 1
    }
    _with_columns(t, rows)
}

pub fn tail(t, n) {
    let mut cnt = if n == null { 5 } else { n }
    if _kind(cnt) != "int" || cnt < 0 { return Err("dataframe.tail requires a non-negative integer row count") }
    let mut start = len(t.rows) - cnt
    if start < 0 { start = 0 }
    let mut rows = []
    let mut i = start
    while i < len(t.rows) {
        rows = push(rows, t.rows[i])
        i = i + 1
    }
    _with_columns(t, rows)
}

pub fn iloc(t, idx) {
    // Scalar position returns a row; a list of positions returns a frame.
    if _kind(idx) == "int" {
        let mut position = idx
        if position < 0 { position = position + len(t.rows) }
        if position < 0 || position >= len(t.rows) { return Err("dataframe.iloc row position out of range") }
        return t.rows[position]
    }
    if _kind(idx) == "list" {
        let mut selected = []
        for raw in idx {
            if _kind(raw) != "int" { return Err("dataframe.iloc positions must be integers") }
            let mut position = raw
            if position < 0 { position = position + len(t.rows) }
            if position < 0 || position >= len(t.rows) { return Err("dataframe.iloc row position out of range") }
            selected = push(selected, t.rows[position])
        }
        return _with_columns(t, selected)
    }
    Err("dataframe.iloc expects an integer or list of integers")
}

pub fn loc(t, start, stop) {
    // Row range by position. Kept for backwards compatibility; label-based
    // selection (pandas .loc semantics) lives in loc_label below.
    if _kind(start) != "int" || start < 0 || start > len(t.rows) { return Err("dataframe.loc start must be a valid row position") }
    let mut rows = []
    let mut i = start
    s := if stop == null { len(t.rows) } else { stop }
    if _kind(s) != "int" || s < start || s > len(t.rows) { return Err("dataframe.loc stop must be a valid row position") }
    while i < s {
        rows = push(rows, t.rows[i])
        i = i + 1
    }
    _with_columns(t, rows)
}

// ──────────────────────────────────────────────
// Label-based selection & assignment (pandas .loc semantics)
// ──────────────────────────────────────────────
//
// Row selectors shared by loc_label/loc_set:
//   - scalar label: exact match; on a multi-level index a scalar matches the
//     first level and a list acts as a partial (prefix) key, selecting all
//     matching rows (pandas partial-key rule). Duplicate labels match all
//     their rows. An absent label is an Err naming the label (KeyError).
//   - list of labels: each label matched as above, in selector order.
//   - list of booleans: a positional mask; its length must equal the row
//     count, otherwise an Err in pandas' words ("Boolean index has wrong
//     length: X instead of Y"). An all-boolean list is ALWAYS a mask, even
//     when the index itself holds booleans (observed pandas 3.0 behavior).
//   - map {"from": a, "to": b}: label slice, inclusive of both ends like
//     pandas. null from/to are open ends. Found bounds resolve to positions
//     (first occurrence for from, last for to), so slices work on unsorted
//     indexes when both labels exist; a non-unique "from" is an Err (pandas
//     "Cannot get left slice bound for non-unique label"). A missing bound
//     uses insertion-point semantics on a monotonic index and is an Err on
//     a non-monotonic one (pandas KeyError wording).

// Positions whose index label matches the selector label (full key, partial
// prefix list, or scalar first-level for multi-level; exact for single).
fn _loc_match_positions(idx, n, label, nlevels) {
    let mut positions = []
    let mut i = 0
    while i < n {
        if _index_label_matches(idx[i], label, nlevels) { positions = push(positions, i) }
        i = i + 1
    }
    positions
}

// Compare a slice bound (scalar or prefix list) against an index label,
// level by level for multi-level indexes.
fn _loc_bound_cmp(label, bound, nlevels) {
    if nlevels <= 1 || _kind(label) != "list" { return _label_cmp_values(label, bound) }
    bv := if _kind(bound) == "list" { bound } else { [bound] }
    let mut i = 0
    while i < len(bv) && i < len(label) {
        c := _label_cmp_values(label[i], bv[i])
        if c != 0 { return c }
        i = i + 1
    }
    0
}

// Resolve one slice bound to a row position: {"pos": p} or an Err.
fn _loc_slice_bound(t, idx, bound, is_left, fname) {
    n := len(idx)
    nlevels := index_nlevels(t)
    if bound == null {
        return {"pos": if is_left { 0 } else { n - 1 }}
    }
    m := _loc_match_positions(idx, n, bound, nlevels)
    if len(m) > 0 {
        // pandas raises for a non-unique left bound on a single-level index;
        // on a multi-level index partial keys normally match several rows,
        // so the left bound is the first match, the right bound the last.
        if is_left && len(m) > 1 && nlevels <= 1 {
            return Err(fname + ": Cannot get left slice bound for non-unique label: " + json.stringify(bound))
        }
        return {"pos": if is_left { m[0] } else { m[len(m) - 1] }}
    }
    // Missing label: insertion point on a monotonic index, error otherwise.
    let mut desc = false
    if is_monotonic(t, false) { desc = false }
    else if is_monotonic(t, true) { desc = true }
    else {
        side := if is_left { "left" } else { "right" }
        return Err(fname + ": Cannot get " + side + " slice bound for non-monotonic index with a missing label " + json.stringify(bound) + ". Either sort the index or specify an existing label.")
    }
    let mut pos = if is_left { n } else { -1 }
    let mut i = 0
    while i < n {
        c := _loc_bound_cmp(idx[i], bound, nlevels)
        if !desc {
            if is_left {
                if c > 0 { pos = i break }
            } else {
                if c < 0 { pos = i }
            }
        } else {
            if is_left {
                if c < 0 { pos = i break }
            } else {
                if c > 0 { pos = i }
            }
        }
        i = i + 1
    }
    {"pos": pos}
}

fn _loc_slice_positions(t, from, to, fname) {
    idx := index(t)
    start := _loc_slice_bound(t, idx, from, true, fname)
    if _kind(start) == "result" { return start }
    stop := _loc_slice_bound(t, idx, to, false, fname)
    if _kind(stop) == "result" { return stop }
    let mut positions = []
    if start.pos <= stop.pos {
        let mut i = start.pos
        while i <= stop.pos { positions = push(positions, i) i = i + 1 }
    }
    positions
}

// Resolve a row selector to {"positions", "scalar"} or an Err.
fn _loc_resolve_rows(t, row_sel, fname) {
    n := len(t.rows)
    idx := index(t)
    nlevels := index_nlevels(t)
    if _kind(row_sel) == "map" {
        if row_sel["from"] == null && row_sel["to"] == null {
            return Err(fname + ": a map row selector is a label slice and needs \"from\" and/or \"to\"")
        }
        positions := _loc_slice_positions(t, row_sel["from"], row_sel["to"], fname)
        if _kind(positions) == "result" { return positions }
        return {"positions": positions, "scalar": false}
    }
    if _kind(row_sel) == "list" {
        if len(row_sel) == 0 { return {"positions": [], "scalar": false} }
        let mut all_bool = true
        for e in row_sel { if _kind(e) != "bool" { all_bool = false } }
        if all_bool {
            if len(row_sel) != n {
                return Err(fname + ": Boolean index has wrong length: " + len(row_sel) + " instead of " + n)
            }
            let mut positions = []
            let mut i = 0
            while i < n { if row_sel[i] { positions = push(positions, i) } i = i + 1 }
            return {"positions": positions, "scalar": false}
        }
        let mut positions = []
        for label in row_sel {
            if _kind(label) == "bool" {
                return Err(fname + ": row selector list cannot mix booleans and labels")
            }
            m := _loc_match_positions(idx, n, label, nlevels)
            if len(m) == 0 {
                return Err(fname + ": label not in index: " + json.stringify(label))
            }
            for p in m { positions = push(positions, p) }
        }
        return {"positions": positions, "scalar": false}
    }
    m := _loc_match_positions(idx, n, row_sel, nlevels)
    if len(m) == 0 {
        return Err(fname + ": label not in index: " + json.stringify(row_sel))
    }
    {"positions": m, "scalar": true}
}

// Resolve a column selector to {"cols", "single"} or an Err.
// null means all columns; a string must name an existing column.
fn _loc_resolve_cols(t, col_sel, fname) {
    if col_sel == null {
        let mut cols = []
        for c in t.columns { cols = push(cols, c) }
        return {"cols": cols, "single": false}
    }
    if _kind(col_sel) == "str" {
        if !contains(t.columns, col_sel) { return Err(fname + ": unknown column: " + col_sel) }
        return {"cols": [col_sel], "single": true}
    }
    if _kind(col_sel) == "list" {
        for c in col_sel {
            if _kind(c) != "str" || !contains(t.columns, c) {
                return Err(fname + ": unknown column: " + json.stringify(c))
            }
        }
        return {"cols": col_sel, "single": false}
    }
    Err(fname + ": column selector must be a column name, a list of names, or null")
}

// Build a frame from selected row positions, carrying index labels by
// position (safe with duplicate rows, unlike value-based index lookup).
fn _loc_frame(t, cols, positions) {
    let mut rows = []
    for p in positions { rows = push(rows, t.rows[p]) }
    if contains(keys(t), "_index") && t._index != null {
        idx := index(t)
        let mut labels = []
        for p in positions { labels = push(labels, idx[p]) }
        return _frame_with_index(cols, rows, labels, t)
    }
    {"_df": true, "columns": cols, "rows": rows}
}

// loc_label(t, row_sel, col_sel) — pandas-style label selection.
//   row_sel: scalar label, list of labels, boolean mask, or
//     {"from": a, "to": b} label slice (inclusive both ends). See the
//     section comment above for the exact rules.
//   col_sel: null (all columns), a column name, or a list of names.
// Return shape mirrors pandas: a scalar selector matching exactly one row
// returns that row as a map (the cell value when col_sel is a single name,
// a column-restricted map when col_sel is a list); a scalar matching
// several duplicate rows — and every non-scalar selector — returns a frame.
pub fn loc_label(t, row_sel, col_sel) {
    rr := _loc_resolve_rows(t, row_sel, "dataframe.loc_label")
    if _kind(rr) == "result" { return rr }
    cr := _loc_resolve_cols(t, col_sel, "dataframe.loc_label")
    if _kind(cr) == "result" { return cr }
    if rr.scalar && len(rr.positions) == 1 {
        row := t.rows[rr.positions[0]]
        if col_sel == null { return row }
        if cr.single { return row[cr.cols[0]] }
        let mut out = {}
        for c in cr.cols { out[c] = row[c] }
        return out
    }
    _loc_frame(t, cr.cols, rr.positions)
}

// Shared assignment core: set cells at positions x cols to value and return
// a new frame (frames are immutable). value may be:
//   - a scalar: broadcast to every selected cell;
//   - a list: per-row values when one column is selected and the length
//     equals the number of selected rows; per-column values broadcast to
//     every selected row when the length equals the number of selected
//     columns; a single-element list broadcasts everywhere (all observed
//     pandas 3.0 behaviors). Anything else is an explicit Err.
// An empty selection is a no-op for scalars; a list that fits none of the
// rules above is an Err even then (observed pandas behavior).
// Duplicate positions are assigned in order, so the last write wins.
fn _assign_cells(t, positions, cols, value, fname) {
    nR := len(positions)
    nC := len(cols)
    let mut row_values = []
    if _kind(value) == "list" {
        L := len(value)
        if nC == 1 && L == nR {
            for v in value { row_values = push(row_values, [v]) }
        } else if L == nC {
            let mut i = 0
            while i < nR { row_values = push(row_values, value) i = i + 1 }
        } else if L == 1 {
            let mut i = 0
            while i < nR { row_values = push(row_values, [value[0]]) i = i + 1 }
        } else {
            return Err(fname + ": cannot broadcast a list of length " + L + " into a selection of " + nR + " row(s) x " + nC + " column(s)")
        }
    } else {
        let mut i = 0
        while i < nR {
            let mut rv = []
            let mut j = 0
            while j < nC { rv = push(rv, value) j = j + 1 }
            row_values = push(row_values, rv)
            i = i + 1
        }
    }
    // Value row per absolute position; duplicate positions: last wins.
    let mut val_at = []
    let mut i = 0
    while i < len(t.rows) { val_at = push(val_at, null) i = i + 1 }
    let mut k = 0
    while k < nR { val_at[positions[k]] = row_values[k] k = k + 1 }
    let mut new_rows = []
    i = 0
    while i < len(t.rows) {
        if val_at[i] == null {
            new_rows = push(new_rows, t.rows[i])
        } else {
            let mut nr = {}
            for c in t.columns { nr[c] = t.rows[i][c] }
            let mut j = 0
            while j < nC { nr[cols[j]] = val_at[i][j] j = j + 1 }
            new_rows = push(new_rows, nr)
        }
        i = i + 1
    }
    _with_same_index(t, t.columns, new_rows)
}

// loc_set(t, row_sel, col_sel, value) — pandas-style label assignment.
// Row/column selectors follow loc_label rules; col_sel of null means all
// columns. Every row matching the selector is updated (pandas duplicate-
// label assignment rule). Unknown labels/columns are Errs naming them.
// Unlike pandas, unknown columns are NOT created — an Err names the column.
pub fn loc_set(t, row_sel, col_sel, value) {
    rr := _loc_resolve_rows(t, row_sel, "dataframe.loc_set")
    if _kind(rr) == "result" { return rr }
    cr := _loc_resolve_cols(t, col_sel, "dataframe.loc_set")
    if _kind(cr) == "result" { return cr }
    _assign_cells(t, rr.positions, cr.cols, value, "dataframe.loc_set")
}

// iloc_set(t, row_sel, col_sel, value) — positional assignment.
// row_sel: integer, list of integers (negative counts from the end), or
// null for all rows. col_sel: integer column position, list of positions,
// or null for all columns. value broadcasting follows _assign_cells rules.
pub fn iloc_set(t, row_sel, col_sel, value) {
    fname := "dataframe.iloc_set"
    n := len(t.rows)
    let mut positions = []
    if row_sel == null {
        let mut i = 0
        while i < n { positions = push(positions, i) i = i + 1 }
    } else if _kind(row_sel) == "int" {
        p := _iloc_row_position(row_sel, n, fname)
        if _kind(p) == "result" { return p }
        positions = [p]
    } else if _kind(row_sel) == "list" {
        for raw in row_sel {
            if _kind(raw) != "int" { return Err(fname + ": row positions must be integers") }
            p := _iloc_row_position(raw, n, fname)
            if _kind(p) == "result" { return p }
            positions = push(positions, p)
        }
    } else {
        return Err(fname + ": row selector must be an integer, a list of integers, or null")
    }
    ncols_n := len(t.columns)
    let mut cols = []
    if col_sel == null {
        for c in t.columns { cols = push(cols, c) }
    } else if _kind(col_sel) == "int" {
        c := _iloc_col_name(t, col_sel, fname)
        if _kind(c) == "result" { return c }
        cols = [c]
    } else if _kind(col_sel) == "list" {
        for raw in col_sel {
            if _kind(raw) != "int" { return Err(fname + ": column positions must be integers") }
            c := _iloc_col_name(t, raw, fname)
            if _kind(c) == "result" { return c }
            cols = push(cols, c)
        }
    } else {
        return Err(fname + ": column selector must be an integer, a list of integers, or null")
    }
    _assign_cells(t, positions, cols, value, fname)
}

fn _iloc_row_position(pos, n, fname) {
    let mut p = pos
    if p < 0 { p = p + n }
    if p < 0 || p >= n { return Err(fname + ": row position " + pos + " out of range for " + n + " row(s)") }
    p
}

fn _iloc_col_name(t, pos, fname) {
    n := len(t.columns)
    let mut p = pos
    if p < 0 { p = p + n }
    if p < 0 || p >= n { return Err(fname + ": column position " + pos + " out of range for " + n + " column(s)") }
    t.columns[p]
}

pub fn select_(t, cols) {
    if !_has_columns(t, cols) { return Err("dataframe.select_: unknown column") }
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in cols { nr[c] = r[c] }
        new_rows = push(new_rows, nr)
    }
    _with_same_index(t, cols, new_rows)
}

pub fn drop(t, cols) {
    let mut keep = []
    for c in t.columns {
        if !contains(cols, c) { keep = push(keep, c) }
    }
    select_(t, keep)
}

// ──────────────────────────────────────────────
// Filtering / querying
// ──────────────────────────────────────────────

pub fn filter_(t, pred) {
    let mut rows = []
    for r in t.rows {
        if pred(r) { rows = push(rows, r) }
    }
    _with_columns(t, rows)
}

pub fn query(t, column, op, value) {
    if !contains(t.columns, column) { return Err("dataframe.query: unknown column " + column) }
    // query(df, "age", ">", 30) — string-based for simple filters
    filter_(t, fn(r) {
        v := r[column]
        if v == null { return false }
        match op {
            "==" { v == value }
            "!=" { v != value }
            ">"  { v > value }
            ">=" { v >= value }
            "<"  { v < value }
            "<=" { v <= value }
            _    { false }
        }
    })
}

pub fn isin(t, column, values) {
    if !contains(t.columns, column) { return Err("dataframe.isin: unknown column " + column) }
    filter_(t, fn(r) { contains(values, r[column]) })
}

pub fn between(t, column, low, high) {
    if !contains(t.columns, column) { return Err("dataframe.between: unknown column " + column) }
    filter_(t, fn(r) {
        v := r[column]
        v != null && v >= low && v <= high
    })
}

pub fn notnull(t, column) {
    if !contains(t.columns, column) { return Err("dataframe.notnull: unknown column " + column) }
    filter_(t, fn(r) { r[column] != null })
}

// ──────────────────────────────────────────────
// Sorting
// ──────────────────────────────────────────────

pub fn sort_by(t, column, desc) {
    if !contains(t.columns, column) { return Err("dataframe.sort_by: unknown column " + column) }
    // Stable merge sort keeps large-frame sorting O(n log n).
    sorted := _merge_sort_rows(t.rows, column, desc)
    _with_columns(t, sorted)
}

pub fn sort_by_multi(t, columns_list, desc_list) {
    if !_has_columns(t, columns_list) { return Err("dataframe.sort_by_multi: unknown column") }
    sorted := _merge_sort_rows_multi(t.rows, columns_list, desc_list)
    _with_columns(t, sorted)
}

pub fn nlargest(t, n, column) {
    if !contains(t.columns, column) { return Err("dataframe.nlargest: unknown column " + column) }
    sort_by(t, column, true) |> head(n)
}

pub fn nsmallest(t, n, column) {
    if !contains(t.columns, column) { return Err("dataframe.nsmallest: unknown column " + column) }
    sort_by(t, column, false) |> head(n)
}

// ──────────────────────────────────────────────
// Column operations
// ──────────────────────────────────────────────

pub fn add_column(t, name, f) {
    let mut new_cols = []
    let exists = contains(t.columns, name)
    for c in t.columns { new_cols = push(new_cols, c) }
    if !exists { new_cols = push(new_cols, name) }
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in t.columns { nr[c] = r[c] }
        nr[name] = f(r)
        new_rows = push(new_rows, nr)
    }
    _with_same_index(t, new_cols, new_rows)
}

pub fn assign(t, assignments) {
    // assign(df, {"full_name": fn(r) { r.first + " " + r.last }, "age_group": fn(r) { ... }})
    let mut result = t
    for name in keys(assignments) {
        result = add_column(result, name, assignments[name])
    }
    result
}

pub fn rename(t, mapping) {
    // rename(df, {"old_name": "new_name"})
    let mut new_cols = []
    for c in t.columns {
        nc := if mapping[c] != null { mapping[c] } else { c }
        if contains(new_cols, nc) { return Err("dataframe.rename would create duplicate column: " + nc) }
        new_cols = push(new_cols, nc)
    }
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in t.columns {
            nc := if mapping[c] != null { mapping[c] } else { c }
            nr[nc] = r[c]
        }
        new_rows = push(new_rows, nr)
    }
    _with_same_index(t, new_cols, new_rows)
}

pub fn apply_(t, column, f) {
    // Apply function to one column, return new df
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in t.columns { nr[c] = r[c] }
        nr[column] = f(r[column])
        new_rows = push(new_rows, nr)
    }
    let mut cols = []
    for c in t.columns { cols = push(cols, c) }
    if !contains(cols, column) { cols = push(cols, column) }
    _with_same_index(t, cols, new_rows)
}

pub fn apply_row(t, f) {
    // Apply function to each row, collect results as list
    let mut results = []
    for r in t.rows { results = push(results, f(r)) }
    results
}

pub fn replace(t, column, old_val, new_val) {
    apply_(t, column, fn(v) { if v == old_val { new_val } else { v } })
}

pub fn clip_(t, column, lo, hi) {
    apply_(t, column, fn(v) {
        if v == null { null }
        else if v < lo { lo }
        else if v > hi { hi }
        else { v }
    })
}

pub fn fill_value(t, column, fill) {
    apply_(t, column, fn(v) { if v == null { fill } else { v } })
}

// ──────────────────────────────────────────────
// Missing data
// ──────────────────────────────────────────────

pub fn fillna(t, fill_map) {
    // fillna(df, {"age": 0, "name": "unknown"})
    let mut result = t
    for col_name in keys(fill_map) {
        result = fill_value(result, col_name, fill_map[col_name])
    }
    result
}

pub fn dropna(t, subset) {
    // Drop rows where any column in subset is null (default: all columns)
    check_cols := if subset == null { t.columns } else { subset }
    filter_(t, fn(r) {
        for c in check_cols {
            if r[c] == null { return false }
        }
        true
    })
}

pub fn isna(t, column) {
    // Return list of booleans
    let mut result = []
    for r in t.rows { result = push(result, r[column] == null) }
    result
}

pub fn count_na(t, column) {
    let mut n = 0
    for r in t.rows { if r[column] == null { n = n + 1 } }
    n
}

// ──────────────────────────────────────────────
// Duplicates
// ──────────────────────────────────────────────

pub fn drop_duplicates(t, subset) {
    check_cols := if subset == null { t.columns } else { subset }
    if !_has_columns(t, check_cols) { return Err("dataframe.drop_duplicates: unknown column") }
    let mut seen = {}
    let mut rows = []
    for r in t.rows {
        key := _row_key(r, check_cols)
        if seen[key] == null {
            seen[key] = true
            rows = push(rows, r)
        }
    }
    from_rows(rows)
}

pub fn duplicated(t, subset) {
    check_cols := if subset == null { t.columns } else { subset }
    if !_has_columns(t, check_cols) { return Err("dataframe.duplicated: unknown column") }
    let mut seen = {}
    let mut result = []
    for r in t.rows {
        key := _row_key(r, check_cols)
        if seen[key] != null {
            result = push(result, true)
        } else {
            seen[key] = true
            result = push(result, false)
        }
    }
    result
}

// ──────────────────────────────────────────────
// Aggregation / grouping
// ──────────────────────────────────────────────

// group_by(t, key_or_keys, aggs)
//   key_or_keys: single column name or list of column names (composite key).
//   aggs: map of output-name -> {"col": c, "op": op}  (named aggregation), or
//         column-name -> [op, ...] / op  (per-column agg list; output columns
//         are named "<col>_<op>", e.g. "salary_sum").
// Groups are keyed by _composite_key (see Internals), so nulls and
// mixed-type key values group exactly, never by string collision.
pub fn group_by(t, group_col, aggs) {
    key_cols := if _kind(group_col) == "list" { group_col } else { [group_col] }
    if len(key_cols) == 0 { return Err("dataframe.group_by: no group columns") }
    for c in key_cols {
        if !contains(t.columns, c) { return Err("dataframe.group_by: unknown group column " + c) }
    }
    // Normalize aggs into an ordered spec list of {"name", "col", "op"}.
    let mut specs = []
    for agg_name in keys(aggs) {
        spec := aggs[agg_name]
        if _kind(spec) == "map" {
            if !contains(t.columns, spec.col) { return Err("dataframe.group_by: unknown aggregation column") }
            if !_valid_agg(spec.op) { return Err("dataframe.group_by: unknown aggregation") }
            specs = push(specs, {"name": agg_name, "col": spec.col, "op": spec.op})
        } else if _kind(spec) == "list" || _kind(spec) == "str" {
            ops := if _kind(spec) == "list" { spec } else { [spec] }
            if !contains(t.columns, agg_name) { return Err("dataframe.group_by: unknown aggregation column " + agg_name) }
            for op in ops {
                if !_valid_agg(op) { return Err("dataframe.group_by: unknown aggregation") }
                specs = push(specs, {"name": agg_name + "_" + op, "col": agg_name, "op": op})
            }
        } else {
            return Err("dataframe.group_by: invalid aggregation spec for " + agg_name)
        }
    }
    let mut groups = {}
    let mut group_order = []
    for r in t.rows {
        k := _composite_key(r, key_cols)
        if groups[k] == null {
            groups[k] = []
            group_order = push(group_order, k)
        }
        groups[k] = push(groups[k], r)
    }
    let mut result = []
    for gk in group_order {
        g := groups[gk]
        let mut row = {}
        for c in key_cols { row[c] = g[0][c] }
        for spec in specs {
            vals := _col_vals(g, spec.col)
            row[spec.name] = _agg(spec.op, vals)
        }
        result = push(result, row)
    }
    let mut new_cols = []
    for c in key_cols { new_cols = push(new_cols, c) }
    for spec in specs { new_cols = push(new_cols, spec.name) }
    {"_df": true, "columns": new_cols, "rows": result}
}

// Pandas-style transform: each row gets its group's aggregate of `column`.
// Result keeps the same columns and index; the target column is replaced.
pub fn group_by_transform(t, group_col, column, op) {
    if !contains(t.columns, group_col) { return Err("dataframe.group_by_transform: unknown group column") }
    if !contains(t.columns, column) { return Err("dataframe.group_by_transform: unknown column") }
    if !_valid_agg(op) { return Err("dataframe.group_by_transform: unknown aggregation") }
    let mut groups = {}
    for r in t.rows {
        k := _value_key(r[group_col])
        if groups[k] == null { groups[k] = [] }
        groups[k] = push(groups[k], r[column])
    }
    let mut stats = {}
    for k in keys(groups) {
        stats[k] = _agg(op, groups[k])
    }
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in t.columns { nr[c] = r[c] }
        nr[column] = stats[_value_key(r[group_col])]
        new_rows = push(new_rows, nr)
    }
    _with_same_index(t, t.columns, new_rows)
}

pub fn group_by_size(t, group_col) {
    if !contains(t.columns, group_col) { return Err("dataframe.group_by_size: unknown group column") }
    let mut groups = {}
    let mut group_order = []
    for r in t.rows {
        k := _value_key(r[group_col])
        if groups[k] == null {
            groups[k] = {"key": r[group_col], "n": 0}
            group_order = push(group_order, k)
        }
        groups[k] = {"key": groups[k].key, "n": groups[k].n + 1}
    }
    let mut result = []
    for gk in group_order {
        g := groups[gk]
        let mut row = {}
        row[group_col] = g.key
        row["size"] = g.n
        result = push(result, row)
    }
    {"_df": true, "columns": [group_col, "size"], "rows": result}
}

pub fn agg(t, aggs) {
    // Aggregate whole dataframe: agg(df, {"total": {col: "price", op: "sum"}, ...})
    let mut row = {}
    for agg_name in keys(aggs) {
        spec := aggs[agg_name]
        if !contains(t.columns, spec.col) || !_valid_agg(spec.op) { return Err("dataframe.agg: invalid aggregation") }
        vals := _col_vals(t.rows, spec.col)
        row[agg_name] = _agg(spec.op, vals)
    }
    row
}

pub fn value_counts(t, column) {
    let mut counts = {}
    let mut values = {}
    let mut order = []
    for r in t.rows {
        k := _value_key(r[column])
        if counts[k] == null {
            counts[k] = 0
            values[k] = r[column]
            order = push(order, k)
        }
        counts[k] = counts[k] + 1
    }
    let mut result = {}
    for k in order {
        let mut display = "" + values[k]
        if result[display] != null {
            display = display + " (" + _kind(values[k]) + ")"
            let mut suffix = 2
            while result[display] != null {
                display = "" + values[k] + " (" + _kind(values[k]) + ")" + str(suffix)
                suffix = suffix + 1
            }
        }
        result[display] = counts[k]
    }
    result
}

pub fn nunique(t, column) {
    let mut seen = {}
    let mut n = 0
    for r in t.rows {
        k := _value_key(r[column])
        if seen[k] == null {
            seen[k] = true
            n = n + 1
        }
    }
    n
}

// ──────────────────────────────────────────────
// Statistics
// ──────────────────────────────────────────────

pub fn describe(t, column) {
    if !contains(t.columns, column) { return Err("dataframe.describe: unknown column " + column) }
    vals := _numeric_col(t, column)
    n := len(vals)
    if n == 0 { return {"count": 0} }
    sorted := _sort_values(vals)
    s := _sum_list(vals)
    mn := s / n
    let mut var_sum = 0.0
    for x in vals { var_sum = var_sum + (x - mn) * (x - mn) }
    std := if n < 2 { null } else { math.sqrt(var_sum / (n - 1)) }
    {
        "count": n,
        "mean": mn,
        "std": std,
        "min": sorted[0],
        "25%": _percentile(sorted, 25),
        "50%": _percentile(sorted, 50),
        "75%": _percentile(sorted, 75),
        "max": sorted[n - 1],
        "sum": s,
    }
}

pub fn describe_all(t) {
    let mut result = {}
    for c in t.columns {
        vals := _numeric_col(t, c)
        if len(vals) > 0 {
            result[c] = describe(t, c)
        }
    }
    result
}

pub fn corr(t, col_a, col_b) {
    if !contains(t.columns, col_a) || !contains(t.columns, col_b) { return Err("dataframe.corr: unknown column") }
    pairs := _numeric_pairs(t, col_a, col_b)
    va := pairs.a
    vb := pairs.b
    n := len(va)
    if n < 2 { return null }
    ma := _sum_list(va) / n
    mb := _sum_list(vb) / n
    let mut cov = 0.0
    let mut sa = 0.0
    let mut sb = 0.0
    let mut i = 0
    while i < n {
        da := va[i] - ma
        db := vb[i] - mb
        cov = cov + da * db
        sa = sa + da * da
        sb = sb + db * db
        i = i + 1
    }
    denom := math.sqrt(sa) * math.sqrt(sb)
    if denom == 0 { null } else { cov / denom }
}

pub fn cov(t, col_a, col_b) {
    if !contains(t.columns, col_a) || !contains(t.columns, col_b) { return Err("dataframe.cov: unknown column") }
    pairs := _numeric_pairs(t, col_a, col_b)
    va := pairs.a
    vb := pairs.b
    n := len(va)
    if n < 2 { return null }
    ma := _sum_list(va) / n
    mb := _sum_list(vb) / n
    let mut c = 0.0
    let mut i = 0
    while i < n {
        c = c + (va[i] - ma) * (vb[i] - mb)
        i = i + 1
    }
    c / (n - 1)
}

// ──────────────────────────────────────────────
// Joins / merging
// ──────────────────────────────────────────────

pub fn join(left, right, on, how) {
    join_type := if how == null { "inner" } else { how }
    if !contains(left.columns, on) || !contains(right.columns, on) { return Err("dataframe.join: join column is missing") }
    if join_type != "inner" && join_type != "left" && join_type != "outer" {
        return Err("dataframe.join supports inner, left, and outer joins")
    }
    let mut idx = {}
    for r in right.rows {
        k := _value_key(r[on])
        if idx[k] == null { idx[k] = [] }
        idx[k] = push(idx[k], r)
    }
    let mut result = []
    let mut right_matched = {}
    right_names := _right_column_names(left, right, on)
    for lr in left.rows {
        k := _value_key(lr[on])
        matches := idx[k]
        if matches != null {
            right_matched[k] = true
            for rr in matches {
                let mut merged = {}
                for c in left.columns { merged[c] = lr[c] }
                for c in right.columns {
                    if c != on { merged[right_names[c]] = rr[c] }
                }
                result = push(result, merged)
            }
        } else if join_type == "left" || join_type == "outer" {
            let mut merged = {}
            for c in left.columns { merged[c] = lr[c] }
            for c in right.columns {
                if c != on { merged[right_names[c]] = null }
            }
            result = push(result, merged)
        }
    }
    // For outer join, add unmatched right rows
    if join_type == "outer" {
        for rr in right.rows {
            k := _value_key(rr[on])
            if right_matched[k] == null {
                let mut merged = {}
                for c in left.columns {
                    if c == on { merged[c] = rr[on] }
                    else { merged[c] = null }
                }
                for c in right.columns {
                    if c == on { merged[c] = rr[c] }
                    else { merged[right_names[c]] = rr[c] }
                }
                result = push(result, merged)
            }
        }
    }
    let mut all_cols = []
    for c in left.columns { all_cols = push(all_cols, c) }
    for c in right.columns {
        if c != on { all_cols = push(all_cols, right_names[c]) }
    }
    {"_df": true, "columns": all_cols, "rows": result}
}

pub fn concat_df(dfs) {
    // Concatenate dataframes vertically
    if len(dfs) == 0 { return from_rows([]) }
    let mut cols = []
    for df in dfs {
        for c in df.columns {
            if !contains(cols, c) { cols = push(cols, c) }
        }
    }
    let mut rows = []
    for df in dfs {
        for r in df.rows {
            let mut nr = {}
            for c in cols { nr[c] = r[c] }
            rows = push(rows, nr)
        }
    }
    {"_df": true, "columns": cols, "rows": rows}
}

// merge(left, right, left_on, right_on, how)
//   left_on/right_on: column name or list of column names (multi-key merge);
//   lists must have equal length. Null key components match each other
//   (pandas-style), and composite keys use the collision-free _composite_key
//   encoding. how: "inner" (default), "left", "outer".
//   Overlapping non-key columns: left keeps its name, right gets "_right".
//   Use merge_opts to pass explicit suffixes.
pub fn merge(left, right, left_on, right_on, how) {
    _merge_impl(left, right, left_on, right_on, how, null)
}

// merge_opts(left, right, left_on, right_on, how, opts) — merge with options.
//   opts.suffixes = [left_suffix, right_suffix] renames overlapping non-key
//   columns instead of the default "_right" right-side renaming.
pub fn merge_opts(left, right, left_on, right_on, how, opts) {
    _merge_impl(left, right, left_on, right_on, how, opts)
}

fn _merge_impl(left, right, left_on, right_on, how, opts) {
    join_type := if how == null { "inner" } else { how }
    lkeys := if _kind(left_on) == "list" { left_on } else { [left_on] }
    rkeys := if _kind(right_on) == "list" { right_on } else { [right_on] }
    if len(lkeys) == 0 || len(lkeys) != len(rkeys) {
        return Err("dataframe.merge: left_on and right_on must be non-empty and of equal length")
    }
    for k in lkeys {
        if !contains(left.columns, k) { return Err("dataframe.merge: join column is missing") }
    }
    for k in rkeys {
        if !contains(right.columns, k) { return Err("dataframe.merge: join column is missing") }
    }
    if join_type != "inner" && join_type != "left" && join_type != "outer" {
        return Err("dataframe.merge supports inner, left, and outer joins")
    }
    let mut suffixes = null
    if opts != null {
        if _kind(opts) != "map" { return Err("dataframe.merge: opts must be a map") }
        suffixes = opts["suffixes"]
        if suffixes != null && (_kind(suffixes) != "list" || len(suffixes) != 2) {
            return Err("dataframe.merge: suffixes must be a [left, right] pair")
        }
    }
    // Resolve output names for every column.
    let mut left_names = {}
    let mut used = {}
    for c in left.columns {
        let mut name = c
        if suffixes != null && contains(right.columns, c) && !contains(lkeys, c) && !contains(rkeys, c) {
            name = c + suffixes[0]
        }
        left_names[c] = name
        used[name] = true
    }
    let mut right_names = {}
    for c in right.columns {
        if contains(rkeys, c) { continue }
        let mut name = c
        if suffixes != null {
            if contains(left.columns, c) {
                name = c + suffixes[1]
            }
        } else if used[name] != null {
            name = c + "_right"
            let mut suffix = 2
            while used[name] != null {
                name = c + "_right" + str(suffix)
                suffix = suffix + 1
            }
        }
        if used[name] != null {
            return Err("dataframe.merge: suffixes produce a duplicate column name " + name)
        }
        used[name] = true
        right_names[c] = name
    }
    // Index right rows by composite key.
    let mut idx = {}
    for r in right.rows {
        k := _composite_key(r, rkeys)
        if idx[k] == null { idx[k] = [] }
        idx[k] = push(idx[k], r)
    }
    let mut result = []
    let mut right_matched = {}
    for lr in left.rows {
        k := _composite_key(lr, lkeys)
        matches := idx[k]
        if matches != null {
            right_matched[k] = true
            for rr in matches {
                let mut merged = {}
                for c in left.columns { merged[left_names[c]] = lr[c] }
                for c in right.columns {
                    if !contains(rkeys, c) { merged[right_names[c]] = rr[c] }
                }
                result = push(result, merged)
            }
        } else if join_type == "left" || join_type == "outer" {
            let mut merged = {}
            for c in left.columns { merged[left_names[c]] = lr[c] }
            for c in right.columns {
                if !contains(rkeys, c) { merged[right_names[c]] = null }
            }
            result = push(result, merged)
        }
    }
    if join_type == "outer" {
        for rr in right.rows {
            k := _composite_key(rr, rkeys)
            if right_matched[k] == null {
                let mut merged = {}
                for c in left.columns {
                    key_pos := _list_index(lkeys, c)
                    if key_pos >= 0 { merged[left_names[c]] = rr[rkeys[key_pos]] }
                    else { merged[left_names[c]] = null }
                }
                for c in right.columns {
                    if !contains(rkeys, c) { merged[right_names[c]] = rr[c] }
                }
                result = push(result, merged)
            }
        }
    }
    let mut all_cols = []
    for c in left.columns { all_cols = push(all_cols, left_names[c]) }
    for c in right.columns {
        if !contains(rkeys, c) { all_cols = push(all_cols, right_names[c]) }
    }
    {"_df": true, "columns": all_cols, "rows": result}
}

// ──────────────────────────────────────────────
// Reshaping
// ──────────────────────────────────────────────

pub fn pivot(t, index_col, pivot_col, value_col) {
    // Pivot: rows become columns
    if !contains(t.columns, index_col) || !contains(t.columns, pivot_col) || !contains(t.columns, value_col) {
        return Err("dataframe.pivot: unknown column")
    }
    let mut pivot_vals = []
    let mut seen = {}
    for r in t.rows {
        k := _value_key(r[pivot_col])
        if seen[k] == null {
            seen[k] = true
            pivot_vals = push(pivot_vals, r[pivot_col])
        }
    }
    let mut groups = {}
    let mut index_order = []
    let mut seen_pairs = {}
    for r in t.rows {
        k := _value_key(r[index_col])
        if groups[k] == null {
            groups[k] = {"_idx": r[index_col]}
            index_order = push(index_order, k)
        }
        pv := _value_key(r[pivot_col])
        pair := json.stringify([k, pv])
        if seen_pairs[pair] != null {
            return Err("dataframe.pivot found duplicate index/column pair")
        }
        seen_pairs[pair] = true
        groups[k][pv] = r[value_col]
    }
    let mut cols = [index_col]
    for pv in pivot_vals { cols = push(cols, "" + pv) }
    let mut rows = []
    for gk in index_order {
        let mut row = {}
        row[index_col] = groups[gk]._idx
        for pv in pivot_vals {
            pk := _value_key(pv)
            row["" + pv] = groups[gk][pk]
        }
        rows = push(rows, row)
    }
    {"_df": true, "columns": cols, "rows": rows}
}

// pivot_table(t, spec) — pivot WITH aggregation over duplicate index/column
// pairs (unlike pivot, which errors on duplicates).
//   spec.index:     column name or list of column names (row keys)
//   spec.columns:   column name whose values become output columns
//   spec.values:    column name to aggregate
//   spec.aggfunc:   "sum" | "mean" | "count" | "min" | "max" | "first" | "last" | "std"
//                   (default "mean")
//   spec.fill_value: value for index/column combinations with no rows
//                    (default null)
pub fn pivot_table(t, spec) {
    if _kind(spec) != "map" { return Err("dataframe.pivot_table expects a spec map") }
    index_spec := spec["index"]
    pivot_col := spec["columns"]
    value_col := spec["values"]
    if index_spec == null || pivot_col == null || value_col == null {
        return Err("dataframe.pivot_table spec requires index, columns, and values")
    }
    index_cols := if _kind(index_spec) == "list" { index_spec } else { [index_spec] }
    if len(index_cols) == 0 { return Err("dataframe.pivot_table: no index columns") }
    for c in index_cols {
        if !contains(t.columns, c) { return Err("dataframe.pivot_table: unknown index column " + c) }
    }
    if !contains(t.columns, pivot_col) { return Err("dataframe.pivot_table: unknown columns column " + pivot_col) }
    if !contains(t.columns, value_col) { return Err("dataframe.pivot_table: unknown values column " + value_col) }
    aggfunc := if spec["aggfunc"] == null { "mean" } else { spec["aggfunc"] }
    if !_valid_agg(aggfunc) { return Err("dataframe.pivot_table: unknown aggfunc " + aggfunc) }
    fill := spec["fill_value"]

    let mut pivot_vals = []
    let mut seen_pivot = {}
    let mut cells = {}
    let mut index_order = []
    let mut index_rows = {}
    for r in t.rows {
        pk := _value_key(r[pivot_col])
        if seen_pivot[pk] == null {
            seen_pivot[pk] = true
            pivot_vals = push(pivot_vals, r[pivot_col])
        }
        ik := _composite_key(r, index_cols)
        if index_rows[ik] == null {
            index_rows[ik] = r
            index_order = push(index_order, ik)
        }
        // Pair key: JSON array of the two collision-free key encodings.
        pair := json.stringify([ik, pk])
        if cells[pair] == null { cells[pair] = [] }
        cells[pair] = push(cells[pair], r[value_col])
    }
    let mut cols = []
    for c in index_cols { cols = push(cols, c) }
    for pv in pivot_vals { cols = push(cols, "" + pv) }
    let mut rows = []
    for ik in index_order {
        let mut row = {}
        for c in index_cols { row[c] = index_rows[ik][c] }
        for pv in pivot_vals {
            pk := _value_key(pv)
            pair := json.stringify([ik, pk])
            if cells[pair] == null {
                row["" + pv] = fill
            } else {
                row["" + pv] = _agg(aggfunc, cells[pair])
            }
        }
        rows = push(rows, row)
    }
    {"_df": true, "columns": cols, "rows": rows}
}
pub fn melt(t, id_cols, value_cols, var_name, val_name) {
    // Melt: columns become rows (unpivot)
    vn := if var_name == null { "variable" } else { var_name }
    vl := if val_name == null { "value" } else { val_name }
    melt_cols := if value_cols == null {
        let mut mc = []
        for c in t.columns {
            if !contains(id_cols, c) { mc = push(mc, c) }
        }
        mc
    } else { value_cols }
    let mut rows = []
    for r in t.rows {
        for vc in melt_cols {
            let mut nr = {}
            for ic in id_cols { nr[ic] = r[ic] }
            nr[vn] = vc
            nr[vl] = r[vc]
            rows = push(rows, nr)
        }
    }
    let mut cols = []
    for c in id_cols { cols = push(cols, c) }
    cols = push(cols, vn)
    cols = push(cols, vl)
    {"_df": true, "columns": cols, "rows": rows}
}

pub fn crosstab(t, row_col, col_col) {
    // Cross-tabulation (frequency table)
    if !contains(t.columns, row_col) || !contains(t.columns, col_col) { return Err("dataframe.crosstab: unknown column") }
    let mut ct = {}
    let mut row_vals = {}
    let mut seen_rows = {}
    let mut row_order = []
    let mut col_vals = {}
    let mut seen_cols = {}
    let mut col_order = []
    for r in t.rows {
        rk := _value_key(r[row_col])
        ck := _value_key(r[col_col])
        if seen_rows[rk] == null {
            seen_rows[rk] = true
            row_vals[rk] = r[row_col]
            row_order = push(row_order, rk)
        }
        if seen_cols[ck] == null {
            seen_cols[ck] = true
            col_vals[ck] = r[col_col]
            col_order = push(col_order, ck)
        }
        if ct[rk] == null { ct[rk] = {} }
        if ct[rk][ck] == null { ct[rk][ck] = 0 }
        ct[rk][ck] = ct[rk][ck] + 1
    }
    let mut cols = [row_col]
    for c in col_order { cols = push(cols, "" + col_vals[c]) }
    let mut rows = []
    for rk in row_order {
        let mut row = {}
        row[row_col] = row_vals[rk]
        for ck in col_order {
            row["" + col_vals[ck]] = if ct[rk][ck] != null { ct[rk][ck] } else { 0 }
        }
        rows = push(rows, row)
    }
    {"_df": true, "columns": cols, "rows": rows}
}

// ──────────────────────────────────────────────
// Window / rolling
// ──────────────────────────────────────────────

pub fn shift(t, column, periods) {
    n := if periods == null { 1 } else { periods }
    if !contains(t.columns, column) { return Err("dataframe.shift: unknown column " + column) }
    if _kind(n) != "int" || n < 0 { return Err("dataframe.shift periods must be a non-negative integer") }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        src := i - n
        nr[column] = if src >= 0 && src < len(t.rows) { t.rows[src][column] } else { null }
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

pub fn diff(t, column, periods) {
    n := if periods == null { 1 } else { periods }
    if !contains(t.columns, column) { return Err("dataframe.diff: unknown column " + column) }
    if _kind(n) != "int" || n < 0 { return Err("dataframe.diff periods must be a non-negative integer") }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        src := i - n
        if src >= 0 && t.rows[src][column] != null && t.rows[i][column] != null {
            nr[column] = t.rows[i][column] - t.rows[src][column]
        } else {
            nr[column] = null
        }
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

pub fn pct_change(t, column, periods) {
    n := if periods == null { 1 } else { periods }
    if !contains(t.columns, column) { return Err("dataframe.pct_change: unknown column " + column) }
    if _kind(n) != "int" || n < 0 { return Err("dataframe.pct_change periods must be a non-negative integer") }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        src := i - n
        if src >= 0 && t.rows[src][column] != null && t.rows[src][column] != 0 && t.rows[i][column] != null {
            nr[column] = (t.rows[i][column] - t.rows[src][column] + 0.0) / t.rows[src][column]
        } else {
            nr[column] = null
        }
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

pub fn rolling(t, column, window, op) {
    if !contains(t.columns, column) { return Err("dataframe.rolling: unknown column " + column) }
    if _kind(window) != "int" || window <= 0 { return Err("dataframe.rolling window must be a positive integer") }
    if !_valid_agg(op) { return Err("dataframe.rolling has an unknown aggregation: " + op) }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        if i >= window - 1 {
            let mut vals = []
            let mut j = i - window + 1
            while j <= i {
                vals = push(vals, t.rows[j][column])
                j = j + 1
            }
            clean := _non_null(vals)
            nr[column] = if len(clean) == window { _agg(op, vals) } else { null }
        } else {
            nr[column] = null
        }
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

pub fn expanding(t, column, op) {
    if !contains(t.columns, column) { return Err("dataframe.expanding: unknown column " + column) }
    if !_valid_agg(op) { return Err("dataframe.expanding has an unknown aggregation: " + op) }
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        let mut vals = []
        let mut j = 0
        while j <= i {
            vals = push(vals, t.rows[j][column])
            j = j + 1
        }
        nr[column] = _agg(op, vals)
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

// ewm_mean / ewm_sum / ewm_var / ewm_std(t, column, opts) — pandas-style
// exponentially-weighted window statistics. The column is replaced in place
// (same convention as rolling/expanding). opts:
//   alpha | span | halflife: exactly one required; pandas conversions
//     alpha = 2/(span+1), alpha = 1 - exp(-ln2/halflife), 0 < alpha <= 1
//   adjust:    true (default) — weights normalized by their sum;
//              false — recursive y_t = (1-alpha)*y_{t-1} + alpha*x_t
//   ignore_na: false (default) — null positions keep decaying the weight
//   bias:      false (default, ewm_var/ewm_std only) — unbiased estimator;
//              a single observation gives null (NaN) rather than 0
// Nulls before the first observation stay null; later nulls hold the previous
// value (pandas 3.0 behavior). All recursions replicate pandas 3.0
// (_libs/window/aggregations.ewm / ewmcov) step for step, including the
// com == 1 (alpha == 0.5) irregular-interval branch for adjust=false means.
// ewm_sum mirrors pandas in existing only for adjust=true (the un-normalized
// recursion) — adjust=false is an Err, like pandas' NotImplementedError.
pub fn ewm_mean(t, column, opts) {
    fname := "dataframe.ewm_mean"
    o := _ewm_resolve(opts, fname)
    if _kind(o) == "result" { return o }
    vals := _ewm_column(t, column, fname)
    if _kind(vals) == "result" { return vals }
    _ewm_replace(t, column, _ewm_run(vals, o.com, o.adjust, o.ignore_na, true))
}

pub fn ewm_sum(t, column, opts) {
    fname := "dataframe.ewm_sum"
    o := _ewm_resolve(opts, fname)
    if _kind(o) == "result" { return o }
    if !o.adjust { return Err(fname + ": sum is not implemented with adjust=False") }
    vals := _ewm_column(t, column, fname)
    if _kind(vals) == "result" { return vals }
    _ewm_replace(t, column, _ewm_run(vals, o.com, o.adjust, o.ignore_na, false))
}

pub fn ewm_var(t, column, opts) {
    fname := "dataframe.ewm_var"
    o := _ewm_resolve(opts, fname)
    if _kind(o) == "result" { return o }
    vals := _ewm_column(t, column, fname)
    if _kind(vals) == "result" { return vals }
    _ewm_replace(t, column, _ewm_var_run(vals, o.com, o.adjust, o.ignore_na, o.bias))
}

pub fn ewm_std(t, column, opts) {
    fname := "dataframe.ewm_std"
    o := _ewm_resolve(opts, fname)
    if _kind(o) == "result" { return o }
    vals := _ewm_column(t, column, fname)
    if _kind(vals) == "result" { return vals }
    vars := _ewm_var_run(vals, o.com, o.adjust, o.ignore_na, o.bias)
    let mut out = []
    for v in vars { out = push(out, if v == null { null } else { math.sqrt(v) }) }
    _ewm_replace(t, column, out)
}

// Validate ewm opts → {"com", "adjust", "ignore_na", "bias"} or an Err.
// com (center of mass) is computed with pandas' exact conversions; the
// kernels derive alpha = 1/(1+com) from it, matching the Cython round-trip
// bit-for-bit.
fn _ewm_resolve(opts, fname) {
    if opts == null || _kind(opts) != "map" {
        return Err(fname + ": opts must be a map with one of alpha, span, halflife")
    }
    let mut provided = []
    for k in ["alpha", "span", "halflife"] {
        if opts[k] != null { provided = push(provided, k) }
    }
    if len(provided) == 0 { return Err(fname + ": must pass one of alpha, span, or halflife") }
    if len(provided) > 1 { return Err(fname + ": alpha, span, and halflife are mutually exclusive") }
    key := provided[0]
    v := opts[key]
    if _kind(v) != "int" && _kind(v) != "float" { return Err(fname + ": " + key + " must be numeric") }
    let mut com = 0.0
    if key == "alpha" {
        a := v + 0.0
        if !(a > 0.0) || a > 1.0 { return Err(fname + ": alpha must satisfy: 0 < alpha <= 1") }
        com = (1.0 - a) / a
    } else if key == "span" {
        span := v + 0.0
        if span < 1.0 { return Err(fname + ": span must satisfy: span >= 1") }
        com = (span - 1.0) / 2.0
    } else {
        halflife := v + 0.0
        if !(halflife > 0.0) { return Err(fname + ": halflife must satisfy: halflife > 0") }
        decay := 1.0 - math.exp(math.log(0.5) / halflife)
        com = 1.0 / decay - 1.0
    }
    let mut adjust = true
    let mut ignore_na = false
    let mut bias = false
    if opts["adjust"] != null { adjust = opts["adjust"] }
    if opts["ignore_na"] != null { ignore_na = opts["ignore_na"] }
    if opts["bias"] != null { bias = opts["bias"] }
    {"com": com, "adjust": adjust, "ignore_na": ignore_na, "bias": bias}
}

// Extract a column as a float-or-null list; Err on unknown/non-numeric data.
fn _ewm_column(t, column, fname) {
    if !contains(t.columns, column) { return Err(fname + ": unknown column " + column) }
    let mut vals = []
    for r in t.rows {
        v := r[column]
        if v == null {
            vals = push(vals, null)
        } else if _kind(v) == "int" || _kind(v) == "float" {
            vals = push(vals, v + 0.0)
        } else {
            return Err(fname + ": column " + column + " must be numeric")
        }
    }
    vals
}

fn _ewm_replace(t, column, out) {
    let mut new_rows = []
    let mut i = 0
    while i < len(t.rows) {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        nr[column] = out[i]
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

// pandas 3.0 ewm recursion (normalize=true → mean, false → sum).
fn _ewm_run(vals, com, adjust, ignore_na, normalize) {
    let mut out = []
    if len(vals) == 0 { return out }
    alpha := 1.0 / (1.0 + com)
    old_wt_factor := 1.0 - alpha
    let mut new_wt = if adjust { 1.0 } else { alpha }
    let mut weighted = vals[0]
    let mut nobs = if vals[0] == null { 0 } else { 1 }
    let mut old_wt = 1.0
    out = push(out, if nobs >= 1 { weighted } else { null })
    let mut i = 1
    while i < len(vals) {
        cur := vals[i]
        is_obs := cur != null
        if is_obs { nobs = nobs + 1 }
        if weighted != null {
            if is_obs || !ignore_na {
                if normalize {
                    old_wt = old_wt * old_wt_factor
                } else {
                    weighted = old_wt_factor * weighted
                }
                if is_obs {
                    if normalize {
                        // avoid numerical drift on constant series
                        if weighted != cur {
                            if !adjust && com == 1.0 { new_wt = 1.0 - old_wt }
                            weighted = (old_wt * weighted + new_wt * cur) / (old_wt + new_wt)
                        }
                        if adjust { old_wt = old_wt + new_wt } else { old_wt = 1.0 }
                    } else {
                        weighted = weighted + cur
                    }
                }
            }
        } else if is_obs {
            weighted = cur
        }
        out = push(out, if nobs >= 1 { weighted } else { null })
        i = i + 1
    }
    out
}

// pandas 3.0 ewmcov recursion with input_y == input_x (variance).
fn _ewm_var_run(vals, com, adjust, ignore_na, bias) {
    let mut out = []
    if len(vals) == 0 { return out }
    alpha := 1.0 / (1.0 + com)
    old_wt_factor := 1.0 - alpha
    new_wt := if adjust { 1.0 } else { alpha }
    let mut mean_x = vals[0]
    let mut nobs = if vals[0] == null { 0 } else { 1 }
    let mut cov = 0.0
    let mut sum_wt = 1.0
    let mut sum_wt2 = 1.0
    let mut old_wt = 1.0
    out = push(out, if nobs >= 1 { if bias { 0.0 } else { null } } else { null })
    let mut i = 1
    while i < len(vals) {
        cur := vals[i]
        is_obs := cur != null
        if is_obs { nobs = nobs + 1 }
        if mean_x != null {
            if is_obs || !ignore_na {
                sum_wt = sum_wt * old_wt_factor
                sum_wt2 = sum_wt2 * old_wt_factor * old_wt_factor
                old_wt = old_wt * old_wt_factor
                if is_obs {
                    old_mean := mean_x
                    // avoid numerical errors on constant series
                    if mean_x != cur {
                        mean_x = (old_wt * old_mean + new_wt * cur) / (old_wt + new_wt)
                    }
                    cov = (old_wt * (cov + (old_mean - mean_x) * (old_mean - mean_x)) + new_wt * (cur - mean_x) * (cur - mean_x)) / (old_wt + new_wt)
                    sum_wt = sum_wt + new_wt
                    sum_wt2 = sum_wt2 + new_wt * new_wt
                    old_wt = old_wt + new_wt
                    if !adjust {
                        sum_wt = sum_wt / old_wt
                        sum_wt2 = sum_wt2 / (old_wt * old_wt)
                        old_wt = 1.0
                    }
                }
            }
        } else if is_obs {
            mean_x = cur
        }
        if nobs >= 1 {
            if bias {
                out = push(out, cov)
            } else {
                numerator := sum_wt * sum_wt
                denominator := numerator - sum_wt2
                if denominator > 0 {
                    out = push(out, (numerator / denominator) * cov)
                } else {
                    out = push(out, null)
                }
            }
        } else {
            out = push(out, null)
        }
        i = i + 1
    }
    out
}

// rank(t, column) — add "<column>_rank" with 1-based average ranks
// (ascending, nulls keep a null rank). Use rank_opts for other methods.
pub fn rank(t, column) {
    _rank_impl(t, column, null)
}

// rank_opts(t, column, opts) — rank with options.
//   opts.method:     "average" (default) | "min" | "max" | "dense" | "first"
//   opts.ascending:  true (default) ranks smallest first; false ranks largest first
//   opts.na_option:  "keep" (default, null rank) | "top" | "bottom"
//   opts.pct:        true → ranks / N (N = non-null count for "keep",
//                    total rows when nulls are ranked)
pub fn rank_opts(t, column, opts) {
    _rank_impl(t, column, opts)
}

fn _rank_impl(t, column, opts) {
    if !contains(t.columns, column) { return Err("dataframe.rank: unknown column " + column) }
    let mut method = "average"
    let mut ascending = true
    let mut na_option = "keep"
    let mut pct = false
    if opts != null {
        if _kind(opts) != "map" { return Err("dataframe.rank: opts must be a map") }
        if opts["method"] != null { method = opts["method"] }
        if opts["ascending"] != null { ascending = opts["ascending"] }
        if opts["na_option"] != null { na_option = opts["na_option"] }
        if opts["pct"] != null { pct = opts["pct"] }
    }
    if !contains(["average", "min", "max", "dense", "first"], method) {
        return Err("dataframe.rank: unknown method " + method)
    }
    if !contains(["keep", "top", "bottom"], na_option) {
        return Err("dataframe.rank: unknown na_option " + na_option)
    }
    n_total := len(t.rows)
    let mut pairs = []
    let mut null_idx = []
    let mut ranks = []
    let mut i = 0
    while i < n_total {
        v := t.rows[i][column]
        if v == null { null_idx = push(null_idx, i) }
        else { pairs = push(pairs, {"i": i, "v": v}) }
        ranks = push(ranks, null)
        i = i + 1
    }
    sorted := _rank_sort_pairs(pairs, !ascending)
    n_vals := len(pairs)
    denom := if na_option == "keep" { n_vals } else { n_total }
    let mut next_pos = 0
    let mut dense = 0
    // Null group ranked before all values.
    if na_option == "top" && len(null_idx) > 0 {
        dense = dense + 1
        g := len(null_idx)
        let mut k = 0
        while k < g {
            r := _rank_value(method, 0, g, k, dense)
            ranks[null_idx[k]] = if pct { r * 1.0 / denom } else { r }
            k = k + 1
        }
        next_pos = g
    }
    // Value tie groups in sorted (stable) order.
    i = 0
    while i < len(sorted) {
        let mut j = i
        while j < len(sorted) && sorted[j].v == sorted[i].v { j = j + 1 }
        dense = dense + 1
        g := j - i
        let mut k = 0
        while k < g {
            r := _rank_value(method, next_pos + i, g, k, dense)
            ranks[sorted[i + k].i] = if pct { r * 1.0 / denom } else { r }
            k = k + 1
        }
        i = j
    }
    // Null group ranked after all values.
    if na_option == "bottom" && len(null_idx) > 0 {
        dense = dense + 1
        g := len(null_idx)
        let mut k = 0
        while k < g {
            r := _rank_value(method, n_vals, g, k, dense)
            ranks[null_idx[k]] = if pct { r * 1.0 / denom } else { r }
            k = k + 1
        }
    }
    rank_col := column + "_rank"
    let mut new_cols = []
    for c in t.columns { new_cols = push(new_cols, c) }
    if !contains(t.columns, rank_col) { new_cols = push(new_cols, rank_col) }
    let mut new_rows = []
    i = 0
    while i < n_total {
        let mut nr = {}
        for c in t.columns { nr[c] = t.rows[i][c] }
        nr[rank_col] = ranks[i]
        new_rows = push(new_rows, nr)
        i = i + 1
    }
    _with_same_index(t, new_cols, new_rows)
}

pub fn cumsum_(t, column) {
    if !contains(t.columns, column) { return Err("dataframe.cumsum_: unknown column " + column) }
    let mut s = 0.0
    let mut new_rows = []
    for r in t.rows {
        let mut nr = {}
        for c in t.columns { nr[c] = r[c] }
        if r[column] != null {
            s = s + r[column]
            nr[column] = s
        } else {
            nr[column] = null
        }
        new_rows = push(new_rows, nr)
    }
    {"_df": true, "columns": t.columns, "rows": new_rows}
}

// ──────────────────────────────────────────────
// Sampling
// ──────────────────────────────────────────────

pub fn sample(t, n, seed) {
    let mut cnt = if n == null { 1 } else { n }
    if _kind(cnt) != "int" || cnt < 0 { return Err("dataframe.sample n must be a non-negative integer") }
    if cnt > len(t.rows) { return Err("dataframe.sample n cannot exceed the number of rows") }
    if seed != null { random.seed(seed) }
    // Fisher-Yates shuffle then take first n
    let mut indices = []
    let mut i = 0
    while i < len(t.rows) {
        indices = push(indices, i)
        i = i + 1
    }
    i = len(indices) - 1
    while i > 0 {
        j := random.int(0, i)
        tmp := indices[i]
        indices[i] = indices[j]
        indices[j] = tmp
        i = i - 1
    }
    let mut rows = []
    i = 0
    while i < cnt {
        rows = push(rows, t.rows[indices[i]])
        i = i + 1
    }
    _with_columns(t, rows)
}

pub fn shuffle(t) {
    sample(t, len(t.rows), null)
}

// ──────────────────────────────────────────────
// Output
// ──────────────────────────────────────────────

pub fn to_csv(t, sep) {
    delimiter := if sep == null { "," } else { sep }
    let mut header = []
    for c in t.columns { header = push(header, _csv_escape(c, delimiter)) }
    let mut lines = [str.join(header, delimiter)]
    for r in t.rows {
        let mut vals = []
        for c in t.columns {
            v := r[c]
            vals = push(vals, _csv_encode(v, delimiter))
        }
        lines = push(lines, str.join(vals, delimiter))
    }
    str.join(lines, "\n")
}

pub fn to_json(t) {
    json.stringify(t.rows)
}

pub fn to_jsonl(t) {
    let mut lines = []
    for r in t.rows { lines = push(lines, json.stringify(r)) }
    str.join(lines, "\n")
}

pub fn to_records(t) {
    t.rows
}

pub fn to_dict(t) {
    let mut result = {}
    for c in t.columns {
        result[c] = col(t, c)
    }
    result
}

pub fn write_csv(t, path, sep) -> Result[any] {
    fs.write(path, to_csv(t, sep))?
    Ok(path)
}

pub fn write_json(t, path) -> Result[any] {
    fs.write(path, to_json(t))?
    Ok(path)
}

pub fn write_jsonl(t, path) -> Result[any] {
    fs.write(path, to_jsonl(t))?
    Ok(path)
}

// ──────────────────────────────────────────────
// SQL bridge (via the stdlib db package; SQLite supported)
// ──────────────────────────────────────────────
//
// Type mapping (SQLite):
//   read_sql: INTEGER -> int, REAL -> float, TEXT -> str, NULL -> null,
//             BLOB -> str (raw bytes as string). The db stdlib also
//             auto-parses TEXT that looks like a JSON object/array into
//             maps/lists — a round trip does not preserve such strings.
//   to_sql:   int -> INTEGER, float -> REAL, str -> TEXT, bool -> BOOLEAN
//             (SQLite stores booleans as 1/0; they read back as int),
//             null -> NULL. Columns mixing unrelated types are rejected.

// read_sql(source, query) — run a SELECT and return the result as a
// DataFrame. source is a db connection handle (db.open(...) value) or a
// conninfo string such as "sqlite:data.db". A conninfo string is opened
// with max_open=1 (so ":memory:" works) and closed before returning.
// Column order follows the query's SELECT list. An empty result set
// yields an empty DataFrame with no columns (rows carry the schema).
pub fn read_sql(source, query) -> Result[any] {
    if _kind(query) != "str" || query == "" {
        return Err("dataframe.read_sql expects a non-empty SQL query string")
    }
    a := _sql_acquire(source)
    if _kind(a) == "result" { return a }
    conn := a.conn
    r := conn.query(query)
    if a.owned { conn.close() }
    if !r.ok { return Err("dataframe.read_sql: " + r.error) }
    Ok(from_rows(r.value))
}

// to_sql(t, source, table, opts) — write a DataFrame to a SQL table.
//   source: db connection handle or conninfo string (see read_sql).
//   table:  table name; it is always double-quoted as a SQL identifier
//           (embedded quotes are doubled), never interpolated raw.
//   opts.if_exists: "fail" (default) | "replace" | "append".
// The write runs in a single transaction; any failure rolls back.
// Returns Ok({"table": table, "rows_written": n}).
pub fn to_sql(t, source, table, opts) -> Result[any] {
    if _kind(t) != "map" || t["_df"] != true {
        return Err("dataframe.to_sql expects a DataFrame")
    }
    if _kind(table) != "str" || table == "" {
        return Err("dataframe.to_sql: table must be a non-empty string")
    }
    let mut if_exists = "fail"
    if opts != null {
        if _kind(opts) != "map" { return Err("dataframe.to_sql: opts must be a map") }
        if opts["if_exists"] != null { if_exists = opts["if_exists"] }
    }
    if !contains(["fail", "replace", "append"], if_exists) {
        return Err("dataframe.to_sql: if_exists must be \"fail\", \"replace\", or \"append\"")
    }
    a := _sql_acquire(source)
    if _kind(a) == "result" { return a }
    conn := a.conn
    r := _to_sql_write(t, conn, table, if_exists)
    if a.owned { conn.close() }
    r
}


pub fn print_(t, n) {
    let mut cnt = if n == null { len(t.rows) } else { n }
    if cnt > len(t.rows) { cnt = len(t.rows) }
    // Calculate column widths
    let mut widths = {}
    for c in t.columns { widths[c] = len(c) }
    let mut i = 0
    while i < cnt {
        for c in t.columns {
            w := len("" + t.rows[i][c])
            if w > widths[c] { widths[c] = w }
        }
        i = i + 1
    }
    // Header
    let mut header = []
    let mut sep_parts = []
    for c in t.columns {
        header = push(header, str.pad_right(c, widths[c]))
        sep_parts = push(sep_parts, str.repeat("-", widths[c]))
    }
    say(str.join(header, "  "))
    say(str.join(sep_parts, "  "))
    // Rows
    i = 0
    while i < cnt {
        let mut vals = []
        for c in t.columns {
            vals = push(vals, str.pad_right("" + t.rows[i][c], widths[c]))
        }
        say(str.join(vals, "  "))
        i = i + 1
    }
    if cnt < len(t.rows) {
        say("... " + str(len(t.rows) - cnt) + " more rows")
    }
    say("[" + str(len(t.rows)) + " rows x " + str(len(t.columns)) + " columns]")
}

// ──────────────────────────────────────────────
// Internals
// ──────────────────────────────────────────────

fn _agg(op, vals) {
    clean := _non_null(vals)
    if op == "count" { return len(clean) }
    if len(clean) == 0 {
        if op == "sum" { return 0 }
        return null
    }
    if (op == "sum" || op == "mean" || op == "std" || op == "var") && !_all_numeric(clean) {
        return null
    }
    match op {
        "sum" { reduce(clean, 0, fn(a, x) { a + x }) }
        "mean" {
            s := reduce(clean, 0.0, fn(a, x) { a + x })
            s / len(clean)
        }
        "min" { reduce(clean, clean[0], fn(a, x) { if x < a { x } else { a } }) }
        "max" { reduce(clean, clean[0], fn(a, x) { if x > a { x } else { a } }) }
        "first" { clean[0] }
        "last" { clean[len(clean) - 1] }
        "var" {
            n := len(clean)
            if n < 2 { return null }
            m := reduce(clean, 0.0, fn(a, x) { a + x }) / n
            let mut s = 0.0
            for x in clean { s = s + (x - m) * (x - m) }
            s / (n - 1)
        }
        "std" {
            n := len(clean)
            if n < 2 { return null }
            m := reduce(clean, 0.0, fn(a, x) { a + x }) / n
            let mut s = 0.0
            for x in clean { s = s + (x - m) * (x - m) }
            math.sqrt(s / (n - 1))
        }
        _ { null }
    }
}

fn _col_vals(rows, col_name) {
    let mut vals = []
    for r in rows { vals = push(vals, r[col_name]) }
    vals
}

fn _numeric_col(t, col_name) {
    let mut vals = []
    for r in t.rows {
        v := r[col_name]
        if _kind(v) == "int" || _kind(v) == "float" { vals = push(vals, v + 0.0) }
    }
    vals
}

fn _sum_list(vals) {
    let mut s = 0.0
    for x in vals { s = s + x }
    s
}

fn _is_series(v) {
    v != null && _kind(v) == "map" && v._series == true && _kind(v.values) == "list" && _kind(v.index) == "list"
}

fn _range(n) {
    let mut result = []
    let mut i = 0
    while i < n { result = push(result, i) i = i + 1 }
    result
}

fn _series_dtype(values) {
    if len(values) == 0 { return "object" }
    let mut found = "null"
    for value in values {
        kind := _kind(value)
        if kind == "null" { continue }
        if found == "null" { found = kind }
        else if found != kind {
            if (found == "int" && kind == "float") || (found == "float" && kind == "int") { found = "float" }
            else { found = "mixed" }
        }
    }
    if found == "null" { "object" } else { found }
}

fn _series_lookup(s, label) {
    let mut i = 0
    while i < len(s.index) {
        if _value_key(s.index[i]) == _value_key(label) {
            return {"found": true, "value": s.values[i]}
        }
        i = i + 1
    }
    {"found": false, "value": null}
}

fn _series_union_index(left, right) {
    let mut result = []
    let mut seen = {}
    for label in left.index {
        key := _value_key(label)
        if seen[key] == null { seen[key] = true result = push(result, label) }
    }
    for label in right.index {
        key := _value_key(label)
        if seen[key] == null { seen[key] = true result = push(result, label) }
    }
    result
}

fn _series_binary(left, right, fill_value, op) {
    if !_is_series(left) || !_is_series(right) { return Err("dataframe series arithmetic expects two Series") }
    labels := _series_union_index(left, right)
    let mut values = []
    for label in labels {
        lv := _series_lookup(left, label)
        rv := _series_lookup(right, label)
        if lv.found && rv.found {
            values = push(values, op(lv.value, rv.value))
        } else if fill_value != null {
            values = push(values, op(if lv.found { lv.value } else { fill_value }, if rv.found { rv.value } else { fill_value }))
        } else {
            values = push(values, null)
        }
    }
    series(values, left.name, labels)
}

fn _with_columns(t, rows) {
    _with_named_columns(t, t.columns, rows)
}

fn _with_named_columns(t, columns, rows) {
    let mut result = {"_df": true, "columns": columns, "rows": rows}
    if contains(keys(t), "_index") && t._index != null {
        result["_index"] = _index_for_rows(t, rows)
        result = _copy_index_meta(result, t)
    }
    result
}

fn _with_same_index(t, columns, rows) {
    let mut result = {"_df": true, "columns": columns, "rows": rows}
    if contains(keys(t), "_index") && t._index != null {
        result["_index"] = t._index
        result = _copy_index_meta(result, t)
    }
    result
}

// Build a frame carrying index labels plus single/multi-level metadata from src.
fn _frame_with_index(columns, rows, labels, src) {
    let mut result = {"_df": true, "columns": columns, "rows": rows, "_index": labels}
    _copy_index_meta(result, src)
}

fn _copy_index_meta(result, src) {
    let mut out = result
    if contains(keys(src), "_index_name") && src._index_name != null {
        out["_index_name"] = src._index_name
    }
    if contains(keys(src), "_index_levels") && src._index_levels != null {
        out["_index_levels"] = src._index_levels
    }
    out
}

// Exact label equality for reindex (full multi-key when multi-level).
fn _index_label_exact(idx_label, query_label, nlevels) {
    if nlevels <= 1 {
        return _value_key(idx_label) == _value_key(query_label)
    }
    if _kind(idx_label) != "list" || _kind(query_label) != "list" { return false }
    if len(idx_label) != nlevels || len(query_label) != nlevels { return false }
    let mut i = 0
    while i < nlevels {
        if _value_key(idx_label[i]) != _value_key(query_label[i]) { return false }
        i = i + 1
    }
    true
}

// loc_labels match: full key, partial prefix list, or scalar first-level match.
fn _index_label_matches(idx_label, query_label, nlevels) {
    if nlevels <= 1 {
        return _value_key(idx_label) == _value_key(query_label)
    }
    if _kind(idx_label) != "list" { return false }
    if _kind(query_label) != "list" {
        // Scalar → match first level only.
        return _value_key(idx_label[0]) == _value_key(query_label)
    }
    if len(query_label) == 0 || len(query_label) > nlevels { return false }
    if len(idx_label) < len(query_label) { return false }
    let mut i = 0
    while i < len(query_label) {
        if _value_key(idx_label[i]) != _value_key(query_label[i]) { return false }
        i = i + 1
    }
    true
}

fn _index_for_rows(t, rows) {
    let mut used = []
    let mut i = 0
    while i < len(t.rows) {
        used = push(used, false)
        i = i + 1
    }
    let mut result = []
    for row in rows {
        let mut found = false
        let mut j = 0
        while j < len(t.rows) {
            if !used[j] && json.stringify(t.rows[j]) == json.stringify(row) {
                result = push(result, index(t)[j])
                used[j] = true
                found = true
                break
            }
            j = j + 1
        }
        if !found { result = push(result, null) }
    }
    result
}

fn _has_columns(t, cols) {
    for c in cols {
        if !contains(t.columns, c) { return false }
    }
    true
}

fn _kind(v) {
    type_of(v)
}

fn _value_key(v) {
    _kind(v) + ":" + json.stringify(v)
}

// Composite group/join key encoding: a JSON array of the per-column
// _value_key strings ("<kind>:<json>"). Each component is a JSON string, so
// embedded separators, quotes, or type-punning values (1 vs "1", null vs
// "null") can never make two distinct key tuples encode to the same key.
fn _composite_key(row, cols) {
    let mut parts = []
    for c in cols { parts = push(parts, _value_key(row[c])) }
    json.stringify(parts)
}

fn _list_index(list, value) {
    let mut i = 0
    while i < len(list) {
        if list[i] == value { return i }
        i = i + 1
    }
    -1
}

// Rank of one member of a tie group: pos = 0-based position of the group's
// first member, g = group size, k = member's stable offset within the group,
// dense_rank = 1-based count of distinct groups seen so far.
fn _rank_value(method, pos, g, k, dense_rank) {
    if method == "min" { return pos + 1 }
    if method == "max" { return pos + g }
    if method == "dense" { return dense_rank }
    if method == "first" { return pos + 1 + k }
    (pos + 1 + pos + g) / 2.0
}

// Stable merge sort of {"i", "v"} pairs by v (ties keep original row order,
// which is what method "first" relies on). Nulls must be filtered out first.
fn _rank_sort_pairs(pairs, desc) {
    if len(pairs) <= 1 {
        let mut copy = []
        for p in pairs { copy = push(copy, p) }
        return copy
    }
    mid := len(pairs) / 2
    left := _rank_sort_pairs(_value_range(pairs, 0, mid), desc)
    right := _rank_sort_pairs(_value_range(pairs, mid, len(pairs)), desc)
    _rank_merge_pairs(left, right, desc)
}

fn _rank_merge_pairs(left, right, desc) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _comes_after(left[li].v, right[ri].v, desc) {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _row_key(row, cols) {
    let mut values = []
    for c in cols { values = push(values, row[c]) }
    json.stringify(values)
}

fn _non_null(vals) {
    let mut result = []
    for v in vals { if v != null { result = push(result, v) } }
    result
}

fn _all_numeric(vals) {
    for v in vals {
        if _kind(v) != "int" && _kind(v) != "float" { return false }
    }
    true
}

fn _valid_agg(op) {
    contains(["sum", "mean", "count", "min", "max", "first", "last", "std", "var"], op)
}

fn _numeric_pairs(t, col_a, col_b) {
    let mut va = []
    let mut vb = []
    for r in t.rows {
        a := r[col_a]
        b := r[col_b]
        if (_kind(a) == "int" || _kind(a) == "float") && (_kind(b) == "int" || _kind(b) == "float") {
            va = push(va, a + 0.0)
            vb = push(vb, b + 0.0)
        }
    }
    {"a": va, "b": vb}
}

fn _comes_after(a, b, desc) {
    // Nulls sort last in both ascending and descending order.
    if a == null { return b != null }
    if b == null { return false }
    if desc { a < b } else { a > b }
}

fn _comes_before(a, b, desc) {
    if a == null { return false }
    if b == null { return true }
    if desc { a > b } else { a < b }
}

fn _copy_rows(rows) {
    let mut result = []
    for row in rows { result = push(result, row) }
    result
}

// Stable ascending merge-sort for scalar lists (used by describe/rank).
// Avoids the host `sort` builtin so `weft check` resolves module code without
// relying on shared-prelude visibility in the type checker.
fn _sort_values(values) {
    if values == null || len(values) <= 1 {
        let mut copy = []
        if values != null {
            for v in values { copy = push(copy, v) }
        }
        return copy
    }
    mid := len(values) / 2
    left := _sort_values(_value_range(values, 0, mid))
    right := _sort_values(_value_range(values, mid, len(values)))
    _merge_values(left, right)
}

fn _value_range(values, start, stop) {
    let mut result = []
    let mut i = start
    while i < stop {
        result = push(result, values[i])
        i = i + 1
    }
    result
}

fn _merge_values(left, right) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _comes_after(left[li], right[ri], false) {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _merge_sort_rows(rows, column, desc) {
    if len(rows) <= 1 { return _copy_rows(rows) }
    mid := len(rows) / 2
    left := _merge_sort_rows(_row_range(rows, 0, mid), column, desc)
    right := _merge_sort_rows(_row_range(rows, mid, len(rows)), column, desc)
    _merge_rows(left, right, column, desc)
}

fn _merge_rows(left, right, column, desc) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _comes_after(left[li][column], right[ri][column], desc) {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) { result = push(result, left[li]) li = li + 1 }
    while ri < len(right) { result = push(result, right[ri]) ri = ri + 1 }
    result
}

fn _merge_sort_rows_multi(rows, columns_list, desc_list) {
    if len(rows) <= 1 { return _copy_rows(rows) }
    mid := len(rows) / 2
    left := _merge_sort_rows_multi(_row_range(rows, 0, mid), columns_list, desc_list)
    right := _merge_sort_rows_multi(_row_range(rows, mid, len(rows)), columns_list, desc_list)
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if _row_comes_after(left[li], right[ri], columns_list, desc_list) {
            result = push(result, right[ri])
            ri = ri + 1
        } else {
            result = push(result, left[li])
            li = li + 1
        }
    }
    while li < len(left) { result = push(result, left[li]) li = li + 1 }
    while ri < len(right) { result = push(result, right[ri]) ri = ri + 1 }
    result
}

fn _row_comes_after(a, b, columns_list, desc_list) {
    let mut i = 0
    while i < len(columns_list) {
        col_name := columns_list[i]
        descending := if i < len(desc_list) { desc_list[i] } else { false }
        av := a[col_name]
        bv := b[col_name]
        if av != bv { return _comes_after(av, bv, descending) }
        i = i + 1
    }
    false
}

fn _row_range(rows, start, stop) {
    let mut result = []
    let mut i = start
    while i < stop { result = push(result, rows[i]) i = i + 1 }
    result
}

fn _right_column_names(left, right, key_col) {
    let mut used = {}
    for c in left.columns { used[c] = true }
    let mut result = {}
    for c in right.columns {
        if c == key_col {
            result[c] = c
            continue
        }
        let mut name = c
        if used[name] != null {
            name = c + "_right"
            let mut suffix = 2
            while used[name] != null {
                name = c + "_right" + str(suffix)
                suffix = suffix + 1
            }
        }
        used[name] = true
        result[c] = name
    }
    result
}

fn _percentile(sorted, p) {
    n := len(sorted)
    k := (p / 100.0) * (n - 1)
    lo := math.floor(k)
    hi := math.ceil(k)
    if lo == hi { sorted[lo] }
    else { sorted[lo] * (hi - k) + sorted[hi] * (k - lo) }
}

fn _parse_value(s) {
    if s == "" { return null }
    if s == "null" || s == "NULL" || s == "None" { return null }
    if s == "true" || s == "TRUE" { return true }
    if s == "false" || s == "FALSE" { return false }
    if len(s) == 0 { return s }
    // check if starts with digit or minus-digit
    first := str.slice(s, 0, 1)
    let mut might_be_num = false
    if first >= "0" && first <= "9" { might_be_num = true }
    if first == "-" && len(s) > 1 {
        second := str.slice(s, 1, 2)
        if second >= "0" && second <= "9" { might_be_num = true }
    }
    if !might_be_num { return s }
    // try parsing as number
    r := json.parse(s)
    if r.ok { r.value } else { s }
}

fn _csv_records(text, delimiter) -> Result[any] {
    if text == "" { return Ok([]) }
    let mut records = []
    let mut row = []
    let mut field = ""
    let mut quoted = false
    let mut after_quote = false
    let mut field_quoted = false
    let mut i = 0
    while i < len(text) {
        ch := str.slice(text, i, i + 1)
        if quoted {
            if ch == "\"" {
                if i + 1 < len(text) && str.slice(text, i + 1, i + 2) == "\"" {
                    field = field + "\""
                    i = i + 2
                    continue
                }
                quoted = false
                after_quote = true
            } else {
                field = field + ch
            }
            i = i + 1
            continue
        }
        if after_quote {
            if ch == delimiter {
                row = push(row, {"text": field, "quoted": true})
                field = ""
                field_quoted = false
                after_quote = false
            } else if ch == "\n" || ch == "\r" {
                row = push(row, {"text": field, "quoted": true})
                records = push(records, row)
                row = []
                field = ""
                field_quoted = false
                after_quote = false
                if ch == "\r" && i + 1 < len(text) && str.slice(text, i + 1, i + 2) == "\n" { i = i + 1 }
            } else if ch != " " && ch != "\t" {
                return Err("dataframe.from_csv has characters after a quoted field")
            }
            i = i + 1
            continue
        }
        if ch == "\"" {
            if str.trim(field) != "" { return Err("dataframe.from_csv quote must start a field") }
            field = ""
            field_quoted = true
            quoted = true
        } else if ch == delimiter {
            row = push(row, {"text": field, "quoted": field_quoted})
            field = ""
            field_quoted = false
        } else if ch == "\n" || ch == "\r" {
            row = push(row, {"text": field, "quoted": field_quoted})
            records = push(records, row)
            row = []
            field = ""
            field_quoted = false
            if ch == "\r" && i + 1 < len(text) && str.slice(text, i + 1, i + 2) == "\n" { i = i + 1 }
        } else {
            field = field + ch
        }
        i = i + 1
    }
    if quoted { return Err("dataframe.from_csv has an unterminated quoted field") }
    row = push(row, {"text": field, "quoted": field_quoted})
    records = push(records, row)
    Ok(records)
}

fn _csv_value(cell) {
    if cell.quoted { cell.text } else { _parse_value(str.trim(cell.text)) }
}

// ── CSV dtype/null policy helpers (from_csv_opts / read_csv_opts) ──

// Validates opts against the parsed header. Returns null when valid.
fn _csv_policy_check(opts, cols) {
    if opts == null { return null }
    if _kind(opts) != "map" { return Err("dataframe.from_csv: opts must be a map") }
    dt := opts["dtypes"]
    if dt != null {
        if _kind(dt) != "map" { return Err("dataframe.from_csv: opts.dtypes must be a map of column to type") }
        for name in keys(dt) {
            if !contains(cols, name) {
                return Err("dataframe.from_csv: opts.dtypes refers to unknown column '" + name + "'")
            }
            if !contains(["int", "float", "str", "bool"], dt[name]) {
                return Err("dataframe.from_csv: opts.dtypes['" + name + "'] must be int, float, str, or bool")
            }
        }
    }
    nv := opts["null_values"]
    if nv != null {
        if _kind(nv) != "list" { return Err("dataframe.from_csv: opts.null_values must be a list of strings") }
        for s in nv {
            if _kind(s) != "str" { return Err("dataframe.from_csv: opts.null_values must be a list of strings") }
        }
    }
    kd := opts["keep_default_null_values"]
    if kd != null && _kind(kd) != "bool" {
        return Err("dataframe.from_csv: opts.keep_default_null_values must be a bool")
    }
    null
}

fn _csv_keep_default_nulls(opts) {
    opts["keep_default_null_values"] != false
}

fn _csv_is_null_sentinel(text, opts) {
    nv := opts["null_values"]
    if nv != null && contains(nv, text) { return true }
    if _csv_keep_default_nulls(opts) {
        return text == "" || text == "null" || text == "NULL" || text == "None"
    }
    false
}

// Per-cell value with policy. Returns the value, or Err on a strict dtype
// violation. With opts == null this is exactly the legacy _csv_value path.
fn _csv_value_policy(cell, col, rownum, opts) {
    if opts == null {
        if cell.quoted { return cell.text }
        return _parse_value(str.trim(cell.text))
    }
    text := if cell.quoted { cell.text } else { str.trim(cell.text) }
    // Quoted cells are explicit strings: null sentinels never apply.
    if !cell.quoted && _csv_is_null_sentinel(text, opts) { return null }
    let mut dtype = null
    dt := opts["dtypes"]
    if dt != null { dtype = dt[col] }
    if dtype != null { return _parse_typed(text, dtype, col, rownum) }
    if cell.quoted { return text }
    if _csv_keep_default_nulls(opts) { return _parse_value(text) }
    _parse_value_no_null(text)
}

// _parse_value without the default null sentinels (for
// keep_default_null_values=false): booleans and numbers still infer.
fn _parse_value_no_null(s) {
    if s == "true" || s == "TRUE" { return true }
    if s == "false" || s == "FALSE" { return false }
    if len(s) == 0 { return s }
    first := str.slice(s, 0, 1)
    let mut might_be_num = false
    if first >= "0" && first <= "9" { might_be_num = true }
    if first == "-" && len(s) > 1 {
        second := str.slice(s, 1, 2)
        if second >= "0" && second <= "9" { might_be_num = true }
    }
    if !might_be_num { return s }
    r := json.parse(s)
    if r.ok { r.value } else { s }
}

// Strictly parse text as dtype ("int" | "float" | "str" | "bool").
fn _parse_typed(text, dtype, col, rownum) {
    where := "dataframe.from_csv row " + rownum + " column '" + col + "': "
    if dtype == "str" { return text }
    if dtype == "bool" {
        if text == "true" || text == "TRUE" { return true }
        if text == "false" || text == "FALSE" { return false }
        return Err(where + "cannot parse '" + text + "' as bool")
    }
    r := json.parse(text)
    if !r.ok { return Err(where + "cannot parse '" + text + "' as " + dtype) }
    v := r.value
    k := _kind(v)
    if dtype == "int" {
        if k == "int" { return v }
        return Err(where + "cannot parse '" + text + "' as int")
    }
    if dtype == "float" {
        if k == "float" { return v }
        if k == "int" { return v * 1.0 }
        return Err(where + "cannot parse '" + text + "' as float")
    }
    Err("dataframe.from_csv: unknown dtype '" + dtype + "'")
}

// ── SQL bridge helpers ──

// _sql_acquire(source) -> {"conn": ..., "owned": bool} or Err.
// A conninfo string is opened with max_open=1 so that SQLite ":memory:"
// databases stay on a single connection (each new pooled connection would
// otherwise see a fresh empty database).
fn _sql_acquire(source) {
    if _kind(source) == "str" {
        r := db.open(source, {"max_open": 1})
        if !r.ok { return Err("dataframe: cannot connect: " + r.error) }
        return {"conn": r.value, "owned": true}
    }
    if _kind(source) != "map" || source["query"] == null {
        return Err("dataframe: expected a db connection handle or conninfo string")
    }
    {"conn": source, "owned": false}
}

// Quote a SQL identifier: standard double quotes, embedded quotes doubled.
fn _sql_ident(name) {
    "\"" + str.replace(name, "\"", "\"\"") + "\""
}

fn _sql_table_exists(conn, name) {
    r := conn.query_one("SELECT name FROM sqlite_master WHERE type='table' AND name=?", [name])
    if !r.ok { return Err("dataframe.to_sql: cannot inspect schema: " + r.error) }
    r.value != null
}

// Map one column's values to a SQLite column type; mixed unrelated types
// and non-scalar values are explicit errors.
fn _sql_column_type(t, c) {
    let mut found = "null"
    for row in t.rows {
        v := row[c]
        if v == null { continue }
        k := _kind(v)
        if k != "int" && k != "float" && k != "str" && k != "bool" {
            return Err("dataframe.to_sql: column '" + c + "' has unsupported type '" + k + "' (only int, float, str, bool, null)")
        }
        if found == "null" { found = k }
        else if found != k {
            if (found == "int" && k == "float") || (found == "float" && k == "int") {
                found = "float"
            } else {
                return Err("dataframe.to_sql: column '" + c + "' has mixed types ('" + found + "' and '" + k + "')")
            }
        }
    }
    if found == "int" { return "INTEGER" }
    if found == "float" { return "REAL" }
    if found == "bool" { return "BOOLEAN" }
    "TEXT"
}

fn _to_sql_write(t, conn, table, if_exists) -> Result[any] {
    qname := _sql_ident(table)
    let mut col_types = {}
    for c in t.columns {
        ct := _sql_column_type(t, c)
        if _kind(ct) == "result" { return ct }
        col_types[c] = ct
    }
    exists := _sql_table_exists(conn, table)
    if _kind(exists) == "result" { return exists }
    if if_exists == "fail" && exists {
        return Err("dataframe.to_sql: table '" + table + "' already exists (if_exists=fail)")
    }
    if if_exists == "append" && !exists {
        return Err("dataframe.to_sql: table '" + table + "' does not exist (if_exists=append)")
    }
    b := conn.begin()
    if !b.ok { return Err("dataframe.to_sql: cannot begin transaction: " + b.error) }
    tx := b.value
    if if_exists == "replace" && exists {
        d := tx.exec("DROP TABLE " + qname)
        if !d.ok {
            tx.rollback()
            return Err("dataframe.to_sql: " + d.error)
        }
    }
    if if_exists != "append" {
        let mut defs = []
        for c in t.columns {
            defs = push(defs, _sql_ident(c) + " " + col_types[c])
        }
        cr := tx.exec("CREATE TABLE " + qname + " (" + str.join(defs, ", ") + ")")
        if !cr.ok {
            tx.rollback()
            return Err("dataframe.to_sql: " + cr.error)
        }
    }
    if len(t.rows) > 0 {
        let mut col_idents = []
        let mut marks = []
        for c in t.columns {
            col_idents = push(col_idents, _sql_ident(c))
            marks = push(marks, "?")
        }
        insert_sql := "INSERT INTO " + qname + " (" + str.join(col_idents, ", ") + ") VALUES (" + str.join(marks, ", ") + ")"
        for row in t.rows {
            let mut params = []
            for c in t.columns { params = push(params, row[c]) }
            ir := tx.exec(insert_sql, params)
            if !ir.ok {
                tx.rollback()
                return Err("dataframe.to_sql: insert failed: " + ir.error)
            }
        }
    }
    cm := tx.commit()
    if !cm.ok { return Err("dataframe.to_sql: commit failed: " + cm.error) }
    Ok({"table": table, "rows_written": len(t.rows)})
}

fn _csv_encode(v, delimiter) {
    if v == null { "" }
    else if _kind(v) == "str" { _csv_escape(v, delimiter) }
    else { _csv_escape("" + v, delimiter) }
}

fn _csv_escape(s, delimiter) {
    if s == "" || str.contains(s, delimiter) || str.contains(s, "\"") || str.contains(s, "\n") || str.contains(s, "\r") {
        "\"" + str.replace(s, "\"", "\"\"") + "\""
    } else { s }
}
