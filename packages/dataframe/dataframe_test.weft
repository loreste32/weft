use "./lib.weft" as df
use warp

fn _sample_df {
    df.from_rows([
        {"name": "Alice", "age": 30, "dept": "eng", "salary": 90000},
        {"name": "Bob", "age": 25, "dept": "eng", "salary": 75000},
        {"name": "Carol", "age": 35, "dept": "sales", "salary": 85000},
        {"name": "Dan", "age": 28, "dept": "sales", "salary": 70000},
        {"name": "Eve", "age": 32, "dept": "eng", "salary": 95000},
    ])
}

fn _columns(data) {
    result := df.from_columns(data)
    test.is_true(result.ok)
    result.value
}

fn _csv(text, sep) {
    result := df.from_csv(text, sep)
    test.is_true(result.ok)
    result.value
}

// === Creation ===

fn test_from_rows {
    t := _sample_df()
    test.eq(df.nrows(t), 5)
    test.eq(df.ncols(t), 4)
}

fn test_from_rows_normalizes_missing_columns {
    t := df.from_rows([{"a": 1}, {"b": 2}])
    test.eq(df.columns(t), ["a", "b"])
    test.eq(df.col(t, "a"), [1, null])
    test.eq(df.col(t, "b"), [null, 2])
}

fn test_from_columns {
    t := _columns({"x": [1, 2, 3], "y": [4, 5, 6]})
    test.eq(df.nrows(t), 3)
    test.eq(df.col(t, "x"), [1, 2, 3])
}

fn test_from_csv {
    csv_text := "name,age,score\nAlice,30,95\nBob,25,87\n"
    t := _csv(csv_text, null)
    test.eq(df.nrows(t), 2)
    test.eq(df.columns(t), ["name", "age", "score"])
    test.eq(df.col(t, "name"), ["Alice", "Bob"])
    // auto-parses numbers
    test.eq(df.col(t, "age"), [30, 25])
}

fn test_from_csv_with_nulls {
    csv_text := "a,b\n1,null\n,3\n"
    t := _csv(csv_text, null)
    test.eq(df.nrows(t), 2)
    r := df.rows(t)
    test.eq(r[0].b, null)
    test.eq(r[1].a, null)
}

fn test_empty {
    t := df.empty(["a", "b"])
    test.eq(df.nrows(t), 0)
    test.eq(df.columns(t), ["a", "b"])
}

// === Shape / info ===

fn test_shape {
    t := _sample_df()
    test.eq(df.shape(t), [5, 4])
}

fn test_info {
    t := _sample_df()
    i := df.info(t)
    test.eq(i.rows, 5)
    test.eq(i.columns, 4)
}

// === Selection ===

fn test_col {
    t := _sample_df()
    names := df.col(t, "name")
    test.eq(len(names), 5)
    test.eq(names[0], "Alice")
}

fn test_warp_interchange_round_trip {
    t := _sample_df()
    packed := df.to_warp(t, ["age", "salary"], "float64")
    test.is_true(packed.ok)
    test.eq(warp.shape(packed.value), [5, 2])
    test.eq(warp.to_list(warp.row(packed.value, 0)), [30.0, 90000.0])
    restored := df.from_warp(packed.value, ["age", "salary"])
    test.is_true(restored.ok)
    test.eq(df.col(restored.value, "age"), [30.0, 25.0, 35.0, 28.0, 32.0])
    test.eq(df.col(restored.value, "salary"), [90000.0, 75000.0, 85000.0, 70000.0, 95000.0])
    one := df.from_warp(warp.array([4, 5], [2]), null)
    test.is_true(one.ok)
    test.eq(df.columns(one.value), ["column_0"])
    test.eq(df.col(one.value, "column_0"), [4, 5])
}

fn test_warp_interchange_rejects_invalid_values {
    t := _sample_df()
    bad_column := df.to_warp(t, ["name"], null)
    test.is_false(bad_column.ok)
    with_null := df.from_rows([{"x": 1}, {"x": null}])
    bad_null := df.to_warp(with_null, ["x"], null)
    test.is_false(bad_null.ok)
    bad_names := df.from_warp(warp.array([1, 2, 3], [3]), ["a", "b"])
    test.is_false(bad_names.ok)
}

fn test_series_contract {
    t := _sample_df()
    s := df.series_from(t, "age")
    test.eq(df.series_name(s), "age")
    test.eq(df.series_values(s), [30, 25, 35, 28, 32])
    test.eq(df.series_index(s), [0, 1, 2, 3, 4])
    test.eq(df.series_shape(s), [5])
    test.eq(df.series_dtype(s), "int")
    doubled := df.series_map(s, fn(v) { v * 2 })
    test.eq(df.series_values(doubled), [60, 50, 70, 56, 64])
}

fn test_series_null_and_counts {
    s := df.series([1, null, 1, 2], "x", ["a", "b", "c", "d"])
    filled := df.series_fillna(s, 0)
    test.eq(df.series_values(filled), [1, 0, 1, 2])
    dropped := df.series_dropna(s)
    test.eq(df.series_values(dropped), [1, 1, 2])
    test.eq(df.series_index(dropped), ["a", "c", "d"])
    test.eq(df.series_unique(s), [1, null, 2])
    counts := df.series_value_counts(s)
    test.eq(counts["int:1"], 2)
    test.eq(counts["null:null"], 1)
}

fn test_series_alignment_and_reindex {
    left := df.series([10, 20], "value", ["a", "b"])
    right := df.series([1, 3], "other", ["b", "c"])
    added := df.series_add(left, right, null)
    test.eq(df.series_index(added), ["a", "b", "c"])
    test.eq(df.series_values(added), [null, 21, null])
    filled := df.series_add(left, right, 0)
    test.eq(df.series_values(filled), [10, 21, 3])
    reordered := df.series_reindex(left, ["b", "x", "a"], -1)
    test.eq(df.series_values(reordered), [20, -1, 10])
}

fn test_set_and_reset_index {
    t := _sample_df()
    invalid_drop := df.set_index(t, "name", 1)
    test.is_false(invalid_drop.ok)
    indexed := df.set_index(t, "name", null)
    test.eq(df.index(indexed), ["Alice", "Bob", "Carol", "Dan", "Eve"])
    test.is_false(contains(df.columns(indexed), "name"))
    restored := df.reset_index(indexed, null)
    test.eq(df.columns(restored)[0], "index")
    test.eq(df.col(restored, "index")[0], "Alice")
    test.eq(df.col(restored, "dept")[2], "sales")
}

fn test_label_selection_and_reindex {
    t := df.set_index(_sample_df(), "name", null)
    selected := df.loc_labels(t, ["Eve", "Alice"])
    test.eq(df.index(selected), ["Eve", "Alice"])
    test.eq(df.col(selected, "age"), [32, 30])
    filled := df.reindex(t, ["Bob", "Missing"], null)
    test.eq(df.index(filled), ["Bob", "Missing"])
    test.eq(df.col(filled, "age"), [25, null])
}

fn test_index_preserved_by_row_transformations {
    indexed := df.set_index(_sample_df(), "name", null)
    filtered := df.query(indexed, "age", ">", 28)
    test.eq(df.index(filtered), ["Alice", "Carol", "Eve"])
    sorted := df.sort_by(filtered, "age", true)
    test.eq(df.index(sorted), ["Carol", "Eve", "Alice"])
    test.eq(df.index(df.head(sorted, 2)), ["Carol", "Eve"])
    test.eq(df.index(df.tail(sorted, 1)), ["Alice"])
    test.eq(df.index(df.loc(sorted, 1, 3)), ["Eve", "Alice"])
    test.eq(df.index(df.select_(sorted, ["age"])), ["Carol", "Eve", "Alice"])
    test.eq(df.index(df.rename(sorted, {"age": "years"})), ["Carol", "Eve", "Alice"])
    added := df.add_column(sorted, "adult", fn(r) { r.age >= 18 })
    test.eq(df.index(added), ["Carol", "Eve", "Alice"])
}

fn test_multi_index_create_and_levels {
    t := _sample_df()
    test.eq(df.index_nlevels(t), 1)
    test.eq(df.index_levels(t), [null])
    bad := df.set_multi_index(t, [], null)
    test.is_false(bad.ok)
    unknown := df.set_multi_index(t, ["dept", "missing"], null)
    test.is_false(unknown.ok)
    single := df.set_multi_index(t, ["name"], null)
    test.eq(df.index_nlevels(single), 1)
    test.eq(df.index(single), ["Alice", "Bob", "Carol", "Dan", "Eve"])
    multi := df.set_multi_index(t, ["dept", "name"], null)
    test.eq(df.index_nlevels(multi), 2)
    test.eq(df.index_levels(multi), ["dept", "name"])
    test.is_false(contains(df.columns(multi), "dept"))
    test.is_false(contains(df.columns(multi), "name"))
    test.eq(df.index(multi)[0], ["eng", "Alice"])
    test.eq(df.index(multi)[2], ["sales", "Carol"])
    kept := df.set_multi_index(t, ["dept", "name"], false)
    test.is_true(contains(df.columns(kept), "dept"))
    test.eq(df.index(kept)[1], ["eng", "Bob"])
}

fn test_multi_index_loc_labels_and_partial {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    full := df.loc_labels(multi, [["eng", "Alice"], ["sales", "Dan"]])
    test.eq(df.nrows(full), 2)
    test.eq(df.index(full), [["eng", "Alice"], ["sales", "Dan"]])
    test.eq(df.col(full, "age"), [30, 28])
    test.eq(df.index_levels(full), ["dept", "name"])
    // Scalar / partial first-level match selects all rows under that level.
    eng := df.loc_labels(multi, ["eng"])
    test.eq(df.nrows(eng), 3)
    test.eq(df.index(eng)[0][0], "eng")
    prefix := df.loc_labels(multi, [["sales"]])
    test.eq(df.nrows(prefix), 2)
    test.eq(df.col(prefix, "salary"), [85000, 70000])
}

fn test_multi_index_reindex_and_reset {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    filled := df.reindex(multi, [["eng", "Bob"], ["ops", "Missing"], ["sales", "Carol"]], null)
    test.eq(df.nrows(filled), 3)
    test.eq(df.index(filled), [["eng", "Bob"], ["ops", "Missing"], ["sales", "Carol"]])
    test.eq(df.col(filled, "age"), [25, null, 35])
    test.eq(df.index_nlevels(filled), 2)
    restored := df.reset_index(multi, null)
    test.eq(df.columns(restored)[0], "dept")
    test.eq(df.columns(restored)[1], "name")
    test.eq(df.col(restored, "dept")[0], "eng")
    test.eq(df.col(restored, "name")[3], "Dan")
    test.eq(df.nrows(restored), 5)
}

fn test_multi_index_preserved_by_head_and_filter {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    filtered := df.query(multi, "age", ">", 28)
    test.eq(df.index_nlevels(filtered), 2)
    test.eq(df.index_levels(filtered), ["dept", "name"])
    test.eq(df.index(filtered), [["eng", "Alice"], ["sales", "Carol"], ["eng", "Eve"]])
    h := df.head(filtered, 2)
    test.eq(df.index(h), [["eng", "Alice"], ["sales", "Carol"]])
    test.eq(df.index_levels(h), ["dept", "name"])
}

fn test_head_tail {
    t := _sample_df()
    h := df.head(t, 2)
    test.eq(df.nrows(h), 2)
    tl := df.tail(t, 2)
    test.eq(df.nrows(tl), 2)
    test.eq(df.col(tl, "name"), ["Dan", "Eve"])
}

fn test_head_default {
    t := _sample_df()
    h := df.head(t, null)
    test.eq(df.nrows(h), 5)
}

fn test_iloc {
    t := _sample_df()
    row := df.iloc(t, 2)
    test.eq(row.name, "Carol")
    last := df.iloc(t, -1)
    test.eq(last.name, "Eve")
    selected := df.iloc(t, [3, 0, -1])
    test.eq(df.col(selected, "name"), ["Dan", "Alice", "Eve"])
    bad := df.iloc(t, [99])
    test.is_false(bad.ok)
}

fn test_loc {
    t := _sample_df()
    sub := df.loc(t, 1, 3)
    test.eq(df.nrows(sub), 2)
    test.eq(df.col(sub, "name"), ["Bob", "Carol"])
}

fn test_select {
    t := _sample_df()
    s := df.select_(t, ["name", "age"])
    test.eq(df.columns(s), ["name", "age"])
    test.eq(df.ncols(s), 2)
}

fn test_drop {
    t := _sample_df()
    d := df.drop(t, ["salary"])
    test.eq(df.ncols(d), 3)
    test.is_false(contains(df.columns(d), "salary"))
}

// === Filtering ===

fn test_filter {
    t := _sample_df()
    eng := df.filter_(t, fn(r) { r.dept == "eng" })
    test.eq(df.nrows(eng), 3)
}

fn test_query {
    t := _sample_df()
    old := df.query(t, "age", ">", 30)
    test.eq(df.nrows(old), 2)
}

fn test_isin {
    t := _sample_df()
    sub := df.isin(t, "name", ["Alice", "Eve"])
    test.eq(df.nrows(sub), 2)
}

fn test_between {
    t := _sample_df()
    mid := df.between(t, "age", 26, 32)
    test.eq(df.nrows(mid), 3)
}

fn test_notnull {
    t := df.from_rows([{"a": 1, "b": null}, {"a": null, "b": 2}, {"a": 3, "b": 3}])
    result := df.notnull(t, "a")
    test.eq(df.nrows(result), 2)
}

// === Sorting ===

fn test_sort_by {
    t := _sample_df()
    s := df.sort_by(t, "age", false)
    ages := df.col(s, "age")
    test.eq(ages[0], 25)
    test.eq(ages[4], 35)
}

fn test_sort_desc {
    t := _sample_df()
    s := df.sort_by(t, "salary", true)
    test.eq(df.col(s, "name")[0], "Eve")
}

fn test_nlargest {
    t := _sample_df()
    top := df.nlargest(t, 2, "salary")
    test.eq(df.nrows(top), 2)
    test.eq(df.col(top, "name")[0], "Eve")
}

fn test_nsmallest {
    t := _sample_df()
    bottom := df.nsmallest(t, 2, "salary")
    test.eq(df.nrows(bottom), 2)
}

// === Column ops ===

fn test_add_column {
    t := _sample_df()
    t2 := df.add_column(t, "senior", fn(r) { r.age >= 30 })
    test.eq(df.ncols(t2), 5)
    test.is_true(df.iloc(t2, 0).senior)
    test.is_false(df.iloc(t2, 1).senior)
}

fn test_assign {
    t := _columns({"x": [1, 2, 3]})
    t2 := df.assign(t, {"double": fn(r) { r.x * 2 }, "triple": fn(r) { r.x * 3 }})
    test.eq(df.ncols(t2), 3)
    test.eq(df.col(t2, "double"), [2, 4, 6])
    test.eq(df.col(t2, "triple"), [3, 6, 9])
}

fn test_rename {
    t := _columns({"old_name": [1, 2]})
    t2 := df.rename(t, {"old_name": "new_name"})
    test.eq(df.columns(t2), ["new_name"])
}

fn test_apply {
    t := _columns({"x": [1, 2, 3]})
    t2 := df.apply_(t, "x", fn(v) { v * 10 })
    test.eq(df.col(t2, "x"), [10, 20, 30])
}

fn test_replace {
    t := _columns({"status": ["active", "inactive", "active"]})
    t2 := df.replace(t, "status", "inactive", "disabled")
    test.eq(df.col(t2, "status"), ["active", "disabled", "active"])
}

fn test_clip {
    t := _columns({"x": [1, 5, 10, 15]})
    t2 := df.clip_(t, "x", 3, 12)
    test.eq(df.col(t2, "x"), [3, 5, 10, 12])
}

// === Missing data ===

fn test_fillna {
    t := df.from_rows([{"a": 1, "b": null}, {"a": null, "b": 2}])
    t2 := df.fillna(t, {"a": 0, "b": -1})
    test.eq(df.col(t2, "a"), [1, 0])
    test.eq(df.col(t2, "b"), [-1, 2])
}

fn test_dropna {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": null, "b": 3}, {"a": 4, "b": null}])
    t2 := df.dropna(t, null)
    test.eq(df.nrows(t2), 1)
}

fn test_dropna_subset {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": null, "b": 3}, {"a": 4, "b": null}])
    t2 := df.dropna(t, ["a"])
    test.eq(df.nrows(t2), 2)
}

fn test_count_na {
    t := df.from_rows([{"a": 1}, {"a": null}, {"a": null}])
    test.eq(df.count_na(t, "a"), 2)
}

// === Duplicates ===

fn test_drop_duplicates {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": 1, "b": 2}, {"a": 3, "b": 4}])
    t2 := df.drop_duplicates(t, null)
    test.eq(df.nrows(t2), 2)
}

fn test_drop_duplicates_subset {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": 1, "b": 3}, {"a": 2, "b": 4}])
    t2 := df.drop_duplicates(t, ["a"])
    test.eq(df.nrows(t2), 2)
}

fn test_duplicated {
    t := df.from_rows([{"a": 1}, {"a": 2}, {"a": 1}])
    d := df.duplicated(t, ["a"])
    test.eq(d, [false, false, true])
}

// === Grouping / aggregation ===

fn test_group_by {
    t := _sample_df()
    g := df.group_by(t, "dept", {
        "total_salary": {"col": "salary", "op": "sum"},
        "avg_age": {"col": "age", "op": "mean"},
        "headcount": {"col": "name", "op": "count"},
    })
    test.eq(df.nrows(g), 2)
    test.is_true(contains(df.columns(g), "total_salary"))
}

fn test_agg {
    t := _sample_df()
    result := df.agg(t, {
        "total": {"col": "salary", "op": "sum"},
        "avg": {"col": "salary", "op": "mean"},
        "n": {"col": "salary", "op": "count"},
    })
    test.eq(result.n, 5)
    test.eq(result.total, 415000)
}

fn test_value_counts {
    t := _sample_df()
    vc := df.value_counts(t, "dept")
    test.eq(vc.eng, 3)
    test.eq(vc.sales, 2)
}

fn test_nunique {
    t := _sample_df()
    test.eq(df.nunique(t, "dept"), 2)
    test.eq(df.nunique(t, "name"), 5)
}

// === Statistics ===

fn test_describe {
    t := _sample_df()
    d := df.describe(t, "salary")
    test.eq(d.count, 5)
    test.eq(d.sum, 415000)
    test.eq(d.min, 70000)
    test.eq(d.max, 95000)
}

fn test_corr {
    t := _columns({"x": [1, 2, 3, 4, 5], "y": [2, 4, 6, 8, 10]})
    c := df.corr(t, "x", "y")
    test.approx(c, 1.0, 1e-6)
}

// === Joins ===

fn test_inner_join {
    left := df.from_rows([{"id": 1, "name": "a"}, {"id": 2, "name": "b"}, {"id": 3, "name": "c"}])
    right := df.from_rows([{"id": 1, "score": 90}, {"id": 3, "score": 80}])
    result := df.join(left, right, "id", "inner")
    test.eq(df.nrows(result), 2)
}

fn test_left_join {
    left := df.from_rows([{"id": 1, "name": "a"}, {"id": 2, "name": "b"}])
    right := df.from_rows([{"id": 1, "score": 90}])
    result := df.join(left, right, "id", "left")
    test.eq(df.nrows(result), 2)
    r := df.rows(result)
    test.eq(r[1].score, null)
}

fn test_concat_df {
    a := df.from_rows([{"x": 1}, {"x": 2}])
    b := df.from_rows([{"x": 3}, {"x": 4}])
    c := df.concat_df([a, b])
    test.eq(df.nrows(c), 4)
    test.eq(df.col(c, "x"), [1, 2, 3, 4])
}

// === Reshaping ===

fn test_pivot {
    t := df.from_rows([
        {"date": "Mon", "metric": "cpu", "value": 45},
        {"date": "Mon", "metric": "mem", "value": 70},
        {"date": "Tue", "metric": "cpu", "value": 50},
        {"date": "Tue", "metric": "mem", "value": 65},
    ])
    p := df.pivot(t, "date", "metric", "value")
    test.eq(df.nrows(p), 2)
    test.is_true(contains(df.columns(p), "cpu"))
    test.is_true(contains(df.columns(p), "mem"))
}

fn test_melt {
    t := df.from_rows([
        {"name": "Alice", "math": 90, "eng": 85},
        {"name": "Bob", "math": 75, "eng": 92},
    ])
    m := df.melt(t, ["name"], ["math", "eng"], "subject", "score")
    test.eq(df.nrows(m), 4)
    test.is_true(contains(df.columns(m), "subject"))
    test.is_true(contains(df.columns(m), "score"))
}

fn test_crosstab {
    t := df.from_rows([
        {"color": "red", "size": "S"},
        {"color": "red", "size": "M"},
        {"color": "blue", "size": "S"},
        {"color": "blue", "size": "S"},
    ])
    ct := df.crosstab(t, "color", "size")
    test.eq(df.nrows(ct), 2)
}

// === Window / rolling ===

fn test_shift {
    t := _columns({"x": [10, 20, 30, 40]})
    s := df.shift(t, "x", 1)
    test.eq(df.col(s, "x"), [null, 10, 20, 30])
}

fn test_diff {
    t := _columns({"x": [10, 15, 25, 40]})
    d := df.diff(t, "x", 1)
    vals := df.col(d, "x")
    test.eq(vals[0], null)
    test.eq(vals[1], 5)
    test.eq(vals[2], 10)
    test.eq(vals[3], 15)
}

fn test_pct_change {
    t := _columns({"x": [100, 110, 99]})
    p := df.pct_change(t, "x", 1)
    vals := df.col(p, "x")
    test.eq(vals[0], null)
    test.approx(vals[1], 0.1, 1e-6)
}

fn test_rolling_mean {
    t := _columns({"x": [1, 2, 3, 4, 5]})
    r := df.rolling(t, "x", 3, "mean")
    vals := df.col(r, "x")
    test.eq(vals[0], null)
    test.eq(vals[1], null)
    test.eq(vals[2], 2)
}

fn test_cumsum {
    t := _columns({"x": [1, 2, 3, 4]})
    c := df.cumsum_(t, "x")
    test.eq(df.col(c, "x"), [1.0, 3.0, 6.0, 10.0])
}

fn test_rank {
    t := _columns({"x": [30, 10, 20]})
    r := df.rank(t, "x")
    test.is_true(contains(df.columns(r), "x_rank"))
}

