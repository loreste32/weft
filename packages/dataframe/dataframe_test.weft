use "./lib.weft" as df
use warp

fn _sample_df {
    df.from_rows([
        {"name": "Alice", "age": 30, "dept": "eng", "salary": 90000},
        {"name": "Bob", "age": 25, "dept": "eng", "salary": 75000},
        {"name": "Carol", "age": 35, "dept": "sales", "salary": 85000},
        {"name": "Dan", "age": 28, "dept": "sales", "salary": 70000},
        {"name": "Eve", "age": 32, "dept": "eng", "salary": 95000},
    ])
}

fn _columns(data) {
    result := df.from_columns(data)
    test.is_true(result.ok)
    result.value
}

fn _csv(text, sep) {
    result := df.from_csv(text, sep)
    test.is_true(result.ok)
    result.value
}

// === Creation ===

fn test_from_rows {
    t := _sample_df()
    test.eq(df.nrows(t), 5)
    test.eq(df.ncols(t), 4)
}

fn test_from_rows_normalizes_missing_columns {
    t := df.from_rows([{"a": 1}, {"b": 2}])
    test.eq(df.columns(t), ["a", "b"])
    test.eq(df.col(t, "a"), [1, null])
    test.eq(df.col(t, "b"), [null, 2])
}

fn test_from_columns {
    t := _columns({"x": [1, 2, 3], "y": [4, 5, 6]})
    test.eq(df.nrows(t), 3)
    test.eq(df.col(t, "x"), [1, 2, 3])
}

fn test_from_csv {
    csv_text := "name,age,score\nAlice,30,95\nBob,25,87\n"
    t := _csv(csv_text, null)
    test.eq(df.nrows(t), 2)
    test.eq(df.columns(t), ["name", "age", "score"])
    test.eq(df.col(t, "name"), ["Alice", "Bob"])
    // auto-parses numbers
    test.eq(df.col(t, "age"), [30, 25])
}

fn test_from_csv_with_nulls {
    csv_text := "a,b\n1,null\n,3\n"
    t := _csv(csv_text, null)
    test.eq(df.nrows(t), 2)
    r := df.rows(t)
    test.eq(r[0].b, null)
    test.eq(r[1].a, null)
}

fn test_empty {
    t := df.empty(["a", "b"])
    test.eq(df.nrows(t), 0)
    test.eq(df.columns(t), ["a", "b"])
}

// === Shape / info ===

fn test_shape {
    t := _sample_df()
    test.eq(df.shape(t), [5, 4])
}

fn test_info {
    t := _sample_df()
    i := df.info(t)
    test.eq(i.rows, 5)
    test.eq(i.columns, 4)
}

// === Selection ===

fn test_col {
    t := _sample_df()
    names := df.col(t, "name")
    test.eq(len(names), 5)
    test.eq(names[0], "Alice")
}

fn test_warp_interchange_round_trip {
    t := _sample_df()
    packed := df.to_warp(t, ["age", "salary"], "float64")
    test.is_true(packed.ok)
    test.eq(warp.shape(packed.value), [5, 2])
    test.eq(warp.to_list(warp.row(packed.value, 0)), [30.0, 90000.0])
    restored := df.from_warp(packed.value, ["age", "salary"])
    test.is_true(restored.ok)
    test.eq(df.col(restored.value, "age"), [30.0, 25.0, 35.0, 28.0, 32.0])
    test.eq(df.col(restored.value, "salary"), [90000.0, 75000.0, 85000.0, 70000.0, 95000.0])
    one := df.from_warp(warp.array([4, 5], [2]), null)
    test.is_true(one.ok)
    test.eq(df.columns(one.value), ["column_0"])
    test.eq(df.col(one.value, "column_0"), [4, 5])
}

fn test_warp_interchange_rejects_invalid_values {
    t := _sample_df()
    bad_column := df.to_warp(t, ["name"], null)
    test.is_false(bad_column.ok)
    with_null := df.from_rows([{"x": 1}, {"x": null}])
    bad_null := df.to_warp(with_null, ["x"], null)
    test.is_false(bad_null.ok)
    bad_names := df.from_warp(warp.array([1, 2, 3], [3]), ["a", "b"])
    test.is_false(bad_names.ok)
}

fn test_series_contract {
    t := _sample_df()
    s := df.series_from(t, "age")
    test.eq(df.series_name(s), "age")
    test.eq(df.series_values(s), [30, 25, 35, 28, 32])
    test.eq(df.series_index(s), [0, 1, 2, 3, 4])
    test.eq(df.series_shape(s), [5])
    test.eq(df.series_dtype(s), "int")
    doubled := df.series_map(s, fn(v) { v * 2 })
    test.eq(df.series_values(doubled), [60, 50, 70, 56, 64])
}

fn test_series_null_and_counts {
    s := df.series([1, null, 1, 2], "x", ["a", "b", "c", "d"])
    filled := df.series_fillna(s, 0)
    test.eq(df.series_values(filled), [1, 0, 1, 2])
    dropped := df.series_dropna(s)
    test.eq(df.series_values(dropped), [1, 1, 2])
    test.eq(df.series_index(dropped), ["a", "c", "d"])
    test.eq(df.series_unique(s), [1, null, 2])
    counts := df.series_value_counts(s)
    test.eq(counts["int:1"], 2)
    test.eq(counts["null:null"], 1)
}

fn test_series_alignment_and_reindex {
    left := df.series([10, 20], "value", ["a", "b"])
    right := df.series([1, 3], "other", ["b", "c"])
    added := df.series_add(left, right, null)
    test.eq(df.series_index(added), ["a", "b", "c"])
    test.eq(df.series_values(added), [null, 21, null])
    filled := df.series_add(left, right, 0)
    test.eq(df.series_values(filled), [10, 21, 3])
    reordered := df.series_reindex(left, ["b", "x", "a"], -1)
    test.eq(df.series_values(reordered), [20, -1, 10])
}

fn test_set_and_reset_index {
    t := _sample_df()
    invalid_drop := df.set_index(t, "name", 1)
    test.is_false(invalid_drop.ok)
    indexed := df.set_index(t, "name", null)
    test.eq(df.index(indexed), ["Alice", "Bob", "Carol", "Dan", "Eve"])
    test.is_false(contains(df.columns(indexed), "name"))
    restored := df.reset_index(indexed, null)
    test.eq(df.columns(restored)[0], "index")
    test.eq(df.col(restored, "index")[0], "Alice")
    test.eq(df.col(restored, "dept")[2], "sales")
}

fn test_label_selection_and_reindex {
    t := df.set_index(_sample_df(), "name", null)
    selected := df.loc_labels(t, ["Eve", "Alice"])
    test.eq(df.index(selected), ["Eve", "Alice"])
    test.eq(df.col(selected, "age"), [32, 30])
    filled := df.reindex(t, ["Bob", "Missing"], null)
    test.eq(df.index(filled), ["Bob", "Missing"])
    test.eq(df.col(filled, "age"), [25, null])
}

fn test_index_preserved_by_row_transformations {
    indexed := df.set_index(_sample_df(), "name", null)
    filtered := df.query(indexed, "age", ">", 28)
    test.eq(df.index(filtered), ["Alice", "Carol", "Eve"])
    sorted := df.sort_by(filtered, "age", true)
    test.eq(df.index(sorted), ["Carol", "Eve", "Alice"])
    test.eq(df.index(df.head(sorted, 2)), ["Carol", "Eve"])
    test.eq(df.index(df.tail(sorted, 1)), ["Alice"])
    test.eq(df.index(df.loc(sorted, 1, 3)), ["Eve", "Alice"])
    test.eq(df.index(df.select_(sorted, ["age"])), ["Carol", "Eve", "Alice"])
    test.eq(df.index(df.rename(sorted, {"age": "years"})), ["Carol", "Eve", "Alice"])
    added := df.add_column(sorted, "adult", fn(r) { r.age >= 18 })
    test.eq(df.index(added), ["Carol", "Eve", "Alice"])
}

fn test_multi_index_create_and_levels {
    t := _sample_df()
    test.eq(df.index_nlevels(t), 1)
    test.eq(df.index_levels(t), [null])
    bad := df.set_multi_index(t, [], null)
    test.is_false(bad.ok)
    unknown := df.set_multi_index(t, ["dept", "missing"], null)
    test.is_false(unknown.ok)
    single := df.set_multi_index(t, ["name"], null)
    test.eq(df.index_nlevels(single), 1)
    test.eq(df.index(single), ["Alice", "Bob", "Carol", "Dan", "Eve"])
    multi := df.set_multi_index(t, ["dept", "name"], null)
    test.eq(df.index_nlevels(multi), 2)
    test.eq(df.index_levels(multi), ["dept", "name"])
    test.is_false(contains(df.columns(multi), "dept"))
    test.is_false(contains(df.columns(multi), "name"))
    test.eq(df.index(multi)[0], ["eng", "Alice"])
    test.eq(df.index(multi)[2], ["sales", "Carol"])
    kept := df.set_multi_index(t, ["dept", "name"], false)
    test.is_true(contains(df.columns(kept), "dept"))
    test.eq(df.index(kept)[1], ["eng", "Bob"])
}

fn test_multi_index_loc_labels_and_partial {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    full := df.loc_labels(multi, [["eng", "Alice"], ["sales", "Dan"]])
    test.eq(df.nrows(full), 2)
    test.eq(df.index(full), [["eng", "Alice"], ["sales", "Dan"]])
    test.eq(df.col(full, "age"), [30, 28])
    test.eq(df.index_levels(full), ["dept", "name"])
    // Scalar / partial first-level match selects all rows under that level.
    eng := df.loc_labels(multi, ["eng"])
    test.eq(df.nrows(eng), 3)
    test.eq(df.index(eng)[0][0], "eng")
    prefix := df.loc_labels(multi, [["sales"]])
    test.eq(df.nrows(prefix), 2)
    test.eq(df.col(prefix, "salary"), [85000, 70000])
}

fn test_multi_index_reindex_and_reset {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    filled := df.reindex(multi, [["eng", "Bob"], ["ops", "Missing"], ["sales", "Carol"]], null)
    test.eq(df.nrows(filled), 3)
    test.eq(df.index(filled), [["eng", "Bob"], ["ops", "Missing"], ["sales", "Carol"]])
    test.eq(df.col(filled, "age"), [25, null, 35])
    test.eq(df.index_nlevels(filled), 2)
    restored := df.reset_index(multi, null)
    test.eq(df.columns(restored)[0], "dept")
    test.eq(df.columns(restored)[1], "name")
    test.eq(df.col(restored, "dept")[0], "eng")
    test.eq(df.col(restored, "name")[3], "Dan")
    test.eq(df.nrows(restored), 5)
}

fn test_multi_index_preserved_by_head_and_filter {
    multi := df.set_multi_index(_sample_df(), ["dept", "name"], null)
    filtered := df.query(multi, "age", ">", 28)
    test.eq(df.index_nlevels(filtered), 2)
    test.eq(df.index_levels(filtered), ["dept", "name"])
    test.eq(df.index(filtered), [["eng", "Alice"], ["sales", "Carol"], ["eng", "Eve"]])
    h := df.head(filtered, 2)
    test.eq(df.index(h), [["eng", "Alice"], ["sales", "Carol"]])
    test.eq(df.index_levels(h), ["dept", "name"])
}

fn test_head_tail {
    t := _sample_df()
    h := df.head(t, 2)
    test.eq(df.nrows(h), 2)
    tl := df.tail(t, 2)
    test.eq(df.nrows(tl), 2)
    test.eq(df.col(tl, "name"), ["Dan", "Eve"])
}

fn test_head_default {
    t := _sample_df()
    h := df.head(t, null)
    test.eq(df.nrows(h), 5)
}

fn test_iloc {
    t := _sample_df()
    row := df.iloc(t, 2)
    test.eq(row.name, "Carol")
    last := df.iloc(t, -1)
    test.eq(last.name, "Eve")
    selected := df.iloc(t, [3, 0, -1])
    test.eq(df.col(selected, "name"), ["Dan", "Alice", "Eve"])
    bad := df.iloc(t, [99])
    test.is_false(bad.ok)
}

fn test_loc {
    t := _sample_df()
    sub := df.loc(t, 1, 3)
    test.eq(df.nrows(sub), 2)
    test.eq(df.col(sub, "name"), ["Bob", "Carol"])
}

fn test_select {
    t := _sample_df()
    s := df.select_(t, ["name", "age"])
    test.eq(df.columns(s), ["name", "age"])
    test.eq(df.ncols(s), 2)
}

fn test_drop {
    t := _sample_df()
    d := df.drop(t, ["salary"])
    test.eq(df.ncols(d), 3)
    test.is_false(contains(df.columns(d), "salary"))
}

// === Filtering ===

fn test_filter {
    t := _sample_df()
    eng := df.filter_(t, fn(r) { r.dept == "eng" })
    test.eq(df.nrows(eng), 3)
}

fn test_query {
    t := _sample_df()
    old := df.query(t, "age", ">", 30)
    test.eq(df.nrows(old), 2)
}

fn test_isin {
    t := _sample_df()
    sub := df.isin(t, "name", ["Alice", "Eve"])
    test.eq(df.nrows(sub), 2)
}

fn test_between {
    t := _sample_df()
    mid := df.between(t, "age", 26, 32)
    test.eq(df.nrows(mid), 3)
}

fn test_notnull {
    t := df.from_rows([{"a": 1, "b": null}, {"a": null, "b": 2}, {"a": 3, "b": 3}])
    result := df.notnull(t, "a")
    test.eq(df.nrows(result), 2)
}

// === Sorting ===

fn test_sort_by {
    t := _sample_df()
    s := df.sort_by(t, "age", false)
    ages := df.col(s, "age")
    test.eq(ages[0], 25)
    test.eq(ages[4], 35)
}

fn test_sort_desc {
    t := _sample_df()
    s := df.sort_by(t, "salary", true)
    test.eq(df.col(s, "name")[0], "Eve")
}

fn test_nlargest {
    t := _sample_df()
    top := df.nlargest(t, 2, "salary")
    test.eq(df.nrows(top), 2)
    test.eq(df.col(top, "name")[0], "Eve")
}

fn test_nsmallest {
    t := _sample_df()
    bottom := df.nsmallest(t, 2, "salary")
    test.eq(df.nrows(bottom), 2)
}

// === Column ops ===

fn test_add_column {
    t := _sample_df()
    t2 := df.add_column(t, "senior", fn(r) { r.age >= 30 })
    test.eq(df.ncols(t2), 5)
    test.is_true(df.iloc(t2, 0).senior)
    test.is_false(df.iloc(t2, 1).senior)
}

fn test_assign {
    t := _columns({"x": [1, 2, 3]})
    t2 := df.assign(t, {"double": fn(r) { r.x * 2 }, "triple": fn(r) { r.x * 3 }})
    test.eq(df.ncols(t2), 3)
    test.eq(df.col(t2, "double"), [2, 4, 6])
    test.eq(df.col(t2, "triple"), [3, 6, 9])
}

fn test_rename {
    t := _columns({"old_name": [1, 2]})
    t2 := df.rename(t, {"old_name": "new_name"})
    test.eq(df.columns(t2), ["new_name"])
}

fn test_apply {
    t := _columns({"x": [1, 2, 3]})
    t2 := df.apply_(t, "x", fn(v) { v * 10 })
    test.eq(df.col(t2, "x"), [10, 20, 30])
}

fn test_replace {
    t := _columns({"status": ["active", "inactive", "active"]})
    t2 := df.replace(t, "status", "inactive", "disabled")
    test.eq(df.col(t2, "status"), ["active", "disabled", "active"])
}

fn test_clip {
    t := _columns({"x": [1, 5, 10, 15]})
    t2 := df.clip_(t, "x", 3, 12)
    test.eq(df.col(t2, "x"), [3, 5, 10, 12])
}

// === Missing data ===

fn test_fillna {
    t := df.from_rows([{"a": 1, "b": null}, {"a": null, "b": 2}])
    t2 := df.fillna(t, {"a": 0, "b": -1})
    test.eq(df.col(t2, "a"), [1, 0])
    test.eq(df.col(t2, "b"), [-1, 2])
}

fn test_dropna {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": null, "b": 3}, {"a": 4, "b": null}])
    t2 := df.dropna(t, null)
    test.eq(df.nrows(t2), 1)
}

fn test_dropna_subset {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": null, "b": 3}, {"a": 4, "b": null}])
    t2 := df.dropna(t, ["a"])
    test.eq(df.nrows(t2), 2)
}

fn test_count_na {
    t := df.from_rows([{"a": 1}, {"a": null}, {"a": null}])
    test.eq(df.count_na(t, "a"), 2)
}

// === Duplicates ===

fn test_drop_duplicates {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": 1, "b": 2}, {"a": 3, "b": 4}])
    t2 := df.drop_duplicates(t, null)
    test.eq(df.nrows(t2), 2)
}

fn test_drop_duplicates_subset {
    t := df.from_rows([{"a": 1, "b": 2}, {"a": 1, "b": 3}, {"a": 2, "b": 4}])
    t2 := df.drop_duplicates(t, ["a"])
    test.eq(df.nrows(t2), 2)
}

fn test_duplicated {
    t := df.from_rows([{"a": 1}, {"a": 2}, {"a": 1}])
    d := df.duplicated(t, ["a"])
    test.eq(d, [false, false, true])
}

// === Grouping / aggregation ===

fn test_group_by {
    t := _sample_df()
    g := df.group_by(t, "dept", {
        "total_salary": {"col": "salary", "op": "sum"},
        "avg_age": {"col": "age", "op": "mean"},
        "headcount": {"col": "name", "op": "count"},
    })
    test.eq(df.nrows(g), 2)
    test.is_true(contains(df.columns(g), "total_salary"))
}

fn test_agg {
    t := _sample_df()
    result := df.agg(t, {
        "total": {"col": "salary", "op": "sum"},
        "avg": {"col": "salary", "op": "mean"},
        "n": {"col": "salary", "op": "count"},
    })
    test.eq(result.n, 5)
    test.eq(result.total, 415000)
}

fn test_value_counts {
    t := _sample_df()
    vc := df.value_counts(t, "dept")
    test.eq(vc.eng, 3)
    test.eq(vc.sales, 2)
}

fn test_nunique {
    t := _sample_df()
    test.eq(df.nunique(t, "dept"), 2)
    test.eq(df.nunique(t, "name"), 5)
}

// === Statistics ===

fn test_describe {
    t := _sample_df()
    d := df.describe(t, "salary")
    test.eq(d.count, 5)
    test.eq(d.sum, 415000)
    test.eq(d.min, 70000)
    test.eq(d.max, 95000)
}

fn test_corr {
    t := _columns({"x": [1, 2, 3, 4, 5], "y": [2, 4, 6, 8, 10]})
    c := df.corr(t, "x", "y")
    test.approx(c, 1.0, 1e-6)
}

// === Joins ===

fn test_inner_join {
    left := df.from_rows([{"id": 1, "name": "a"}, {"id": 2, "name": "b"}, {"id": 3, "name": "c"}])
    right := df.from_rows([{"id": 1, "score": 90}, {"id": 3, "score": 80}])
    result := df.join(left, right, "id", "inner")
    test.eq(df.nrows(result), 2)
}

fn test_left_join {
    left := df.from_rows([{"id": 1, "name": "a"}, {"id": 2, "name": "b"}])
    right := df.from_rows([{"id": 1, "score": 90}])
    result := df.join(left, right, "id", "left")
    test.eq(df.nrows(result), 2)
    r := df.rows(result)
    test.eq(r[1].score, null)
}

fn test_concat_df {
    a := df.from_rows([{"x": 1}, {"x": 2}])
    b := df.from_rows([{"x": 3}, {"x": 4}])
    c := df.concat_df([a, b])
    test.eq(df.nrows(c), 4)
    test.eq(df.col(c, "x"), [1, 2, 3, 4])
}

// === Reshaping ===

fn test_pivot {
    t := df.from_rows([
        {"date": "Mon", "metric": "cpu", "value": 45},
        {"date": "Mon", "metric": "mem", "value": 70},
        {"date": "Tue", "metric": "cpu", "value": 50},
        {"date": "Tue", "metric": "mem", "value": 65},
    ])
    p := df.pivot(t, "date", "metric", "value")
    test.eq(df.nrows(p), 2)
    test.is_true(contains(df.columns(p), "cpu"))
    test.is_true(contains(df.columns(p), "mem"))
}

fn test_melt {
    t := df.from_rows([
        {"name": "Alice", "math": 90, "eng": 85},
        {"name": "Bob", "math": 75, "eng": 92},
    ])
    m := df.melt(t, ["name"], ["math", "eng"], "subject", "score")
    test.eq(df.nrows(m), 4)
    test.is_true(contains(df.columns(m), "subject"))
    test.is_true(contains(df.columns(m), "score"))
}

fn test_crosstab {
    t := df.from_rows([
        {"color": "red", "size": "S"},
        {"color": "red", "size": "M"},
        {"color": "blue", "size": "S"},
        {"color": "blue", "size": "S"},
    ])
    ct := df.crosstab(t, "color", "size")
    test.eq(df.nrows(ct), 2)
}

// === Window / rolling ===

fn test_shift {
    t := _columns({"x": [10, 20, 30, 40]})
    s := df.shift(t, "x", 1)
    test.eq(df.col(s, "x"), [null, 10, 20, 30])
}

fn test_diff {
    t := _columns({"x": [10, 15, 25, 40]})
    d := df.diff(t, "x", 1)
    vals := df.col(d, "x")
    test.eq(vals[0], null)
    test.eq(vals[1], 5)
    test.eq(vals[2], 10)
    test.eq(vals[3], 15)
}

fn test_pct_change {
    t := _columns({"x": [100, 110, 99]})
    p := df.pct_change(t, "x", 1)
    vals := df.col(p, "x")
    test.eq(vals[0], null)
    test.approx(vals[1], 0.1, 1e-6)
}

fn test_rolling_mean {
    t := _columns({"x": [1, 2, 3, 4, 5]})
    r := df.rolling(t, "x", 3, "mean")
    vals := df.col(r, "x")
    test.eq(vals[0], null)
    test.eq(vals[1], null)
    test.eq(vals[2], 2)
}

fn test_cumsum {
    t := _columns({"x": [1, 2, 3, 4]})
    c := df.cumsum_(t, "x")
    test.eq(df.col(c, "x"), [1.0, 3.0, 6.0, 10.0])
}

fn test_rank {
    t := _columns({"x": [30, 10, 20]})
    r := df.rank(t, "x")
    test.is_true(contains(df.columns(r), "x_rank"))
}

// === Sampling ===

fn test_sample {
    t := _sample_df()
    s := df.sample(t, 3, null)
    test.eq(df.nrows(s), 3)
}

fn test_shuffle {
    t := _sample_df()
    s := df.shuffle(t)
    test.eq(df.nrows(s), 5)
}

// === Output ===

fn test_to_csv {
    t := _columns({"a": [1, 2], "b": [3, 4]})
    csv := df.to_csv(t, null)
    test.is_true(str.contains(csv, "a,b"))
    test.is_true(str.contains(csv, "1,3"))
}

fn test_to_json {
    t := df.from_rows([{"x": 1}])
    j := df.to_json(t)
    test.is_true(str.contains(j, "\"x\""))
}

fn test_to_jsonl {
    t := df.from_rows([{"x": 1}, {"x": 2}])
    jl := df.to_jsonl(t)
    lines := str.split(jl, "\n")
    test.eq(len(lines), 2)
}

fn test_to_records {
    t := _sample_df()
    recs := df.to_records(t)
    test.eq(len(recs), 5)
    test.eq(recs[0].name, "Alice")
}

fn test_to_dict {
    t := _columns({"x": [1, 2], "y": [3, 4]})
    d := df.to_dict(t)
    test.eq(d.x, [1, 2])
    test.eq(d.y, [3, 4])
}

// === CSV roundtrip ===

fn test_csv_roundtrip {
    t := _columns({"name": ["Alice", "Bob"], "score": [95, 87]})
    csv := df.to_csv(t, null)
    t2 := _csv(csv, null)
    test.eq(df.nrows(t2), 2)
    test.eq(df.col(t2, "name"), ["Alice", "Bob"])
    test.eq(df.col(t2, "score"), [95, 87])
}

// === Regression and contract coverage ===

fn test_dtypes_scan_all_rows {
    t := df.from_rows([
        {"i": 1, "f": 1.5, "b": true, "s": "x", "n": null},
        {"i": 2, "f": 2, "b": false, "s": "y", "n": null},
    ])
    d := df.dtypes(t)
    test.eq(d.i, "int")
    test.eq(d.f, "float")
    test.eq(d.b, "bool")
    test.eq(d.s, "str")
    test.eq(d.n, "null")
}

fn test_schema_union_and_empty_results {
    t := df.from_rows([{"a": 1}, {"b": 2}])
    test.eq(df.columns(t), ["a", "b"])
    test.eq(df.col(t, "b"), [null, 2])
    empty := df.filter_(t, fn(r) { false })
    test.eq(df.columns(empty), ["a", "b"])
    test.eq(df.shape(empty), [0, 2])
}

fn test_from_columns_rejects_mismatched_lengths {
    r := df.from_columns({"a": [1, 2], "b": [3]})
    test.is_false(r.ok)
}

fn test_csv_quotes_crlf_and_empty_string {
    csv := "name,note,empty\r\n\"A,B\",\"say \"\"hi\"\"\",\"\"\r\n"
    r := df.from_csv(csv, null)
    test.is_true(r.ok)
    t := r.value
    row := df.iloc(t, 0)
    test.eq(row.name, "A,B")
    test.eq(row.note, "say \"hi\"")
    test.eq(row.empty, "")
    roundtrip := _csv(df.to_csv(t, null), null)
    test.eq(df.iloc(roundtrip, 0).note, "say \"hi\"")
}

fn test_csv_rejects_bad_rows_and_headers {
    bad_row := df.from_csv("a,b\n1\n", null)
    test.is_false(bad_row.ok)
    bad_header := df.from_csv("a,a\n1,2\n", null)
    test.is_false(bad_header.ok)
}

fn test_null_aware_group_aggregation {
    t := df.from_rows([
        {"g": "x", "v": 1},
        {"g": "x", "v": null},
        {"g": "y", "v": null},
    ])
    grouped := df.group_by(t, "g", {
        "total": {"col": "v", "op": "sum"},
        "average": {"col": "v", "op": "mean"},
        "count": {"col": "v", "op": "count"},
    })
    x := df.iloc(grouped, 0)
    y := df.iloc(grouped, 1)
    test.eq(x.total, 1)
    test.eq(x.average, 1)
    test.eq(x.count, 1)
    test.eq(y.total, 0)
    test.is_null(y.average)
    test.eq(y.count, 0)
}

fn test_describe_uses_sample_std {
    t := _columns({"x": [1, 2, 3]})
    d := df.describe(t, "x")
    test.approx(d.std, 1.0, 1e-6)
}

fn test_corr_uses_pairwise_rows {
    t := df.from_rows([
        {"a": 1, "b": 10},
        {"a": 2, "b": null},
        {"a": null, "b": 30},
        {"a": 4, "b": 40},
    ])
    test.approx(df.corr(t, "a", "b"), 1.0, 1e-6)
}

fn test_join_suffixes_and_outer_merge {
    left := df.from_rows([{"id": 1, "value": "left"}])
    right := df.from_rows([{"id": 1, "value": "right"}])
    joined := df.join(left, right, "id", "inner")
    test.eq(df.iloc(joined, 0).value, "left")
    test.eq(df.iloc(joined, 0).value_right, "right")

    users := df.from_rows([{"user_id": 1, "name": "A"}])
    orders := df.from_rows([{"order_user": 2, "total": 9}])
    merged := df.merge(users, orders, "user_id", "order_user", "outer")
    test.eq(df.nrows(merged), 2)
    test.eq(df.iloc(merged, 1).user_id, 2)
    test.eq(df.iloc(merged, 1).total, 9)
}

fn test_typed_duplicate_keys {
    t := df.from_rows([{"v": 1}, {"v": "1"}, {"v": "a|b"}, {"v": "a|b"}])
    unique := df.drop_duplicates(t, ["v"])
    test.eq(df.nrows(unique), 3)
    counts := df.value_counts(t, "v")
    test.eq(counts["1"], 1)
    test.eq(counts["1 (str)"], 1)
}

fn test_pivot_rejects_duplicate_pairs {
    t := df.from_rows([
        {"i": "a", "p": "x", "v": 1},
        {"i": "a", "p": "x", "v": 2},
    ])
    result := df.pivot(t, "i", "p", "v")
    test.is_false(result.ok)
}

fn test_sampling_seed_and_shuffle {
    t := _columns({"id": [0, 1, 2, 3, 4]})
    a := df.sample(t, 3, 77)
    b := df.sample(t, 3, 77)
    test.eq(df.col(a, "id"), df.col(b, "id"))
    shuffled := df.shuffle(t)
    test.eq(df.nrows(shuffled), 5)
    test.eq(df.ncols(shuffled), 1)
    zero := df.sample(t, 0, 77)
    test.eq(df.columns(zero), ["id"])
    too_many := df.sample(t, 6, 77)
    test.is_false(too_many.ok)
}

fn test_rolling_and_cumsum_preserve_nulls {
    t := df.from_rows([{"x": 1}, {"x": null}, {"x": 3}])
    r := df.rolling(t, "x", 2, "mean")
    test.eq(df.col(r, "x"), [null, null, null])
    c := df.cumsum_(t, "x")
    test.eq(df.col(c, "x"), [1.0, null, 4.0])
    bad := df.rolling(t, "x", 0, "mean")
    test.is_false(bad.ok)
}

fn test_rank_averages_ties_and_apply_adds_column {
    t := _columns({"x": [30, 10, 10]})
    ranked := df.rank(t, "x")
    test.eq(df.col(ranked, "x_rank"), [3.0, 1.5, 1.5])
    added := df.apply_(t, "new", fn(v) { 1 })
    test.is_true(contains(df.columns(added), "new"))
}

fn test_100k_row_frame_operations {
    let mut values = []
    let mut i = 0
    while i < 100000 {
        values = push(values, 100000 - i)
        i = i + 1
    }
    t := _columns({"value": values})
    test.eq(df.nrows(t), 100000)
    filtered := df.filter_(t, fn(row) { row.value <= 100 })
    test.eq(df.nrows(filtered), 100)
    preview := df.head(t, 5)
    test.eq(df.nrows(preview), 5)
}

fn test_group_by_transform {
    t := _sample_df()
    g := df.group_by_transform(t, "dept", "salary", "sum")
    test.eq(df.nrows(g), 5)
    // eng salaries 90000+75000+95000=260000
    eng := df.filter_(g, fn(r) { r.dept == "eng" })
    test.eq(df.col(eng, "salary")[0], 260000)
    idxed := df.set_index(t, "name", null)
    g2 := df.group_by_transform(idxed, "dept", "age", "mean")
    test.eq(df.index(g2), df.index(idxed))
}

fn test_group_by_size {
    t := _sample_df()
    s := df.group_by_size(t, "dept")
    test.eq(df.nrows(s), 2)
    sizes := df.col(s, "size")
    test.is_true(contains(sizes, 3) && contains(sizes, 2))
}

fn test_swaplevel_and_droplevel {
    t := _sample_df()
    multi := df.set_multi_index(t, ["dept", "name"], null)
    test.eq(df.index_nlevels(multi), 2)
    sw := df.swaplevel(multi, 0, 1)
    test.eq(df.index_levels(sw), ["name", "dept"])
    lab0 := df.index(sw)[0]
    test.eq(lab0[0], "Alice")
    test.eq(lab0[1], "eng")
    d1 := df.droplevel(multi, 0)
    test.eq(df.index_nlevels(d1), 1)
    test.eq(df.index(d1)[0], "Alice")
}

// === Multi-column group_by ===

fn test_group_by_multi_key_basic {
    t := df.from_rows([
        {"dept": "eng", "loc": "sf", "salary": 100, "age": 30},
        {"dept": "eng", "loc": "sf", "salary": 200, "age": 40},
        {"dept": "eng", "loc": "ny", "salary": 300, "age": 50},
        {"dept": "sales", "loc": "sf", "salary": 400, "age": 60},
    ])
    g := df.group_by(t, ["dept", "loc"], {"salary": ["sum", "mean", "count"], "age": "max"})
    test.eq(df.nrows(g), 3)
    test.eq(df.columns(g), ["dept", "loc", "salary_sum", "salary_mean", "salary_count", "age_max"])
    r0 := df.iloc(g, 0)
    test.eq(r0.dept, "eng")
    test.eq(r0.loc, "sf")
    test.eq(r0.salary_sum, 300)
    test.approx(r0.salary_mean, 150.0, 1e-9)
    test.eq(r0.salary_count, 2)
    test.eq(r0.age_max, 40)
    r2 := df.iloc(g, 2)
    test.eq(r2.dept, "sales")
    test.eq(r2.salary_sum, 400)
}

fn test_group_by_multi_key_still_supports_named_aggs {
    t := _sample_df()
    g := df.group_by(t, ["dept"], {
        "total": {"col": "salary", "op": "sum"},
        "n": {"col": "name", "op": "count"},
    })
    test.eq(df.columns(g), ["dept", "total", "n"])
    eng := df.filter_(g, fn(r) { r.dept == "eng" })
    test.eq(df.iloc(eng, 0).total, 260000)
    test.eq(df.iloc(eng, 0).n, 3)
}

// Adversarial: composite-key encoding must not collide for keys containing
// separators, JSON metacharacters, or type-punning values.
fn test_group_by_multi_key_encoding_no_collisions {
    t := df.from_rows([
        {"k1": "a", "k2": "b|c", "v": 1},
        {"k1": "a|b", "k2": "c", "v": 2},
        {"k1": "a\u001fb", "k2": "c", "v": 4},
        {"k1": "a", "k2": "b\u001fc", "v": 8},
        {"k1": "[\"a\", \"b\"]", "k2": "c", "v": 16},
        {"k1": 1, "k2": "x", "v": 32},
        {"k1": "1", "k2": "x", "v": 64},
        {"k1": null, "k2": "x", "v": 128},
        {"k1": "null", "k2": "x", "v": 256},
    ])
    g := df.group_by(t, ["k1", "k2"], {"v": ["sum", "count"]})
    // Every row is a distinct composite key: 9 groups, each count 1.
    test.eq(df.nrows(g), 9)
    test.eq(df.col(g, "v_count"), [1, 1, 1, 1, 1, 1, 1, 1, 1])
    // int 1 and str "1" are different groups, in first-seen order.
    test.eq(df.iloc(g, 5).k1, 1)
    test.eq(df.iloc(g, 6).k1, "1")
    // null key component is preserved as null, not the string "null".
    test.eq(df.iloc(g, 7).k1, null)
    test.eq(df.iloc(g, 8).k1, "null")
}

fn test_group_by_all_null_key_column {
    t := df.from_rows([
        {"k": null, "v": 10},
        {"k": null, "v": 20},
        {"k": null, "v": null},
    ])
    g := df.group_by(t, "k", {"v": ["sum", "count", "mean"]})
    test.eq(df.nrows(g), 1)
    r := df.iloc(g, 0)
    test.eq(r.k, null)
    test.eq(r.v_sum, 30)
    test.eq(r.v_count, 2)
    test.approx(r.v_mean, 15.0, 1e-9)
}

fn test_group_by_empty_frame {
    t := df.empty(["k", "v"])
    g := df.group_by(t, ["k"], {"v": ["sum"]})
    test.eq(df.nrows(g), 0)
    test.eq(df.columns(g), ["k", "v_sum"])
}

fn test_group_by_single_row_groups_and_null_aggs {
    t := df.from_rows([
        {"k": "a", "v": null},
        {"k": "b", "v": 7},
    ])
    g := df.group_by(t, "k", {"v": ["sum", "mean", "count", "std"]})
    test.eq(df.nrows(g), 2)
    ra := df.iloc(g, 0)
    // All-null group: sum is 0, count is 0, mean/std are null (documented _agg semantics).
    test.eq(ra.v_sum, 0)
    test.eq(ra.v_count, 0)
    test.eq(ra.v_mean, null)
    test.eq(ra.v_std, null)
    rb := df.iloc(g, 1)
    test.eq(rb.v_sum, 7)
    test.eq(rb.v_count, 1)
    test.eq(rb.v_std, null)
}

fn test_group_by_multi_key_errors {
    t := _sample_df()
    missing := df.group_by(t, ["dept", "nope"], {"salary": ["sum"]})
    test.is_false(missing.ok)
    empty_keys := df.group_by(t, [], {"salary": ["sum"]})
    test.is_false(empty_keys.ok)
    bad_op := df.group_by(t, ["dept"], {"salary": ["sum", "median"]})
    test.is_false(bad_op.ok)
    bad_col := df.group_by(t, ["dept"], {"nope": ["sum"]})
    test.is_false(bad_col.ok)
    bad_spec := df.group_by(t, ["dept"], {"salary": 42})
    test.is_false(bad_spec.ok)
}

// === pivot_table ===

fn _pivot_dupes_df {
    df.from_rows([
        {"i": "a", "p": "x", "v": 1},
        {"i": "a", "p": "x", "v": 3},
        {"i": "a", "p": "x", "v": 2},
        {"i": "a", "p": "x", "v": 4},
        {"i": "a", "p": "y", "v": 10},
        {"i": "b", "p": "x", "v": 5},
    ])
}

fn test_pivot_table_aggregates_duplicates {
    t := _pivot_dupes_df()
    s := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "sum"})
    test.eq(df.nrows(s), 2)
    test.eq(df.columns(s), ["i", "x", "y"])
    ra := df.iloc(s, 0)
    test.eq(ra.x, 10)
    test.eq(ra.y, 10)
    rb := df.iloc(s, 1)
    test.eq(rb.x, 5)
    test.eq(rb.y, null)

    m := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "mean"})
    test.approx(df.iloc(m, 0).x, 2.5, 1e-9)
    c := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "count"})
    test.eq(df.iloc(c, 0).x, 4)
    test.eq(df.iloc(c, 1).x, 1)
    mn := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "min"})
    test.eq(df.iloc(mn, 0).x, 1)
    mx := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "max"})
    test.eq(df.iloc(mx, 0).x, 4)
    // default aggfunc is mean
    d := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v"})
    test.approx(df.iloc(d, 0).y, 10.0, 1e-9)
}

fn test_pivot_table_fill_value {
    t := _pivot_dupes_df()
    s := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "sum", "fill_value": 0})
    test.eq(df.iloc(s, 1).y, 0)
    // fill_value applies only to missing cells, not to real aggregates
    test.eq(df.iloc(s, 0).x, 10)
}

fn test_pivot_table_multi_index {
    t := df.from_rows([
        {"i": "a", "q": 1, "p": "x", "v": 5},
        {"i": "a", "q": 1, "p": "x", "v": 7},
        {"i": "a", "q": 2, "p": "x", "v": 100},
    ])
    s := df.pivot_table(t, {"index": ["i", "q"], "columns": "p", "values": "v", "aggfunc": "sum"})
    test.eq(df.nrows(s), 2)
    test.eq(df.columns(s), ["i", "q", "x"])
    test.eq(df.iloc(s, 0).x, 12)
    test.eq(df.iloc(s, 1).x, 100)
}

// Adversarial: index/column values containing separator characters must not
// collapse into one cell.
fn test_pivot_table_separator_values_no_collision {
    t := df.from_rows([
        {"i": "a|x", "p": "y", "v": 1},
        {"i": "a", "p": "x|y", "v": 2},
    ])
    s := df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "sum"})
    test.eq(df.nrows(s), 2)
    test.eq(df.columns(s), ["i", "y", "x|y"])
    test.eq(df.iloc(s, 0).y, 1)
    row0 := df.iloc(s, 0)
    row1 := df.iloc(s, 1)
    test.eq(row0["x|y"], null)
    test.eq(row1["x|y"], 2)
}

fn test_pivot_separator_values_no_false_duplicate {
    t := df.from_rows([
        {"i": "a\u001fx", "p": "y", "v": 1},
        {"i": "a", "p": "x\u001fy", "v": 2},
    ])
    p := df.pivot(t, "i", "p", "v")
    test.eq(df.nrows(p), 2)
}

fn test_pivot_table_empty_and_errors {
    e := df.empty(["i", "p", "v"])
    s := df.pivot_table(e, {"index": "i", "columns": "p", "values": "v", "aggfunc": "sum"})
    test.eq(df.nrows(s), 0)
    test.eq(df.columns(s), ["i"])

    t := _pivot_dupes_df()
    test.is_false(df.pivot_table(t, {"index": "i", "columns": "p", "values": "v", "aggfunc": "median"}).ok)
    test.is_false(df.pivot_table(t, {"index": "i", "columns": "p"}).ok)
    test.is_false(df.pivot_table(t, {"index": "nope", "columns": "p", "values": "v"}).ok)
    test.is_false(df.pivot_table(t, {"index": [], "columns": "p", "values": "v"}).ok)
    test.is_false(df.pivot_table(t, "nope").ok)
}

// === rank methods ===

fn _rank_ties_df {
    _columns({"x": [30, 10, 10, 20]})
}

fn test_rank_methods_on_ties {
    t := _rank_ties_df()
    avg := df.rank_opts(t, "x", {"method": "average"})
    test.eq(df.col(avg, "x_rank"), [4.0, 1.5, 1.5, 3.0])
    mn := df.rank_opts(t, "x", {"method": "min"})
    test.eq(df.col(mn, "x_rank"), [4, 1, 1, 3])
    mx := df.rank_opts(t, "x", {"method": "max"})
    test.eq(df.col(mx, "x_rank"), [4, 2, 2, 3])
    dense := df.rank_opts(t, "x", {"method": "dense"})
    test.eq(df.col(dense, "x_rank"), [3, 1, 1, 2])
    first := df.rank_opts(t, "x", {"method": "first"})
    test.eq(df.col(first, "x_rank"), [4, 1, 2, 3])
}

fn test_rank_descending {
    t := _rank_ties_df()
    desc := df.rank_opts(t, "x", {"ascending": false})
    test.eq(df.col(desc, "x_rank"), [1.0, 3.5, 3.5, 2.0])
    ddense := df.rank_opts(t, "x", {"method": "dense", "ascending": false})
    test.eq(df.col(ddense, "x_rank"), [1, 3, 3, 2])
    dfirst := df.rank_opts(t, "x", {"method": "first", "ascending": false})
    test.eq(df.col(dfirst, "x_rank"), [1, 3, 4, 2])
}

fn test_rank_na_options {
    t := _columns({"x": [30, 10, null, 10]})
    keep := df.rank_opts(t, "x", null)
    test.eq(df.col(keep, "x_rank"), [3.0, 1.5, null, 1.5])
    top := df.rank_opts(t, "x", {"method": "min", "na_option": "top"})
    test.eq(df.col(top, "x_rank"), [4, 2, 1, 2])
    bottom := df.rank_opts(t, "x", {"method": "min", "na_option": "bottom"})
    test.eq(df.col(bottom, "x_rank"), [3, 1, 4, 1])
    // nulls ranked as a tie group honour method "first" in row order
    t2 := _columns({"x": [null, 5, null]})
    top2 := df.rank_opts(t2, "x", {"method": "first", "na_option": "top"})
    test.eq(df.col(top2, "x_rank"), [1, 3, 2])
}

fn test_rank_pct {
    t := _columns({"x": [30, 10, null, 10]})
    pct := df.rank_opts(t, "x", {"pct": true})
    test.eq(df.col(pct, "x_rank"), [1.0, 0.5, null, 0.5])
    ptop := df.rank_opts(t, "x", {"method": "min", "na_option": "top", "pct": true})
    test.eq(df.col(ptop, "x_rank"), [1.0, 0.5, 0.25, 0.5])
}

fn test_rank_empty_and_all_null {
    e := df.empty(["x"])
    r := df.rank_opts(e, "x", {"method": "dense"})
    test.eq(df.nrows(r), 0)
    test.eq(df.columns(r), ["x", "x_rank"])

    allnull := _columns({"x": [null, null]})
    k := df.rank_opts(allnull, "x", null)
    test.eq(df.col(k, "x_rank"), [null, null])
    tp := df.rank_opts(allnull, "x", {"method": "first", "na_option": "top"})
    test.eq(df.col(tp, "x_rank"), [1, 2])
    bt := df.rank_opts(allnull, "x", {"method": "min", "na_option": "bottom"})
    test.eq(df.col(bt, "x_rank"), [1, 1])
}

fn test_rank_errors {
    t := _rank_ties_df()
    test.is_false(df.rank_opts(t, "nope", null).ok)
    test.is_false(df.rank_opts(t, "x", {"method": "median"}).ok)
    test.is_false(df.rank_opts(t, "x", {"na_option": "drop"}).ok)
    test.is_false(df.rank_opts(t, "x", "nope").ok)
    // default two-arg form still works and matches average/keep
    d := df.rank(t, "x")
    test.eq(df.col(d, "x_rank"), [4.0, 1.5, 1.5, 3.0])
}

// === multi-key merge ===

fn test_merge_multi_key_basic {
    left := df.from_rows([
        {"a": 1, "b": "x", "lv": 10},
        {"a": 1, "b": "y", "lv": 20},
        {"a": 2, "b": "x", "lv": 30},
    ])
    right := df.from_rows([
        {"a": 1, "b": "x", "rv": 100},
        {"a": 2, "b": "x", "rv": 200},
        {"a": 2, "b": "x", "rv": 300},
    ])
    m := df.merge(left, right, ["a", "b"], ["a", "b"], "inner")
    test.eq(df.nrows(m), 3)
    test.eq(df.col(m, "lv"), [10, 30, 30])
    test.eq(df.col(m, "rv"), [100, 200, 300])
    // composite key: (1,"x") must NOT match (1,"y")
    no_match := df.merge(left, right, ["a", "b"], ["a", "b"], "inner")
    test.is_true(contains(df.col(no_match, "rv"), 100))
}

fn test_merge_multi_key_types_and_nulls {
    left := df.from_rows([
        {"a": 1, "b": "x", "lv": 1},
        {"a": "1", "b": "x", "lv": 2},
        {"a": null, "b": "x", "lv": 3},
        {"a": "a|b", "b": "c", "lv": 4},
        {"a": "a", "b": "b|c", "lv": 5},
    ])
    right := df.from_rows([
        {"a": 1, "b": "x", "rv": 10},
        {"a": "1", "b": "x", "rv": 20},
        {"a": null, "b": "x", "rv": 30},
        {"a": "a", "b": "b|c", "rv": 50},
    ])
    m := df.merge(left, right, ["a", "b"], ["a", "b"], "inner")
    test.eq(df.nrows(m), 4)
    // int 1 joins only to int 1; "1" only to "1"; null matches null (pandas-style)
    test.eq(df.col(m, "lv"), [1, 2, 3, 5])
    test.eq(df.col(m, "rv"), [10, 20, 30, 50])
    // separator-bearing composite keys do not collide: ("a|b","c") is unmatched
    test.is_true(!contains(df.col(m, "lv"), 4))
}

fn test_merge_multi_key_outer_and_left {
    left := df.from_rows([{"a": 1, "b": 1, "lv": 10}, {"a": 2, "b": 2, "lv": 20}])
    right := df.from_rows([{"a": 1, "b": 1, "rv": 100}, {"a": 3, "b": 3, "rv": 300}])
    o := df.merge(left, right, ["a", "b"], ["a", "b"], "outer")
    test.eq(df.nrows(o), 3)
    test.eq(df.col(o, "lv"), [10, 20, null])
    test.eq(df.col(o, "rv"), [100, null, 300])
    // unmatched right row fills the left key columns
    test.eq(df.iloc(o, 2).a, 3)
    test.eq(df.iloc(o, 2).b, 3)
    l := df.merge(left, right, ["a", "b"], ["a", "b"], "left")
    test.eq(df.nrows(l), 2)
    test.eq(df.iloc(l, 1).rv, null)
}

fn test_merge_suffixes {
    left := df.from_rows([{"id": 1, "value": "L", "uniq_l": 0}])
    right := df.from_rows([{"id": 1, "value": "R", "uniq_r": 0}])
    m := df.merge_opts(left, right, "id", "id", "inner", {"suffixes": ["_x", "_y"]})
    test.eq(df.columns(m), ["id", "value_x", "uniq_l", "value_y", "uniq_r"])
    test.eq(df.iloc(m, 0).value_x, "L")
    test.eq(df.iloc(m, 0).value_y, "R")
    // multi-key + suffixes: key columns are never suffixed
    left2 := df.from_rows([{"a": 1, "b": 2, "value": "L"}])
    right2 := df.from_rows([{"a": 1, "b": 2, "value": "R"}])
    m2 := df.merge_opts(left2, right2, ["a", "b"], ["a", "b"], "inner", {"suffixes": ["_l", "_r"]})
    test.eq(df.columns(m2), ["a", "b", "value_l", "value_r"])
    // default (no opts) keeps the historical "_right" behaviour
    d := df.merge(left, right, "id", "id", "inner")
    test.eq(df.columns(d), ["id", "value", "uniq_l", "value_right", "uniq_r"])
}

fn test_merge_multi_key_errors {
    left := df.from_rows([{"a": 1, "b": 1}])
    right := df.from_rows([{"a": 1, "b": 1}])
    test.is_false(df.merge(left, right, ["a", "b"], ["a"], "inner").ok)
    test.is_false(df.merge(left, right, ["a", "nope"], ["a", "b"], "inner").ok)
    test.is_false(df.merge(left, right, [], [], "inner").ok)
    test.is_false(df.merge(left, right, "a", "a", "right").ok)
    test.is_false(df.merge_opts(left, right, "a", "a", "inner", {"suffixes": ["_x"]}).ok)
    test.is_false(df.merge_opts(left, right, "a", "a", "inner", "nope").ok)
}

fn test_merge_empty_frames {
    left := df.empty(["a", "b", "lv"])
    right := df.from_rows([{"a": 1, "b": 1, "rv": 100}])
    inner := df.merge(left, right, ["a", "b"], ["a", "b"], "inner")
    test.eq(df.nrows(inner), 0)
    test.eq(df.columns(inner), ["a", "b", "lv", "rv"])
    outer := df.merge(left, right, ["a", "b"], ["a", "b"], "outer")
    test.eq(df.nrows(outer), 1)
    test.eq(df.iloc(outer, 0).lv, null)
    test.eq(df.iloc(outer, 0).rv, 100)
    both := df.merge(left, df.empty(["a", "b", "rv"]), ["a", "b"], ["a", "b"], "outer")
    test.eq(df.nrows(both), 0)
}
