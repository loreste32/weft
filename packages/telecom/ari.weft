// ──────────────────────────────────────────────
// Events
// ──────────────────────────────────────────────

pub fn events_url(client) { client.ws_url }

pub fn listen(client, handler) -> Result[any] {
    say("ARI connecting to ${client.ws_url}")
    ws_conn := ws.connect(client.ws_url)?
    while true {
        msg := ws_conn.recv()
        if !msg.ok {
            // Connection closed or errored — end the loop instead of hanging.
            break
        }
        event := json.parse(msg.value)
        if event.ok {
            handler(event.value)
        }
        // Malformed event JSON is skipped so one bad frame cannot kill the loop.
    }
    Ok(unit)
}

