pub fn connect(opts) {
    host := env.get("ASTERISK_HOST", "127.0.0.1")
    port := env.get("ASTERISK_ARI_PORT", "8088")
    username := env.get("ASTERISK_ARI_USER", "asterisk")
    password := env.get("ASTERISK_ARI_PASSWORD", "asterisk")
    app := "weft"
    if opts != null {
        if opts.host != null {
            host = opts.host
        }
        if opts.port != null {
            port = opts.port
        }
        if opts.username != null {
            username = opts.username
        }
        if opts.password != null {
            password = opts.password
        }
        if opts.app != null {
            app = opts.app
        }
    }
    {
        "base_url": "http://$host:$port/ari",
        "ws_url": "ws://$host:$port/ari/events?app=$app&api_key=$username:$password",
        "auth": base64.encode("$username:$password"),
        "app": app,
        "username": username,
    }
}


fn req(client, method, path, body) -> Result[any] {
    url := "${client.base_url}$path"
    headers := {
        "Authorization": "Basic ${client.auth}",
        "Content-Type": "application/json",
    }
    resp := http.fetch(url, {
        "method": method,
        "headers": headers,
        "body": if body != null { json.stringify(body) } else { null },
    })?
    if resp.status >= 400 {
        return Err("ARI $method $path: HTTP ${resp.status} ${resp.body}", "ari")
    }
    if resp.body != null && resp.body != "" { json.parse(resp.body) } else { Ok({}) }
}


fn get(client, path) -> Result[any] { req(client, "GET", path, null) }


fn post(client, path, body) -> Result[any] { req(client, "POST", path, body) }


fn del(client, path) -> Result[any] { req(client, "DELETE", path, null) }


pub fn channels(client) -> Result[any] { get(client, "/channels") }


pub fn channel(client, id) -> Result[any] { get(client, "/channels/$id") }


pub fn originate(client, endpoint, opts) -> Result[any] {
    body := {"endpoint": endpoint, "app": client.app}
    if opts != null {
        if opts.caller_id != null {
            body.callerId = opts.caller_id
        }
        if opts.context != null {
            body.context = opts.context
        }
        if opts.extension != null {
            body.extension = opts.extension
        }
        if opts.variables != null {
            body.variables = opts.variables
        }
    }
    post(client, "/channels", body)
}


pub fn answer_channel(client, id) -> Result[any] { post(client, "/channels/$id/answer", null) }


pub fn hangup_channel(client, id, reason) -> Result[any] {
    path := "/channels/$id"
    if reason != null {
        path = "$path?reason=$reason"
    }
    del(client, path)
}


pub fn play_channel(client, id, media, playback_id) -> Result[any] {
    path := "/channels/$id/play?media=$media"
    if playback_id != null {
        path = "$path&playbackId=$playback_id"
    }
    post(client, path, null)
}


pub fn record_channel(client, id, name, opts) -> Result[any] {
    path := "/channels/$id/record?name=$name"
    if opts != null {
        if opts.format != null {
            path = "$path&format=${opts.format}"
        }
        if opts.max_duration != null {
            path = "$path&maxDurationSeconds=${opts.max_duration}"
        }
        if opts.max_silence != null {
            path = "$path&maxSilenceSeconds=${opts.max_silence}"
        }
        if opts.beep != null {
            path = "$path&beep=${opts.beep}"
        }
        if opts.terminate_on != null {
            path = "$path&terminateOn=${opts.terminate_on}"
        }
    }
    post(client, path, null)
}


pub fn send_dtmf_channel(client, id, digits) -> Result[any] { post(client, "/channels/$id/dtmf?dtmf=$digits", null) }


pub fn hold(client, id) -> Result[any] { post(client, "/channels/$id/hold", null) }


pub fn unhold(client, id) -> Result[any] { del(client, "/channels/$id/hold") }


pub fn mute(client, id, direction) -> Result[any] {
    d := if direction != null { direction } else { "both" }
    post(client, "/channels/$id/mute?direction=$d", null)
}


pub fn unmute(client, id) -> Result[any] { del(client, "/channels/$id/mute") }


pub fn redirect_channel(client, id, endpoint) -> Result[any] { post(client, "/channels/$id/redirect?endpoint=$endpoint", null) }


pub fn set_variable(client, id, name, value) -> Result[any] { post(client, "/channels/$id/variable?variable=$name&value=$value", null) }


pub fn get_variable(client, id, name) -> Result[any] { get(client, "/channels/$id/variable?variable=$name") }


pub fn snoop(client, id, app_name, opts) -> Result[any] {
    path := "/channels/$id/snoop?app=$app_name&spy=both"
    if opts != null {
        if opts.whisper != null {
            path = "$path&whisper=${opts.whisper}"
        }
    }
    post(client, path, null)
}


pub fn create_bridge(client, bridge_kind) -> Result[any] {
    bk := if bridge_kind != null { bridge_kind } else { "mixing" }
    post(client, "/bridges?type=$bk", null)
}


pub fn bridges(client) -> Result[any] { get(client, "/bridges") }


pub fn add_to_bridge(client, bridge_id, channel_ids) -> Result[any] {
    ids := channel_ids
    if len(channel_ids) > 0 && channel_ids[0] != null {
        ids = str.join(channel_ids, ",")
    }
    post(client, "/bridges/$bridge_id/addChannel?channel=$ids", null)
}


pub fn remove_from_bridge(client, bridge_id, channel_id) -> Result[any] { post(client, "/bridges/$bridge_id/removeChannel?channel=$channel_id", null) }


pub fn destroy_bridge(client, bridge_id) -> Result[any] { del(client, "/bridges/$bridge_id") }


pub fn play_bridge(client, bridge_id, media) -> Result[any] { post(client, "/bridges/$bridge_id/play?media=$media", null) }


pub fn stop_playback(client, playback_id) -> Result[any] { del(client, "/playbacks/$playback_id") }


pub fn control_playback(client, playback_id, operation) -> Result[any] { post(client, "/playbacks/$playback_id/control?operation=$operation", null) }


pub fn recordings(client) -> Result[any] { get(client, "/recordings/stored") }


pub fn stop_recording(client, name) -> Result[any] { post(client, "/recordings/live/$name/stop", null) }


pub fn delete_recording(client, name) -> Result[any] { del(client, "/recordings/stored/$name") }


pub fn endpoints(client) -> Result[any] { get(client, "/endpoints") }


pub fn endpoint(client, tech, resource) -> Result[any] { get(client, "/endpoints/$tech/$resource") }


pub fn sounds(client) -> Result[any] { get(client, "/sounds") }


pub fn events_url(client) { client.ws_url }


pub fn listen(client, handler) -> Result[any] {
    say("ARI connecting to ${client.ws_url}")
    ws_conn := ws.connect(client.ws_url)?
    while true {
        msg := ws_conn.read()?
        if msg == null {
            break
        }
        event := json.parse(msg)?
        handler(event)
    }
    Ok(unit)
}

