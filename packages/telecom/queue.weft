pub fn create(name, opts) {
    q := {
        "name": name,
        "calls": [],
        "max_wait_sec": 600,
        "max_size": 100,
        "music_url": null,
        "announce_position": true,
        "announce_interval": 30,
        "priority_levels": 3,
        "overflow_action": "voicemail",
        "stats": {
            "total_enqueued": 0,
            "total_dequeued": 0,
            "total_abandoned": 0,
            "total_wait_sec": 0,
        },
    }
    if opts != null {
        if opts.max_wait_sec != null {
            q.max_wait_sec = opts.max_wait_sec
        }
        if opts.max_size != null {
            q.max_size = opts.max_size
        }
        if opts.music_url != null {
            q.music_url = opts.music_url
        }
        if opts.announce_position != null {
            q.announce_position = opts.announce_position
        }
        if opts.announce_interval != null {
            q.announce_interval = opts.announce_interval
        }
        if opts.priority_levels != null {
            q.priority_levels = opts.priority_levels
        }
        if opts.overflow_action != null {
            q.overflow_action = opts.overflow_action
        }
    }
    q
}


pub fn add(q, call_id, opts) {
    if len(q.calls) >= q.max_size {
        return {"overflow": true, "action": q.overflow_action}
    }
    priority := 1
    caller_id := ""
    skill_tags := []
    data := {}
    if opts != null {
        if opts.priority != null {
            priority = opts.priority
        }
        if opts.caller_id != null {
            caller_id = opts.caller_id
        }
        if opts.skill_tags != null {
            skill_tags = opts.skill_tags
        }
        if opts.data != null {
            data = opts.data
        }
    }
    entry := {
        "call_id": call_id,
        "enqueued_at": time.now(),
        "priority": priority,
        "caller_id": caller_id,
        "skill_tags": skill_tags,
        "data": data,
    }
    mut inserted := false
    mut i := 0
    while i < len(q.calls) {
        if q.calls[i].priority < priority {
            mut new_calls := []
            mut j := 0
            while j < len(q.calls) {
                if j == i && !inserted {
                    push(new_calls, entry)
                    inserted = true
                }
                push(new_calls, q.calls[j])
                j = j + 1
            }
            q.calls = new_calls
            inserted = true
            i = len(q.calls)
        }
        i = i + 1
    }
    if !inserted { push(q.calls, entry) }
    q.stats.total_enqueued = q.stats.total_enqueued + 1
    pos := position(q, call_id)
    {
        "position": pos,
        "estimated_wait_sec": pos * 60,
        "overflow": false,
    }
}


pub fn next(q) {
    if len(q.calls) == 0 {
        return null
    }
    entry := q.calls[0]
    q.calls = slice(q.calls, 1)
    wait := time.now() - entry.enqueued_at
    q.stats.total_dequeued = q.stats.total_dequeued + 1
    q.stats.total_wait_sec = q.stats.total_wait_sec + wait
    entry.wait_sec = wait
    entry
}


pub fn remove(q, call_id) {
    mut new_calls := []
    mut found := false
    for c in q.calls {
        if c.call_id == call_id {
            found = true
            q.stats.total_abandoned = q.stats.total_abandoned + 1
        } else { push(new_calls, c) }
    }
    q.calls = new_calls
    found
}


pub fn position(q, call_id) {
    mut i := 0
    for c in q.calls {
        i = i + 1
        if c.call_id == call_id {
            return i
        }
    }
    0
}


pub fn stats(q) {
    avg_wait := 0
    if q.stats.total_dequeued > 0 {
        avg_wait = q.stats.total_wait_sec / q.stats.total_dequeued
    }
    longest := 0
    now := time.now()
    for c in q.calls {
        w := now - c.enqueued_at
        if w > longest {
            longest = w
        }
    }
    {
        "name": q.name,
        "size": len(q.calls),
        "total_enqueued": q.stats.total_enqueued,
        "total_dequeued": q.stats.total_dequeued,
        "total_abandoned": q.stats.total_abandoned,
        "avg_wait_sec": avg_wait,
        "longest_wait_sec": longest,
    }
}


pub fn for_skill(q, skill) {
    mut result := []
    for c in q.calls {
        for s in c.skill_tags {
            if s == skill { push(result, c) }
        }
    }
    result
}


pub fn announce(q, call_id) {
    pos := position(q, call_id)
    if pos == 0 {
        return {"text": "You are not currently in the queue."}
    }
    if pos == 1 {
        return {
            "text": "You are next in line. An agent will be with you shortly.",
        }
    }
    wait := pos * 60
    mins := int(wait / 60)
    {"text": "You are currently number $pos in the queue. Estimated wait time is approximately $mins minutes. Thank you for your patience."}
}

