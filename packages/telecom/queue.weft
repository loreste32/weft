// Call queue with priority, overflow, agent state, estimated wait, and callbacks.

pub fn create(name, opts) {
    q := {
        "name": name,
        "calls": [],
        "agents": [],
        "max_wait_sec": 600,
        "max_size": 100,
        "music_url": null,
        "announce_position": true,
        "announce_interval": 30,
        "overflow_action": "voicemail",
        "stats": {
            "total_enqueued": 0,
            "total_dequeued": 0,
            "total_abandoned": 0,
            "total_wait_sec": 0,
        },
    }
    if opts != null {
        if contains(keys(opts), "max_wait_sec") { q.max_wait_sec = opts.max_wait_sec }
        if contains(keys(opts), "max_size") { q.max_size = opts.max_size }
        if contains(keys(opts), "music_url") { q.music_url = opts.music_url }
        if contains(keys(opts), "announce_position") { q.announce_position = opts.announce_position }
        if contains(keys(opts), "announce_interval") { q.announce_interval = opts.announce_interval }
        if contains(keys(opts), "overflow_action") { q.overflow_action = opts.overflow_action }
    }
    q
}

pub fn add(q, call_id, opts) {
    if len(q.calls) >= q.max_size {
        return {"overflow": true, "action": q.overflow_action, "position": 0}
    }
    let mut priority = 1
    let mut caller_id = ""
    let mut skill_tags = []
    let mut data = {}
    let mut callback = null
    if opts != null {
        if contains(keys(opts), "priority") { priority = opts.priority }
        if contains(keys(opts), "caller_id") { caller_id = opts.caller_id }
        if contains(keys(opts), "skill_tags") { skill_tags = opts.skill_tags }
        if contains(keys(opts), "data") { data = opts.data }
        if contains(keys(opts), "callback") { callback = opts.callback }
    }
    entry := {
        "call_id": call_id,
        "enqueued_at": time.now(),
        "priority": priority,
        "caller_id": caller_id,
        "skill_tags": skill_tags,
        "data": data,
        "callback": callback,
    }
    // Insert by priority (higher priority first)
    let mut inserted = false
    let mut new_calls = []
    let mut i = 0
    while i < len(q.calls) {
        if !inserted && q.calls[i].priority < priority {
            new_calls = push(new_calls, entry)
            inserted = true
        }
        new_calls = push(new_calls, q.calls[i])
        i = i + 1
    }
    if !inserted { new_calls = push(new_calls, entry) }
    q.calls = new_calls
    q.stats.total_enqueued = q.stats.total_enqueued + 1
    pos := position(q, call_id)
    {
        "position": pos,
        "estimated_wait_sec": estimated_wait(q, call_id),
        "overflow": false,
    }
}

pub fn next(q) {
    if len(q.calls) == 0 { return null }
    entry := q.calls[0]
    q.calls = slice(q.calls, 1)
    wait := time.now() - entry.enqueued_at
    q.stats.total_dequeued = q.stats.total_dequeued + 1
    q.stats.total_wait_sec = q.stats.total_wait_sec + wait
    entry.wait_sec = wait
    entry
}

pub fn remove(q, call_id) {
    let mut new_calls = []
    let mut found = false
    for c in q.calls {
        if c.call_id == call_id {
            found = true
            q.stats.total_abandoned = q.stats.total_abandoned + 1
        } else {
            new_calls = push(new_calls, c)
        }
    }
    q.calls = new_calls
    found
}

pub fn position(q, call_id) {
    let mut i = 0
    for c in q.calls {
        i = i + 1
        if c.call_id == call_id { return i }
    }
    0
}

pub fn estimated_wait(q, call_id) {
    pos := position(q, call_id)
    if pos == 0 { return 0 }
    avg := if q.stats.total_dequeued > 0 {
        q.stats.total_wait_sec / q.stats.total_dequeued
    } else { 60 }
    available := len(filter(q.agents, fn(a) { a.state == "available" }))
    if available > 0 { pos * avg / available } else { pos * avg }
}

pub fn stats(q) {
    let mut avg_wait = 0
    if q.stats.total_dequeued > 0 {
        avg_wait = q.stats.total_wait_sec / q.stats.total_dequeued
    }
    let mut longest = 0
    now := time.now()
    for c in q.calls {
        w := now - c.enqueued_at
        if w > longest { longest = w }
    }
    available := len(filter(q.agents, fn(a) { a.state == "available" }))
    {
        "name": q.name,
        "size": len(q.calls),
        "agents_total": len(q.agents),
        "agents_available": available,
        "total_enqueued": q.stats.total_enqueued,
        "total_dequeued": q.stats.total_dequeued,
        "total_abandoned": q.stats.total_abandoned,
        "avg_wait_sec": avg_wait,
        "longest_wait_sec": longest,
    }
}

pub fn for_skill(q, skill) {
    filter(q.calls, fn(c) {
        contains(c.skill_tags, skill)
    })
}

// ── Agent management ──

pub fn add_agent(q, agent_id, opts) {
    let mut skills = []
    if opts != null && contains(keys(opts), "skills") { skills = opts.skills }
    q.agents = push(q.agents, {
        "id": agent_id, "state": "available", "skills": skills,
        "calls_handled": 0, "last_call_at": null,
    })
}

pub fn set_agent_state(q, agent_id, state) {
    let mut i = 0
    while i < len(q.agents) {
        if q.agents[i].id == agent_id {
            q.agents[i].state = state
        }
        i = i + 1
    }
}

pub fn agent_complete(q, agent_id) {
    let mut i = 0
    while i < len(q.agents) {
        if q.agents[i].id == agent_id {
            q.agents[i].state = "available"
            q.agents[i].calls_handled = q.agents[i].calls_handled + 1
            q.agents[i].last_call_at = time.now()
        }
        i = i + 1
    }
}

pub fn next_agent(q, required_skill) {
    let mut best = null
    let mut i = 0
    while i < len(q.agents) {
        agent := q.agents[i]
        if agent.state == "available" {
            if required_skill != null {
                if !contains(agent.skills, required_skill) {
                    i = i + 1
                    continue
                }
            }
            if best == null || agent.calls_handled < best.calls_handled {
                best = agent
            }
        }
        i = i + 1
    }
    best
}

// ── Announcements ──

pub fn announce(q, call_id) {
    pos := position(q, call_id)
    if pos == 0 {
        return {"text": "You are not currently in the queue.", "position": 0}
    }
    if pos == 1 {
        return {"text": "You are next in line. An agent will be with you shortly.", "position": 1}
    }
    wait := estimated_wait(q, call_id)
    mins := math.floor(wait / 60)
    {
        "text": "You are currently number " + ("" + pos) + " in the queue. Estimated wait time is approximately " + ("" + mins) + " minutes.",
        "position": pos,
        "estimated_wait_sec": wait,
    }
}
