pub fn menu(prompt_text, routes, opts) {
    let mut timeout = 5
    let mut max_digits = 1
    let mut retries = 3
    let mut invalid_msg = "Invalid selection. Please try again."
    if opts != null {
        if contains(keys(opts), "timeout") && opts.timeout != null {
            timeout = opts.timeout
        }
        if contains(keys(opts), "max_digits") && opts.max_digits != null {
            max_digits = opts.max_digits
        }
        if contains(keys(opts), "retries") && opts.retries != null {
            retries = opts.retries
        }
        if contains(keys(opts), "invalid_msg") && opts.invalid_msg != null {
            invalid_msg = opts.invalid_msg
        }
    }
    {
        "action": "dtmf_menu",
        "prompt": prompt_text,
        "routes": routes,
        "timeout": timeout,
        "max_digits": max_digits,
        "retries": retries,
        "invalid_msg": invalid_msg,
    }
}


pub fn collect(prompt_text, max_digits, opts) {
    let mut timeout = 10
    let mut finish_on_key = "#"
    if opts != null {
        if contains(keys(opts), "timeout") && opts.timeout != null {
            timeout = opts.timeout
        }
        if contains(keys(opts), "finish_on_key") && opts.finish_on_key != null {
            finish_on_key = opts.finish_on_key
        }
    }
    {
        "action": "gather",
        "kind": "dtmf",
        "prompt": {
            "action": "play",
            "src": prompt_text,
            "tts": true,
        },
        "max_digits": max_digits,
        "timeout": timeout,
        "finish_on_key": finish_on_key,
    }
}


pub fn confirm(prompt_text, opts) {
    let mut yes_key = "1"
    let mut no_key = "2"
    if opts != null {
        if contains(keys(opts), "yes_key") && opts.yes_key != null {
            yes_key = opts.yes_key
        }
        if contains(keys(opts), "no_key") && opts.no_key != null {
            no_key = opts.no_key
        }
    }
    full_prompt := "$prompt_text Press $yes_key to confirm, $no_key to cancel."
    menu(full_prompt, {
        "$yes_key": {"result": "confirmed"},
        "$no_key": {"result": "cancelled"},
    }, {"max_digits": 1})
}


pub fn route(digit, routes) {
    if routes[digit] != null {
        return routes[digit]
    }
    if routes["*"] != null {
        return routes["*"]
    }
    null
}

