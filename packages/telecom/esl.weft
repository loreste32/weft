// ESL — FreeSWITCH Event Socket Library client with proper frame parsing.
// Protocol: headers separated by \n, blank line between headers and body,
// Content-Length header determines body size.

// ──────────────────────────────────────────────
// Limits
// ──────────────────────────────────────────────

fn _max_header_size { 65536 }
fn _max_body_size { 10485760 }
fn _max_header_count { 128 }
fn _max_event_queue { 10000 }

// ──────────────────────────────────────────────
// Frame parser
// ──────────────────────────────────────────────

fn _find_delimiter(b) {
    // Check both \n\n and \r\n\r\n, return {idx, len} or null
    d1 := str.find(b, "\n\n")
    d2 := str.find(b, "\r\n\r\n")
    if d1 >= 0 && (d2 < 0 || d1 <= d2) {
        return {"idx": d1, "dlen": 2}
    }
    if d2 >= 0 {
        return {"idx": d2, "dlen": 4}
    }
    null
}

fn _read_until_delimiter(conn, buf) -> Result[any] {
    let mut b = buf
    while true {
        found := _find_delimiter(b)
        if found != null {
            before := str.slice(b, 0, found.idx)
            after := str.slice(b, found.idx + found.dlen)
            return Ok({"before": before, "after": after})
        }
        // Enforce header size limit DURING reads, not after
        ensure(len(b) <= _max_header_size(), "ESL: header block exceeds 64KB limit")?
        chunk := conn.read()?
        if chunk == "" || chunk == null {
            return Err("ESL: connection closed while reading")
        }
        b = b + chunk
    }
}

fn _parse_headers(raw) -> Result[any] {
    let mut headers = {}
    let mut count = 0
    lines := str.split(raw, "\n")
    for line in lines {
        trimmed := str.trim(line)
        if trimmed == "" { continue }
        count = count + 1
        ensure(count <= _max_header_count(), "ESL: too many headers")?
        idx := str.find(trimmed, ": ")
        if idx >= 0 {
            key := str.slice(trimmed, 0, idx)
            val := str.slice(trimmed, idx + 2)
            // Reject duplicate Content-Length
            if key == "Content-Length" && headers["Content-Length"] != null {
                return Err("ESL: duplicate Content-Length header")
            }
            headers[key] = val
        }
    }
    Ok(headers)
}

fn _parse_content_length(cl_str) -> Result[any] {
    // Strict integer parsing — reject floats, negatives, leading signs, non-numeric
    if cl_str == null || cl_str == "" { return Err("empty Content-Length") }
    trimmed := str.trim(cl_str)
    if len(trimmed) == 0 { return Err("empty Content-Length") }
    // Check each character is a digit
    let mut i = 0
    while i < len(trimmed) {
        ch := str.slice(trimmed, i, i + 1)
        if ch < "0" || ch > "9" {
            return Err("ESL: non-numeric Content-Length: " + trimmed)
        }
        i = i + 1
    }
    // Parse via json.parse (safe for digit-only strings)
    r := json.parse(trimmed)
    ensure(r.ok, "ESL: invalid Content-Length")?
    val := r.value
    ensure(val >= 0 && val <= _max_body_size(), "ESL: Content-Length out of range")?
    Ok(val)
}

fn _read_frame(conn, buf) -> Result[any] {
    result := _read_until_delimiter(conn, buf)?
    headers := _parse_headers(result.before)?
    let mut remaining = result.after

    cl := headers["Content-Length"]
    if cl != null {
        needed := _parse_content_length(cl)?
        while len(remaining) < needed {
            chunk := conn.read()?
            if chunk == "" || chunk == null {
                return Err("ESL: connection closed while reading body")
            }
            remaining = remaining + chunk
            ensure(len(remaining) <= _max_body_size() + 4096, "ESL: body buffer overflow")?
        }
        body := str.slice(remaining, 0, needed)
        leftover := str.slice(remaining, needed)
        return Ok({"headers": headers, "body": body, "_buf": leftover})
    }
    Ok({"headers": headers, "body": "", "_buf": remaining})
}

fn _is_event(frame) {
    ct := frame.headers["Content-Type"]
    ct != null && (str.contains(ct, "event") || str.contains(ct, "text/event"))
}

fn _shift_queue(queue) {
    let mut remaining = []
    let mut i = 1
    while i < len(queue) {
        remaining = push(remaining, queue[i])
        i = i + 1
    }
    remaining
}

fn _parse_event_body(frame) {
    if frame.body != "" {
        parsed := json.parse(frame.body)
        if parsed.ok { return parsed.value }
    }
    frame
}

// ──────────────────────────────────────────────
// Connection
// ──────────────────────────────────────────────

pub fn connect(host, port, password) -> Result[any] {
    h := if host != null { host } else { "127.0.0.1" }
    p := if port != null { port } else { 8021 }
    pw := if password != null { password } else { "ClueCon" }
    conn := socket.dial("tcp", "$h:$p")?

    frame := _read_frame(conn, "")?
    ct := frame.headers["Content-Type"]
    ensure(ct != null && ct == "auth/request", "expected auth/request from FreeSWITCH")?

    conn.write("auth $pw\n\n")?
    reply := _read_frame(conn, frame._buf)?
    reply_text := reply.headers["Reply-Text"]
    ensure(reply_text != null && str.starts_with(reply_text, "+OK"), "ESL auth failed")?

    Ok({
        "_conn": conn,
        "_buf": reply._buf,
        "_events": [],
        "_mode": "inbound",
        "host": h,
        "port": p,
        "connected": true,
    })
}

// ──────────────────────────────────────────────
// Commands
// ──────────────────────────────────────────────

pub fn command(e, cmd) -> Result[any] {
    e._conn.write("$cmd\n\n")?
    let mut buf = e._buf
    let mut events = e._events
    while true {
        frame := _read_frame(e._conn, buf)?
        buf = frame._buf
        if _is_event(frame) {
            if len(events) >= _max_event_queue() {
                // drop oldest event to prevent unbounded growth
                events = _shift_queue(events)
            }
            events = push(events, frame)
            continue
        }
        e._buf = buf
        e._events = events
        if frame.body != "" && str.contains("" + frame.headers["Content-Type"], "json") {
            parsed := json.parse(frame.body)
            if parsed.ok { return Ok(parsed.value) }
        }
        return Ok(frame.body)
    }
}

pub fn api(e, cmd) -> Result[any] { command(e, "api $cmd") }

pub fn bgapi(e, cmd) -> Result[any] { command(e, "bgapi $cmd") }

pub fn subscribe(e, events) -> Result[any] {
    command(e, "event json $events")?
    Ok(null)
}

pub fn filter(e, header, value) -> Result[any] {
    command(e, "filter $header $value")?
    Ok(null)
}

pub fn myevents(e, uuid) -> Result[any] {
    command(e, "myevents json $uuid")?
    Ok(null)
}

// ──────────────────────────────────────────────
// Event receiving
// ──────────────────────────────────────────────

pub fn recv_event(e) -> Result[any] {
    if len(e._events) > 0 {
        evt := e._events[0]
        e._events = _shift_queue(e._events)
        return Ok(_parse_event_body(evt))
    }
    let mut buf = e._buf
    while true {
        frame := _read_frame(e._conn, buf)?
        buf = frame._buf
        e._buf = buf
        if _is_event(frame) {
            return Ok(_parse_event_body(frame))
        }
    }
}

pub fn recv_event_timeout(e, timeout_sec) -> Result[any] {
    // Return queued event immediately if available
    if len(e._events) > 0 {
        return recv_event(e)
    }
    // Set a socket read deadline, then try reading frames
    e._conn.set_read_deadline(timeout_sec)?
    let mut buf = e._buf
    while true {
        // _read_frame will call conn.read() which will timeout via the deadline
        frame := _read_frame(e._conn, buf)
        // Check if it's a timeout error
        repr := "" + frame
        if str.contains(repr, "timeout") {
            // Reset deadline for future reads
            e._conn.set_read_deadline(60)?
            return Err("ESL: recv_event timeout after " + str(timeout_sec) + "s")
        }
        if !frame.ok {
            e._conn.set_read_deadline(60)?
            return frame
        }
        f := frame.value
        buf = f._buf
        e._buf = buf
        // Reset deadline after successful read
        e._conn.set_read_deadline(60)?
        if _is_event(f) {
            return Ok(_parse_event_body(f))
        }
        // Non-event frame during timeout wait — discard and retry
        // Re-set the deadline for remaining time
        // ponytail: proper remaining-time tracking needs monotonic clock
        e._conn.set_read_deadline(timeout_sec)?
    }
}

// ──────────────────────────────────────────────
// Call control
// ──────────────────────────────────────────────

pub fn execute(e, uuid, app, arg) -> Result[any] {
    let mut msg = "sendmsg $uuid\ncall-command: execute\nexecute-app-name: $app"
    if arg != null && arg != "" {
        msg = "$msg\nexecute-app-arg: $arg"
    }
    command(e, msg)
}

pub fn answer(e, uuid) -> Result[any] { execute(e, uuid, "answer", null) }

pub fn hangup(e, uuid, cause) -> Result[any] {
    c := if cause != null { cause } else { "NORMAL_CLEARING" }
    execute(e, uuid, "hangup", c)
}

pub fn playback(e, uuid, file) -> Result[any] { execute(e, uuid, "playback", file) }

pub fn record(e, uuid, file, max_sec, silence_thresh) -> Result[any] {
    let mut arg = file
    if max_sec != null { arg = "$arg $max_sec" }
    if silence_thresh != null { arg = "$arg $silence_thresh" }
    execute(e, uuid, "record_session", arg)
}

pub fn bridge(e, uuid, destination) -> Result[any] { execute(e, uuid, "bridge", destination) }

pub fn transfer(e, uuid, extension, context) -> Result[any] {
    ctx := if context != null { context } else { "default" }
    api(e, "uuid_transfer $uuid $extension XML $ctx")
}

pub fn send_dtmf(e, uuid, digits) -> Result[any] { api(e, "uuid_send_dtmf $uuid $digits") }

pub fn set_var(e, uuid, name, value) -> Result[any] { execute(e, uuid, "set", "$name=$value") }

pub fn play_and_get_digits(e, uuid, opts) -> Result[any] {
    min := if opts.min != null { opts.min } else { 1 }
    max := if opts.max != null { opts.max } else { 4 }
    tries := if opts.tries != null { opts.tries } else { 3 }
    timeout := if opts.timeout_ms != null { opts.timeout_ms } else { 5000 }
    term := if opts.terminator != null { opts.terminator } else { "#" }
    file := if opts.file != null { opts.file } else { "silence_stream://250" }
    invalid := if opts.invalid_file != null { opts.invalid_file } else { "silence_stream://250" }
    var_name := if opts.var_name != null { opts.var_name } else { "dtmf_result" }
    regex := if opts.regex != null { opts.regex } else { "\\d+" }
    arg := "$min $max $tries $timeout $term $file $invalid $var_name $regex"
    execute(e, uuid, "play_and_get_digits", arg)
}

pub fn originate(e, dest, app, arg) -> Result[any] {
    a := if app != null { app } else { "&park" }
    full := if arg != null { "$a($arg)" } else { a }
    api(e, "originate $dest $full")
}

pub fn conference(e, uuid, room, opts) -> Result[any] {
    let mut flags = ""
    if opts != null {
        if opts.muted == true { flags = "$flags+muted" }
        if opts.deaf == true { flags = "$flags+deaf" }
        if opts.moderator == true { flags = "$flags+moderator" }
    }
    if flags != "" { execute(e, uuid, "conference", "$room$flags") }
    else { execute(e, uuid, "conference", room) }
}

pub fn uuid_bridge(e, uuid1, uuid2) -> Result[any] { api(e, "uuid_bridge $uuid1 $uuid2") }

pub fn show(e, what) -> Result[any] { api(e, "show $what as json") }

pub fn status(e) -> Result[any] { api(e, "status") }

pub fn close(e) -> Result[any] {
    e._conn.close()?
    e.connected = false
    Ok(null)
}

// ──────────────────────────────────────────────
// Outbound mode
// ──────────────────────────────────────────────

pub fn outbound_server(port, handler) -> Result[any] {
    p := if port != null { port } else { 9090 }
    ln := socket.listen("tcp", ":$p")?
    say("ESL outbound server listening on :$p")
    while true {
        conn := ln.accept()?
        initial := conn.read()?
        conn.write("connect\n\n")?
        frame := _read_frame(conn, initial)?
        conn.write("myevents json\n\n")?
        ack := _read_frame(conn, frame._buf)?
        e := {
            "_conn": conn,
            "_buf": ack._buf,
            "_events": [],
            "_mode": "outbound",
            "connected": true,
        }
        handler(e)
    }
}
