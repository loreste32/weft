// ESL — FreeSWITCH Event Socket Library client with proper frame parsing.
// Protocol: headers separated by \n, blank line between headers and body,
// Content-Length header determines body size.

// ──────────────────────────────────────────────
// Limits
// ──────────────────────────────────────────────

fn _max_header_size { 65536 }
fn _max_body_size { 10485760 }
fn _max_header_count { 128 }
fn _max_event_queue { 10000 }
fn _max_request_queue { 256 }

// ──────────────────────────────────────────────
// Frame parser
// ──────────────────────────────────────────────

fn _find_delimiter(b) {
    // Check both \n\n and \r\n\r\n, return {idx, len} or null
    d1 := str.find(b, "\n\n")
    d2 := str.find(b, "\r\n\r\n")
    if d1 >= 0 && (d2 < 0 || d1 <= d2) {
        return {"idx": d1, "dlen": 2}
    }
    if d2 >= 0 {
        return {"idx": d2, "dlen": 4}
    }
    null
}

fn _read_until_delimiter(conn, buf) -> Result[any] {
    let mut b = buf
    while true {
        found := _find_delimiter(b)
        if found != null {
            ensure(found.idx <= _max_header_size(), "ESL: header block exceeds 64KB limit")?
            before := str.slice(b, 0, found.idx)
            after := str.slice(b, found.idx + found.dlen)
            return Ok({"before": before, "after": after})
        }
        // Enforce header size limit DURING reads, not after
        ensure(len(b) <= _max_header_size(), "ESL: header block exceeds 64KB limit")?
        chunk := conn.read()?
        if chunk == "" || chunk == null {
            return Err("ESL: connection closed while reading")
        }
        b = b + chunk
    }
}

fn _parse_headers(raw) -> Result[any] {
    let mut headers = {}
    let mut count = 0
    lines := str.split(raw, "\n")
    for line in lines {
        trimmed := str.trim(line)
        if trimmed == "" { continue }
        count = count + 1
        ensure(count <= _max_header_count(), "ESL: too many headers")?
        idx := str.find(trimmed, ":")
        ensure(idx > 0, "ESL: malformed header line")?
        {
            // Normalize header names for case-insensitive matching
            key := str.trim(str.slice(trimmed, 0, idx))
            // Use original case for storage but check Content-Length case-insensitively
            val := str.trim(str.slice(trimmed, idx + 1))
            lower_key := str.lower(key)
            if lower_key == "content-length" {
                if headers["Content-Length"] != null {
                    return Err("ESL: duplicate Content-Length header")
                }
                headers["Content-Length"] = val
            } else if lower_key == "content-type" {
                headers["Content-Type"] = val
            } else if lower_key == "reply-text" {
                headers["Reply-Text"] = val
            } else {
                headers[key] = val
            }
        }
    }
    Ok(headers)
}

fn _parse_content_length(cl_str) -> Result[any] {
    // Strict integer parsing — reject floats, negatives, leading signs, non-numeric
    if cl_str == null || cl_str == "" { return Err("empty Content-Length") }
    trimmed := str.trim(cl_str)
    if len(trimmed) == 0 { return Err("empty Content-Length") }
    // Check each character is a digit
    let mut i = 0
    while i < len(trimmed) {
        ch := str.slice(trimmed, i, i + 1)
        if ch < "0" || ch > "9" {
            return Err("ESL: non-numeric Content-Length: " + trimmed)
        }
        i = i + 1
    }
    val := int.parse(trimmed)?
    ensure(val >= 0 && val <= _max_body_size(), "ESL: Content-Length out of range")?
    Ok(val)
}

fn _read_frame(conn, buf) -> Result[any] {
    result := _read_until_delimiter(conn, buf)?
    headers := _parse_headers(result.before)?
    let mut remaining = result.after

    cl := headers["Content-Length"]
    if cl != null {
        needed := _parse_content_length(cl)?
        while len(remaining) < needed {
            chunk := conn.read()?
            if chunk == "" || chunk == null {
                return Err("ESL: connection closed while reading body")
            }
            remaining = remaining + chunk
            // Allow buffer up to body size + reasonable TCP overshoot (next frame headers)
            ensure(len(remaining) <= _max_body_size() + _max_header_size(), "ESL: body buffer overflow")?
        }
        body := str.slice(remaining, 0, needed)
        leftover := str.slice(remaining, needed)
        return Ok({"headers": headers, "body": body, "_buf": leftover})
    }
    Ok({"headers": headers, "body": "", "_buf": remaining})
}

fn _is_event(frame) {
    ct := frame.headers["Content-Type"]
    ct != null && (str.contains(ct, "event") || str.contains(ct, "text/event"))
}

fn _shift_queue(queue) {
    let mut remaining = []
    let mut i = 1
    while i < len(queue) {
        remaining = push(remaining, queue[i])
        i = i + 1
    }
    remaining
}

fn _parse_event_body(frame) {
    if frame.body != "" {
        parsed := json.parse(frame.body)
        if parsed.ok { return parsed.value }
    }
    frame
}

fn _reply_ok(value) {
    {"ok": true, "value": value}
}

fn _reply_err(message) {
    {"ok": false, "error": message}
}

fn _frame_value(frame) {
    if frame.body != "" && str.contains("" + frame.headers["Content-Type"], "json") {
        parsed := json.parse(frame.body)
        if parsed.ok { return parsed.value }
    }
    frame.body
}

// The reader is the only function allowed to call conn.read after connect.
fn _reader_loop(conn, frames, initial_buf) {
    let mut buf = initial_buf
    while true {
        result := _read_frame(conn, buf)
        if !result.ok {
            send(frames, {"kind": "error", "error": "" + result.error})
            close(frames)
            return
        }
        frame := result.value
        buf = frame._buf
        send(frames, frame)
    }
}

fn _fail_pending(pending, message) {
    let mut rest = pending
    while len(rest) > 0 {
        request := rest[0]
        rest = _shift_queue(rest)
        send(request.reply, _reply_err(message))
    }
}

fn _fail_event_waiters(waiters, message) {
    let mut rest = waiters
    while len(rest) > 0 {
        waiter := rest[0]
        rest = _shift_queue(rest)
        send(waiter.reply, _reply_err(message))
    }
}

// The coordinator owns command writes and all routing state. The reader and
// coordinator are deliberately separate: socket reads never compete with a
// command or event consumer, and event-before-reply ordering is preserved.
fn _coordinator(conn, frames, requests, event_requests, event_cancels) {
    let mut pending = []
    let mut events = []
    let mut waiters = []
    let mut next_id = 1
    let mut dead = false
    let mut dead_error = "ESL: connection closed"

    while true {
        selected := select_recv([frames, requests, event_requests, event_cancels])
        if !selected.ok { break }
        choice := selected.value

        if choice.i == 0 {
            frame := choice.value
            if frame.kind == "error" {
                dead = true
                dead_error = frame.error
                _fail_pending(pending, dead_error)
                _fail_event_waiters(waiters, dead_error)
                pending = []
                waiters = []
                continue
            }
            if _is_event(frame) {
                if len(waiters) > 0 {
                    waiter := waiters[0]
                    waiters = _shift_queue(waiters)
                    send(waiter.reply, _reply_ok(_parse_event_body(frame)))
                } else {
                    if len(events) >= _max_event_queue() {
                        events = _shift_queue(events)
                    }
                    events = push(events, frame)
                }
            } else if len(pending) > 0 {
                request := pending[0]
                pending = _shift_queue(pending)
                send(request.reply, _reply_ok(_frame_value(frame)))
            }
        } else if choice.i == 1 {
            request := choice.value
            if dead {
                send(request.reply, _reply_err(dead_error))
                continue
            }
            pending = push(pending, request)
            written := conn.write(request.cmd)
            if !written.ok {
                pending = _shift_queue(pending)
                dead = true
                dead_error = "ESL: write failed: " + written.error
                send(request.reply, _reply_err(dead_error))
                _fail_pending(pending, dead_error)
                pending = []
            }
        } else if choice.i == 2 {
            request := choice.value
            if dead {
                send(request.reply, _reply_err(dead_error))
                if request.ack != null { send(request.ack, {"ok": false, "error": dead_error}) }
                continue
            }
            if len(events) > 0 {
                event := events[0]
                events = _shift_queue(events)
                send(request.reply, _reply_ok(_parse_event_body(event)))
                if request.ack != null { send(request.ack, {"ok": true, "id": -1}) }
            } else {
                id := next_id
                next_id = next_id + 1
                waiters = push(waiters, {"id": id, "reply": request.reply})
                if request.ack != null { send(request.ack, {"ok": true, "id": id}) }
            }
        } else {
            cancel := choice.value
            let mut remaining = []
            let mut removed = false
            for waiter in waiters {
                if waiter.id == cancel.id {
                    removed = true
                } else {
                    remaining = push(remaining, waiter)
                }
            }
            waiters = remaining
            send(cancel.ack, {"ok": true, "removed": removed})
        }
    }
}

// parse_frame parses exactly one complete frame from an in-memory buffer.
// It is useful for protocol tests and for callers that already own a read
// buffer. The unconsumed suffix is returned as `remaining`.
pub fn parse_frame(raw) -> Result[any] {
    found := _find_delimiter(raw)
    if found == null { return Err("ESL: incomplete header block") }
    ensure(found.idx <= _max_header_size(), "ESL: header block exceeds 64KB limit")?
    before := str.slice(raw, 0, found.idx)
    let mut remaining = str.slice(raw, found.idx + found.dlen)
    headers := _parse_headers(before)?
    let mut body = ""
    content_length := headers["Content-Length"]
    if content_length != null {
        needed := _parse_content_length(content_length)?
        if len(remaining) < needed {
            return Err("ESL: incomplete frame body")
        }
        body = str.slice(remaining, 0, needed)
        remaining = str.slice(remaining, needed)
    }
    Ok({"headers": headers, "body": body, "remaining": remaining})
}

// ──────────────────────────────────────────────
// Connection
// ──────────────────────────────────────────────

pub fn connect(host, port, password) -> Result[any] {
    h := if host != null { host } else { "127.0.0.1" }
    p := if port != null { port } else { 8021 }
    pw := if password != null { password } else { "ClueCon" }
    conn := socket.dial("tcp", "$h:$p")?

    frame_result := _read_frame(conn, "")
    if !frame_result.ok {
        conn.close()
        return Err(frame_result.error)
    }
    frame := frame_result.value
    ct := frame.headers["Content-Type"]
    if ct == null || ct != "auth/request" {
        conn.close()
        return Err("expected auth/request from FreeSWITCH")
    }

    auth_write := conn.write("auth $pw\n\n")
    if !auth_write.ok {
        conn.close()
        return Err(auth_write.error)
    }
    reply_result := _read_frame(conn, frame._buf)
    if !reply_result.ok {
        conn.close()
        return Err(reply_result.error)
    }
    reply := reply_result.value
    reply_text := reply.headers["Reply-Text"]
    if reply_text == null || !str.starts_with(reply_text, "+OK") {
        conn.close()
        return Err("ESL auth failed")
    }

    frames := channel(_max_event_queue())
    requests := channel(_max_request_queue())
    event_requests := channel(_max_request_queue())
    event_cancels := channel(_max_request_queue())
    reader_task := spawn(_reader_loop, conn, frames, reply._buf)?
    coordinator_task := spawn(_coordinator, conn, frames, requests, event_requests, event_cancels)?

    Ok({
        "_conn": conn,
        "_buf": reply._buf,
        "_events": [],
        "_requests": requests,
        "_event_requests": event_requests,
        "_event_cancels": event_cancels,
        "_reader_task": reader_task,
        "_coordinator_task": coordinator_task,
        "_mode": "inbound",
        "host": h,
        "port": p,
        "connected": true,
    })
}

// ──────────────────────────────────────────────
// Commands
// ──────────────────────────────────────────────

pub fn command(e, cmd) -> Result[any] {
    if e._requests != null {
        reply := channel(1)
        send(e._requests, {"cmd": "$cmd\n\n", "reply": reply})
        result := recv(reply)?
        if result.ok { return Ok(result.value) }
        return Err(result.error)
    }
    e._conn.write("$cmd\n\n")?
    let mut buf = e._buf
    let mut events = e._events
    while true {
        frame := _read_frame(e._conn, buf)?
        buf = frame._buf
        if _is_event(frame) {
            if len(events) >= _max_event_queue() {
                // drop oldest event to prevent unbounded growth
                events = _shift_queue(events)
            }
            events = push(events, frame)
            continue
        }
        e._buf = buf
        e._events = events
        if frame.body != "" && str.contains("" + frame.headers["Content-Type"], "json") {
            parsed := json.parse(frame.body)
            if parsed.ok { return Ok(parsed.value) }
        }
        return Ok(frame.body)
    }
}

pub fn api(e, cmd) -> Result[any] { command(e, "api $cmd") }

pub fn bgapi(e, cmd) -> Result[any] { command(e, "bgapi $cmd") }

pub fn subscribe(e, events) -> Result[any] {
    command(e, "event json $events")?
    Ok(null)
}

pub fn filter(e, header, value) -> Result[any] {
    command(e, "filter $header $value")?
    Ok(null)
}

pub fn myevents(e, uuid) -> Result[any] {
    command(e, "myevents json $uuid")?
    Ok(null)
}

// ──────────────────────────────────────────────
// Event receiving
// ──────────────────────────────────────────────

pub fn recv_event(e) -> Result[any] {
    if e._event_requests != null {
        reply := channel(1)
        send(e._event_requests, {"reply": reply})
        result := recv(reply)?
        if result.ok { return Ok(result.value) }
        return Err(result.error)
    }
    if len(e._events) > 0 {
        evt := e._events[0]
        e._events = _shift_queue(e._events)
        return Ok(_parse_event_body(evt))
    }
    let mut buf = e._buf
    while true {
        frame := _read_frame(e._conn, buf)?
        buf = frame._buf
        e._buf = buf
        if _is_event(frame) {
            return Ok(_parse_event_body(frame))
        }
    }
}

pub fn recv_event_timeout(e, timeout_sec) -> Result[any] {
    if e._event_requests != null {
        ensure(timeout_sec != null && timeout_sec > 0, "timeout_sec must be positive")?
        reply := channel(1)
        ack := channel(1)
        send(e._event_requests, {"reply": reply, "ack": ack})
        registered := recv(ack)?
        if !registered.ok { return Err(registered.error) }
        selected := select_recv([reply], timeout_sec * 1000)
        if selected.ok {
            result := selected.value.value
            if result.ok { return Ok(result.value) }
            return Err(result.error)
        }
        cancel_ack := channel(1)
        send(e._event_cancels, {"id": registered.id, "ack": cancel_ack})
        recv(cancel_ack)?
        // Delivery and timeout can race. If the coordinator delivered the
        // event just before processing cancellation, preserve that result
        // instead of reporting a false timeout or losing the event.
        delivered := try_recv(reply)?
        if delivered.ok {
            result := delivered.value
            if result.ok { return Ok(result.value) }
            return Err(result.error)
        }
        return Err("ESL: recv_event timeout after " + str(timeout_sec) + "s")
    }
    if len(e._events) > 0 {
        return recv_event(e)
    }
    // Set ONE absolute deadline — do not restart on non-event frames
    e._conn.set_read_deadline(timeout_sec)?
    let mut buf = e._buf
    let mut timed_out = false
    while !timed_out {
        frame := _read_frame(e._conn, buf)
        repr := "" + frame
        if str.contains(repr, "timeout") {
            timed_out = true
            continue
        }
        if !frame.ok {
            e._conn.clear_read_deadline()?
            return frame
        }
        f := frame.value
        buf = f._buf
        e._buf = buf
        if _is_event(f) {
            e._conn.clear_read_deadline()?
            return Ok(_parse_event_body(f))
        }
        // Non-event frame: do NOT restart the deadline, it's still running
    }
    e._conn.clear_read_deadline()?
    Err("ESL: recv_event timeout after " + str(timeout_sec) + "s")
}

// ──────────────────────────────────────────────
// Call control
// ──────────────────────────────────────────────

pub fn execute(e, uuid, app, arg) -> Result[any] {
    let mut msg = "sendmsg $uuid\ncall-command: execute\nexecute-app-name: $app"
    if arg != null && arg != "" {
        msg = "$msg\nexecute-app-arg: $arg"
    }
    command(e, msg)
}

pub fn answer(e, uuid) -> Result[any] { execute(e, uuid, "answer", null) }

pub fn hangup(e, uuid, cause) -> Result[any] {
    c := if cause != null { cause } else { "NORMAL_CLEARING" }
    execute(e, uuid, "hangup", c)
}

pub fn playback(e, uuid, file) -> Result[any] { execute(e, uuid, "playback", file) }

pub fn record(e, uuid, file, max_sec, silence_thresh) -> Result[any] {
    let mut arg = file
    if max_sec != null { arg = "$arg $max_sec" }
    if silence_thresh != null { arg = "$arg $silence_thresh" }
    execute(e, uuid, "record_session", arg)
}

pub fn bridge(e, uuid, destination) -> Result[any] { execute(e, uuid, "bridge", destination) }

pub fn transfer(e, uuid, extension, context) -> Result[any] {
    ctx := if context != null { context } else { "default" }
    api(e, "uuid_transfer $uuid $extension XML $ctx")
}

pub fn send_dtmf(e, uuid, digits) -> Result[any] { api(e, "uuid_send_dtmf $uuid $digits") }

pub fn set_var(e, uuid, name, value) -> Result[any] { execute(e, uuid, "set", "$name=$value") }

pub fn play_and_get_digits(e, uuid, opts) -> Result[any] {
    min := if opts.min != null { opts.min } else { 1 }
    max := if opts.max != null { opts.max } else { 4 }
    tries := if opts.tries != null { opts.tries } else { 3 }
    timeout := if opts.timeout_ms != null { opts.timeout_ms } else { 5000 }
    term := if opts.terminator != null { opts.terminator } else { "#" }
    file := if opts.file != null { opts.file } else { "silence_stream://250" }
    invalid := if opts.invalid_file != null { opts.invalid_file } else { "silence_stream://250" }
    var_name := if opts.var_name != null { opts.var_name } else { "dtmf_result" }
    regex := if opts.regex != null { opts.regex } else { "\\d+" }
    arg := "$min $max $tries $timeout $term $file $invalid $var_name $regex"
    execute(e, uuid, "play_and_get_digits", arg)
}

pub fn originate(e, dest, app, arg) -> Result[any] {
    a := if app != null { app } else { "&park" }
    full := if arg != null { "$a($arg)" } else { a }
    api(e, "originate $dest $full")
}

pub fn conference(e, uuid, room, opts) -> Result[any] {
    let mut flags = ""
    if opts != null {
        if opts.muted == true { flags = "$flags+muted" }
        if opts.deaf == true { flags = "$flags+deaf" }
        if opts.moderator == true { flags = "$flags+moderator" }
    }
    if flags != "" { execute(e, uuid, "conference", "$room$flags") }
    else { execute(e, uuid, "conference", room) }
}

pub fn uuid_bridge(e, uuid1, uuid2) -> Result[any] { api(e, "uuid_bridge $uuid1 $uuid2") }

pub fn show(e, what) -> Result[any] { api(e, "show $what as json") }

pub fn status(e) -> Result[any] { api(e, "status") }

pub fn close(e) -> Result[any] {
    e._conn.close()?
    e.connected = false
    Ok(null)
}

// ──────────────────────────────────────────────
// Outbound mode
// ──────────────────────────────────────────────

pub fn outbound_server(port, handler) -> Result[any] {
    p := if port != null { port } else { 9090 }
    ln := socket.listen("tcp", ":$p")?
    say("ESL outbound server listening on :$p")
    while true {
        conn := ln.accept()?
        initial := conn.read()?
        conn.write("connect\n\n")?
        frame := _read_frame(conn, initial)?
        conn.write("myevents json\n\n")?
        ack := _read_frame(conn, frame._buf)?
        e := {
            "_conn": conn,
            "_buf": ack._buf,
            "_events": [],
            "_mode": "outbound",
            "connected": true,
        }
        handler(e)
    }
}
