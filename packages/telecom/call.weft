pub fn answer(opts) {
    a := {"action": "answer"}
    if opts != null {
        if contains(keys(opts), "headers") && opts.headers != null {
            a.headers = opts.headers
        }
        if contains(keys(opts), "timeout") && opts.timeout != null {
            a.timeout = opts.timeout
        }
    }
    a
}


pub fn hangup(opts) {
    a := {"action": "hangup"}
    if opts != null {
        if contains(keys(opts), "reason") && opts.reason != null {
            a.reason = opts.reason
        }
        if contains(keys(opts), "headers") && opts.headers != null {
            a.headers = opts.headers
        }
    }
    a
}


pub fn play(src, opts) {
    a := {"action": "play", "src": src}
    if opts != null {
        if contains(keys(opts), "tts") && opts.tts != null {
            a.tts = opts.tts
        }
        if contains(keys(opts), "voice") && opts.voice != null {
            a.voice = opts.voice
        }
        if contains(keys(opts), "language") && opts.language != null {
            a.language = opts.language
        }
        if contains(keys(opts), "loop") && opts.loop != null {
            a.loop = opts.loop
        }
        if contains(keys(opts), "bargin") && opts.bargin != null {
            a.bargin = opts.bargin
        }
    }
    a
}


pub fn say_text(text, opts) {
    play(text, {"tts": true})
}


pub fn gather(opts) {
    a := {"action": "gather"}
    if opts == null {
        return a
    }
    if contains(keys(opts), "kind") && opts.kind != null {
        a.kind = opts.kind
    }
    if contains(keys(opts), "timeout") && opts.timeout != null {
        a.timeout = opts.timeout
    }
    if contains(keys(opts), "max_digits") && opts.max_digits != null {
        a.max_digits = opts.max_digits
    }
    if contains(keys(opts), "finish_on_key") && opts.finish_on_key != null {
        a.finish_on_key = opts.finish_on_key
    }
    if contains(keys(opts), "prompt") && opts.prompt != null {
        a.prompt = opts.prompt
    }
    if contains(keys(opts), "language") && opts.language != null {
        a.language = opts.language
    }
    if contains(keys(opts), "speech_timeout") && opts.speech_timeout != null {
        a.speech_timeout = opts.speech_timeout
    }
    if contains(keys(opts), "hints") && opts.hints != null {
        a.hints = opts.hints
    }
    if contains(keys(opts), "speech_model") && opts.speech_model != null {
        a.speech_model = opts.speech_model
    }
    if contains(keys(opts), "bargin") && opts.bargin != null {
        a.bargin = opts.bargin
    }
    a
}


pub fn record(opts) {
    a := {"action": "record"}
    if opts != null {
        if contains(keys(opts), "max_duration") && opts.max_duration != null {
            a.max_duration = opts.max_duration
        }
        if contains(keys(opts), "beep") && opts.beep != null {
            a.beep = opts.beep
        }
        if contains(keys(opts), "format") && opts.format != null {
            a.format = opts.format
        }
        if contains(keys(opts), "trim_silence") && opts.trim_silence != null {
            a.trim_silence = opts.trim_silence
        }
        if contains(keys(opts), "channels") && opts.channels != null {
            a.channels = opts.channels
        }
        if contains(keys(opts), "callback_url") && opts.callback_url != null {
            a.callback_url = opts.callback_url
        }
    }
    a
}


pub fn pause(seconds) { {
    "action": "pause",
    "duration": if seconds != null { seconds } else { 1 },
} }


pub fn transfer(dest, opts) {
    a := {"action": "transfer", "destination": dest}
    if opts != null {
        if contains(keys(opts), "kind") && opts.kind != null {
            a.kind = opts.kind
        }
        if contains(keys(opts), "headers") && opts.headers != null {
            a.headers = opts.headers
        }
        if contains(keys(opts), "caller_id") && opts.caller_id != null {
            a.caller_id = opts.caller_id
        }
        if contains(keys(opts), "timeout") && opts.timeout != null {
            a.timeout = opts.timeout
        }
        if contains(keys(opts), "music_url") && opts.music_url != null {
            a.music_url = opts.music_url
        }
    }
    a
}


pub fn bridge(call_id, opts) {
    a := {"action": "bridge", "call_id": call_id}
    if opts != null {
        if contains(keys(opts), "headers") && opts.headers != null {
            a.headers = opts.headers
        }
        if contains(keys(opts), "record") && opts.record != null {
            a.record = opts.record
        }
    }
    a
}


pub fn conference(room, opts) {
    a := {"action": "conference", "room": room}
    if opts != null {
        if contains(keys(opts), "muted") && opts.muted != null {
            a.muted = opts.muted
        }
        if contains(keys(opts), "moderator") && opts.moderator != null {
            a.moderator = opts.moderator
        }
        if contains(keys(opts), "beep_on_enter") && opts.beep_on_enter != null {
            a.beep_on_enter = opts.beep_on_enter
        }
        if contains(keys(opts), "max_participants") && opts.max_participants != null {
            a.max_participants = opts.max_participants
        }
        if contains(keys(opts), "music_url") && opts.music_url != null {
            a.music_url = opts.music_url
        }
        if contains(keys(opts), "record") && opts.record != null {
            a.record = opts.record
        }
    }
    a
}


pub fn redirect(url) { {"action": "redirect", "url": url} }


pub fn reject(reason) { {
    "action": "reject",
    "reason": if reason != null { reason } else { "rejected" },
} }

