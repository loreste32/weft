pub fn normalize(number, country_code) {
    cc := if country_code != null { country_code } else { "1" }
    mut clean := ""
    mut i := 0
    while i < len(number) {
        c := str.slice(number, i, i + 1)
        if c == "+" && i == 0 {
            clean = clean + c
        } else if c >= "0" && c <= "9" {
            clean = clean + c
        }
        i = i + 1
    }
    if str.starts_with(clean, "+") {
        return clean
    }
    if str.starts_with(clean, "00") {
        return "+" + str.slice(clean, 2)
    }
    if str.starts_with(clean, "0") {
        return "+$cc" + str.slice(clean, 1)
    }
    if len(clean) == 10 && cc == "1" {
        return "+1$clean"
    }
    "+$cc$clean"
}


pub fn is_e164(number) { str.starts_with(number, "+") && len(number) >= 8 && len(number) <= 16 }


pub fn country(number) {
    if !str.starts_with(number, "+") {
        return null
    }
    n := str.slice(number, 1)
    if str.starts_with(n, "1") {
        return "US/CA"
    }
    prefixes := {
        "44": "GB",
        "33": "FR",
        "49": "DE",
        "39": "IT",
        "34": "ES",
        "81": "JP",
        "86": "CN",
        "91": "IN",
        "55": "BR",
        "7": "RU",
        "61": "AU",
        "64": "NZ",
        "52": "MX",
        "82": "KR",
        "90": "TR",
        "31": "NL",
        "46": "SE",
        "47": "NO",
        "45": "DK",
        "358": "FI",
        "48": "PL",
        "43": "AT",
        "41": "CH",
        "32": "BE",
        "351": "PT",
        "353": "IE",
        "972": "IL",
        "971": "AE",
        "966": "SA",
        "20": "EG",
        "27": "ZA",
        "234": "NG",
        "254": "KE",
    }
    for plen in [3, 2, 1] {
        if len(n) >= plen {
            prefix := str.slice(n, 0, plen)
            if prefixes[prefix] != null {
                return prefixes[prefix]
            }
        }
    }
    null
}


pub fn area_code(number) {
    n := normalize(number, "1")
    if !str.starts_with(n, "+1") {
        return null
    }
    digits := str.slice(n, 2)
    if len(digits) >= 3 {
        return str.slice(digits, 0, 3)
    }
    null
}


pub fn is_tollfree(number) {
    ac := area_code(number)
    if ac == null {
        return false
    }
    tollfree := [
        "800",
        "833",
        "844",
        "855",
        "866",
        "877",
        "888",
    ]
    for tf in tollfree {
        if ac == tf {
            return true
        }
    }
    false
}


pub fn caller_id(name, number) { {"name": name, "number": normalize(number, null)} }


pub fn mask(number) {
    if len(number) <= 6 {
        return "****"
    }
    prefix := str.slice(number, 0, 2)
    suffix := str.slice(number, len(number) - 6)
    "$prefix***$suffix"
}


pub fn sip_uri(user, domain, opts) {
    let mut scheme = "sip"
    if opts != null && opts.secure == true {
        scheme = "sips"
    }
    let mut uri = "$scheme:$user@$domain"
    if opts != null && opts.port != null {
        uri = "$scheme:$user@$domain:${opts.port}"
    }
    if opts != null && opts.transport != null {
        uri = "$uri;transport=${opts.transport}"
    }
    uri
}

