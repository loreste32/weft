pub fn config(opts) {
    cfg := {
        "url": env.get("WEFT_TTS_URL", "https://tts.lancethedev.com"),
        "api_key": env.get("WEFT_TTS_KEY", ""),
        "voice": "default",
        "language": "en-US",
        "format": "wav",
        "sample_rate": 16000,
        "speed": 1.0,
        "pitch": 1.0,
    }
    if opts != null {
        if contains(keys(opts), "url") && opts.url != null {
            cfg.url = opts.url
        }
        if contains(keys(opts), "api_key") && opts.api_key != null {
            cfg.api_key = opts.api_key
        }
        if contains(keys(opts), "voice") && opts.voice != null {
            cfg.voice = opts.voice
        }
        if contains(keys(opts), "language") && opts.language != null {
            cfg.language = opts.language
        }
        if contains(keys(opts), "format") && opts.format != null {
            cfg.format = opts.format
        }
        if contains(keys(opts), "sample_rate") && opts.sample_rate != null {
            cfg.sample_rate = opts.sample_rate
        }
        if contains(keys(opts), "speed") && opts.speed != null {
            cfg.speed = opts.speed
        }
        if contains(keys(opts), "pitch") && opts.pitch != null {
            cfg.pitch = opts.pitch
        }
    }
    cfg
}


pub fn speak(text, opts) -> Result[any] {
    cfg := config(opts)
    headers := {"Content-Type": "application/json"}
    if cfg.api_key != "" {
        headers["Authorization"] = "Bearer ${cfg.api_key}"
    }
    body := json.stringify({
        "text": text,
        "voice": cfg.voice,
        "language": cfg.language,
        "format": cfg.format,
        "sample_rate": cfg.sample_rate,
        "speed": cfg.speed,
        "pitch": cfg.pitch,
    })
    resp := http.post("${cfg.url}/v1/synthesize", body, {"headers": headers, "timeout": 30})?
    data := json.parse(resp)?
    Ok({
        "audio_url": if data.audio_url != null { data.audio_url } else { "" },
        "duration_ms": if data.duration_ms != null { data.duration_ms } else { 0 },
        "format": cfg.format,
        "size": if data.size != null { data.size } else { 0 },
    })
}


pub fn speak_ssml(ssml_text, opts) -> Result[any] {
    cfg := config(opts)
    headers := {"Content-Type": "application/json"}
    if cfg.api_key != "" {
        headers["Authorization"] = "Bearer ${cfg.api_key}"
    }
    body := json.stringify({
        "ssml": ssml_text,
        "voice": cfg.voice,
        "format": cfg.format,
        "sample_rate": cfg.sample_rate,
    })
    resp := http.post("${cfg.url}/v1/synthesize", body, {"headers": headers, "timeout": 30})?
    json.parse(resp)
}


pub fn voices(opts) -> Result[any] {
    cfg := config(opts)
    headers := {}
    if cfg.api_key != "" {
        headers["Authorization"] = "Bearer ${cfg.api_key}"
    }
    resp := http.get("${cfg.url}/v1/voices", {"headers": headers})?
    data := json.parse(resp)?
    Ok(if data.voices != null { data.voices } else { data })
}


pub fn cache_speak(text, cache_dir, opts) -> Result[any] {
    hash := crypto.sha256(text)
    short := str.slice(hash, 0, 16)
    cfg := config(opts)
    path := fs.join(cache_dir, "$short.${cfg.format}")
    if fs.exists(path) {
        return Ok(path)
    }
    result := speak(text, opts)?
    if result.audio_url != "" {
        audio := http.get(result.audio_url)?
        fs.mkdir(cache_dir)?
        fs.write_bytes(path, audio)?
    }
    Ok(path)
}

