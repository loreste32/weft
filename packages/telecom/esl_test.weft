use "./esl.weft" as esl

fn mock_auth_failure_server(listener) -> Result[any] {
    conn := listener.accept()?
    conn.write("Content-Type: auth/request\n\n")?
    conn.read()?
    conn.write("Content-Type: command/reply\nReply-Text: -ERR invalid password\n\n")?
    conn.close()?
    listener.close()?
    Ok(null)
}

fn test_parser_handles_lf_and_crlf() {
    lf := esl.parse_frame("Content-Type: auth/request\n\n")?
    test.eq(lf.headers["Content-Type"], "auth/request")

    crlf := esl.parse_frame("Content-Type: text/event-json\r\nContent-Length: 7\r\n\r\n{\"x\":1}")?
    test.eq(crlf.body, "{\"x\":1}")
    test.eq(crlf.headers["Content-Type"], "text/event-json")
    Ok(null)
}

fn test_parser_handles_fragmented_and_coalesced_frames() {
    partial := esl.parse_frame("Content-Type: text/plain\nContent-Length: 5\n\nhe")
    test.eq(partial.ok, false)

    first := esl.parse_frame("Content-Type: text/plain\nContent-Length: 5\n\nhelloContent-Type: text/plain\n\n")?
    test.eq(first.body, "hello")
    test.eq(first.remaining, "Content-Type: text/plain\n\n")

    second := esl.parse_frame(first.remaining)?
    test.eq(second.headers["Content-Type"], "text/plain")
    Ok(null)
}

fn test_parser_rejects_invalid_content_lengths() {
    duplicate := esl.parse_frame("Content-Length: 1\nContent-Length: 1\n\na")
    test.eq(duplicate.ok, false)

    negative := esl.parse_frame("Content-Length: -1\n\n")
    test.eq(negative.ok, false)

    non_numeric := esl.parse_frame("Content-Length: 1.5\n\n")
    test.eq(non_numeric.ok, false)

    too_large := esl.parse_frame("Content-Length: 10485761\n\n")
    test.eq(too_large.ok, false)

    malformed := esl.parse_frame("Malformed-Header\n\n")
    test.eq(malformed.ok, false)

    oversized := esl.parse_frame("X: " + str.repeat("a", 65540) + "\n\n")
    test.eq(oversized.ok, false)
    Ok(null)
}

fn test_connect_rejects_auth_failure() {
    listener := socket.listen("tcp", "127.0.0.1:0")?
    parts := str.split(listener.addr, ":")
    port := parts[len(parts) - 1]
    server := spawn(mock_auth_failure_server, listener)
    result := esl.connect("127.0.0.1", port, "wrong-password")
    test.is_false(result.ok)
    server.await()?
    Ok(null)
}
