pub fn build(text, opts) {
    p := {"text": text, "tts": true}
    if opts != null {
        if contains(keys(opts), "voice") && opts.voice != null {
            p.voice = opts.voice
        }
        if contains(keys(opts), "language") && opts.language != null {
            p.language = opts.language
        }
        if contains(keys(opts), "bargin") && opts.bargin != null {
            p.bargin = opts.bargin
        }
        if contains(keys(opts), "loop") && opts.loop != null {
            p.loop = opts.loop
        }
        if contains(keys(opts), "ssml") && opts.ssml != null {
            p.ssml = true
            p.text = opts.ssml
        }
    }
    p
}


pub fn audio(url, opts) {
    p := {"audio_url": url, "tts": false}
    if opts != null {
        if contains(keys(opts), "bargin") && opts.bargin != null {
            p.bargin = opts.bargin
        }
        if contains(keys(opts), "loop") && opts.loop != null {
            p.loop = opts.loop
        }
    }
    p
}


pub fn ssml(parts) {
    let mut out = "<speak>"
    for part in parts {
        if contains(keys(part), "text") {
            out = out + part.text
        }
        if contains(keys(part), "pause_dur") {
            out = out + "<break time=\"${part.pause_dur}\"/>"
        }
        if contains(keys(part), "say_as") {
            out = out + "<say-as interpret-as=\"${part.say_as.interpret_as}\">${part.say_as.text}</say-as>"
        }
        if contains(keys(part), "emphasis") {
            level := if part.emphasis.level != null { part.emphasis.level } else { "moderate" }
            out = out + "<emphasis level=\"$level\">${part.emphasis.text}</emphasis>"
        }
        if contains(keys(part), "prosody") {
            let mut attrs = ""
            if part.prosody.rate != null {
                attrs = attrs + " rate=\"${part.prosody.rate}\""
            }
            if part.prosody.pitch != null {
                attrs = attrs + " pitch=\"${part.prosody.pitch}\""
            }
            if part.prosody.volume != null {
                attrs = attrs + " volume=\"${part.prosody.volume}\""
            }
            out = out + "<prosody$attrs>${part.prosody.text}</prosody>"
        }
        if contains(keys(part), "sub") {
            out = out + "<sub alias=\"${part.sub.alias}\">${part.sub.text}</sub>"
        }
        if contains(keys(part), "audio") {
            out = out + "<audio src=\"${part.audio.src}\"/>"
        }
        if contains(keys(part), "p") {
            out = out + "<p>${part.p}</p>"
        }
        if contains(keys(part), "s") {
            out = out + "<s>${part.s}</s>"
        }
    }
    out + "</speak>"
}


pub fn digits(number) { ssml([
    {
        "say_as": {"interpret_as": "digits", "text": "$number"},
    },
]) }


pub fn spell(word) { ssml([
    {
        "say_as": {"interpret_as": "characters", "text": word},
    },
]) }


pub fn phone(number) { ssml([
    {
        "say_as": {"interpret_as": "telephone", "text": number},
    },
]) }


pub fn date(d) { ssml([
    {
        "say_as": {"interpret_as": "date", "text": d},
    },
]) }


pub fn currency(amount) { ssml([
    {
        "say_as": {"interpret_as": "currency", "text": amount},
    },
]) }


pub fn sequence(prompts) {
    mut actions := []
    for p in prompts {
        if p.audio_url != null { push(actions, {"action": "play", "src": p.audio_url}) } else if p.text != null { push(actions, {
            "action": "play",
            "src": p.text,
            "tts": true,
            "voice": if p.voice != null { p.voice } else { null },
            "language": if p.language != null { p.language } else { null },
        }) }
    }
    actions
}

