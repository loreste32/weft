pub fn click_to_call(ari, from_ep, to_ep, opts) -> Result[any] {
    orig_fn := fn(ep, o) -> Result[any] { ari_mod.originate(ari, ep, o) }
    webrtc_mod.click_to_call(orig_fn, from_ep, to_ep, opts)
}

