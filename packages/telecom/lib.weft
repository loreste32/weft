// telecom.mask(number) -> str
pub fn mask(number) { dialplan_mod.mask(number) }

// telecom.sip_uri(user, domain, opts?) -> str
pub fn sip_uri(user, domain, opts) { dialplan_mod.sip_uri(user, domain, opts) }
