// telecom.is_e164(number) -> bool
pub fn is_e164(number) { dialplan_mod.is_e164(number) }

// telecom.country(number) -> str|null
pub fn country(number) { dialplan_mod.country(number) }

// telecom.area_code(number) -> str|null
pub fn area_code(number) { dialplan_mod.area_code(number) }

// telecom.is_tollfree(number) -> bool
pub fn is_tollfree(number) { dialplan_mod.is_tollfree(number) }

// telecom.caller_id(name, number) -> map
