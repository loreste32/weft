pub fn answer(opts) { call.answer(opts) }


pub fn hangup(opts) { call.hangup(opts) }


pub fn play(src, opts) { call.play(src, opts) }


pub fn speak(text, opts) { call.say_text(text, opts) }


pub fn gather(opts) { call.gather(opts) }


pub fn record(opts) { call.record(opts) }


pub fn pause(seconds) { call.pause(seconds) }


pub fn transfer(dest, opts) { call.transfer(dest, opts) }


pub fn bridge(call_id, opts) { call.bridge(call_id, opts) }


pub fn conference(room, opts) { call.conference(room, opts) }


pub fn redirect(url) { call.redirect(url) }


pub fn reject(reason) { call.reject(reason) }


pub fn actions(list) { {"actions": list} }


pub fn dtmf_menu(prompt_text, routes, opts) { dtmf_mod.menu(prompt_text, routes, opts) }


pub fn dtmf_collect(prompt_text, max_digits, opts) { dtmf_mod.collect(prompt_text, max_digits, opts) }


pub fn dtmf_confirm(prompt_text, opts) { dtmf_mod.confirm(prompt_text, opts) }


pub fn iva(config) { iva_mod.create(config) }


