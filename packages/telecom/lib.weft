pub fn cdr(event) { cdr_mod.from_event(event) }


pub fn cdr_store(record, path) -> Result[any] { cdr_mod.store(record, path) }


pub fn webhook_server(port, handler) { http.serve(":$port", fn(req) {
    event := json.parse(req.body)?
    result := handler(event)
    http.json(result)
}) }


pub fn parse_event(req) -> Result[any] {
    if req.body != null && req.body != "" {
        return json.parse(req.body)
    }
    Ok(req.params)
}


