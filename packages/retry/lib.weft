pub fn run(f, opts) -> Result[any] {
    let mut max = 3
    let mut delay = 200
    let mut bk = 2.0
    let mut max_delay = 30000
    let mut on_retry = null
    if opts != null {
        if opts.max_attempts != null {
            max = opts.max_attempts
        }
        if opts.delay_ms != null {
            delay = opts.delay_ms
        }
        if opts.backoff != null {
            bk = opts.backoff
        }
        if opts.max_delay_ms != null {
            max_delay = opts.max_delay_ms
        }
        if opts.on_retry != null {
            on_retry = opts.on_retry
        }
    }
    mut attempt := 0
    mut last_err := null
    mut current_delay := delay
    while attempt < max {
        attempt = attempt + 1
        r := f()
        if r.ok {
            return Ok(r.value)
        }
        last_err = r.err
        if attempt < max {
            if on_retry != null { on_retry(attempt, last_err, current_delay) }
            time.sleep_ms(current_delay)
            current_delay = int(current_delay * bk)
            if current_delay > max_delay {
                current_delay = max_delay
            }
        }
    }
    Err(last_err)
}


pub fn linear(f, attempts, delay_ms) -> Result[any] {
    let mut max = if attempts != null { attempts } else { 3 }
    d := if delay_ms != null { delay_ms } else { 500 }
    run(f, {
        "max_attempts": max,
        "delay_ms": d,
        "backoff": 1.0,
    })
}


pub fn once(f) -> Result[any] { run(f, {"max_attempts": 2, "delay_ms": 100}) }


pub fn with_timeout(f, timeout_sec, opts) -> Result[any] {
    let mut max = 1000
    let mut delay = 200
    let mut bk = 1.5
    let mut max_delay = 5000
    if opts != null {
        if opts.delay_ms != null {
            delay = opts.delay_ms
        }
        if opts.backoff != null {
            bk = opts.backoff
        }
        if opts.max_delay_ms != null {
            max_delay = opts.max_delay_ms
        }
    }
    deadline := time.now() + timeout_sec
    mut attempt := 0
    mut last_err := null
    mut current_delay := delay
    while attempt < max {
        if time.now() > deadline {
            return Err(last_err)
        }
        attempt = attempt + 1
        r := f()
        if r.ok {
            return Ok(r.value)
        }
        last_err = r.err
        if time.now() + current_delay / 1000.0 > deadline {
            return Err(last_err)
        }
        time.sleep_ms(current_delay)
        current_delay = int(current_delay * bk)
        if current_delay > max_delay {
            current_delay = max_delay
        }
    }
    Err(last_err)
}

