pub fn render(tmpl, data) {
    mut result := tmpl
    for key in data {
        val := "$key"
        if data[key] != null {
            val = "${data[key]}"
        }
        result = str.replace(result, "{{$key}}", val)
        result = str.replace(result, "{{ $key }}", val)
    }
    result
}


pub fn render_file(path, data) -> Result[any] {
    tmpl := fs.read(path)?
    Ok(render(tmpl, data))
}


pub fn each(tmpl, items, item_name) {
    mut parts := []
    for item in items {
        mut rendered := tmpl
        if item != null {
            for key in item {
                rendered = str.replace(rendered, "{{$item_name.$key}}", "${item[key]}")
                rendered = str.replace(rendered, "{{ $item_name.$key }}", "${item[key]}")
            }
        }
        rendered = str.replace(rendered, "{{$item_name}}", "$item")
        rendered = str.replace(rendered, "{{ $item_name }}", "$item")
        push(parts, rendered)
    }
    str.join(parts, "")
}


pub fn cond(condition, if_true, if_false) {
    if condition { if_true } else {
        if if_false != null { if_false } else { "" }
    }
}


pub fn html_escape(s) {
    mut result := s
    result = str.replace(result, "&", "&amp;")
    result = str.replace(result, "<", "&lt;")
    result = str.replace(result, ">", "&gt;")
    result = str.replace(result, "\"", "&quot;")
    result = str.replace(result, "'", "&#39;")
    result
}


pub fn html(tmpl, data) {
    mut safe := {}
    for key in data {
        if data[key] != null {
            safe[key] = html_escape("${data[key]}")
        } else {
            safe[key] = ""
        }
    }
    render(tmpl, safe)
}

