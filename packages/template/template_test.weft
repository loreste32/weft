use "./lib.weft" as t

fn test_html_escape_basic {
    r := t.html_escape("<b>hi</b>")
    test.is_true(str.contains(r, "&lt;"))
    test.is_true(str.contains(r, "&gt;"))
}

fn test_html_escape_ampersand {
    r := t.html_escape("a & b")
    test.is_true(str.contains(r, "&amp;"))
}

fn test_render {
    r := t.render("hello {{name}}", {"name": "world"})
    test.eq(r, "hello world")
}

fn test_render_multiple {
    r := t.render("{{a}} and {{b}}", {"a": "x", "b": "y"})
    test.eq(r, "x and y")
}

fn test_cond_true {
    test.eq(t.cond(true, "yes", "no"), "yes")
}

fn test_cond_false {
    test.eq(t.cond(false, "yes", "no"), "no")
}

