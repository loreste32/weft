pub fn red(s) { "\\x1b[31m$s\\x1b[0m" }


pub fn green(s) { "\\x1b[32m$s\\x1b[0m" }


pub fn yellow(s) { "\\x1b[33m$s\\x1b[0m" }


pub fn blue(s) { "\\x1b[34m$s\\x1b[0m" }


pub fn magenta(s) { "\\x1b[35m$s\\x1b[0m" }


pub fn cyan(s) { "\\x1b[36m$s\\x1b[0m" }


pub fn white(s) { "\\x1b[37m$s\\x1b[0m" }


pub fn gray(s) { "\\x1b[90m$s\\x1b[0m" }


pub fn bold(s) { "\\x1b[1m$s\\x1b[0m" }


pub fn dim(s) { "\\x1b[2m$s\\x1b[0m" }


pub fn italic(s) { "\\x1b[3m$s\\x1b[0m" }


pub fn underline(s) { "\\x1b[4m$s\\x1b[0m" }


pub fn strike(s) { "\\x1b[9m$s\\x1b[0m" }


pub fn bg_red(s) { "\\x1b[41m$s\\x1b[0m" }


pub fn bg_green(s) { "\\x1b[42m$s\\x1b[0m" }


pub fn bg_yellow(s) { "\\x1b[43m$s\\x1b[0m" }


pub fn bg_blue(s) { "\\x1b[44m$s\\x1b[0m" }


pub fn strip(s) { re.replace_all(s, `\x1b\[[0-9;]*m`, "") }


pub fn ok(msg) { green("✓") + " " + msg }


pub fn fail(msg) { red("✗") + " " + msg }


pub fn warn(msg) { yellow("⚠") + " " + msg }


pub fn info(msg) { blue("ℹ") + " " + msg }


pub fn header(msg) { "\\x1b[1;4m$msg\\x1b[0m" }


pub fn code(s) { dim("`$s`") }

