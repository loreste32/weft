// Public classical estimators. The bodies live in knn.weft, kmeans.weft, and tree.weft.
// Import names stay off the public function names so `knn` does not hide its module.

use "./knn.weft" as neighbors
use "./kmeans.weft" as lloyd
use "./tree.weft" as cart

pub fn knn_predict(features, targets, queries, k, weighted = null) -> Result[any] {
    neighbors.knn_predict(features, targets, queries, k, weighted)
}

pub fn knn(features, targets, queries, k, weighted = null) -> Result[any] {
    neighbors.knn(features, targets, queries, k, weighted)
}

pub fn kmeans(features, k, opts = null) -> Result[any] {
    lloyd.kmeans(features, k, opts)
}

pub fn decision_tree_fit(features, targets, opts = null) -> Result[any] {
    cart.decision_tree_fit(features, targets, opts)
}

pub fn tree_fit(features, targets, opts = null) -> Result[any] {
    cart.tree_fit(features, targets, opts)
}

pub fn decision_tree_predict(model, features) -> Result[any] {
    cart.decision_tree_predict(model, features)
}

pub fn tree_predict(model, features) -> Result[any] {
    cart.tree_predict(model, features)
}

pub fn decision_tree_regressor_fit(features, targets, opts = null) -> Result[any] {
    cart.decision_tree_regressor_fit(features, targets, opts)
}

pub fn decision_tree_regressor_predict(model, features) -> Result[any] {
    cart.decision_tree_regressor_predict(model, features)
}
