pub fn accuracy(preds, labels) {
    mut ok := 0
    mut i := 0
    mut n := len(preds)
    if len(labels) < n {
        n = len(labels)
    }
    if n == 0 {
        return 0.0
    }
    while i < n {
        if preds[i] == labels[i] {
            ok = ok + 1
        }
        i = i + 1
    }
    ok * 1.0 / n
}


pub fn mse(preds, labels) {
    mut s := 0.0
    mut i := 0
    mut n := len(preds)
    if len(labels) < n {
        n = len(labels)
    }
    if n == 0 {
        return 0.0
    }
    while i < n {
        d := preds[i] - labels[i]
        s = s + d * d
        i = i + 1
    }
    s / n
}


pub fn split(rows, train_ratio) {
    n := len(rows)
    mut cut := n * train_ratio
    mut k := 0
    while k < n && k < cut {
        k = k + 1
    }
    k = 0
    while k < n && k * 1.0 / n < train_ratio {
        k = k + 1
    }
    mut train := []
    mut test := []
    mut i := 0
    while i < n {
        if i < k { push(train, rows[i]) } else { push(test, rows[i]) }
        i = i + 1
    }
    {"train": train, "test": test}
}

