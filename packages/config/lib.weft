// config — unified configuration loader with env overlay and validation.

pub fn load(path) -> Result[any] {
    content := fs.read(path)?
    if str.ends_with(path, ".json") {
        return json.parse(content)
    }
    if str.ends_with(path, ".yaml") || str.ends_with(path, ".yml") {
        return yaml.parse(content)
    }
    if str.ends_with(path, ".toml") {
        return toml.parse(content)
    }
    if str.ends_with(path, ".env") {
        return Ok(load_env(path)?)
    }
    Err("unsupported config format: " + path)
}

pub fn load_env(path) -> Result[any] {
    content := fs.read(path)?
    let mut result = {}
    lines := str.lines(content)
    for line in lines {
        trimmed := str.trim(line)
        if trimmed == "" || str.starts_with(trimmed, "#") {
            continue
        }
        idx := str.find(trimmed, "=")
        if idx >= 0 {
            key := str.trim(str.slice(trimmed, 0, idx))
            let mut val = str.trim(str.slice(trimmed, idx + 1))
            if len(val) >= 2 {
                if (str.starts_with(val, "\"") && str.ends_with(val, "\"")) || (str.starts_with(val, "'") && str.ends_with(val, "'")) {
                    val = str.slice(val, 1, len(val) - 1)
                }
            }
            result[key] = val
        }
    }
    Ok(result)
}

pub fn load_json(path) -> Result[any] {
    content := fs.read(path)?
    json.parse(content)
}

pub fn load_yaml(path) -> Result[any] {
    content := fs.read(path)?
    yaml.parse(content)
}

pub fn load_toml(path) -> Result[any] {
    content := fs.read(path)?
    toml.parse(content)
}

pub fn get(cfg, key) {
    parts := str.split(key, ".")
    let mut current = cfg
    for part in parts {
        if current == null {
            return null
        }
        // only traverse maps — return null for non-map intermediates
        if len(keys(current)) == 0 && current != {} {
            return null
        }
        if !contains(keys(current), part) {
            return null
        }
        current = current[part]
    }
    current
}

pub fn get_or(cfg, key, default_val) {
    v := get(cfg, key)
    if v == null { default_val } else { v }
}

pub fn require(cfg, keys) -> Result[any] {
    let mut missing = []
    for key in keys {
        if get(cfg, key) == null {
            missing = push(missing, key)
        }
    }
    if len(missing) > 0 {
        return Err("missing required config keys: " + str.join(missing, ", "))
    }
    Ok(cfg)
}

pub fn merge(base, overlay) {
    let mut result = base
    for key in overlay {
        result[key] = overlay[key]
    }
    result
}

pub fn validate(cfg, schema) -> Result[any] {
    let mut errors = []
    for key in schema {
        rule := schema[key]
        val := get(cfg, key)
        if rule.required == true && val == null {
            errors = push(errors, key + " is required")
            continue
        }
    }
    if len(errors) > 0 {
        return Err(str.join(errors, "; "))
    }
    Ok(cfg)
}

pub fn from_env(keys) {
    let mut result = {}
    for key in keys {
        v := env.get(key)
        if v != null {
            result[key] = v
        }
    }
    result
}
