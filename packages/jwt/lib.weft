pub fn decode(token) -> Result[any] {
    parts := str.split(token, ".")
    ensure(len(parts) == 3, "invalid JWT: expected 3 parts, got ${len(parts)}")?
    header := json.parse(base64.url_decode(parts[0])?)?
    payload := json.parse(base64.url_decode(parts[1])?)?
    Ok({
        "header": header,
        "payload": payload,
        "signature": parts[2],
    })
}


pub fn claims(token) -> Result[any] {
    d := decode(token)?
    Ok(d.payload)
}


pub fn expired(token) -> Result[any] {
    c := claims(token)?
    if c.exp == null {
        return Ok(false)
    }
    Ok(time.now() > c.exp)
}


pub fn expires_in(token) -> Result[any] {
    c := claims(token)?
    if c.exp == null {
        return Err("no exp claim")
    }
    Ok(int(c.exp - time.now()))
}


pub fn has_claim(token, key) -> Result[any] {
    c := claims(token)?
    Ok(c[key] != null)
}


pub fn issuer(token) -> Result[any] {
    c := claims(token)?
    Ok(c.iss)
}


pub fn subject(token) -> Result[any] {
    c := claims(token)?
    Ok(c.sub)
}


pub fn audience(token) -> Result[any] {
    c := claims(token)?
    Ok(c.aud)
}


pub fn summary(token) -> Result[any] {
    d := decode(token)?
    c := d.payload
    Ok({
        "alg": d.header.alg,
        "typ": d.header.typ,
        "iss": c.iss,
        "sub": c.sub,
        "exp": c.exp,
        "expired": if c.exp != null { time.now() > c.exp } else { null },
        "claims": len(c),
    })
}

