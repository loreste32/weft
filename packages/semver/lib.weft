pub fn parse(s) -> Result[any] {
    ensure(s != null && s != "", "empty version string")?
    raw := s
    if str.starts_with(s, "v") {
        s = str.slice(s, 1)
    }
    pre := ""
    if str.contains(s, "-") {
        parts := str.split(s, "-")
        s = parts[0]
        pre = str.join(str.slice(parts, 1), "-")
    }
    parts := str.split(s, ".")
    ensure(len(parts) == 3, "version must be major.minor.patch, got: $raw")?
    major := int.parse(parts[0]).unwrap_or(-1)
    minor := int.parse(parts[1]).unwrap_or(-1)
    patch := int.parse(parts[2]).unwrap_or(-1)
    ensure(major >= 0 && minor >= 0 && patch >= 0, "invalid version numbers in: $raw")?
    Ok({
        "major": major,
        "minor": minor,
        "patch": patch,
        "pre": pre,
        "raw": raw,
    })
}


pub fn compare(a, b) -> Result[any] {
    va := parse(a)?
    vb := parse(b)?
    if va.major != vb.major {
        return Ok(if va.major < vb.major { -1 } else { 1 })
    }
    if va.minor != vb.minor {
        return Ok(if va.minor < vb.minor { -1 } else { 1 })
    }
    if va.patch != vb.patch {
        return Ok(if va.patch < vb.patch { -1 } else { 1 })
    }
    if va.pre != "" && vb.pre == "" {
        return Ok(-1)
    }
    if va.pre == "" && vb.pre != "" {
        return Ok(1)
    }
    if va.pre < vb.pre {
        return Ok(-1)
    }
    if va.pre > vb.pre {
        return Ok(1)
    }
    Ok(0)
}


pub fn gt(a, b) -> Result[any] { Ok(compare(a, b)? == 1) }


pub fn gte(a, b) -> Result[any] { Ok(compare(a, b)? >= 0) }


pub fn lt(a, b) -> Result[any] { Ok(compare(a, b)? == -1) }


pub fn lte(a, b) -> Result[any] { Ok(compare(a, b)? <= 0) }


pub fn eq(a, b) -> Result[any] { Ok(compare(a, b)? == 0) }


pub fn satisfies(version, constraint) -> Result[any] {
    v := parse(version)?
    c := str.trim(constraint)
    if str.starts_with(c, "^") {
        base := parse(str.slice(c, 1))?
        if v.major != base.major {
            return Ok(false)
        }
        return gte(version, str.slice(c, 1))
    }
    if str.starts_with(c, "~") {
        base := parse(str.slice(c, 1))?
        if v.major != base.major || v.minor != base.minor {
            return Ok(false)
        }
        return gte(version, str.slice(c, 1))
    }
    if str.starts_with(c, ">=") {
        return gte(version, str.slice(c, 2))
    }
    if str.starts_with(c, "<=") {
        return lte(version, str.slice(c, 2))
    }
    if str.starts_with(c, ">") {
        return gt(version, str.slice(c, 1))
    }
    if str.starts_with(c, "<") {
        return lt(version, str.slice(c, 1))
    }
    if str.starts_with(c, "=") {
        return eq(version, str.slice(c, 1))
    }
    eq(version, c)
}


pub fn bump(version, part) -> Result[any] {
    v := parse(version)?
    match part {
        "major" { Ok("${v.major + 1}.0.0") }
        "minor" { Ok("${v.major}.${v.minor + 1}.0") }
        "patch" { Ok("${v.major}.${v.minor}.${v.patch + 1}") }
        _ { Err("part must be major, minor, or patch") }
    }
}


pub fn format(v) {
    s := "${v.major}.${v.minor}.${v.patch}"
    if v.pre != "" {
        s = "$s-${v.pre}"
    }
    s
}


pub fn valid(s) {
    r := parse(s)
    r.ok
}

