// auth — authentication utilities for web applications and APIs.

pub fn hmac_sign(key, message) -> Result[any] {
    ensure(len(key) > 0, "key must not be empty")?
    ensure(len(message) > 0, "message must not be empty")?
    Ok(crypto.hmac_sha256(key, message))
}

pub fn hmac_verify(key, message, signature) -> Result[any] {
    expected := hmac_sign(key, message)?
    Ok(expected == signature)
}

pub fn hash_password(password) -> Result[any] {
    ensure(len(password) >= 8, "password must be at least 8 characters")?
    salt := crypto.random_hex(16)
    hash := crypto.sha256(salt + password)
    Ok({
        "hash": hash,
        "salt": salt,
        "algorithm": "sha256",
    })
}

pub fn verify_password(password, record) -> Result[any] {
    hash := crypto.sha256(record.salt + password)
    Ok(hash == record.hash)
}

pub fn generate_token(length) -> str {
    n := if length != null { length } else { 32 }
    crypto.random_hex(n)
}

pub fn generate_api_key(prefix) -> str {
    p := if prefix != null { prefix + "_" } else { "" }
    p + crypto.random_hex(24)
}

pub fn basic_auth_header(username, password) -> str {
    "Basic " + base64.encode(username + ":" + password)
}

pub fn parse_basic_auth(header) -> Result[any] {
    ensure(str.starts_with(header, "Basic "), "not a Basic auth header")?
    decoded := base64.decode(str.slice(header, 6))?
    // find first colon to split user:password (password may contain colons)
    idx := str.find(decoded, ":")
    ensure(idx >= 0, "invalid Basic auth format")?
    Ok({
        "username": str.slice(decoded, 0, idx),
        "password": str.slice(decoded, idx + 1),
    })
}

pub fn bearer_header(token) -> str {
    "Bearer " + token
}

pub fn parse_bearer(header) -> Result[any] {
    ensure(str.starts_with(header, "Bearer "), "not a Bearer token header")?
    Ok(str.slice(header, 7))
}

pub fn oauth_authorize_url(base_url, client_id, redirect_uri, scope, state) -> str {
    let mut q = "response_type=code&client_id=" + url.escape(client_id) + "&redirect_uri=" + url.escape(redirect_uri)
    if scope != null {
        q = q + "&scope=" + url.escape(scope)
    }
    if state != null {
        q = q + "&state=" + url.escape(state)
    }
    base_url + "?" + q
}

pub fn oauth_token_request(token_url, client_id, client_secret, code, redirect_uri) -> Result[any] {
    body := "grant_type=authorization_code"
        + "&code=" + url.escape(code)
        + "&client_id=" + url.escape(client_id)
        + "&client_secret=" + url.escape(client_secret)
        + "&redirect_uri=" + url.escape(redirect_uri)
    resp := http.post(token_url, body, {
        "headers": {"Content-Type": "application/x-www-form-urlencoded"},
    })?
    json.parse(resp.body)
}
