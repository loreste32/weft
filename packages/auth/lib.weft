// auth — authentication utilities for web applications and APIs.

pub fn hmac_sign(key, message) -> Result[any] {
    ensure(len(key) > 0, "key must not be empty")?
    ensure(len(message) > 0, "message must not be empty")?
    Ok(crypto.hmac_sha256(key, message))
}

pub fn hmac_verify(key, message, signature) -> Result[any] {
    expected := hmac_sign(key, message)?
    Ok(crypto.equal(expected, signature))
}

// hash_password uses Argon2id with stored parameters for forward compatibility.
pub fn hash_password(password, opts) -> Result[any] {
    ensure(len(password) >= 8, "password must be at least 8 characters")?
    salt := crypto.random_hex(16)
    t := if opts != null && opts.time != null { opts.time } else { 1 }
    mem := if opts != null && opts.memory != null { opts.memory } else { 65536 }
    threads := if opts != null && opts.threads != null { opts.threads } else { 4 }
    key_len := if opts != null && opts.key_len != null { opts.key_len } else { 32 }
    // bound parameters to prevent DoS
    ensure(t >= 1 && t <= 100, "argon2id time must be 1-100")?
    ensure(mem >= 1024 && mem <= 4194304, "argon2id memory must be 1024-4194304 KiB")?
    ensure(threads >= 1 && threads <= 64, "argon2id threads must be 1-64")?
    ensure(key_len >= 16 && key_len <= 64, "argon2id key_len must be 16-64")?
    hash := crypto.argon2id(password, salt, t, mem, threads, key_len)
    Ok({
        "hash": hash,
        "salt": salt,
        "algorithm": "argon2id",
        "version": 19,
        "time": t,
        "memory": mem,
        "threads": threads,
        "key_len": key_len,
    })
}

// hash_password_pbkdf2 uses PBKDF2-HMAC-SHA-256 as a portable alternative.
pub fn hash_password_pbkdf2(password, iterations) -> Result[any] {
    ensure(len(password) >= 8, "password must be at least 8 characters")?
    salt := crypto.random_hex(16)
    iter := if iterations != null { iterations } else { 100000 }
    ensure(iter >= 10000 && iter <= 10000000, "pbkdf2 iterations must be 10000-10000000")?
    hash := crypto.pbkdf2(password, salt, iter, 32)
    Ok({
        "hash": hash,
        "salt": salt,
        "algorithm": "pbkdf2",
        "iterations": iter,
        "key_len": 32,
    })
}

pub fn verify_password(password, record) -> Result[any] {
    ensure(record != null, "password record is null")?
    ensure(record.hash != null && record.salt != null, "malformed password record")?
    alg := if record.algorithm != null { record.algorithm } else { "argon2id" }
    if alg == "argon2id" {
        // Bound params before calling native function
        t := if record.time != null { record.time } else { 1 }
        mem := if record.memory != null { record.memory } else { 65536 }
        threads := if record.threads != null { record.threads } else { 4 }
        key_len := if record.key_len != null { record.key_len } else { 32 }
        ensure(t >= 1 && t <= 10, "argon2id time out of safe range (1-10)")?
        ensure(mem >= 8192 && mem <= 262144, "argon2id memory out of safe range (8-256 MiB)")?
        ensure(threads >= 1 && threads <= 16, "argon2id threads out of safe range (1-16)")?
        ensure(key_len >= 16 && key_len <= 64, "argon2id key_len out of safe range")?
        expected := crypto.argon2id(password, record.salt, t, mem, threads, key_len)
        return Ok(crypto.equal(expected, record.hash))
    }
    if alg == "pbkdf2" {
        iter := if record.iterations != null { record.iterations } else { 100000 }
        ensure(iter >= 10000 && iter <= 10000000, "pbkdf2 iterations out of safe range")?
        key_len := if record.key_len != null { record.key_len } else { 32 }
        expected := crypto.pbkdf2(password, record.salt, iter, key_len)
        return Ok(crypto.equal(expected, record.hash))
    }
    if alg == "sha256-10k" {
        // Legacy format — verify but flag for rehash
        let mut hash = record.salt + password
        rounds := if record.rounds != null { record.rounds } else { 10000 }
        ensure(rounds >= 1 && rounds <= 100000, "sha256-10k rounds out of range")?
        let mut i = 0
        while i < rounds {
            hash = crypto.sha256(hash + record.salt)
            i = i + 1
        }
        return Ok(crypto.equal(hash, record.hash))
    }
    Err("unknown password algorithm: $alg")
}

// needs_rehash checks if a password record should be upgraded.
pub fn needs_rehash(record) {
    if record == null { return true }
    if record.algorithm == null { return true }
    // non-argon2id always needs rehash
    if record.algorithm != "argon2id" { return true }
    // check all stored params against current defaults
    if record.version == null || record.version < 19 { return true }
    if record.time == null || record.time < 1 { return true }
    if record.memory == null || record.memory < 65536 { return true }
    if record.threads == null || record.threads < 4 { return true }
    if record.key_len == null || record.key_len < 32 { return true }
    false
}

pub fn generate_token(length) -> str {
    n := if length != null { length } else { 32 }
    crypto.random_hex(n)
}

pub fn generate_api_key(prefix) -> str {
    p := if prefix != null { prefix + "_" } else { "" }
    p + crypto.random_hex(24)
}

pub fn basic_auth_header(username, password) -> str {
    "Basic " + base64.encode(username + ":" + password)
}

pub fn parse_basic_auth(header) -> Result[any] {
    ensure(str.starts_with(header, "Basic "), "not a Basic auth header")?
    decoded := base64.decode(str.slice(header, 6))?
    idx := str.find(decoded, ":")
    ensure(idx >= 0, "invalid Basic auth format")?
    Ok({
        "username": str.slice(decoded, 0, idx),
        "password": str.slice(decoded, idx + 1),
    })
}

pub fn bearer_header(token) -> str {
    "Bearer " + token
}

pub fn parse_bearer(header) -> Result[any] {
    ensure(str.starts_with(header, "Bearer "), "not a Bearer token header")?
    Ok(str.slice(header, 7))
}

pub fn oauth_authorize_url(base_url, client_id, redirect_uri, scope, state) -> str {
    let mut q = "response_type=code&client_id=" + url.escape(client_id) + "&redirect_uri=" + url.escape(redirect_uri)
    if scope != null { q = q + "&scope=" + url.escape(scope) }
    if state != null { q = q + "&state=" + url.escape(state) }
    base_url + "?" + q
}

pub fn oauth_token_request(token_url, client_id, client_secret, code, redirect_uri) -> Result[any] {
    body := "grant_type=authorization_code"
        + "&code=" + url.escape(code)
        + "&client_id=" + url.escape(client_id)
        + "&client_secret=" + url.escape(client_secret)
        + "&redirect_uri=" + url.escape(redirect_uri)
    resp := http.post(token_url, body, {
        "headers": {"Content-Type": "application/x-www-form-urlencoded"},
    })?
    json.parse(resp.body)
}
