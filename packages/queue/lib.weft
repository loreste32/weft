// queue — in-process job queue with workers, retries, and dead-letter.

pub fn new(opts) {
    o := if opts != null { opts } else { {} }
    {
        "items": [],
        "dead": [],
        "processed": 0,
        "failed": 0,
        "max_retries": if o.max_retries != null { o.max_retries } else { 3 },
    }
}

pub fn push(q, job) {
    let mut items = q.items
    items = items + [{"payload": job, "attempts": 0, "id": uuid.v4()}]
    q.items = items
    q
}

pub fn process(q, handler) {
    let mut results = []
    let mut remaining = []
    let mut dead = q.dead
    let mut processed = q.processed
    let mut failed = q.failed
    for item in q.items {
        result := handler(item.payload)
        // handler returns Ok(v) or Err(e) — check .ok field
        if result.ok != null && result.ok == true {
            results = results + [{"id": item.id, "status": "ok"}]
            processed = processed + 1
        } else {
            let mut att = item.attempts + 1
            if att >= q.max_retries {
                dead = dead + [{"id": item.id, "payload": item.payload, "attempts": att}]
                failed = failed + 1
            } else {
                remaining = remaining + [{"payload": item.payload, "attempts": att, "id": item.id}]
            }
        }
    }
    q.items = remaining
    q.dead = dead
    q.processed = processed
    q.failed = failed
    Ok({"queue": q, "results": results})
}

pub fn stats(q) {
    {
        "pending": len(q.items),
        "processed": q.processed,
        "failed": q.failed,
        "dead_letter": len(q.dead),
    }
}

pub fn retry_dead(q, handler) {
    let mut items = q.items
    for item in q.dead {
        items = items + [{"payload": item.payload, "attempts": 0, "id": item.id}]
    }
    q.items = items
    q.dead = []
    process(q, handler)
}

pub fn dead_letter(q) {
    q.dead
}

pub fn drain(q) {
    items := q.items
    q.items = []
    {"queue": q, "drained": items}
}
