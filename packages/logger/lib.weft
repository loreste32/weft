// logger — structured logging with levels, JSON output, and child loggers.

fn level_num(level) {
    if level == "debug" { 0 }
    else if level == "info" { 1 }
    else if level == "warn" { 2 }
    else if level == "error" { 3 }
    else if level == "fatal" { 4 }
    else { 1 }
}

pub fn new(opts) {
    let mut level = "info"
    let mut format = "text"
    let mut fields = {}
    if opts != null {
        if contains(keys(opts), "level") { level = opts["level"] }
        if contains(keys(opts), "format") { format = opts["format"] }
        if contains(keys(opts), "fields") { fields = opts["fields"] }
    }
    {"level": level, "format": format, "fields": fields}
}

fn should_log(logger, level) {
    level_num(level) >= level_num(logger.level)
}

fn emit(logger, level, msg, extra) {
    if !should_log(logger, level) { return null }
    ts := time.format(time.now(), "2006-01-02T15:04:05Z07:00")
    let mut fields = logger.fields
    if extra != null {
        for k in extra {
            fields[k] = extra[k]
        }
    }
    if logger.format == "json" {
        let mut entry = {"time": ts, "level": level, "msg": msg}
        for k in fields {
            entry[k] = fields[k]
        }
        say(json.encode(entry))
    } else {
        prefix := ts + " [" + str.upper(level) + "] "
        let mut suffix = ""
        if len(fields) > 0 {
            let mut parts = []
            for k in fields {
                parts = parts + [k + "=" + str(fields[k])]
            }
            suffix = " " + str.join(parts, " ")
        }
        say(prefix + msg + suffix)
    }
}

pub fn debug(logger, msg, extra) { emit(logger, "debug", msg, extra) }
pub fn info(logger, msg, extra) { emit(logger, "info", msg, extra) }
pub fn warn(logger, msg, extra) { emit(logger, "warn", msg, extra) }
pub fn error(logger, msg, extra) { emit(logger, "error", msg, extra) }
pub fn fatal(logger, msg, extra) { emit(logger, "fatal", msg, extra) }

pub fn with(logger, fields) {
    let mut merged = logger.fields
    for k in fields {
        merged[k] = fields[k]
    }
    {
        "level": logger.level,
        "format": logger.format,
        "fields": merged,
    }
}

pub fn child(logger, name) {
    with(logger, {"logger": name})
}

pub fn set_level(logger, level) {
    logger.level = level
    logger
}

pub fn json_format(logger) {
    logger.format = "json"
    logger
}

pub fn text_format(logger) {
    logger.format = "text"
    logger
}
