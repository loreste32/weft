use math


use json


use http


pub fn new { {
    "_embed_store": true,
    "docs": [],
    "vectors": [],
    "meta": [],
} }


pub fn add(store, id, text, embed_fn) {
    vec := embed_fn(text)
    docs := push(store.docs, id)
    vectors := push(store.vectors, vec)
    meta := push(store.meta, {"id": id, "text": text})
    {
        "_embed_store": true,
        "docs": docs,
        "vectors": vectors,
        "meta": meta,
    }
}


pub fn add_batch(store, items, embed_fn) {
    mut s := store
    for item in items {
        s = add(s, item.id, item.text, embed_fn)
    }
    s
}


pub fn search(store, query, k, embed_fn) {
    q_vec := embed_fn(query)
    mut scored := []
    mut i := 0
    while i < len(store.vectors) {
        score := cosine(q_vec, store.vectors[i])
        scored = push(scored, {
            "id": store.docs[i],
            "text": store.meta[i].text,
            "score": score,
        })
        i = i + 1
    }
    sorted := sort(scored, fn(a, b) { a.score < b.score })
    top_k := if k > len(sorted) { len(sorted) } else { k }
    slice(sorted, 0, top_k)
}


pub fn size(store) { len(store.docs) }


pub fn cosine(a, b) {
    if len(a) != len(b) {
        return 0
    }
    mut dot := 0.0
    mut na := 0.0
    mut nb := 0.0
    mut i := 0
    while i < len(a) {
        dot = dot + a[i] * b[i]
        na = na + a[i] * a[i]
        nb = nb + b[i] * b[i]
        i = i + 1
    }
    denom := math.sqrt(na) * math.sqrt(nb)
    if denom == 0 {
        return 0
    }
    dot / denom
}


pub fn openai_embed(text, opts) -> Result[any] {
    base := if opts != null && opts["base_url"] != null { opts["base_url"] } else { env.get("OPENAI_BASE_URL", "https://api.openai.com/v1") }
    key := if opts != null && opts["api_key"] != null { opts["api_key"] } else { env.get("OPENAI_API_KEY", "") }
    model := if opts != null && opts["model"] != null { opts["model"] } else { "text-embedding-3-small" }
    body := json.stringify({"input": text, "model": model})
    r := http.post(base + "/embeddings", body, {
        "headers": {
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
        },
    })?
    data := json.parse(r.body)?
    data.data[0].embedding
}


pub fn save(store, path) -> Result[any] {
    data := json.stringify({
        "docs": store.docs,
        "vectors": store.vectors,
        "meta": store.meta,
    })
    fs.write(path, data)?
}


pub fn load(path) -> Result[any] {
    raw := fs.read(path)?
    data := json.parse(raw)?
    Ok({
        "_embed_store": true,
        "docs": data.docs,
        "vectors": data.vectors,
        "meta": data.meta,
    })
}

