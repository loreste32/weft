// http_router — structured HTTP routing with path params, middleware, and groups.
//
//   weft registry install http_router
//   use http_router

// http_router.new() -> map
// Create a new router.
pub fn new() {
    {"_routes": [], "_middleware": [], "_groups": []}
}

// http_router.get(router, path, handler) -> router
pub fn get(r, path, handler) { add_route(r, "GET", path, handler) }

// http_router.post(router, path, handler) -> router
pub fn post(r, path, handler) { add_route(r, "POST", path, handler) }

// http_router.put(router, path, handler) -> router
pub fn put(r, path, handler) { add_route(r, "PUT", path, handler) }

// http_router.delete(router, path, handler) -> router
pub fn delete(r, path, handler) { add_route(r, "DELETE", path, handler) }

// http_router.patch(router, path, handler) -> router
pub fn patch(r, path, handler) { add_route(r, "PATCH", path, handler) }

// http_router.any(router, path, handler) -> router
pub fn any(r, path, handler) { add_route(r, "*", path, handler) }

fn add_route(r, method, path, handler) {
    push(r._routes, {"method": method, "path": path, "handler": handler, "middleware": []})
    r
}

// http_router.use(router, middleware_fn) -> router
// Add middleware. middleware_fn(req, next) should call next(req) to continue.
pub fn middleware(r, mw) {
    push(r._middleware, mw)
    r
}

// http_router.group(router, prefix, setup_fn) -> router
// Group routes under a prefix.
pub fn group(r, prefix, setup_fn) {
    sub := new()
    setup_fn(sub)
    for route in sub._routes {
        route.path = "$prefix${route.path}"
        push(r._routes, route)
    }
    r
}

// http_router.serve(router, port) -> unit
// Start the HTTP server with this router.
pub fn serve(r, port) {
    http.serve(":$port", fn(req) {
        handle(r, req)
    })
}

// http_router.handle(router, req) -> response
// Match a request against the router (for custom servers).
pub fn handle(r, req) {
    for route in r._routes {
        if route.method != "*" && route.method != req.method { continue }
        params := match_path(route.path, req.path)
        if params != null {
            req.params = params
            // run middleware chain
            handler := route.handler
            mut i := len(r._middleware) - 1
            while i >= 0 {
                mw := r._middleware[i]
                inner := handler
                handler = fn(r) { mw(r, inner) }
                i = i - 1
            }
            return handler(req)
        }
    }
    http.text(404, "not found")
}

fn match_path(pattern, actual) {
    p_parts := str.split(str.trim(pattern, "/"), "/")
    a_parts := str.split(str.trim(actual, "/"), "/")
    if len(p_parts) != len(a_parts) { return null }

    params := {}
    mut i := 0
    while i < len(p_parts) {
        if str.starts_with(p_parts[i], ":") {
            key := str.slice(p_parts[i], 1)
            params[key] = a_parts[i]
        } else if p_parts[i] != a_parts[i] {
            return null
        }
        i = i + 1
    }
    params
}

// http_router.cors(opts?) -> middleware
// CORS middleware.
pub fn cors(opts) {
    origin := "*"
    methods := "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    headers := "Content-Type, Authorization"
    if opts != null {
        if opts.origin != null { origin = opts.origin }
        if opts.methods != null { methods = opts.methods }
        if opts.headers != null { headers = opts.headers }
    }
    fn(req, next) {
        if req.method == "OPTIONS" {
            return http.text(204, "", {
                "Access-Control-Allow-Origin": origin,
                "Access-Control-Allow-Methods": methods,
                "Access-Control-Allow-Headers": headers,
            })
        }
        resp := next(req)
        resp
    }
}

// http_router.logger() -> middleware
// Request logging middleware.
pub fn logger() {
    fn(req, next) {
        start := time.now()
        resp := next(req)
        elapsed := int((time.now() - start) * 1000)
        log.info("${req.method} ${req.path} (${elapsed}ms)")
        resp
    }
}
