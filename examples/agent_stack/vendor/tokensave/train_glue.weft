pub fn to_example(ep) {
    mut instr := "" + ep.ask
    if contains(keys(ep), "goal") && ep.goal != "" {
        instr = "" + ep.ask
    }
    mut ctx := ""
    if contains(keys(ep), "docs") && ep.docs != null {
        mut i := 0
        while i < len(ep.docs) {
            ctx = ctx + "- " + ep.docs[i] + "\n"
            i = i + 1
        }
    }
    mut out := ""
    if contains(keys(ep), "note") && ep.note != "" && ep.ok {
        out = "" + ep.note
    } else {
        mut kind := "short"
        if contains(keys(ep), "kind") {
            kind = "" + ep.kind
        }
        out = "Goal: " + ep.goal + "\nKind: " + kind + "\n"
        if ctx != "" {
            out = out + "Context:\n" + ctx
        }
        out = out + "Answer using only the context. Be brief and accurate."
    }
    {
        "id": ep.id,
        "instruction": instr,
        "input": ctx,
        "output": out,
        "tags": ["tokensave", "memory"],
    }
}


pub fn export_train(memory_path, out_jsonl) -> Result[any] {
    raw := fs.read(memory_path)?
    data := json.parse(raw)?
    mut lines := ""
    mut n := 0
    if contains(keys(data), "episodes") {
        for ep in data.episodes {
            mut okv := true
            if contains(keys(ep), "ok") {
                okv = ep.ok
            }
            if !okv {
                continue
            }
            ex := to_example(ep)
            lines = lines + json.stringify(ex) + "\n"
            n = n + 1
        }
    }
    fs.write(out_jsonl, lines)?
    Ok({"n": n, "path": out_jsonl})
}


pub fn gold_row(ask, answer, kind) {
    mut k := "short"
    if kind != null && kind != "" {
        k = "" + kind
    }
    {
        "id": "gold-" + time.now(),
        "instruction": "" + ask,
        "input": "",
        "output": "" + answer,
        "tags": ["tokensave", "gold", k],
    }
}


pub fn append_gold(path, ask, answer, kind) -> Result[any] {
    row := gold_row(ask, answer, kind)
    mut prev := ""
    if fs.exists(path) {
        prev = fs.read(path)?
    }
    fs.write(path, prev + json.stringify(row) + "\n")?
    Ok(row)
}

