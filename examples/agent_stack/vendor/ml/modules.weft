use json
use fs
use math
use warp
use "./autograd.weft" as ag

// Small composable trainable modules and checkpoint boundaries. Module maps
// contain autograd nodes at runtime; checkpoint files contain only plain
// parameter values, optimizer state, and user metadata, never graph links.

// seed(value) returns a deterministic RNG handle. Pass it to linear_module as
// the optional third argument for reproducible initialization.
pub fn seed(value) -> Result[any] {
    if _kind(value) != "int" { return Err("ml.seed expects an integer") }
    Ok({"_ml_rng": true, "state": if value == 0 { 1 } else { value }})
}

fn _next_unit(rng) {
    // Numerical Recipes LCG; returns [0, 1) and mutates rng.state.
    let mut next = (rng.state * 1664525 + 1013904223) % 2147483647
    if next < 0 { next = -next }
    rng.state = next
    value := (next + 0.0) / 2147483647.0
    value
}

fn _rand_array(shape, scale, rng) {
    let mut n = 1
    for dim in shape { n = n * dim }
    let mut data = []
    let mut i = 0
    while i < n {
        value := _next_unit(rng)
        data = push(data, (value * 2.0 - 1.0) * scale)
        i = i + 1
    }
    warp.array(data, shape)
}

pub fn linear_module(in_features, out_features, seed_arg) -> Result[any] {
    if _kind(in_features) != "int" || in_features <= 0 { return Err("ml.linear_module in_features must be positive") }
    if _kind(out_features) != "int" || out_features <= 0 { return Err("ml.linear_module out_features must be positive") }
    scale := 1.0 / math.sqrt(in_features + 0.0)
    rng := if seed_arg == null {
        {"_ml_rng": true, "state": 1}
    } else if _kind(seed_arg) == "int" {
        {"_ml_rng": true, "state": if seed_arg == 0 { 1 } else { seed_arg }}
    } else if _kind(seed_arg) == "map" && seed_arg._ml_rng == true {
        seed_arg
    } else {
        return Err("ml.linear_module seed must be int or ml.seed handle")
    }
    weight := ag.variable(_rand_array([in_features, out_features], scale, rng))?
    bias := ag.variable(warp.zeros([out_features]))?
    Ok({
        "kind": "linear",
        "in_features": in_features,
        "out_features": out_features,
        "weight": weight,
        "bias": bias,
        "parameters": [weight, bias],
    })
}

pub fn sequential(modules) -> Result[any] {
    if _kind(modules) != "list" || len(modules) == 0 {
        return Err("ml.sequential expects a non-empty module list")
    }
    let mut parameters = []
    for module in modules {
        if module.kind == "linear" {
            for parameter in module.parameters { parameters = push(parameters, parameter) }
        } else if module.kind == "relu" {
            // activation — no parameters
        } else {
            return Err("ml.sequential received an unsupported module kind")
        }
    }
    Ok({
        "kind": "sequential",
        "modules": modules,
        "parameters": parameters,
    })
}

pub fn relu_module() -> Result[any] {
    Ok({"kind": "relu", "parameters": []})
}

pub fn module_forward(module, input) -> Result[any] {
    if module == null || _kind(module) != "map" { return Err("ml.module_forward expects a module") }
    if module.kind == "linear" {
        // sequential may pass an autograd node; unwrap to array when needed.
        arr := if _is_array(input) {
            input
        } else if _kind(input) == "map" && contains(keys(input), "value") {
            ag.value(input)?
        } else {
            input
        }
        return linear_forward(module, arr)
    }
    if module.kind == "relu" {
        node := if _kind(input) == "map" && contains(keys(input), "grad") {
            input
        } else {
            ag.constant(input)?
        }
        return ag.relu(node)
    }
    if module.kind == "sequential" {
        let mut value = input
        for child in module.modules {
            value = module_forward(child, value)?
        }
        return Ok(value)
    }
    Err("ml.module_forward received an unsupported module kind")
}

pub fn module_parameters(module) -> Result[any] {
    if module == null || _kind(module) != "map" || !_parameter_list(module.parameters) {
        // Empty parameter lists are valid for pure activations.
        if module != null && _kind(module) == "map" && module.kind == "relu" {
            return Ok([])
        }
        if module != null && _kind(module) == "map" && module.kind == "sequential" && _kind(module.parameters) == "list" {
            return Ok(module.parameters)
        }
        if !_is_linear(module) { return Err("ml.module_parameters expects a supported module") }
    }
    Ok(module.parameters)
}

pub fn linear_forward(module, input) -> Result[any] {
    if !_is_linear(module) { return Err("ml.linear_forward expects a linear module") }
    if !_is_array(input) || len(warp.shape(input)) != 2 || warp.shape(input)[1] != module.in_features {
        return Err("ml.linear_forward input shape does not match in_features")
    }
    input_node := ag.constant(input)?
    product := ag.matmul(input_node, module.weight)?
    // Bias [out_features] broadcasts onto [batch, out_features] via warp.add.
    ag.add(product, module.bias)
}

pub fn state_dict(parameters) -> Result[any] {
    if !_parameter_list(parameters) { return Err("ml.state_dict expects a non-empty list of trainable variables") }
    let mut values = []
    for parameter in parameters { values = push(values, ag.value(parameter)?) }
    Ok(values)
}

pub fn load_state_dict(parameters, values) -> Result[any] {
    if !_parameter_list(parameters) || _kind(values) != "list" || len(values) != len(parameters) {
        return Err("ml.load_state_dict parameter count does not match")
    }
    let mut validated = []
    for value in values {
        candidate := ag.variable(value)
        if !candidate.ok { return Err("ml.load_state_dict contains an invalid parameter value") }
        validated = push(validated, candidate.value.value)
    }
    let mut i = 0
    while i < len(parameters) {
        parameters[i].value = validated[i]
        i = i + 1
    }
    Ok(null)
}

pub fn save_checkpoint(path, parameters, optimizer_state, metadata) -> Result[any] {
    if path == null || path == "" { return Err("ml.save_checkpoint expects a path") }
    values := state_dict(parameters)?
    payload := {
        "format": "weft.ml.checkpoint",
        "version": 1,
        "parameters": values,
        "optimizer": if optimizer_state == null { {} } else { optimizer_state },
        "metadata": if metadata == null { {} } else { metadata },
    }
    fs.write(path, json.stringify(payload))?
    Ok(path)
}

pub fn load_checkpoint(path) -> Result[any] {
    if path == null || path == "" { return Err("ml.load_checkpoint expects a path") }
    raw := fs.read(path)?
    payload := json.parse(raw)?
    if _kind(payload) != "map" || payload.format != "weft.ml.checkpoint" || payload.version != 1 {
        return Err("ml.load_checkpoint has an unsupported format or version")
    }
    if _kind(payload.parameters) != "list" || payload.optimizer == null || payload.metadata == null {
        return Err("ml.load_checkpoint is missing required fields")
    }
    Ok(payload)
}

fn _is_linear(module) {
    module != null && _kind(module) == "map" && module.kind == "linear" && _parameter_list(module.parameters)
}

fn _parameter_list(parameters) {
    if _kind(parameters) != "list" || len(parameters) == 0 { return false }
    for parameter in parameters {
        current := ag.value(parameter)
        if !current.ok { return false }
    }
    true
}

fn _is_array(value) {
    value != null && _kind(value) == "map" && value._warp == true
}

fn _kind(value) { type_of(value) }
