// In-memory vector index + JSON persistence (simple RAG store).

use "./vec.weft" as vec

// index() -> empty index map {items: []}
pub fn index() {
    {"items": []}
}

// index_add(idx, id, vector, meta?) -> idx (mutates items list)
pub fn index_add(idx, id, vector, meta) {
    mut m := meta
    if m == null {
        m = {}
    }
    push(idx.items, {
        "id": id,
        "vec": vector,
        "meta": m,
    })
    idx
}

// index_search(idx, query_vec, k) -> [{id, score, meta}]
pub fn index_search(idx, query, k) {
    vec.topk(query, idx.items, k)
}

// index_save(idx, path) -> Result
pub fn index_save(idx, path) -> Result {
    fs.write(path, json.stringify(idx))?
    Ok(path)
}

// index_load(path) -> Result[index]
pub fn index_load(path) -> Result {
    raw := fs.read(path)?
    data := json.parse(raw)?
    if data.items == null {
        return Ok({"items": []})
    }
    Ok(data)
}
