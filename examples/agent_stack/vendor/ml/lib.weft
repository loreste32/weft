use "./vec.weft" as vec


use "./embed.weft" as emb


use "./index.weft" as idx


use "./metrics.weft" as met
use "./train.weft" as tr


pub fn cosine(a, b) { vec.cosine(a, b) }


pub fn dot(a, b) { vec.dot(a, b) }


pub fn norm(a) { vec.norm(a) }


pub fn topk(query, items, k) { vec.topk(query, items, k) }


pub fn provider { emb.provider() }


pub fn embed(text) -> Result[any] { emb.embed1(text) }


pub fn embed_with(text, opts) -> Result[any] { emb.embed(text, opts) }


pub fn embed_many(texts) -> Result[any] { emb.embed_many(texts) }


pub fn index { idx.index() }


pub fn index_add(ix, id, vector, meta) { idx.index_add(ix, id, vector, meta) }


pub fn index_search(ix, query, k) { idx.index_search(ix, query, k) }


pub fn index_save(ix, path) -> Result[any] { idx.index_save(ix, path) }


pub fn index_load(path) -> Result[any] { idx.index_load(path) }


pub fn accuracy(preds, labels) { met.accuracy(preds, labels) }


pub fn mse(preds, labels) { met.mse(preds, labels) }


pub fn split(rows, train_ratio) { met.split(rows, train_ratio) }

pub fn linear_fit(features, targets, opts) -> Result[any] { tr.linear_fit(features, targets, opts) }
pub fn logistic_fit(features, targets, opts) -> Result[any] { tr.logistic_fit(features, targets, opts) }
pub fn fit(kind, features, targets, opts) -> Result[any] { tr.fit(kind, features, targets, opts) }
pub fn train(kind, features, targets, opts) -> Result[any] { tr.train(kind, features, targets, opts) }
pub fn predict(model, features) -> Result[any] { tr.predict(model, features) }
pub fn predict_classes(model, features, threshold) -> Result[any] { tr.predict_classes(model, features, threshold) }
pub fn score(model, features, targets) -> Result[any] { tr.score(model, features, targets) }
pub fn standardize(features) -> Result[any] { tr.standardize(features) }
