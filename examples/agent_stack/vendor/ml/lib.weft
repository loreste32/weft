pub fn fwd_sub(left, right) -> Result[any] { fw.sub(left, right) }
pub fn fwd_mul(left, right) -> Result[any] { fw.mul(left, right) }
pub fn fwd_div(left, right) -> Result[any] { fw.div(left, right) }
