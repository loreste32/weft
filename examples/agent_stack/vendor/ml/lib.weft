use "./vec.weft" as vec


use "./embed.weft" as emb


use "./index.weft" as idx


use "./metrics.weft" as met
use "./train.weft" as tr
use "./autograd.weft" as ag
use "./modules.weft" as mods


pub fn cosine(a, b) { vec.cosine(a, b) }


pub fn dot(a, b) { vec.dot(a, b) }


pub fn norm(a) { vec.norm(a) }


pub fn topk(query, items, k) { vec.topk(query, items, k) }


pub fn provider { emb.provider() }


pub fn embed(text) -> Result[any] { emb.embed1(text) }


pub fn embed_with(text, opts) -> Result[any] { emb.embed(text, opts) }


pub fn embed_many(texts) -> Result[any] { emb.embed_many(texts) }


pub fn index { idx.index() }


pub fn index_add(ix, id, vector, meta) { idx.index_add(ix, id, vector, meta) }


pub fn index_search(ix, query, k) { idx.index_search(ix, query, k) }


pub fn index_save(ix, path) -> Result[any] { idx.index_save(ix, path) }


pub fn index_load(path) -> Result[any] { idx.index_load(path) }


pub fn accuracy(preds, labels) { met.accuracy(preds, labels) }


pub fn mse(preds, labels) { met.mse(preds, labels) }


pub fn split(rows, train_ratio) { met.split(rows, train_ratio) }

pub fn linear_fit(features, targets, opts) -> Result[any] { tr.linear_fit(features, targets, opts) }
pub fn logistic_fit(features, targets, opts) -> Result[any] { tr.logistic_fit(features, targets, opts) }
pub fn fit(kind, features, targets, opts) -> Result[any] { tr.fit(kind, features, targets, opts) }
pub fn train(kind, features, targets, opts) -> Result[any] { tr.train(kind, features, targets, opts) }
pub fn predict(model, features) -> Result[any] { tr.predict(model, features) }
pub fn predict_classes(model, features, threshold) -> Result[any] { tr.predict_classes(model, features, threshold) }
pub fn score(model, features, targets) -> Result[any] { tr.score(model, features, targets) }
pub fn standardize(features) -> Result[any] { tr.standardize(features) }
pub fn variable(value) -> Result[any] { ag.variable(value) }
pub fn constant(value) -> Result[any] { ag.constant(value) }
pub fn value(node) -> Result[any] { ag.value(node) }
pub fn grad(node) -> Result[any] { ag.grad(node) }
pub fn zero_grad(node) -> Result[any] { ag.zero_grad(node) }
pub fn zero_grad_many(parameters) -> Result[any] { ag.zero_grad_many(parameters) }
pub fn backward(node) -> Result[any] { ag.backward(node) }
pub fn sgd_step(parameters, learning_rate, weight_decay) -> Result[any] { ag.sgd_step(parameters, learning_rate, weight_decay) }
pub fn adam_state(parameters) -> Result[any] { ag.adam_state(parameters) }
pub fn adam_step(parameters, state, learning_rate, beta1, beta2, epsilon, weight_decay) -> Result[any] { ag.adam_step(parameters, state, learning_rate, beta1, beta2, epsilon, weight_decay) }
pub fn add(left, right) -> Result[any] { ag.add(left, right) }
pub fn sub(left, right) -> Result[any] { ag.sub(left, right) }
pub fn mul(left, right) -> Result[any] { ag.mul(left, right) }
pub fn div(left, right) -> Result[any] { ag.div(left, right) }
pub fn neg(node) -> Result[any] { ag.neg(node) }
pub fn exp(node) -> Result[any] { ag.exp(node) }
pub fn log(node) -> Result[any] { ag.log(node) }
pub fn relu(node) -> Result[any] { ag.relu(node) }
pub fn pow(node, exponent) -> Result[any] { ag.pow(node, exponent) }
pub fn sum(node) -> Result[any] { ag.sum(node) }
pub fn mean(node) -> Result[any] { ag.mean(node) }
pub fn matmul(left, right) -> Result[any] { ag.matmul(left, right) }
pub fn linear_module(in_features, out_features) -> Result[any] { mods.linear_module(in_features, out_features) }
pub fn module_parameters(module) -> Result[any] { mods.module_parameters(module) }
pub fn linear_forward(module, input) -> Result[any] { mods.linear_forward(module, input) }
pub fn state_dict(parameters) -> Result[any] { mods.state_dict(parameters) }
pub fn load_state_dict(parameters, values) -> Result[any] { mods.load_state_dict(parameters, values) }
pub fn save_checkpoint(path, parameters, optimizer_state, metadata) -> Result[any] { mods.save_checkpoint(path, parameters, optimizer_state, metadata) }
pub fn load_checkpoint(path) -> Result[any] { mods.load_checkpoint(path) }
