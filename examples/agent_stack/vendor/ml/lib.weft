pub fn fwd_exp(node) -> Result[any] { fw.exp(node) }
pub fn fwd_log(node) -> Result[any] { fw.log(node) }
pub fn fwd_sin(node) -> Result[any] { fw.sin(node) }
pub fn fwd_cos(node) -> Result[any] { fw.cos(node) }
pub fn fwd_sqrt(node) -> Result[any] { fw.sqrt(node) }
pub fn fwd_tanh(node) -> Result[any] { fw.tanh(node) }
pub fn fwd_sigmoid(node) -> Result[any] { fw.sigmoid(node) }
pub fn fwd_relu(node) -> Result[any] { fw.relu(node) }
pub fn fwd_pow(node, exponent) -> Result[any] { fw.pow(node, exponent) }
pub fn fwd_sum(node) -> Result[any] { fw.sum(node) }
