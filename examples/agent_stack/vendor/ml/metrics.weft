pub fn accuracy(preds, labels) {
    if preds == null || labels == null {
        return Err("ml.accuracy expects predictions and labels")
    }
    if len(preds) != len(labels) {
        return Err("ml.accuracy requires predictions and labels with equal lengths")
    }
    mut ok := 0
    mut i := 0
    n := len(preds)
    if n == 0 {
        return 0.0
    }
    while i < n {
        if preds[i] == labels[i] {
            ok = ok + 1
        }
        i = i + 1
    }
    ok * 1.0 / n
}


pub fn mse(preds, labels) {
    if preds == null || labels == null {
        return Err("ml.mse expects predictions and labels")
    }
    if len(preds) != len(labels) {
        return Err("ml.mse requires predictions and labels with equal lengths")
    }
    mut s := 0.0
    mut i := 0
    n := len(preds)
    if n == 0 {
        return 0.0
    }
    while i < n {
        d := preds[i] - labels[i]
        s = s + d * d
        i = i + 1
    }
    s / n
}


pub fn split(rows, train_ratio) {
    if rows == null {
        return Err("ml.split expects rows")
    }
    if train_ratio < 0.0 || train_ratio > 1.0 {
        return Err("ml.split train_ratio must be between 0 and 1")
    }
    n := len(rows)
    mut k := 0
    while k < n && k * 1.0 / n < train_ratio {
        k = k + 1
    }
    mut train := []
    mut test := []
    mut i := 0
    while i < n {
        if i < k { push(train, rows[i]) } else { push(test, rows[i]) }
        i = i + 1
    }
    {"train": train, "test": test}
}
