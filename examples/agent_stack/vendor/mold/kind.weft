pub fn of(v) {
    if v == null {
        return "null"
    }
    s := json.stringify(v)
    if s == "true" || s == "false" {
        return "bool"
    }
    if str.starts_with(s, "\"") {
        return "str"
    }
    if str.starts_with(s, "[") {
        return "list"
    }
    if str.starts_with(s, "{") {
        return "map"
    }
    if str.contains(s, ".") || str.contains(s, "e") || str.contains(s, "E") {
        return "float"
    }
    return "int"
}


pub fn is_num(v) {
    k := of(v)
    k == "int" || k == "float"
}

