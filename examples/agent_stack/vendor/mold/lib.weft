// mold — pour LLM/API JSON into structured maps (optional module, pure Weft).
//
// Agent stack: docs/ECOSYSTEM.md
//   llm (stdlib) → mold (shapes) → tokensave / ml (optional siblings)
//
//   weft packages get mold && weft install
//   use mold

use "./fields.weft" as F
use "./validate.weft" as V
use "./emit.weft" as E

// --- field builders (avoid shadowing host str/int packages) -----------------

pub fn field(name, typ, opts) -> Result {
    f := F.base_open(typ, opts)?
    f["name"] = name
    Ok(f)
}

pub fn string(opts) -> Result { F.f_str(opts) }
pub fn integer(opts) -> Result { F.f_int(opts) }
pub fn float(opts) -> Result { F.f_float(opts) }
pub fn boolean(opts) -> Result { F.f_bool(opts) }
pub fn any(opts) -> Result { F.f_any(opts) }
pub fn list(item, opts) -> Result { F.f_list(item, opts) }
pub fn object(fields, opts) -> Result { F.f_object(fields, opts) }

// short aliases
pub fn str(opts) -> Result { F.f_str(opts) }
pub fn int(opts) -> Result { F.f_int(opts) }
pub fn bool(opts) -> Result { F.f_bool(opts) }

// --- model ------------------------------------------------------------------

pub fn model(fields) -> Result {
    expanded := F.expand_fields(fields)?
    Ok({
        "kind": "mold.model",
        "fields": expanded,
    })
}

// --- validate / parse / extract ---------------------------------------------

pub fn validate(model, data) -> Result {
    V.validate_mut(model, data)
}

pub fn parse(model, raw) -> Result {
    V.parse(model, raw)
}

pub fn extract(model, text) -> Result {
    V.extract(model, text)
}

pub fn errors(result) {
    V.errors(result)
}

pub fn ok(result) {
    V.ok(result)
}

// --- emit (JSON Schema + provider tool wire formats) ------------------------

pub fn json_schema(model, title) {
    E.json_schema(model, title)
}

// OpenAI-style parameters object: {type, properties, required, …}
pub fn tool_params(model) {
    E.tool_params(model)
}

// Full tools[] entry for OpenAI-compat / many proxies:
//   {"type":"function","function":{"name","description","parameters"}}
pub fn tool_spec(name, model, desc) {
    mut d := ""
    if desc != null {
        d = "" + desc
    }
    {
        "type": "function",
        "function": {
            "name": name,
            "description": d,
            "parameters": E.tool_params(model),
        },
    }
}

// Anthropic-style tool: {name, description, input_schema}
pub fn input_schema_tool(name, model, desc) {
    mut d := ""
    if desc != null {
        d = "" + desc
    }
    {
        "name": name,
        "description": d,
        "input_schema": E.tool_params(model),
    }
}
