use "./lib.weft" as mold


fn person_model { mold.model({
    "name": "str!",
    "age": mold.integer({"min": 0, "max": 150})?,
    "email": "str?",
    "tags": ["str"],
    "active": mold.boolean({"default": true})?,
})? }


fn test_parse_ok {
    m := person_model()
    r := mold.parse(m, "{\"name\":\"Ada\",\"age\":36,\"tags\":[\"math\"]}")?
    test.eq(r["name"], "Ada")
    test.eq(r["age"], 36)
    test.eq(r["active"], true)
}


fn test_required {
    m := person_model()
    r := mold.parse(m, "{\"age\":1}")
    test.eq(r.ok, false)
}


fn test_min {
    m := person_model()
    r := mold.parse(m, "{\"name\":\"x\",\"age\":-1}")
    test.eq(r.ok, false)
}


fn test_json_schema {
    m := person_model()
    js := mold.json_schema(m, "Person")
    test.eq(js["type"], "object")
    test.eq(js["title"], "Person")
    test.eq(js["properties"]["name"]["type"], "string")
    test.eq(js["properties"]["age"]["type"], "integer")
}


fn test_tool_params {
    m := person_model()
    p := mold.tool_params(m)
    test.eq(p["type"], "object")
    test.eq(p["properties"]["name"]["type"], "string")
}


fn test_tool_spec {
    m := person_model()
    spec := mold.tool_spec("person", m, "a person record")
    test.eq(spec["type"], "function")
    test.eq(spec["function"]["name"], "person")
    test.eq(spec["function"]["parameters"]["type"], "object")
    ant := mold.input_schema_tool("person", m, "a person record")
    test.eq(ant["name"], "person")
    test.eq(ant["input_schema"]["type"], "object")
}


fn test_extract_fences {
    m := person_model()
    raw := "```json\n{\"name\":\"Bob\",\"age\":20,\"tags\":[]}\n```"
    r := mold.extract(m, raw)?
    test.eq(r["name"], "Bob")
}


fn test_nested {
    m := mold.model({"user": mold.object({"id": "str!", "n": "int"}, null)?})?
    r := mold.parse(m, "{\"user\":{\"id\":\"u1\",\"n\":2}}")?
    test.eq(r["user"]["id"], "u1")
    test.eq(r["user"]["n"], 2)
}


fn test_max_list {
    m := mold.model({
        "tags": ["str"],
    })?
    mut parts := ""
    mut i := 0
    while i < 10001 {
        if i > 0 {
            parts = parts + ","
        }
        parts = parts + "\"x\""
        i = i + 1
    }
    r := mold.parse(m, "{\"tags\":[" + parts + "]}")
    test.eq(r.ok, false)
}


fn test_max_depth {
    mut fields := {"v": "int"}
    mut i := 0
    while i < 40 {
        fields = {"c": mold.object(fields, null)?}
        i = i + 1
    }
    m := mold.model(fields)?
    mut data := "{\"v\":1}"
    mut j := 0
    while j < 40 {
        data = "{\"c\":" + data + "}"
        j = j + 1
    }
    r := mold.parse(m, data)
    test.eq(r.ok, false)
}

