use json
use str
use warp
use "./device.weft" as dev

// Small reverse-mode autodiff tape for scalar model expressions.
// Nodes are ordinary Weft maps so the API remains portable and inspectable.
// Gradients accumulate across backward calls; call zero_grad before a new pass.

pub fn variable(value) -> Result[any] {
    if !_supported_value(value) { return Err("ml.variable expects a finite numeric scalar or warp array") }
    Ok(_node(value, true, [], null, null))
}

pub fn constant(value) -> Result[any] {
    if !_supported_value(value) { return Err("ml.constant expects a finite numeric scalar or warp array") }
    Ok(_node(value, false, [], null, null))
}

pub fn value(node) -> Result[any] {
    n := _unwrap_device(node)
    if !_is_node(n) { return Err("ml.value expects an autograd node") }
    n.value
}

pub fn grad(node) -> Result[any] {
    n := _unwrap_device(node)
    if !_is_node(n) { return Err("ml.grad expects an autograd node") }
    n.grad
}

pub fn zero_grad(node) -> Result[any] {
    if !_is_node(node) { return Err("ml.zero_grad expects an autograd node") }
    order := []
    _collect(node, order)
    for item in order { item.grad = _zero_like(item.value) }
    for item in order { item._topo_mark = false }
    Ok(null)
}

// reverse-mode VJP. When create_graph is true/1, VJPs are built with autograd
// nodes so node.grad is itself a graph (nested reverse-mode / double backward).
// This covers scalar and warp-array values for the core op set (see _graph_op);
// gelu/softmax/huber/cross_entropy keep numeric VJPs even under create_graph.
// node._graph_complete records whether every propagated op got a graph VJP, so
// higher-order callers can fall back instead of trusting a truncated graph.
pub fn backward(node, create_graph) -> Result[any] {
    if !_is_node(node) { return Err("ml.backward expects an autograd node") }
    if !_number(node.value) { return Err("ml.backward requires a scalar output; reduce arrays first") }
    cg := _flag(create_graph)
    order := []
    _collect(node, order)
    node.grad = _seed_grad(node.grad, cg)?
    let mut graph_complete := true
    let mut i := len(order) - 1
    while i >= 0 {
        item := order[i]
        if item.op != null {
            if cg {
                built := _propagate_graph(item)?
                if !built { graph_complete = false }
            } else {
                _propagate(item)
            }
        }
        i = i - 1
    }
    if cg { node._graph_complete = graph_complete }
    for item in order { item._topo_mark = false }
    Ok(null)
}

// Build gradient nodes d(output)/d(inputs[i]) via reverse-mode with create_graph.
// Returns a list of autograd nodes (one per input). Works for scalar and
// warp-array inputs as long as every op in the graph has a graph VJP.
pub fn grad_fn(output, inputs) -> Result[any] {
    if !_is_node(output) { return Err("ml.grad_fn expects an autograd output node") }
    if !_number(output.value) { return Err("ml.grad_fn requires a scalar output; reduce arrays first") }
    if _kind(inputs) != "list" || len(inputs) == 0 {
        return Err("ml.grad_fn expects a non-empty list of input variables")
    }
    for inp in inputs {
        if !_is_node(inp) || !inp.requires_grad {
            return Err("ml.grad_fn inputs must be trainable autograd variables")
        }
    }
    zero_grad(output)?
    backward(output, true)?
    if contains(keys(output), "_graph_complete") && output._graph_complete == false {
        return Err("ml.grad_fn graph contains ops with numeric-only VJPs (gelu/softmax/huber/cross_entropy)")
    }
    let mut grads = []
    for inp in inputs {
        g := inp.grad
        if _is_node(g) {
            grads = push(grads, g)
        } else if _number(g) {
            // No graph parents (e.g. output is the input itself): wrap constant grad.
            grads = push(grads, constant(g)?)
        } else {
            return Err("ml.grad_fn produced a non-scalar gradient without a graph")
        }
    }
    Ok(grads)
}

pub fn add(left, right) -> Result[any] {
    _binary(left, right, "add", fn(a, b) { _value_add(a, b) })
}

pub fn sub(left, right) -> Result[any] {
    _binary(left, right, "sub", fn(a, b) { _value_sub(a, b) })
}

pub fn mul(left, right) -> Result[any] {
    _binary(left, right, "mul", fn(a, b) { _value_mul(a, b) })
}

pub fn div(left, right) -> Result[any] {
    _binary(left, right, "div", fn(a, b) { _value_div(a, b) })
}

pub fn neg(node) -> Result[any] {
    _unary(node, "neg", fn(a) { _value_neg(a) }, null)
}

pub fn exp(node) -> Result[any] {
    _unary(node, "exp", fn(a) { _value_exp(a) }, null)
}

pub fn log(node) -> Result[any] {
    _unary(node, "log", fn(a) { _value_log(a) }, null)
}

pub fn relu(node) -> Result[any] {
    _unary(node, "relu", fn(a) { _value_relu(a) }, null)
}

pub fn pow(node, exponent) -> Result[any] {
    if !_number(exponent) { return Err("ml.pow exponent must be numeric") }
    _unary(node, "pow", fn(a) { _value_pow(a, exponent) }, exponent)
}

pub fn sum(node) -> Result[any] {
    _unary(node, "sum", fn(a) { _value_sum(a) }, null)
}

pub fn mean(node) -> Result[any] {
    _unary(node, "mean", fn(a) { _value_sum(a) / _value_numel(a) }, null)
}

pub fn matmul(left, right) -> Result[any] {
    x := _as_node(left)
    y := _as_node(right)
    if x == null || y == null || !_is_array(x.value) || !_is_array(y.value) {
        return Err("ml.matmul expects two warp arrays")
    }
    if len(warp.shape(x.value)) != 2 || len(warp.shape(y.value)) != 2 {
        return Err("ml.matmul autodiff currently supports two-dimensional arrays")
    }
    _binary(left, right, "matmul", fn(a, b) { _value_matmul(a, b) })
}

pub fn sigmoid(node) -> Result[any] {
    _unary(node, "sigmoid", fn(a) { _value_sigmoid(a) }, null)
}

pub fn tanh(node) -> Result[any] {
    _unary(node, "tanh", fn(a) { _value_tanh(a) }, null)
}

// Gaussian-error-linear-unit, tanh approximation (Hendrycks & Gimpel):
// gelu(x) = 0.5 x (1 + tanh(sqrt(2/pi) (x + 0.044715 x^3))).
pub fn gelu(node) -> Result[any] {
    _unary(node, "gelu", fn(a) { _value_gelu(a) }, null)
}

// Axis-aware softmax over a warp array with max-subtraction stabilization.
// axis defaults to the last axis; negative axes count from the end.
pub fn softmax(node, axis) -> Result[any] {
    x := _as_node(node)
    if x == null || !_is_array(x.value) { return Err("ml.softmax expects a warp array") }
    ax := _softmax_axis(x.value, axis)
    if ax == null { return Err("ml.softmax axis out of range") }
    _unary(node, "softmax", fn(a) { _value_softmax(a, ax) }, ax)
}

// Elementwise Huber loss between two values; reduce with mean/sum. The
// quadratic/linear kink sits at |pred - target| = delta (default 1.0).
pub fn huber(left, right, delta) -> Result[any] {
    d := if delta == null { 1.0 } else { delta }
    if !_number(d) || d <= 0 { return Err("ml.huber delta must be finite and positive") }
    x := _as_node(left)
    y := _as_node(right)
    if x == null || y == null { return Err("ml.huber expects numeric scalars or nodes") }
    result := _value_huber(x.value, y.value, d)
    if _failed(result) { return result }
    Ok(_node(result, x.requires_grad || y.requires_grad, [x, y], "huber", d))
}

// Mean softmax cross-entropy over a 2-D logits array [batch, classes] and a
// list of integer class targets. The log-softmax is computed with the
// log-sum-exp trick (max subtraction), so extreme logits cannot overflow.
pub fn cross_entropy(node, targets) -> Result[any] {
    x := _as_node(node)
    if x == null || !_is_array(x.value) || len(warp.shape(x.value)) != 2 {
        return Err("ml.cross_entropy expects 2-D logits [batch, classes]")
    }
    shape := warp.shape(x.value)
    if shape[0] == 0 { return Err("ml.cross_entropy expects a non-empty batch") }
    if !_class_targets(targets, shape[0], shape[1]) {
        return Err("ml.cross_entropy expects one in-range integer class index per row")
    }
    result := _value_cross_entropy(x.value, targets)
    if _failed(result) { return result }
    Ok(_node(result, x.requires_grad, [x], "cross_entropy", targets))
}

// Optimizer primitives operate on variable nodes in place. The node graph
// remains inspectable, while parameter values change only through an explicit
// optimizer step. Gradients are intentionally retained until zero_grad_many
// is called, matching the accumulation behavior of backward().
pub fn zero_grad_many(parameters) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.zero_grad_many expects a list of trainable variables") }
    for parameter in parameters { parameter.grad = _zero_like(parameter.value) }
    Ok(null)
}

// Numeric gradient value (unwraps a create_graph grad node). Prefer grad() + value() for inspection.
pub fn grad_value(node) -> Result[any] {
    if !_is_node(node) { return Err("ml.grad_value expects an autograd node") }
    Ok(_grad_numeric(node.grad))
}

pub fn sgd_step(parameters, learning_rate, weight_decay) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.sgd_step expects a list of trainable variables") }
    if !_number(learning_rate) || learning_rate <= 0 { return Err("ml.sgd_step learning_rate must be finite and positive") }
    decay := if weight_decay == null { 0.0 } else { weight_decay }
    if !_number(decay) || decay < 0 { return Err("ml.sgd_step weight_decay must be finite and non-negative") }
    for parameter in parameters {
        // Frozen parameters (ml.freeze) are skipped entirely: no value update,
        // no weight-decay drift, regardless of what their grad buffer holds.
        if !parameter.requires_grad { continue }
        raw := _grad_numeric(parameter.grad)
        gradient := if decay == 0 { raw } else { _value_add(raw, _value_mul(decay, parameter.value)) }
        parameter.value = _value_sub(parameter.value, _value_mul(learning_rate, gradient))
    }
    Ok(null)
}

pub fn adam_state(parameters) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.adam_state expects a list of trainable variables") }
    let mut first_moments = []
    let mut second_moments = []
    for parameter in parameters {
        first_moments = push(first_moments, _zero_like(parameter.value))
        second_moments = push(second_moments, _zero_like(parameter.value))
    }
    Ok({"step": 0, "m": first_moments, "v": second_moments})
}

pub fn adam_step(parameters, state, learning_rate, beta1, beta2, epsilon, weight_decay) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.adam_step expects a list of trainable variables") }
    if _kind(state) != "map" || !contains(keys(state), "step") || !contains(keys(state), "m") || !contains(keys(state), "v") {
        return Err("ml.adam_step expects state returned by adam_state")
    }
    if len(state.m) != len(parameters) || len(state.v) != len(parameters) { return Err("ml.adam_step state does not match parameters") }
    if !_number(learning_rate) || learning_rate <= 0 { return Err("ml.adam_step learning_rate must be finite and positive") }
    b1 := if beta1 == null { 0.9 } else { beta1 }
    b2 := if beta2 == null { 0.999 } else { beta2 }
    eps := if epsilon == null { 1e-8 } else { epsilon }
    decay := if weight_decay == null { 0.0 } else { weight_decay }
    if !_number(b1) || b1 < 0 || b1 >= 1 { return Err("ml.adam_step beta1 must be in [0, 1)") }
    if !_number(b2) || b2 < 0 || b2 >= 1 { return Err("ml.adam_step beta2 must be in [0, 1)") }
    if !_number(eps) || eps <= 0 { return Err("ml.adam_step epsilon must be finite and positive") }
    if !_number(decay) || decay < 0 { return Err("ml.adam_step weight_decay must be finite and non-negative") }
    state.step = state.step + 1
    step := state.step
    bias_first := 1.0 - math.pow(b1, step)
    bias_second := 1.0 - math.pow(b2, step)
    let mut i = 0
    while i < len(parameters) {
        parameter := parameters[i]
        // Frozen parameters are skipped before any moment update: their m/v
        // entries stay untouched, so no momentum drift can move them later.
        if !parameter.requires_grad {
            i = i + 1
            continue
        }
        raw := _grad_numeric(parameter.grad)
        gradient := if decay == 0 { raw } else { _value_add(raw, _value_mul(decay, parameter.value)) }
        first := _value_add(_value_mul(b1, state.m[i]), _value_mul(1.0 - b1, gradient))
        second := _value_add(_value_mul(b2, state.v[i]), _value_mul(1.0 - b2, _value_mul(gradient, gradient)))
        state.m[i] = first
        state.v[i] = second
        first_hat := _value_div(first, bias_first)
        second_hat := _value_div(second, bias_second)
        denominator := _value_add(_value_sqrt(second_hat), eps)
        parameter.value = _value_sub(parameter.value, _value_div(_value_mul(learning_rate, first_hat), denominator))
        i = i + 1
    }
    Ok(null)
}

// Global-norm gradient clipping (PyTorch formula): total_norm is the L2 norm
// over every trainable parameter's gradient; when it exceeds max_norm, all
// gradients are scaled by max_norm / (total_norm + 1e-6). Returns the
// pre-clip total norm. Frozen parameters contribute nothing. Zero gradients
// yield norm 0 and a no-op (no division by zero).
pub fn clip_grad_norm(parameters, max_norm) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.clip_grad_norm expects a list of trainable variables") }
    if !_number(max_norm) || max_norm < 0 { return Err("ml.clip_grad_norm max_norm must be finite and non-negative") }
    let mut total = 0.0
    for parameter in parameters {
        if !parameter.requires_grad { continue }
        total = total + _grad_sum_squares(_grad_numeric(parameter.grad))
    }
    norm := math.sqrt(total)
    clip_coef := max_norm / (norm + 1e-6)
    if clip_coef < 1 {
        for parameter in parameters {
            if !parameter.requires_grad { continue }
            parameter.grad = _value_mul(clip_coef, _grad_numeric(parameter.grad))
        }
    }
    Ok(norm)
}

// Elementwise gradient clipping to [-max_abs, max_abs]. Frozen parameters are
// left untouched. Returns Ok(null).
pub fn clip_grad_value(parameters, max_abs) -> Result[any] {
    if !_optimizer_parameters(parameters) { return Err("ml.clip_grad_value expects a list of trainable variables") }
    if !_number(max_abs) || max_abs < 0 { return Err("ml.clip_grad_value max_abs must be finite and non-negative") }
    for parameter in parameters {
        if !parameter.requires_grad { continue }
        parameter.grad = _value_clip(_grad_numeric(parameter.grad), -max_abs, max_abs)
    }
    Ok(null)
}

fn _grad_sum_squares(g) {
    if _is_array(g) { return warp.sum(warp.mul(g, g)) + 0.0 }
    g * g + 0.0
}

fn _binary(left, right, op, operation) -> Result[any] {
    x := _as_node(left)
    y := _as_node(right)
    if x == null || y == null { return Err("ml autograd operations expect numeric scalars or nodes") }
    result := operation(x.value, y.value)
    if _failed(result) { return result }
    out := _node(result, x.requires_grad || y.requires_grad, [x, y], op, null)
    Ok(out)
}

fn _unary(node, op, operation, aux) -> Result[any] {
    x := _as_node(node)
    if x == null { return Err("ml autograd operation expects a numeric scalar or node") }
    result := operation(x.value)
    if _failed(result) { return result }
    out := _node(result, x.requires_grad, [x], op, aux)
    Ok(out)
}

fn _propagate(node) {
    parents := node.parents
    g := _grad_numeric(node.grad)
    if node.op == "add" {
        _add_grad(parents[0], _reduce_to_parent(g, parents[0].value))
        _add_grad(parents[1], _reduce_to_parent(g, parents[1].value))
    } else if node.op == "sub" {
        _add_grad(parents[0], _reduce_to_parent(g, parents[0].value))
        _add_grad(parents[1], _reduce_to_parent(_value_neg(g), parents[1].value))
    } else if node.op == "mul" {
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, parents[1].value), parents[0].value))
        _add_grad(parents[1], _reduce_to_parent(_value_mul(g, parents[0].value), parents[1].value))
    } else if node.op == "div" {
        _add_grad(parents[0], _reduce_to_parent(_value_div(g, parents[1].value), parents[0].value))
        denominator := _value_mul(parents[1].value, parents[1].value)
        right := _value_neg(_value_div(_value_mul(g, parents[0].value), denominator))
        _add_grad(parents[1], _reduce_to_parent(right, parents[1].value))
    } else if node.op == "neg" {
        _add_grad(parents[0], _reduce_to_parent(_value_neg(g), parents[0].value))
    } else if node.op == "exp" {
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, node.value), parents[0].value))
    } else if node.op == "log" {
        _add_grad(parents[0], _reduce_to_parent(_value_div(g, parents[0].value), parents[0].value))
    } else if node.op == "relu" {
        mask := _value_relu_derivative(parents[0].value)
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, mask), parents[0].value))
    } else if node.op == "pow" {
        exponent := node.aux
        factor := _value_pow(parents[0].value, exponent - 1.0)
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, _value_mul(exponent, factor)), parents[0].value))
    } else if node.op == "sum" {
        _add_grad(parents[0], _expand_like(g, parents[0].value))
    } else if node.op == "mean" {
        _add_grad(parents[0], _value_div(_expand_like(g, parents[0].value), _value_numel(parents[0].value)))
    } else if node.op == "matmul" {
        left := parents[0].value
        right := parents[1].value
        _add_grad(parents[0], _value_matmul(g, warp.T(right)))
        _add_grad(parents[1], _value_matmul(warp.T(left), g))
    } else if node.op == "sigmoid" {
        s := node.value
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, _value_mul(s, _value_sub(1.0, s))), parents[0].value))
    } else if node.op == "tanh" {
        t := node.value
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, _value_sub(1.0, _value_mul(t, t))), parents[0].value))
    } else if node.op == "gelu" {
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, _gelu_derivative(parents[0].value)), parents[0].value))
    } else if node.op == "softmax" {
        // Jacobian-vector product: dx = s * (g - sum(g * s, axis, keepdims)).
        s := node.value
        dot := warp.sum_axis_opts(warp.mul(g, s), node.aux, true)
        _add_grad(parents[0], warp.mul(s, warp.sub(g, dot)))
    } else if node.op == "huber" {
        // d/dpred = clip(pred - target, -delta, delta); d/dtarget = -that.
        delta := node.aux
        residual := _value_sub(parents[0].value, parents[1].value)
        clipped := _value_clip(residual, -delta, delta)
        _add_grad(parents[0], _reduce_to_parent(_value_mul(g, clipped), parents[0].value))
        _add_grad(parents[1], _reduce_to_parent(_value_mul(g, _value_neg(clipped)), parents[1].value))
    } else if node.op == "cross_entropy" {
        // dL/dlogits = (softmax - onehot) / batch.
        probs := _value_softmax(parents[0].value, 1)
        _add_grad(parents[0], _value_mul(g, _ce_grad(probs, node.aux, warp.shape(parents[0].value))))
    } else if node.op == "reduce_to" {
        // Internal graph-VJP node: forward reduced over broadcast axes, so the
        // VJP broadcasts the gradient back to the input shape.
        _add_grad(parents[0], _value_expand_to(g, warp.shape(parents[0].value)))
    } else if node.op == "expand_to" {
        // Internal graph-VJP node: forward broadcast to a larger shape, so the
        // VJP sums the gradient back down over the broadcast axes.
        _add_grad(parents[0], _reduce_to_parent(g, parents[0].value))
    } else if node.op == "transpose" {
        _add_grad(parents[0], warp.T(g))
    }
}

// Nested reverse-mode: build parent.grad from tape ops so a second backward
// differentiates through the first-gradient graph. Covers scalars and warp
// arrays for the core op set; broadcasting is undone with reduce_to /
// expand_to / transpose nodes, which are themselves differentiable tape ops.
// Returns Ok(true) when a graph VJP was built, Ok(false) on numeric fallback.
fn _propagate_graph(node) -> Result[any] {
    if !_graph_op(node) {
        _propagate(node)
        return Ok(false)
    }
    parents := node.parents
    g := _ensure_grad_node(node.grad)?
    if node.op == "add" {
        _add_grad_graph(parents[0], _graph_reduce(g, parents[0])?)?
        _add_grad_graph(parents[1], _graph_reduce(g, parents[1])?)?
    } else if node.op == "sub" {
        _add_grad_graph(parents[0], _graph_reduce(g, parents[0])?)?
        _add_grad_graph(parents[1], _graph_reduce(neg(g)?, parents[1])?)?
    } else if node.op == "mul" {
        _add_grad_graph(parents[0], _graph_reduce(mul(g, parents[1])?, parents[0])?)?
        _add_grad_graph(parents[1], _graph_reduce(mul(g, parents[0])?, parents[1])?)?
    } else if node.op == "div" {
        _add_grad_graph(parents[0], _graph_reduce(div(g, parents[1])?, parents[0])?)?
        y2 := mul(parents[1], parents[1])?
        num := mul(g, parents[0])?
        _add_grad_graph(parents[1], _graph_reduce(neg(div(num, y2)?)?, parents[1])?)?
    } else if node.op == "neg" {
        _add_grad_graph(parents[0], neg(g)?)?
    } else if node.op == "exp" {
        // d exp(x)/dx = exp(x) = this node
        _add_grad_graph(parents[0], mul(g, node)?)?
    } else if node.op == "log" {
        _add_grad_graph(parents[0], div(g, parents[0])?)?
    } else if node.op == "relu" {
        // Subgradient mask is treated as a constant (non-differentiable kink).
        mask := constant(_value_relu_derivative(parents[0].value))?
        _add_grad_graph(parents[0], mul(g, mask)?)?
    } else if node.op == "pow" {
        exponent := node.aux
        factor := pow(parents[0], exponent - 1.0)?
        scaled := mul(constant(exponent)?, factor)?
        _add_grad_graph(parents[0], mul(g, scaled)?)?
    } else if node.op == "sum" {
        _add_grad_graph(parents[0], _graph_expand(g, parents[0])?)?
    } else if node.op == "mean" {
        if _number(parents[0].value) {
            // scalar mean is identity
            _add_grad_graph(parents[0], g)?
        } else {
            n := constant(_value_numel(parents[0].value))?
            _add_grad_graph(parents[0], _graph_expand(div(g, n)?, parents[0])?)?
        }
    } else if node.op == "matmul" {
        _add_grad_graph(parents[0], matmul(g, _transpose_node(parents[1]))?)?
        _add_grad_graph(parents[1], matmul(_transpose_node(parents[0]), g)?)?
    } else if node.op == "sigmoid" {
        // d sigmoid/dx = s (1 - s) with s = this node.
        one := constant(1.0)?
        _add_grad_graph(parents[0], mul(g, mul(node, sub(one, node)?)?)?)?
    } else if node.op == "tanh" {
        // d tanh/dx = 1 - t^2 with t = this node.
        one := constant(1.0)?
        t2 := mul(node, node)?
        _add_grad_graph(parents[0], mul(g, sub(one, t2)?)?)?
    } else if node.op == "reduce_to" {
        _add_grad_graph(parents[0], _graph_expand(g, parents[0])?)?
    } else if node.op == "expand_to" {
        _add_grad_graph(parents[0], _graph_reduce(g, parents[0])?)?
    } else if node.op == "transpose" {
        _add_grad_graph(parents[0], _transpose_node(g))?
    }
    Ok(true)
}

// Ops whose VJPs are built from tape ops under create_graph, for scalar and
// warp-array values alike. gelu/softmax/huber/cross_entropy stay numeric under
// create_graph: their VJPs need non-differentiable helpers (comparison masks,
// keepdims axis reductions, one-hot target construction), so a second backward
// through them would silently drop second-order terms.
fn _graph_op(node) {
    op := node.op
    if op == "add" || op == "sub" || op == "mul" || op == "div" || op == "neg" ||
        op == "exp" || op == "log" || op == "relu" || op == "pow" ||
        op == "sum" || op == "mean" || op == "matmul" ||
        op == "sigmoid" || op == "tanh" { return true }
    // Internal gradient-plumbing nodes created by the graph VJPs above.
    if op == "reduce_to" || op == "expand_to" || op == "transpose" { return true }
    false
}

// Reduce a gradient node to a parent's shape, undoing forward broadcasting.
// Scalar parents reduce an array gradient with the differentiable sum op;
// smaller array parents get an internal reduce_to node. Same-shape gradients
// pass through unchanged so the scalar path is bit-identical to before.
fn _graph_reduce(g, parent) -> Result[any] {
    if !_is_array(parent.value) {
        if _is_array(g.value) { return sum(g) }
        return Ok(g)
    }
    if !_is_array(g.value) { return Err("ml.backward create_graph cannot reduce a scalar gradient to an array parent") }
    shape := warp.shape(parent.value)
    if warp.shape(g.value) == shape { return Ok(g) }
    Ok(_node(_value_reduce_to(g.value, shape), g.requires_grad, [g], "reduce_to", shape))
}

// Broadcast a gradient node up to a parent's shape (VJP of a reduction).
// Scalar parents pass the gradient through unchanged.
fn _graph_expand(g, parent) -> Result[any] {
    if !_is_array(parent.value) { return Ok(g) }
    shape := warp.shape(parent.value)
    if _is_array(g.value) && warp.shape(g.value) == shape { return Ok(g) }
    value := _value_expand_to(g.value, shape)
    if is_err(value) { return value }
    Ok(_node(value, g.requires_grad, [g], "expand_to", shape))
}

fn _transpose_node(x) {
    _node(warp.T(x.value), x.requires_grad, [x], "transpose", null)
}

// Reduce an array value to a broadcast-compatible target shape (sum over the
// broadcast axes); mirrors _reduce_to_parent with a shape template.
fn _value_reduce_to(value, shape) {
    _reduce_to_parent(value, warp.zeros(shape))
}

// Broadcast a scalar or array value to a target shape (right-aligned NumPy
// rules); inverse of _value_reduce_to.
fn _value_expand_to(value, shape) {
    if _is_array(value) {
        if warp.shape(value) == shape { return value }
        return warp.broadcast_to(value, shape)
    }
    warp.full(shape, value)
}

fn _add_grad(node, amount) {
    if !node.requires_grad { return }
    current := _grad_numeric(node.grad)
    node.grad = _value_add(current, amount)
}

fn _add_grad_graph(node, amount) -> Result[any] {
    if !node.requires_grad { return Ok(null) }
    if _is_node(node.grad) {
        node.grad = add(node.grad, amount)?
    } else if _number(node.grad) && node.grad == 0 {
        node.grad = amount
    } else if _number(node.grad) {
        node.grad = add(constant(node.grad)?, amount)?
    } else if _grad_is_zero(node.grad) {
        // Fresh zeroed array gradient: take the contribution node directly.
        node.grad = amount
    } else {
        node.grad = add(constant(node.grad)?, amount)?
    }
    Ok(null)
}

fn _grad_is_zero(g) {
    if _is_array(g) { return warp.sum(warp.abs_(g)) == 0.0 }
    g == 0
}

fn _seed_grad(current, create_graph) -> Result[any] {
    if create_graph {
        if _is_node(current) {
            return Ok(add(current, constant(1.0)?)?)
        }
        if _number(current) {
            // Keep numeric seed; first _ensure_grad_node wraps it.
            return Ok(current + 1.0)
        }
        return Ok(1.0)
    }
    if _is_node(current) {
        return Ok(current.value + 1.0)
    }
    Ok(current + 1.0)
}

fn _ensure_grad_node(g) -> Result[any] {
    if _is_node(g) { return Ok(g) }
    if !_supported_value(g) { return Err("ml.backward create_graph expects scalar or warp-array gradients") }
    constant(g)
}

fn _grad_numeric(g) {
    if _is_node(g) { return g.value }
    g
}

fn _flag(v) {
    if v == null || v == false || v == 0 || v == 0.0 { return false }
    if v == true || v == 1 || v == 1.0 { return true }
    false
}

fn _as_node(value) {
    if _is_node(value) { return value }
    if !_supported_value(value) { return null }
    _node(value, false, [], null, null)
}

fn _node(value, requires_grad, parents, op, aux) {
    {
        "_autograd": true,
        "value": value,
        "grad": _zero_like(value),
        "requires_grad": requires_grad,
        "parents": parents,
        "op": op,
        "aux": aux,
        "_topo_mark": false,
    }
}

fn _collect(node, order) {
    if !_is_node(node) || node._topo_mark { return }
    node._topo_mark = true
    for parent in node.parents { _collect(parent, order) }
    push(order, node)
}

fn _supported_value(value) { _number(value) || _is_array(value) }

fn _is_array(value) {
    value != null && _kind(value) == "map" && value._warp == true
}

fn _zero_like(value) {
    if _is_array(value) { return warp.zeros(warp.shape(value)) }
    0.0
}

fn _expand_like(value, target) {
    if _is_array(target) {
        return warp.full(warp.shape(target), value)
    }
    value
}

fn _reduce_to_parent(value, parent) {
    if _is_array(value) && !_is_array(parent) { return warp.sum(value) }
    if !_is_array(value) && _is_array(parent) { return _expand_like(value, parent) }
    if _is_array(value) && _is_array(parent) {
        output_shape := warp.shape(value)
        target_shape := warp.shape(parent)
        let mut result := value
        let mut axis := len(output_shape) - 1
        while axis >= 0 {
            aligned := axis - (len(output_shape) - len(target_shape))
            if aligned < 0 || target_shape[aligned] == 1 && output_shape[axis] != 1 {
                result = warp.sum_axis_opts(result, axis, true)
            }
            axis = axis - 1
        }
        return warp.reshape(result, target_shape)
    }
    value
}

fn _value_add(a, b) {
    if _is_array(a) || _is_array(b) { return warp.add(a, b) }
    a + b
}

fn _value_sub(a, b) {
    if _is_array(a) || _is_array(b) { return warp.sub(a, b) }
    a - b
}

fn _value_mul(a, b) {
    if _is_array(a) || _is_array(b) { return warp.mul(a, b) }
    a * b
}

fn _value_div(a, b) {
    if _is_array(a) || _is_array(b) { return warp.div(a, b) }
    a / b
}

fn _value_neg(a) {
    if _is_array(a) { return warp.neg(a) }
    -a
}

fn _value_sqrt(a) {
    if _is_array(a) { return warp.sqrt(a) }
    math.sqrt(a)
}

fn _value_exp(a) {
    if _is_array(a) { return warp.exp(a) }
    math.exp(a)
}

fn _value_log(a) {
    if _is_array(a) { return warp.log_(a) }
    math.log(a)
}

fn _value_relu(a) {
    if _is_array(a) {
        // Prefer maximum when present; fall back for older vendor warps.
        // greater returns 0/1, so a * (a > 0) is ReLU without a maximum op.
        return warp.mul(a, warp.greater(a, 0.0))
    }
    if a > 0.0 { a } else { 0.0 }
}

fn _value_relu_derivative(a) {
    if _is_array(a) { return warp.greater(a, 0.0) }
    if a > 0.0 { 1.0 } else { 0.0 }
}

fn _value_pow(a, exponent) {
    if _is_array(a) { return warp.pow_(a, exponent) }
    math.pow(a, exponent)
}

fn _value_sum(a) {
    if _is_array(a) { return warp.sum(a) }
    a
}

fn _value_numel(a) {
    if _is_array(a) { return warp.size(a) + 0.0 }
    1.0
}

fn _value_matmul(a, b) {
    if _is_array(a) || _is_array(b) {
        dispatched := dev.dispatch_matmul(a, b)
        if is_err(dispatched) { return dispatched }
        if dispatched.value != null && dispatched.value.dispatched == true {
            return dispatched.value.value
        }
        return warp.matmul(a, b)
    }
    a * b
}

fn _value_sigmoid(a) {
    if _is_array(a) {
        // Both branches are evaluated eagerly; the overflow-prone lane of each
        // branch is discarded by where, so extreme values stay finite.
        positive := warp.div(1.0, warp.add(1.0, warp.exp(warp.neg(a))))
        e := warp.exp(a)
        return warp.where(warp.greater_equal(a, 0.0), positive, warp.div(e, warp.add(1.0, e)))
    }
    if a >= 0 { return 1.0 / (1.0 + math.exp(-a)) }
    e := math.exp(a)
    return e / (1.0 + e)
}

fn _value_tanh(a) {
    if _is_array(a) { return warp.tanh(a) }
    _scalar_tanh(a)
}

fn _scalar_tanh(x) {
    if x > 20.0 { return 1.0 }
    if x < -20.0 { return -1.0 }
    e := math.exp(2.0 * x)
    return (e - 1.0) / (e + 1.0)
}

fn _value_gelu(a) {
    if _is_array(a) {
        return warp.mul(warp.mul(0.5, a), warp.add(1.0, warp.tanh(_gelu_inner(a))))
    }
    return 0.5 * a * (1.0 + _scalar_tanh(_gelu_inner_scalar(a)))
}

fn _gelu_derivative(x) {
    // d/dx [0.5 x (1 + tanh u)], u = sqrt(2/pi) (x + 0.044715 x^3),
    // u' = sqrt(2/pi) (1 + 0.134145 x^2).
    if _is_array(x) {
        t := warp.tanh(_gelu_inner(x))
        sech2 := warp.sub(1.0, warp.mul(t, t))
        du := warp.mul(0.7978845608028654, warp.add(1.0, warp.mul(0.134145, warp.pow_(x, 2.0))))
        return warp.add(warp.mul(0.5, warp.add(1.0, t)), warp.mul(warp.mul(0.5, x), warp.mul(sech2, du)))
    }
    t := _scalar_tanh(_gelu_inner_scalar(x))
    0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * 0.7978845608028654 * (1.0 + 0.134145 * x * x)
}

fn _gelu_inner(a) {
    warp.mul(0.7978845608028654, warp.add(a, warp.mul(0.044715, warp.pow_(a, 3.0))))
}

fn _gelu_inner_scalar(x) {
    0.7978845608028654 * (x + 0.044715 * x * x * x)
}

fn _value_softmax(a, axis) {
    shifted := warp.sub(a, warp.max_axis_opts(a, axis, true))
    e := warp.exp(shifted)
    warp.div(e, warp.sum_axis_opts(e, axis, true))
}

fn _value_huber(a, b, delta) {
    residual := _value_sub(a, b)
    if _is_array(residual) {
        magnitude := warp.abs_(residual)
        quadratic := warp.mul(0.5, warp.mul(residual, residual))
        linear := warp.mul(delta, warp.sub(magnitude, 0.5 * delta))
        return warp.where(warp.less_equal(magnitude, delta), quadratic, linear)
    }
    magnitude := math.abs(residual)
    if magnitude <= delta { return 0.5 * residual * residual }
    return delta * (magnitude - 0.5 * delta)
}

fn _value_cross_entropy(logits, targets) {
    shape := warp.shape(logits)
    n := shape[0]
    classes := shape[1]
    // log-softmax row i: z - m - log(sum(exp(z - m))); loss averages the
    // negative target log-probability: log(s) + m - z_target.
    m := warp.max_axis_opts(logits, 1, true)
    s := warp.sum_axis_opts(warp.exp(warp.sub(logits, m)), 1, true)
    flat := warp.to_list(logits)
    flat_m := warp.to_list(m)
    flat_s := warp.to_list(s)
    let mut total = 0.0
    let mut i = 0
    while i < n {
        total = total + math.log(flat_s[i]) + flat_m[i] - flat[i * classes + targets[i]]
        i = i + 1
    }
    total / n
}

fn _ce_grad(probs, targets, shape) {
    n := shape[0]
    classes := shape[1]
    let mut data = []
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < classes {
            data = push(data, if j == targets[i] { 1.0 } else { 0.0 })
            j = j + 1
        }
        i = i + 1
    }
    warp.div(warp.sub(probs, warp.array(data, shape)), n + 0.0)
}

fn _value_clip(a, lo, hi) {
    if _is_array(a) { return warp.clip(a, lo, hi) }
    math.clamp(a, lo, hi)
}

fn _softmax_axis(value, axis) {
    ndim := len(warp.shape(value))
    let mut ax = if axis == null { ndim - 1 } else { axis }
    if _kind(ax) != "int" { return null }
    if ax < 0 { ax = ax + ndim }
    if ax < 0 || ax >= ndim { return null }
    ax
}

fn _class_targets(targets, n, classes) {
    if _kind(targets) != "list" || len(targets) != n { return false }
    for target in targets {
        if _kind(target) != "int" || target < 0 || target >= classes { return false }
    }
    true
}

fn _failed(value) {
    is_err(value)
}

// to_device wraps non-CPU placements in {"value", "fallback", "requested"};
// value/grad look through that wrapper so placed nodes stay usable.
fn _unwrap_device(value) {
    if value == null || _kind(value) != "map" { return value }
    if contains(keys(value), "fallback") && contains(keys(value), "requested") &&
        contains(keys(value), "value") {
        return value.value
    }
    value
}

fn _is_node(value) {
    if value == null || _kind(value) != "map" { return false }
    // Warp arrays are maps too; only autograd nodes carry _autograd.
    if !contains(keys(value), "_autograd") { return false }
    value._autograd == true
}

fn _number(value) {
    if value == null { return false }
    k := _kind(value)
    if k != "int" && k != "float" { return false }
    value == value && !math.isinf(value)
}

fn _optimizer_parameters(parameters) {
    if _kind(parameters) != "list" || len(parameters) == 0 { return false }
    for parameter in parameters {
        if !_is_node(parameter) { return false }
        // A parameter must be trainable or explicitly frozen via ml.freeze
        // (which marks _frozen); plain constants are still rejected.
        if !parameter.requires_grad && !_is_frozen(parameter) { return false }
    }
    true
}

fn _is_frozen(node) {
    contains(keys(node), "_frozen") && node._frozen == true
}

fn _kind(value) {
    type_of(value)
}
