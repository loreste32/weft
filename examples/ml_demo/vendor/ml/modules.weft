use json
use fs
use math
use str
use warp
use "./autograd.weft" as ag

// Small composable trainable modules and checkpoint boundaries. Module maps
// contain autograd nodes at runtime; checkpoint files contain only plain
// parameter values, optimizer state, and user metadata, never graph links.

// seed(value) returns a deterministic RNG handle. Pass it to linear_module as
// the optional third argument for reproducible initialization.
pub fn seed(value) -> Result[any] {
    if _kind(value) != "int" { return Err("ml.seed expects an integer") }
    Ok({"_ml_rng": true, "state": if value == 0 { 1 } else { value }})
}

fn _next_unit(rng) {
    // Numerical Recipes LCG; returns [0, 1) and mutates rng.state.
    let mut next = (rng.state * 1664525 + 1013904223) % 2147483647
    if next < 0 { next = -next }
    rng.state = next
    value := (next + 0.0) / 2147483647.0
    value
}

fn _rand_array(shape, scale, rng) {
    let mut n = 1
    for dim in shape { n = n * dim }
    let mut data = []
    let mut i = 0
    while i < n {
        value := _next_unit(rng)
        data = push(data, (value * 2.0 - 1.0) * scale)
        i = i + 1
    }
    warp.array(data, shape)
}

pub fn linear_module(in_features, out_features, seed_arg) -> Result[any] {
    if _kind(in_features) != "int" || in_features <= 0 { return Err("ml.linear_module in_features must be positive") }
    if _kind(out_features) != "int" || out_features <= 0 { return Err("ml.linear_module out_features must be positive") }
    scale := 1.0 / math.sqrt(in_features + 0.0)
    rng := if seed_arg == null {
        {"_ml_rng": true, "state": 1}
    } else if _kind(seed_arg) == "int" {
        {"_ml_rng": true, "state": if seed_arg == 0 { 1 } else { seed_arg }}
    } else if _kind(seed_arg) == "map" && seed_arg._ml_rng == true {
        seed_arg
    } else {
        return Err("ml.linear_module seed must be int or ml.seed handle")
    }
    weight := ag.variable(_rand_array([in_features, out_features], scale, rng))?
    bias := ag.variable(warp.zeros([out_features]))?
    Ok({
        "kind": "linear",
        "in_features": in_features,
        "out_features": out_features,
        "weight": weight,
        "bias": bias,
        "parameters": [weight, bias],
    })
}

pub fn sequential(modules) -> Result[any] {
    if _kind(modules) != "list" || len(modules) == 0 {
        return Err("ml.sequential expects a non-empty module list")
    }
    let mut parameters = []
    for module in modules {
        if module.kind == "linear" {
            for parameter in module.parameters { parameters = push(parameters, parameter) }
        } else if _is_activation(module) {
            // activation — no parameters
        } else {
            return Err("ml.sequential received an unsupported module kind")
        }
    }
    Ok({
        "kind": "sequential",
        "modules": modules,
        "parameters": parameters,
    })
}

pub fn relu_module() -> Result[any] {
    Ok({"kind": "relu", "parameters": []})
}

pub fn sigmoid_module() -> Result[any] {
    Ok({"kind": "sigmoid", "parameters": []})
}

pub fn tanh_module() -> Result[any] {
    Ok({"kind": "tanh", "parameters": []})
}

pub fn gelu_module() -> Result[any] {
    Ok({"kind": "gelu", "parameters": []})
}

// axis is optional; defaults to the last axis (see ml.softmax).
pub fn softmax_module(axis) -> Result[any] {
    Ok({"kind": "softmax", "axis": axis, "parameters": []})
}

pub fn module_forward(module, input) -> Result[any] {
    if module == null || _kind(module) != "map" { return Err("ml.module_forward expects a module") }
    if module.kind == "linear" {
        // sequential passes the previous module's autograd node through so
        // gradients keep flowing into earlier layers; raw arrays are wrapped
        // as constants inside linear_forward.
        return linear_forward(module, input)
    }
    if module.kind == "relu" {
        node := if _kind(input) == "map" && contains(keys(input), "grad") {
            input
        } else {
            ag.constant(input)?
        }
        return ag.relu(node)
    }
    if module.kind == "sigmoid" || module.kind == "tanh" || module.kind == "gelu" || module.kind == "softmax" {
        node := if _kind(input) == "map" && contains(keys(input), "grad") {
            input
        } else {
            ag.constant(input)?
        }
        if module.kind == "sigmoid" { return ag.sigmoid(node) }
        if module.kind == "tanh" { return ag.tanh(node) }
        if module.kind == "gelu" { return ag.gelu(node) }
        return ag.softmax(node, module.axis)
    }
    if module.kind == "sequential" {
        let mut value = input
        for child in module.modules {
            value = module_forward(child, value)?
        }
        return Ok(value)
    }
    Err("ml.module_forward received an unsupported module kind")
}

pub fn module_parameters(module) -> Result[any] {
    if module == null || _kind(module) != "map" || !_parameter_list(module.parameters) {
        // Empty parameter lists are valid for pure activations.
        if module != null && _kind(module) == "map" && _is_activation(module) {
            return Ok([])
        }
        if module != null && _kind(module) == "map" && module.kind == "sequential" && _kind(module.parameters) == "list" {
            return Ok(module.parameters)
        }
        if !_is_linear(module) { return Err("ml.module_parameters expects a supported module") }
    }
    Ok(module.parameters)
}

// named_parameters(module) returns [{"name", "parameter"}] entries following
// the state_dict order: a linear module exposes "weight" and "bias"; a
// sequential prefixes each child with its index ("0.weight", "2.bias", ...).
// Activations contribute no entries. These names are what freeze/unfreeze
// match against.
pub fn named_parameters(module) -> Result[any] {
    if _is_linear(module) {
        return Ok([
            {"name": "weight", "parameter": module.weight},
            {"name": "bias", "parameter": module.bias},
        ])
    }
    if module != null && _kind(module) == "map" && _is_activation(module) {
        return Ok([])
    }
    if module != null && _kind(module) == "map" && module.kind == "sequential" && _kind(module.modules) == "list" {
        let mut result = []
        let mut i = 0
        while i < len(module.modules) {
            child := module.modules[i]
            if _is_linear(child) {
                result = push(result, {"name": "" + i + ".weight", "parameter": child.weight})
                result = push(result, {"name": "" + i + ".bias", "parameter": child.bias})
            }
            i = i + 1
        }
        return Ok(result)
    }
    Err("ml.named_parameters expects a supported module")
}

// freeze(module, names) marks matching parameters as not requiring gradients:
// backward accumulates nothing into them and every optimizer step skips them
// (values and Adam moments stay bit-identical). names is null (all
// parameters), a single name, or a list of names; a trailing "*" makes a name
// a prefix pattern (e.g. "0.*" freezes the first sequential child). Unknown
// names are an error and freeze nothing. unfreeze reverses it.
pub fn freeze(module, names) -> Result[any] {
    _set_frozen(module, names, true)
}

pub fn unfreeze(module, names) -> Result[any] {
    _set_frozen(module, names, false)
}

fn _set_frozen(module, names, frozen) -> Result[any] {
    named := named_parameters(module)?
    if names == null {
        for entry in named { _apply_frozen(entry.parameter, frozen) }
        return Ok(null)
    }
    let mut patterns = names
    if _kind(names) == "str" { patterns = [names] }
    if _kind(patterns) != "list" || len(patterns) == 0 {
        return Err("ml.freeze names must be a string, a non-empty list of strings, or null")
    }
    // Validate every pattern first so a typo freezes nothing at all.
    for pattern in patterns {
        if _kind(pattern) != "str" { return Err("ml.freeze names must be strings") }
        let mut matched = false
        for entry in named {
            if _name_matches(entry.name, pattern) { matched = true }
        }
        if !matched { return Err("ml.freeze found no parameter matching '" + pattern + "'") }
    }
    for entry in named {
        for pattern in patterns {
            if _name_matches(entry.name, pattern) { _apply_frozen(entry.parameter, frozen) }
        }
    }
    Ok(null)
}

fn _name_matches(name, pattern) {
    if name == pattern { return true }
    if str.ends_with(pattern, "*") {
        return str.starts_with(name, str.slice(pattern, 0, len(pattern) - 1))
    }
    false
}

fn _apply_frozen(parameter, frozen) {
    parameter.requires_grad = !frozen
    parameter._frozen = frozen
}

pub fn linear_forward(module, input) -> Result[any] {
    if !_is_linear(module) { return Err("ml.linear_forward expects a linear module") }
    // Input may be a raw warp array (wrapped as a constant) or the autograd
    // node produced by an upstream module (kept, so the chain stays
    // differentiable end to end).
    input_value := if _is_node(input) { input.value } else { input }
    if !_is_array(input_value) || len(warp.shape(input_value)) != 2 || warp.shape(input_value)[1] != module.in_features {
        return Err("ml.linear_forward input shape does not match in_features")
    }
    input_node := if _is_node(input) { input } else { ag.constant(input)? }
    product := ag.matmul(input_node, module.weight)?
    // Bias [out_features] broadcasts onto [batch, out_features] via warp.add.
    ag.add(product, module.bias)
}

pub fn state_dict(parameters) -> Result[any] {
    if !_parameter_list(parameters) { return Err("ml.state_dict expects a non-empty list of trainable variables") }
    let mut values = []
    for parameter in parameters { values = push(values, ag.value(parameter)?) }
    Ok(values)
}

pub fn load_state_dict(parameters, values) -> Result[any] {
    if !_parameter_list(parameters) || _kind(values) != "list" || len(values) != len(parameters) {
        return Err("ml.load_state_dict parameter count does not match")
    }
    let mut validated = []
    for value in values {
        candidate := ag.variable(value)
        if !candidate.ok { return Err("ml.load_state_dict contains an invalid parameter value") }
        validated = push(validated, candidate.value.value)
    }
    let mut i = 0
    while i < len(parameters) {
        parameters[i].value = validated[i]
        i = i + 1
    }
    Ok(null)
}

// Checkpoints are versioned JSON documents. Version 2 adds a top-level
// numeric "epoch" (taken from metadata.epoch when saving, else 0) so a
// resume flow can continue the training loop at the right step; the stored
// optimizer map (e.g. adam_state) round-trips bit-identically, so resuming
// with it reproduces uninterrupted training exactly. Version 1 files still
// load; their epoch defaults to 0.
pub fn save_checkpoint(path, parameters, optimizer_state, metadata) -> Result[any] {
    if path == null || path == "" { return Err("ml.save_checkpoint expects a path") }
    values := state_dict(parameters)?
    let mut epoch = 0
    if metadata != null && _kind(metadata) == "map" && contains(keys(metadata), "epoch") {
        candidate := metadata.epoch
        if candidate != null && (_kind(candidate) == "int" || _kind(candidate) == "float") && candidate >= 0 {
            epoch = candidate
        }
    }
    payload := {
        "format": "weft.ml.checkpoint",
        "version": 2,
        "parameters": values,
        "optimizer": if optimizer_state == null { {} } else { optimizer_state },
        "epoch": epoch,
        "metadata": if metadata == null { {} } else { metadata },
    }
    fs.write(path, json.stringify(payload))?
    Ok(path)
}

pub fn load_checkpoint(path) -> Result[any] {
    if path == null || path == "" { return Err("ml.load_checkpoint expects a path") }
    raw := fs.read(path)?
    payload := json.parse(raw)?
    if _kind(payload) != "map" || payload.format != "weft.ml.checkpoint" ||
        (payload.version != 1 && payload.version != 2) {
        return Err("ml.load_checkpoint has an unsupported format or version")
    }
    if _kind(payload.parameters) != "list" || payload.optimizer == null || payload.metadata == null {
        return Err("ml.load_checkpoint is missing required fields")
    }
    // Version 1 has no epoch field; normalize so callers always see one.
    if !contains(keys(payload), "epoch") || payload.epoch == null {
        payload.epoch = 0
    }
    epoch := payload.epoch
    if (_kind(epoch) != "int" && _kind(epoch) != "float") || epoch < 0 {
        return Err("ml.load_checkpoint has an invalid epoch field")
    }
    Ok(payload)
}

// resume(path, target) restores a training run from a checkpoint: it loads
// the stored weights into target (a module or a plain parameter list) and
// returns {"epoch", "optimizer", "metadata", "parameters"}. optimizer is the
// stored optimizer state, ready to pass back to adam_step so resumed training
// is bit-identical to uninterrupted training; it is null when the checkpoint
// carries no optimizer state (graceful default: create fresh state). A
// checkpoint whose optimizer state does not match the parameters is an error.
pub fn resume(path, target) -> Result[any] {
    checkpoint := load_checkpoint(path)?
    let mut parameters = target
    if _kind(target) != "list" {
        parameters = module_parameters(target)?
    }
    load_state_dict(parameters, checkpoint.parameters)?
    let mut optimizer = checkpoint.optimizer
    if _kind(optimizer) != "map" || len(keys(optimizer)) == 0 {
        optimizer = null
    } else if !_optimizer_state_shape(optimizer, len(parameters)) {
        return Err("ml.resume checkpoint optimizer state does not match the parameters")
    }
    Ok({
        "epoch": checkpoint.epoch,
        "optimizer": optimizer,
        "metadata": checkpoint.metadata,
        "parameters": parameters,
    })
}

fn _optimizer_state_shape(state, count) {
    k := keys(state)
    if !contains(k, "step") || !contains(k, "m") || !contains(k, "v") { return false }
    if _kind(state.step) != "int" && _kind(state.step) != "float" { return false }
    if state.step < 0 { return false }
    if _kind(state.m) != "list" || _kind(state.v) != "list" { return false }
    len(state.m) == count && len(state.v) == count
}

fn _is_linear(module) {
    module != null && _kind(module) == "map" && module.kind == "linear" && _parameter_list(module.parameters)
}

fn _is_activation(module) {
    if module == null || _kind(module) != "map" { return false }
    kind := module.kind
    kind == "relu" || kind == "sigmoid" || kind == "tanh" || kind == "gelu" || kind == "softmax"
}

fn _parameter_list(parameters) {
    if _kind(parameters) != "list" || len(parameters) == 0 { return false }
    for parameter in parameters {
        current := ag.value(parameter)
        if !current.ok { return false }
    }
    true
}

fn _is_array(value) {
    value != null && _kind(value) == "map" && contains(keys(value), "_warp") && value._warp == true
}

fn _is_node(value) {
    value != null && _kind(value) == "map" && contains(keys(value), "_autograd") && value._autograd == true
}

fn _kind(value) { type_of(value) }
