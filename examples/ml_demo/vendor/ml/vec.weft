use math


pub fn dot(a, b) {
    if a == null || b == null {
        return Err("ml.dot expects two vectors")
    }
    if len(a) != len(b) {
        return Err("ml.dot requires vectors with equal dimensions")
    }
    mut s := 0.0
    mut i := 0
    mut n := len(a)
    while i < n {
        s = s + a[i] * b[i]
        i = i + 1
    }
    s
}


pub fn norm(a) { math.sqrt(dot(a, a)) }


pub fn cosine(a, b) {
    if a == null || b == null {
        return Err("ml.cosine expects two vectors")
    }
    if len(a) != len(b) {
        return Err("ml.cosine requires vectors with equal dimensions")
    }
    na := norm(a)
    nb := norm(b)
    if na == 0.0 || nb == 0.0 { 0.0 } else { dot(a, b) / (na * nb) }
}


pub fn topk(query, items, k) {
    if query == null || items == null {
        return Err("ml.topk expects a query vector and items")
    }
    if k < 0 {
        return Err("ml.topk requires a non-negative k")
    }
    mut scored := []
    mut i := 0
    while i < len(items) {
        it := items[i]
        if it == null || it.vec == null {
            return Err("ml.topk items must contain a vec field")
        }
        if len(query) != len(it.vec) {
            return Err("ml.topk requires every item vector to match the query dimension")
        }
        sc := cosine(query, it.vec)
        push(scored, {
            "id": it.id,
            "score": sc,
            "meta": it.meta,
            "vec": it.vec,
        })
        i = i + 1
    }
    mut a := 0
    while a < len(scored) {
        mut best := a
        mut b := a + 1
        while b < len(scored) {
            if scored[b].score > scored[best].score {
                best = b
            }
            b = b + 1
        }
        if best != a {
            tmp := scored[a]
            scored[a] = scored[best]
            scored[best] = tmp
        }
        a = a + 1
    }
    mut out := []
    mut j := 0
    mut lim := k
    if lim > len(scored) {
        lim = len(scored)
    }
    while j < lim {
        hit := scored[j]
        push(out, {
            "id": hit.id,
            "score": hit.score,
            "meta": hit.meta,
        })
        j = j + 1
    }
    out
}
