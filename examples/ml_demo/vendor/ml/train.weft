use math
use "./metrics.weft" as met
use warp

// Small, deterministic classical models that scale with minibatches. This is
// intentionally a model API, not a promise of a full autograd framework.

pub fn linear_fit(features, targets, opts) -> Result[any] {
    feature_rows := _feature_rows(features)
    target_values := _target_values(targets)
    shape := _validate_dataset(feature_rows, target_values)
    if shape == null { return Err("ml.linear_fit expects a non-empty numeric matrix and matching targets") }
    dims := shape[1]
    settings := _settings(opts)
    let mut weights = []
    let mut j = 0
    while j < dims { weights = push(weights, 0.0) j = j + 1 }
    let mut bias = 0.0
    let mut epoch = 0
    let mut loss = 0.0
    while epoch < settings.epochs {
    step := _linear_epoch(feature_rows, target_values, weights, bias, settings, epoch)
    loss = step.loss
    bias = step.bias
        epoch = epoch + 1
    }
    Ok({
        "kind": "linear",
        "weights": weights,
        "bias": bias,
        "features": dims,
        "epochs": settings.epochs,
        "loss": loss,
    })
}

pub fn logistic_fit(features, targets, opts) -> Result[any] {
    feature_rows := _feature_rows(features)
    target_values := _target_values(targets)
    shape := _validate_dataset(feature_rows, target_values)
    if shape == null { return Err("ml.logistic_fit expects a non-empty numeric matrix and matching targets") }
    n := shape[0]
    dims := shape[1]
    settings := _settings(opts)
    let mut weights = []
    let mut j = 0
    while j < dims { weights = push(weights, 0.0) j = j + 1 }
    let mut bias = 0.0
    let mut epoch = 0
    let mut loss = 0.0
    while epoch < settings.epochs {
    step := _logistic_epoch(feature_rows, target_values, weights, bias, settings, epoch)
    loss = step.loss
    bias = step.bias
        epoch = epoch + 1
    }
    Ok({
        "kind": "logistic",
        "weights": weights,
        "bias": bias,
        "features": dims,
        "epochs": settings.epochs,
        "loss": loss,
    })
}

pub fn fit(kind, features, targets, opts) -> Result[any] {
    if kind == "linear" { return linear_fit(features, targets, opts) }
    if kind == "logistic" { return logistic_fit(features, targets, opts) }
    Err("ml.fit kind must be linear or logistic")
}

pub fn train(kind, features, targets, opts) -> Result[any] {
    fit(kind, features, targets, opts)
}

pub fn predict(model, features) -> Result[any] {
    if model == null || model.weights == null { return Err("ml.predict expects a fitted model") }
    feature_rows := _feature_rows(features)
    shape := _validate_features(feature_rows)
    if shape == null || shape[1] != len(model.weights) { return Err("ml.predict feature dimensions do not match model") }
    let mut result = []
    for row in feature_rows {
        z := model.bias + _row_dot(row, model.weights)
        result = push(result, if model.kind == "logistic" { _sigmoid(z) } else { z })
    }
    Ok(result)
}

pub fn predict_classes(model, features, threshold) -> Result[any] {
    t := if threshold == null { 0.5 } else { threshold }
    probabilities := predict(model, features)
    if !probabilities.ok { return probabilities }
    let mut result = []
    for value in probabilities.value { result = push(result, if value >= t { 1 } else { 0 }) }
    Ok(result)
}

pub fn score(model, features, targets) -> Result[any] {
    if model == null { return Err("ml.score expects a fitted model") }
    if model.kind == "logistic" {
        classes := predict_classes(model, features, 0.5)?
        value := met.accuracy(classes, targets)
        if _kind(value) == "map" { return value }
        return Ok(value)
    }
    predictions := predict(model, features)?
    mse_value := met.mse(predictions, targets)
    if _kind(mse_value) == "map" { return mse_value }
    Ok(mse_value)
}

// batches(features, targets, batch_size, opts) materializes one epoch of
// minibatches as a list of {"x", "y", "indices"} maps. opts:
//   shuffle (bool, default false) — permute sample order with a seeded LCG
//   seed    (int, default 1)      — same seed + data => identical batches
//   drop_last (bool, default false) — drop a trailing partial batch
// Every sample appears in exactly one batch per call, shuffled or not.
pub fn batches(features, targets, batch_size, opts) -> Result[any] {
    feature_rows := _feature_rows(features)
    target_values := _target_values(targets)
    shape := _validate_dataset(feature_rows, target_values)
    if shape == null { return Err("ml.batches expects a non-empty numeric matrix and matching targets") }
    if _kind(batch_size) != "int" || batch_size <= 0 {
        return Err("ml.batches batch_size must be a positive integer")
    }
    n := shape[0]
    shuffle := _option_bool(opts, "shuffle", false)
    drop_last := _option_bool(opts, "drop_last", false)
    order := if shuffle {
        _permutation(n, _option_int(opts, "seed", 1, 0, 2147483646))
    } else {
        _sequential_order(n)
    }
    let mut result = []
    let mut start = 0
    while start < n {
        stop := if start + batch_size < n { start + batch_size } else { n }
        if drop_last && stop - start < batch_size { start = stop } else {
            let mut batch_x = []
            let mut batch_y = []
            let mut indices = []
            let mut i = start
            while i < stop {
                idx := order[i]
                batch_x = push(batch_x, feature_rows[idx])
                batch_y = push(batch_y, target_values[idx])
                indices = push(indices, idx)
                i = i + 1
            }
            result = push(result, {"x": batch_x, "y": batch_y, "indices": indices})
            start = stop
        }
    }
    Ok(result)
}

pub fn standardize(features) -> Result[any] {
    feature_rows := _feature_rows(features)
    shape := _validate_features(feature_rows)
    if shape == null { return Err("ml.standardize expects a non-empty numeric matrix") }
    n := shape[0]
    dims := shape[1]
    let mut means = []
    let mut scales = []
    let mut j = 0
    while j < dims {
        let mut total = 0.0
        for row in feature_rows { total = total + row[j] }
        mean_value := total / n
        let mut variance = 0.0
        for row in feature_rows { delta := row[j] - mean_value variance = variance + delta * delta }
        let mut scale := math.sqrt(variance / n)
        if scale == 0 { scale = 1.0 }
        means = push(means, mean_value)
        scales = push(scales, scale)
        j = j + 1
    }
    let mut values = []
    for row in feature_rows {
        let mut result = []
        j = 0
        while j < dims { result = push(result, (row[j] - means[j]) / scales[j]) j = j + 1 }
        values = push(values, result)
    }
    Ok({"values": values, "mean": means, "scale": scales})
}

// Training accepts ordinary nested lists and packed Warp matrices. The
// current trainer materializes a Warp input into row lists once at the API
// boundary, preserving the existing minibatch implementation while making
// DataFrame -> Warp -> ML pipelines explicit and deterministic.
fn _feature_rows(features) {
    if !_is_warp_array(features) { return features }
    shape := warp.shape(features)
    if _kind(shape) != "list" || len(shape) != 2 { return null }
    flat := warp.to_list(features)
    if _kind(flat) != "list" || len(flat) != shape[0] * shape[1] { return null }
    let mut rows = []
    let mut i = 0
    while i < shape[0] {
        let mut row = []
        let mut j = 0
        while j < shape[1] {
            row = push(row, flat[i * shape[1] + j])
            j = j + 1
        }
        rows = push(rows, row)
        i = i + 1
    }
    rows
}

fn _target_values(targets) {
    if !_is_warp_array(targets) { return targets }
    shape := warp.shape(targets)
    if _kind(shape) != "list" || len(shape) != 1 { return null }
    values := warp.to_list(targets)
    if _kind(values) != "list" || len(values) != shape[0] { return null }
    values
}

fn _is_warp_array(value) {
    _kind(value) == "map" && contains(keys(value), "_warp") && value._warp == true
}

fn _validate_dataset(features, targets) {
    shape := _validate_features(features)
    if shape == null || targets == null || _kind(targets) != "list" || len(targets) != shape[0] { return null }
    for target in targets { if _kind(target) != "int" && _kind(target) != "float" { return null } }
    shape
}

fn _validate_features(features) {
    if features == null || _kind(features) != "list" || len(features) == 0 { return null }
    first := features[0]
    if _kind(first) != "list" || len(first) == 0 { return null }
    dims := len(first)
    for row in features {
        if _kind(row) != "list" || len(row) != dims { return null }
        for value in row { if _kind(value) != "int" && _kind(value) != "float" { return null } }
    }
    [len(features), dims]
}

fn _settings(opts) {
    epochs := _option_int(opts, "epochs", 100, 1, 100000)
    batch_size := _option_int(opts, "batch_size", 256, 1, 1000000)
    learning_rate := _option_number(opts, "learning_rate", 0.01, 1e-12, 1e6)
    l2 := _option_number(opts, "l2", 0.0, 0.0, 1e6)
    shuffle := _option_bool(opts, "shuffle", false)
    seed := _option_int(opts, "seed", 1, 0, 2147483646)
    {"epochs": epochs, "batch_size": batch_size, "learning_rate": learning_rate, "l2": l2, "shuffle": shuffle, "seed": seed}
}

fn _option_bool(opts, name, fallback) {
    if opts == null || _kind(opts) != "map" || opts[name] == null { return fallback }
    value := opts[name]
    if value == true { return true }
    if value == false { return false }
    fallback
}

// Fisher-Yates shuffle driven by the same Numerical Recipes LCG as module
// init, so a given seed always produces the same permutation.
fn _permutation(n, seed) {
    order := _sequential_order(n)
    if n < 2 { return order }
    let mut state = seed % 2147483647
    if state <= 0 { state = state + 2147483646 }
    let mut i = n - 1
    while i > 0 {
        state = (state * 1664525 + 1013904223) % 2147483647
        if state < 0 { state = -state }
        j := state % (i + 1)
        tmp := order[i]
        order[i] = order[j]
        order[j] = tmp
        i = i - 1
    }
    order
}

fn _sequential_order(n) {
    let mut order = []
    let mut i = 0
    while i < n { order = push(order, i) i = i + 1 }
    order
}

fn _option_int(opts, name, fallback, low, high) {
    if opts == null || _kind(opts) != "map" || opts[name] == null { return fallback }
    value := opts[name]
    if _kind(value) != "int" || value < low || value > high { return fallback }
    value
}

fn _option_number(opts, name, fallback, low, high) {
    if opts == null || _kind(opts) != "map" || opts[name] == null { return fallback }
    value := opts[name]
    kind := _kind(value)
    if (kind != "int" && kind != "float") || value < low || value > high { return fallback }
    value + 0.0
}

fn _linear_epoch(features, targets, weights, bias, settings, epoch) {
    let mut total_loss = 0.0
    let mut start = 0
    let mut current_bias = bias
    order := if settings.shuffle { _permutation(len(features), settings.seed + epoch) } else { null }
    while start < len(features) {
        stop := if start + settings.batch_size < len(features) { start + settings.batch_size } else { len(features) }
        let mut gradients = []
        let mut j = 0
        while j < len(weights) { gradients = push(gradients, 0.0) j = j + 1 }
        let mut bias_gradient = 0.0
        count := stop - start
        let mut i = start
        while i < stop {
            idx := if order == null { i } else { order[i] }
            prediction := _row_dot(features[idx], weights) + current_bias
            error := prediction - targets[idx]
            total_loss = total_loss + error * error
            bias_gradient = bias_gradient + error
            j = 0
            while j < len(weights) { gradients[j] = gradients[j] + error * features[idx][j] j = j + 1 }
            i = i + 1
        }
        j = 0
        while j < len(weights) {
            weights[j] = weights[j] - settings.learning_rate * (gradients[j] / count + settings.l2 * weights[j])
            j = j + 1
        }
        current_bias = current_bias - settings.learning_rate * bias_gradient / count
        start = stop
    }
    {"loss": total_loss / len(features), "bias": current_bias}
}

fn _logistic_epoch(features, targets, weights, bias, settings, epoch) {
    let mut total_loss = 0.0
    let mut start = 0
    let mut current_bias = bias
    order := if settings.shuffle { _permutation(len(features), settings.seed + epoch) } else { null }
    while start < len(features) {
        stop := if start + settings.batch_size < len(features) { start + settings.batch_size } else { len(features) }
        let mut gradients = []
        let mut j = 0
        while j < len(weights) { gradients = push(gradients, 0.0) j = j + 1 }
        let mut bias_gradient = 0.0
        count := stop - start
        let mut i = start
        while i < stop {
            idx := if order == null { i } else { order[i] }
            probability := _sigmoid(_row_dot(features[idx], weights) + current_bias)
            target := targets[idx]
            total_loss = total_loss - (target * math.log(probability + 1e-12) + (1 - target) * math.log(1 - probability + 1e-12))
            error := probability - target
            bias_gradient = bias_gradient + error
            j = 0
            while j < len(weights) { gradients[j] = gradients[j] + error * features[idx][j] j = j + 1 }
            i = i + 1
        }
        j = 0
        while j < len(weights) {
            weights[j] = weights[j] - settings.learning_rate * (gradients[j] / count + settings.l2 * weights[j])
            j = j + 1
        }
        current_bias = current_bias - settings.learning_rate * bias_gradient / count
        start = stop
    }
    {"loss": total_loss / len(features), "bias": current_bias}
}

fn _row_dot(row, weights) {
    let mut result = 0.0
    let mut j = 0
    while j < len(weights) { result = result + row[j] * weights[j] j = j + 1 }
    result
}

fn _sigmoid(value) {
    if value >= 0 {
        1.0 / (1.0 + math.exp(-value))
    } else {
        e := math.exp(value)
        e / (1.0 + e)
    }
}

fn _kind(value) {
    if value == null { return "null" }
    text := json.stringify(value)
    if text == "true" || text == "false" { return "bool" }
    if str.starts_with(text, "\"") { return "str" }
    if str.starts_with(text, "[") { return "list" }
    if str.starts_with(text, "{") { return "map" }
    if str.contains(text, ".") || str.contains(text, "e") || str.contains(text, "E") { return "float" }
    "int"
}
