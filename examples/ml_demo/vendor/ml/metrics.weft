// Lightweight eval metrics — pure Weft.

// accuracy(preds, labels) — equal counts / n
pub fn accuracy(preds, labels) {
    mut ok := 0
    mut i := 0
    mut n := len(preds)
    if len(labels) < n {
        n = len(labels)
    }
    if n == 0 {
        return 0.0
    }
    while i < n {
        if preds[i] == labels[i] {
            ok = ok + 1
        }
        i = i + 1
    }
    ok * 1.0 / n
}

// mse(preds, labels) — mean squared error for numeric lists
pub fn mse(preds, labels) {
    mut s := 0.0
    mut i := 0
    mut n := len(preds)
    if len(labels) < n {
        n = len(labels)
    }
    if n == 0 {
        return 0.0
    }
    while i < n {
        d := preds[i] - labels[i]
        s = s + d * d
        i = i + 1
    }
    s / n
}

// split(rows, train_ratio) -> {train, test}
// train_ratio in 0..1 (e.g. 0.8). Deterministic prefix split (shuffle first if needed).
pub fn split(rows, train_ratio) {
    n := len(rows)
    mut cut := n * train_ratio
    // cut as int via loop
    mut k := 0
    while k < n && k < cut {
        k = k + 1
    }
    // if train_ratio is float like 0.8, n*0.8 might be float — use while k < n * train_ratio
    k = 0
    while k < n && (k * 1.0 / n) < train_ratio {
        k = k + 1
    }
    mut train := []
    mut test := []
    mut i := 0
    while i < n {
        if i < k {
            push(train, rows[i])
        } else {
            push(test, rows[i])
        }
        i = i + 1
    }
    {"train": train, "test": test}
}
