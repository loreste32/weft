use math
use accelerator

// ndarray-compatible numerical arrays for Weft. Arrays are immutable values:
// operations return a new array and never mutate the caller's data.

// ──────────────────────────────────────────────
// Creation
// ──────────────────────────────────────────────

pub fn array(data, shape) {
    if _wkind(data) != "list" { return Err("warp.array expects a flat data list") }
    s := if shape == null { [len(data)] } else { shape }
    if !_valid_shape(s) { return Err("warp.array expects non-negative integer dimensions") }
    if _prod(s) != len(data) { return Err("warp.array data length does not match shape") }
    {"_warp": true, "data": data, "shape": s, "_dtype": _infer_dtype(data)}
}

// Logical dtypes follow NumPy's common scalar names. Values remain ordinary
// Weft values; this metadata does not claim packed storage or SIMD execution.
pub fn array_typed(data, shape, dtype_name) {
    if _wkind(data) != "list" { return Err("warp.array_typed expects a flat data list") }
    s := if shape == null { [len(data)] } else { shape }
    if !_valid_shape(s) { return Err("warp.array_typed expects non-negative integer dimensions") }
    if _prod(s) != len(data) { return Err("warp.array_typed data length does not match shape") }
    if !_valid_dtype(dtype_name) { return Err("warp.array_typed received unsupported dtype") }
    let mut casted = []
    for value in data {
        kind := _wkind(value)
        if dtype_name != "object" && (value == null || (kind != "bool" && kind != "int" && kind != "float")) {
            return Err("warp.array_typed expects numeric values for this dtype")
        }
        casted = push(casted, _cast_value(value, dtype_name))
    }
    {"_warp": true, "data": casted, "shape": s, "_dtype": dtype_name}
}

pub fn astype(a, dtype_name) {
    if !_is_arr(a) { return Err("warp.astype expects an array") }
    array_typed(a.data, a.shape, dtype_name)
}

pub fn dtype(a) {
    if !_is_arr(a) { return _infer_dtype([a]) }
    if a._dtype == null { _infer_dtype(a.data) } else { a._dtype }
}

pub fn zeros(shape) { full(shape, 0.0) }

pub fn ones(shape) { full(shape, 1.0) }

pub fn full(shape, value) {
    if !_valid_shape(shape) { return Err("warp.full expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, value)
        i = i + 1 }
    array(d, shape)
}

pub fn zeros_dtype(shape, dtype_name) { full_dtype(shape, 0, dtype_name) }

pub fn ones_dtype(shape, dtype_name) { full_dtype(shape, 1, dtype_name) }

pub fn full_dtype(shape, value, dtype_name) {
    if !_valid_shape(shape) { return Err("warp.full_dtype expects non-negative integer dimensions") }
    if !_valid_dtype(dtype_name) { return Err("warp.full_dtype received unsupported dtype") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, _cast_value(value, dtype_name))
        i = i + 1 }
    array_typed(d, shape, dtype_name)
}

pub fn arange(start_or_stop, stop_arg, step_arg) {
    let mut s0 = start_or_stop
    let mut s1 = stop_arg
    let mut st = step_arg
    if s1 == null { s1 = s0
        s0 = 0 }
    if st == null { st = 1 }
    if st == 0 { return Err("warp.arange step cannot be zero") }
    let mut d = []
    let mut v = s0
    if st > 0 {
        while v < s1 { d = push(d, v)
        v = v + st }
    } else {
        while v > s1 { d = push(d, v)
        v = v + st }
    }
    array(d, [len(d)])
}

pub fn linspace(start, stop, n) {
    if _wkind(n) != "int" || n < 1 { return Err("warp.linspace requires a positive integer count") }
    if n == 1 { return array([start + 0.0], [1]) }
    step := (stop - start + 0.0) / (n - 1)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, start + 0.0 + i * step)
        i = i + 1 }
    array(d, [n])
}

pub fn eye(n) {
    if _wkind(n) != "int" || n < 0 { return Err("warp.eye requires a non-negative integer size") }
    let mut d = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n {
            d = push(d, if r == c { 1.0 } else { 0.0 })
            c = c + 1
        }
        r = r + 1
    }
    array(d, [n, n])
}

pub fn diag(a) {
    data := _data(a)
    s := if _is_arr(a) { a.shape } else { [len(data)] }
    if len(s) == 2 {
        rows := s[0]
        cols := s[1]
        n := if rows < cols { rows } else { cols }
        let mut d = []
        let mut i = 0
        while i < n {
            d = push(d, data[i * cols + i])
            i = i + 1
        }
        return array(d, [n])
    }
    n := len(data)
    let mut d = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n {
            d = push(d, if r == c { data[r] } else { 0.0 })
            c = c + 1
        }
        r = r + 1
    }
    array(d, [n, n])
}

pub fn from_list(nested) {
    // [[1,2],[3,4]] → array([1,2,3,4], [2,2])
    if _wkind(nested) != "list" { return Err("warp.from_list expects a list") }
    if len(nested) == 0 { return array([], [0]) }
    first := nested[0]
    if _wkind(first) != "list" { return array(nested, [len(nested)]) }
    // check if first element is a list (2D)
    let mut flat = []
    cols := len(first)
    for row in nested {
        if _wkind(row) != "list" || len(row) != cols { return Err("warp.from_list requires rectangular nested lists") }
        for v in row { flat = push(flat, v) }
    }
    array(flat, [len(nested), cols])
}

pub fn rand(shape) {
    if !_valid_shape(shape) { return Err("warp.rand expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, random.float())
        i = i + 1 }
    array(d, shape)
}

pub fn randn(shape) {
    if !_valid_shape(shape) { return Err("warp.randn expects non-negative integer dimensions") }
    // Box-Muller for normal distribution
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n {
        u1 := random.float()
        u2 := random.float()
        z := math.sqrt(-2.0 * math.log(u1 + 1e-15)) * math.cos(2.0 * 3.141592653589793 * u2)
        d = push(d, z)
        i = i + 1
    }
    array(d, shape)
}

pub fn randint(low, high, shape) {
    if high <= low { return Err("warp.randint requires high greater than low") }
    if !_valid_shape(shape) { return Err("warp.randint expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, random.int(low, high - 1))
        i = i + 1 }
    array(d, shape)
}

// ──────────────────────────────────────────────
// Shape / indexing
// ──────────────────────────────────────────────

pub fn shape(a) { a.shape }

pub fn size(a) { len(a.data) }

pub fn ndim(a) { len(a.shape) }

pub fn reshape(a, new_shape) {
    if _wkind(new_shape) != "list" { return Err("warp.reshape expects a shape list") }
    let mut inferred = -1
    let mut known = 1
    let mut unknowns = 0
    for dim in new_shape {
        if _wkind(dim) != "int" || dim < -1 { return Err("warp.reshape dimensions must be non-negative integers or one -1") }
        if dim == -1 { unknowns = unknowns + 1 }
        else { known = known * dim }
    }
    if unknowns > 1 { return Err("warp.reshape allows at most one inferred dimension") }
    let mut target = []
    for dim in new_shape { target = push(target, dim) }
    if unknowns == 1 {
        if known == 0 || len(a.data) % known != 0 { return Err("warp.reshape cannot infer a dimension") }
        inferred = len(a.data) / known
        let mut i = 0
        while i < len(target) { if target[i] == -1 { target[i] = inferred }
            i = i + 1 }
    }
    if !_valid_shape(target) || _prod(target) != len(a.data) {
        return Err("warp.reshape shape must preserve the number of elements")
    }
    _array_like(a.data, target, a)
}

pub fn flatten(a) { _array_like(a.data, [len(a.data)], a) }

pub fn ravel(a) { flatten(a) }

pub fn squeeze(a) {
    let mut s = []
    for dim in a.shape { if dim != 1 { s = push(s, dim) } }
    _array_like(a.data, s, a)
}

pub fn expand_dims(a, axis) {
    normalized := _normalize_axis(axis, len(a.shape), true)
    if normalized == null { return Err("warp.expand_dims axis is out of range") }
    let mut s = []
    let mut i = 0
    while i <= len(a.shape) {
        if i == normalized { s = push(s, 1) }
        if i < len(a.shape) { s = push(s, a.shape[i]) }
        i = i + 1
    }
    _array_like(a.data, s, a)
}

pub fn transpose(a, axes) {
    if !_is_arr(a) { return Err("warp.transpose expects an array") }
    let mut rank = len(a.shape)
    axis_arg := if _wkind(axes) == "unit" { null } else { axes }
    let mut order = []
    if axis_arg == null {
        let mut i = rank - 1
        while i >= 0 { order = push(order, i)
            i = i - 1 }
    } else {
        if _wkind(axis_arg) != "list" || len(axis_arg) != rank { return Err("warp.transpose axes must be a permutation") }
        for axis in axis_arg {
            normalized := _normalize_axis(axis, rank, false)
            if normalized == null || contains(order, normalized) { return Err("warp.transpose axes must be a permutation") }
            order = push(order, normalized)
        }
    }
    let mut out_shape = []
    for axis in order { out_shape = push(out_shape, a.shape[axis]) }
    let mut d = []
    n := _prod(out_shape)
    let mut i = 0
    while i < n {
        out_index := _unravel(i, out_shape)
        let mut source_index = []
        let mut j = 0
        while j < rank { source_index = push(source_index, 0)
            j = j + 1 }
        j = 0
        while j < rank { source_index[order[j]] = out_index[j]
            j = j + 1 }
        d = push(d, a.data[_flat_index(source_index, a.shape)])
        i = i + 1
    }
    _array_like(d, out_shape, a)
}

pub fn T(a) {
    s := a.shape
    if len(s) != 2 { return a }
    rows := s[0]
    cols := s[1]
    let mut d = []
    let mut c = 0
    while c < cols {
        let mut r = 0
        while r < rows { d = push(d, a.data[r * cols + c])
        r = r + 1 }
        c = c + 1
    }
    array(d, [cols, rows])
}

pub fn get(a, indices) {
    // get(a, [1, 2]) → element at row 1, col 2
    if len(indices) != len(a.shape) { return Err("warp.get requires one index per dimension") }
    s := a.shape
    let mut idx = 0
    let mut stride = len(a.data)
    let mut i = 0
    while i < len(indices) {
        if indices[i] < 0 || indices[i] >= s[i] { return Err("warp.get index is out of range") }
        stride = stride / s[i]
        idx = idx + indices[i] * stride
        i = i + 1
    }
    a.data[idx]
}

pub fn set(a, indices, value) {
    if len(indices) != len(a.shape) { return Err("warp.set requires one index per dimension") }
    s := a.shape
    let mut idx = 0
    let mut stride = len(a.data)
    let mut i = 0
    while i < len(indices) {
        if indices[i] < 0 || indices[i] >= s[i] { return Err("warp.set index is out of range") }
        stride = stride / s[i]
        idx = idx + indices[i] * stride
        i = i + 1
    }
    let mut d = _copy(a.data)
    d[idx] = value
    array(d, s)
}

pub fn row(a, r) {
    if len(a.shape) != 2 || r < 0 || r >= a.shape[0] { return Err("warp.row expects a valid 2D row") }
    cols := a.shape[1]
    let mut d = []
    let mut c = 0
    while c < cols { d = push(d, a.data[r * cols + c])
        c = c + 1 }
    array(d, [cols])
}

pub fn col(a, c) {
    if len(a.shape) != 2 || c < 0 || c >= a.shape[1] { return Err("warp.col expects a valid 2D column") }
    rows := a.shape[0]
    cols := a.shape[1]
    let mut d = []
    let mut r = 0
    while r < rows { d = push(d, a.data[r * cols + c])
        r = r + 1 }
    array(d, [rows])
}

pub fn slice(a, start, stop) {
    data := a.data
    s := if stop == null { len(data) } else { stop }
    if start < 0 || start > len(data) { return Err("warp.slice start is out of range") }
    if s < start || s > len(data) { return Err("warp.slice stop is out of range") }
    let mut d = []
    let mut i = start
    while i < s { d = push(d, data[i])
        i = i + 1 }
    array(d, [len(d)])
}

// ──────────────────────────────────────────────
// Element-wise arithmetic
// ──────────────────────────────────────────────

pub fn add(a, b) { _binop(a, b, fn(x, y) { x + y }) }
pub fn sub(a, b) { _binop(a, b, fn(x, y) { x - y }) }
pub fn mul(a, b) { _binop(a, b, fn(x, y) { x * y }) }
pub fn div(a, b) { _binop(a, b, fn(x, y) { x / y }) }
pub fn mod_(a, b) { _binop(a, b, fn(x, y) { x % y }) }
pub fn neg(a) { _unaryop(a, fn(x) { -x }) }
pub fn abs_(a) { _unaryop(a, fn(x) { math.abs(x) }) }

pub fn pow_(a, p) {
    if _is_arr(p) { _binop(a, p, fn(x, y) { math.pow(x, y) }) }
    else { _unaryop(a, fn(x) { math.pow(x, p) }) }
}

pub fn round_(a, decimals) {
    dec := if decimals == null { 0 } else { decimals }
    factor := math.pow(10, dec)
    _unaryop(a, fn(x) { math.round(x * factor) / factor })
}

pub fn floor_(a) { _unaryop(a, fn(x) { math.floor(x) }) }
pub fn ceil_(a) { _unaryop(a, fn(x) { math.ceil(x) }) }
pub fn clip(a, lo, hi) { _unaryop(a, fn(x) { math.clamp(x, lo, hi) }) }
pub fn sign(a) { _unaryop(a, fn(x) { if x > 0 { 1.0 } else if x < 0 { -1.0 } else { 0.0 } }) }

// ──────────────────────────────────────────────
// Math functions (element-wise)
// ──────────────────────────────────────────────

pub fn sqrt(a) { _unaryop(a, fn(x) { math.sqrt(x) }) }
pub fn exp(a) { _unaryop(a, fn(x) { math.exp(x) }) }
pub fn log_(a) { _unaryop(a, fn(x) { math.log(x) }) }
pub fn log2(a) { _unaryop(a, fn(x) { math.log(x) / math.log(2) }) }
pub fn log10(a) { _unaryop(a, fn(x) { math.log(x) / math.log(10) }) }

pub fn sin(a) { _unaryop(a, fn(x) { math.sin(x) }) }
pub fn cos(a) { _unaryop(a, fn(x) { math.cos(x) }) }
pub fn tan(a) { _unaryop(a, fn(x) { math.tan(x) }) }
pub fn asin(a) { _unaryop(a, fn(x) { math.asin(x) }) }
pub fn acos(a) { _unaryop(a, fn(x) { math.acos(x) }) }
pub fn atan(a) { _unaryop(a, fn(x) { math.atan(x) }) }
pub fn atan2(y, x) { _binop(y, x, fn(a, b) { math.atan2(a, b) }) }

pub fn sinh(a) { _unaryop(a, fn(x) { (math.exp(x) - math.exp(-x)) / 2 }) }
pub fn cosh(a) { _unaryop(a, fn(x) { (math.exp(x) + math.exp(-x)) / 2 }) }
pub fn tanh(a) { _unaryop(a, fn(x) {
    (math.exp(2 * x) - 1) / (math.exp(2 * x) + 1)
}) }

// ──────────────────────────────────────────────
// Comparisons (element-wise, return 0/1 arrays)
// ──────────────────────────────────────────────

pub fn equal(a, b) { _binop(a, b, fn(x, y) { if x == y { 1 } else { 0 } }) }
pub fn not_equal(a, b) { _binop(a, b, fn(x, y) { if x != y { 1 } else { 0 } }) }
pub fn less(a, b) { _binop(a, b, fn(x, y) { if x < y { 1 } else { 0 } }) }
pub fn less_equal(a, b) { _binop(a, b, fn(x, y) { if x <= y { 1 } else { 0 } }) }
pub fn greater(a, b) { _binop(a, b, fn(x, y) { if x > y { 1 } else { 0 } }) }
pub fn greater_equal(a, b) { _binop(a, b, fn(x, y) { if x >= y { 1 } else { 0 } }) }

pub fn where(cond, x, y) {
    cs := _operand_shape(cond)
    xs := _operand_shape(x)
    ys := _operand_shape(y)
    shape := _broadcast_shape(_broadcast_shape(cs, xs), ys)
    if shape == null { return Err("warp.where operands could not be broadcast together") }
    let mut d = []
    let mut i = 0
    n := _prod(shape)
    while i < n {
        index := _unravel(i, shape)
        cv := _operand_value(cond, index, shape)
        xv := _operand_value(x, index, shape)
        yv := _operand_value(y, index, shape)
        d = push(d, if cv != 0 { xv } else { yv })
        i = i + 1
    }
    array(d, shape)
}

pub fn all_(a) {
    for x in a.data { if x == 0 { return false } }
    true
}

pub fn any_(a) {
    for x in a.data { if x != 0 { return true } }
    false
}

// ──────────────────────────────────────────────
// Reductions
// ──────────────────────────────────────────────

pub fn sum(a) {
    let mut s = 0.0
    for x in _data(a) { s = s + x }
    s
}

pub fn prod(a) {
    let mut s = 1.0
    for x in _data(a) { s = s * x }
    s
}

pub fn mean(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    sum(a) / len(data)
}

pub fn var_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    m := mean(a)
    let mut s = 0.0
    for x in data { s = s + (x - m) * (x - m) }
    s / len(data)
}

pub fn std_(a) {
    value := var_(a)
    if value == null { return null }
    math.sqrt(value)
}

pub fn min_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut m = data[0]
    let mut i = 1
    while i < len(data) { if data[i] < m { m = data[i] }
        i = i + 1 }
    m
}

pub fn max_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut m = data[0]
    let mut i = 1
    while i < len(data) { if data[i] > m { m = data[i] }
        i = i + 1 }
    m
}

pub fn argmin(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut mi = 0
    let mut i = 1
    while i < len(data) { if data[i] < data[mi] { mi = i }
        i = i + 1 }
    mi
}

pub fn argmax(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut mi = 0
    let mut i = 1
    while i < len(data) { if data[i] > data[mi] { mi = i }
        i = i + 1 }
    mi
}

pub fn cumsum(a) {
    data := _data(a)
    let mut d = []
    let mut s = 0.0
    for x in data { s = s + x
        d = push(d, s) }
    array(d, a.shape)
}

pub fn cumprod(a) {
    data := _data(a)
    let mut d = []
    let mut s = 1.0
    for x in data { s = s * x
        d = push(d, s) }
    array(d, a.shape)
}

pub fn median(a) {
    if len(_data(a)) == 0 { return null }
    sorted := sort(a)
    data := sorted.data
    n := len(data)
    if n % 2 == 1 { data[n / 2] }
    else { (data[n / 2 - 1] + data[n / 2]) / 2.0 }
}

pub fn percentile(a, p) {
    if len(_data(a)) == 0 { return null }
    if p < 0 || p > 100 { return Err("warp.percentile requires p between 0 and 100") }
    sorted := sort(a)
    data := sorted.data
    n := len(data)
    k := (p / 100.0) * (n - 1)
    lo := math.floor(k)
    hi := math.ceil(k)
    if lo == hi { data[int(lo)] }
    else { data[int(lo)] * (hi - k) + data[int(hi)] * (k - lo) }
}

// Axis-based reductions. Negative axes are accepted and reductions work for
// every rank, including a rank-1 reduction to a scalar.

pub fn sum_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { acc + x }, 0.0)
}

pub fn mean_axis(a, axis) {
    if !_is_arr(a) { return Err("warp.mean_axis expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.mean_axis axis is out of range") }
    result := sum_axis(a, normalized)
    n := a.shape[normalized]
    div(result, n)
}

pub fn min_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { if x < acc { x } else { acc } }, 1e308)
}

pub fn max_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { if x > acc { x } else { acc } }, -1e308)
}

pub fn sum_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { acc + x }, 0.0, keepdims)
}

pub fn mean_axis_opts(a, axis, keepdims) {
    if !_is_arr(a) { return Err("warp.mean_axis_opts expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.mean_axis_opts axis is out of range") }
    result := sum_axis_opts(a, normalized, keepdims)
    div(result, a.shape[normalized])
}

pub fn min_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { if x < acc { x } else { acc } }, 1e308, keepdims)
}

pub fn max_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { if x > acc { x } else { acc } }, -1e308, keepdims)
}

// ──────────────────────────────────────────────
// Linear algebra
// ──────────────────────────────────────────────

pub fn dot(a, b) {
    matmul(a, b)
}

pub fn matmul(a, b) {
    sa := a.shape
    sb := b.shape
    if len(sa) == 1 && len(sb) == 1 {
        if sa[0] != sb[0] { return Err("warp.matmul vector lengths do not match") }
        let mut result = 0.0
        let mut i = 0
        while i < sa[0] {
            result = result + a.data[i] * b.data[i]
            i = i + 1
        }
        return result
    }
    if len(sa) == 2 && len(sb) == 1 {
        if sa[1] != sb[0] { return Err("warp.matmul inner dimensions do not match") }
        rows := sa[0]
        cols := sa[1]
        let mut d = []
        let mut r = 0
        while r < rows {
            let mut result = 0.0
            let mut j = 0
            while j < cols {
                result = result + a.data[r * cols + j] * b.data[j]
                j = j + 1
            }
            d = push(d, result)
            r = r + 1
        }
        return array(d, [rows])
    }
    if len(sa) == 1 && len(sb) == 2 {
        if sa[0] != sb[0] { return Err("warp.matmul inner dimensions do not match") }
        rows := sb[0]
        cols := sb[1]
        let mut d = []
        let mut c = 0
        while c < cols {
            let mut result = 0.0
            let mut i = 0
            while i < rows {
                result = result + a.data[i] * b.data[i * cols + c]
                i = i + 1
            }
            d = push(d, result)
            c = c + 1
        }
        return array(d, [cols])
    }
    if len(sa) != 2 || len(sb) != 2 { return Err("warp.matmul supports only 1D and 2D arrays") }
    m := sa[0]
    k := sa[1]
    if k != sb[0] { return Err("warp.matmul inner dimensions do not match") }
    n := sb[1]
    let mut d = []
    let mut r = 0
    while r < m {
        let mut c = 0
        while c < n {
            let mut result = 0.0
            let mut j = 0
            while j < k {
                result = result + a.data[r * k + j] * b.data[j * n + c]
                j = j + 1
            }
            d = push(d, result)
            c = c + 1
        }
        r = r + 1
    }
    array(d, [m, n])
}

pub fn norm(a) {
    // L2 norm (Euclidean)
    let mut s = 0.0
    for x in _data(a) { s = s + x * x }
    math.sqrt(s)
}

pub fn norm_l1(a) {
    let mut s = 0.0
    for x in _data(a) { s = s + math.abs(x) }
    s
}

pub fn normalize(a) {
    n := norm(a)
    if n == 0 { return a }
    div(a, n)
}

pub fn trace(a) {
    n := a.shape[0]
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + a.data[i * n + i]
        i = i + 1 }
    s
}

// ponytail: LU decomposition is O(n^3) pure Weft — fine for n<=50, use mlinfer for larger
fn _lu(a) -> Result[any] {
    // LU decomposition with partial pivoting: PA = LU
    n := a.shape[0]
    // copy matrix data into mutable flat array
    let mut m = []
    for x in a.data { m = push(m, x + 0.0) }
    // permutation vector
    let mut perm = []
    let mut i = 0
    while i < n { perm = push(perm, i)
        i = i + 1 }
    let mut sign = 1
    // forward elimination
    let mut col = 0
    while col < n {
        // find pivot
        let mut max_val = -1.0
        let mut max_row = col
        let mut r = col
        while r < n {
            v := math.abs(m[r * n + col])
            if v > max_val {
                max_val = v
                max_row = r
            }
            r = r + 1
        }
        ensure(max_val > 1e-12, "singular matrix")?
        // swap rows
        if max_row != col {
            let mut c = 0
            while c < n {
                tmp := m[col * n + c]
                m[col * n + c] = m[max_row * n + c]
                m[max_row * n + c] = tmp
                c = c + 1
            }
            tmp := perm[col]
            perm[col] = perm[max_row]
            perm[max_row] = tmp
            sign = sign * -1
        }
        // eliminate below pivot
        r = col + 1
        while r < n {
            factor := m[r * n + col] / m[col * n + col]
            m[r * n + col] = factor
            let mut c = col + 1
            while c < n {
                m[r * n + c] = m[r * n + c] - factor * m[col * n + c]
                c = c + 1
            }
            r = r + 1
        }
        col = col + 1
    }
    Ok({"m": m, "perm": perm, "n": n, "sign": sign})
}

fn _lu_solve(lu, b_data) {
    // Forward then back substitution using LU result
    n := lu.n
    m := lu.m
    perm := lu.perm
    // apply permutation to b
    let mut pb = []
    let mut i = 0
    while i < n { pb = push(pb, b_data[perm[i]])
        i = i + 1 }
    // forward substitution (L * y = Pb)
    i = 1
    while i < n {
        let mut s = pb[i]
        let mut j = 0
        while j < i {
            s = s - m[i * n + j] * pb[j]
            j = j + 1
        }
        pb[i] = s
        i = i + 1
    }
    // back substitution (U * x = y)
    i = n - 1
    while i >= 0 {
        let mut s = pb[i]
        let mut j = i + 1
        while j < n {
            s = s - m[i * n + j] * pb[j]
            j = j + 1
        }
        pb[i] = s / m[i * n + i]
        i = i - 1
    }
    pb
}

pub fn det(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "det: matrix must be square 2D")?
    ensure(len(a.data) == a.shape[0] * a.shape[1], "det: data/shape mismatch")?
    n := a.shape[0]
    d := a.data
    if n == 1 { return Ok(d[0]) }
    if n == 2 { return Ok(d[0] * d[3] - d[1] * d[2]) }
    // General case via LU
    lu := _lu(a)?
    let mut det_val = lu.sign + 0.0
    let mut i = 0
    while i < n {
        det_val = det_val * lu.m[i * n + i]
        i = i + 1
    }
    Ok(det_val)
}

pub fn inv(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "inv: matrix must be square 2D")?
    n := a.shape[0]
    d := a.data
    // 2x2 fast path
    if n == 2 {
        dt := d[0] * d[3] - d[1] * d[2] + 0.0
        ensure(dt != 0, "inv: singular matrix")?
        return Ok(array([d[3]/dt, -d[1]/dt, -d[2]/dt, d[0]/dt], [2, 2]))
    }
    // General case: solve A * X = I column by column
    lu := _lu(a)?
    let mut result = []
    let mut col = 0
    while col < n {
        // identity column
        let mut e = []
        let mut i = 0
        while i < n { e = push(e, if i == col { 1.0 } else { 0.0 })
            i = i + 1 }
        x := _lu_solve(lu, e)
        col = col + 1
        // x is one column of the inverse — we'll assemble row-major later
        let mut j = 0
        while j < n { result = push(result, x[j])
            j = j + 1 }
    }
    // result is column-major, transpose to row-major
    let mut row_major = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n { row_major = push(row_major, result[c * n + r])
            c = c + 1 }
        r = r + 1
    }
    Ok(array(row_major, [n, n]))
}

pub fn solve(a, b) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "solve: A must be square")?
    n := a.shape[0]
    lu := _lu(a)?
    bd := _data(b)
    if len(bd) == n {
        x := _lu_solve(lu, bd)
        return Ok(array(x, b.shape))
    }
    // multiple right-hand sides (n x m matrix)
    ensure(len(b.shape) == 2 && b.shape[0] == n, "solve: B rows must match A")?
    m := b.shape[1]
    // solve each column, then transpose column-major → row-major
    let mut cols = []
    let mut col = 0
    while col < m {
        let mut rhs = []
        let mut i = 0
        while i < n {
            rhs = push(rhs, bd[i * m + col])
            i = i + 1
        }
        x := _lu_solve(lu, rhs)
        cols = push(cols, x)
        col = col + 1
    }
    // assemble row-major from column solutions
    let mut result = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < m {
            result = push(result, cols[c][r])
            c = c + 1
        }
        r = r + 1
    }
    Ok(array(result, [n, m]))
}

pub fn outer(a, b) {
    ad := _data(a)
    bd := _data(b)
    let mut d = []
    for x in ad {
        for y in bd { d = push(d, x * y) }
    }
    array(d, [len(ad), len(bd)])
}

pub fn cross(a, b) {
    // 3D cross product
    ad := _data(a)
    bd := _data(b)
    array([
        ad[1]*bd[2] - ad[2]*bd[1],
        ad[2]*bd[0] - ad[0]*bd[2],
        ad[0]*bd[1] - ad[1]*bd[0],
    ], [3])
}

// ──────────────────────────────────────────────
// Manipulation
// ──────────────────────────────────────────────

pub fn concat(a, b) {
    concatenate([a, b], null)
}

pub fn concatenate(arrays, axis) {
    if _wkind(arrays) != "list" || len(arrays) == 0 { return Err("warp.concatenate requires at least one array") }
    first := arrays[0]
    if !_is_arr(first) { return Err("warp.concatenate expects arrays") }
    rank := len(first.shape)
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, rank, false)
    if normalized == null { return Err("warp.concatenate axis is out of range") }
    let mut out_shape = []
    for dim in first.shape { out_shape = push(out_shape, dim) }
    out_shape[normalized] = 0
    for a in arrays {
        if !_is_arr(a) || len(a.shape) != rank { return Err("warp.concatenate arrays must have equal dimensions") }
        let mut i = 0
        while i < rank { if i != normalized && a.shape[i] != first.shape[i] { return Err("warp.concatenate shapes differ outside the concatenation axis") }
            i = i + 1 }
        out_shape[normalized] = out_shape[normalized] + a.shape[normalized]
    }
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        let mut offset = 0
        let mut selected = null
        for a in arrays {
            if out_index[normalized] < offset + a.shape[normalized] {
                selected = a
                break
            }
            offset = offset + a.shape[normalized]
        }
        source_index := _copy(out_index)
        source_index[normalized] = source_index[normalized] - offset
        d = push(d, selected.data[_flat_index(source_index, selected.shape)])
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn stack(arrays, axis) {
    if _wkind(arrays) != "list" || len(arrays) == 0 { return Err("warp.stack requires at least one array") }
    rank := len(arrays[0].shape)
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, rank + 1, false)
    if normalized == null { return Err("warp.stack axis is out of range") }
    let mut expanded = []
    for a in arrays { expanded = push(expanded, expand_dims(a, normalized)) }
    concatenate(expanded, normalized)
}

pub fn split(a, sections, axis) {
    if !_is_arr(a) || _wkind(sections) != "int" || sections <= 0 { return Err("warp.split requires a positive integer section count") }
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, len(a.shape), false)
    if normalized == null || a.shape[normalized] % sections != 0 { return Err("warp.split requires equal sections") }
    width := a.shape[normalized] / sections
    let mut result = []
    let mut i = 0
    while i < sections {
        result = push(result, _slice_axis(a, i * width, (i + 1) * width, normalized))
        i = i + 1
    }
    result
}

pub fn take(a, indices, axis) {
    if !_is_arr(a) || _wkind(indices) != "list" { return Err("warp.take expects an array and index list") }
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    if axis_arg == null {
        let mut d = []
        for index in indices {
            if _wkind(index) != "int" || index < 0 || index >= len(a.data) { return Err("warp.take index is out of range") }
            d = push(d, a.data[index])
        }
        return array(d, [len(d)])
    }
    normalized := _normalize_axis(axis_arg, len(a.shape), false)
    if normalized == null { return Err("warp.take axis is out of range") }
    for index in indices { if _wkind(index) != "int" || index < 0 || index >= a.shape[normalized] { return Err("warp.take index is out of range") } }
    let mut out_shape = _copy(a.shape)
    out_shape[normalized] = len(indices)
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[normalized] = indices[out_index[normalized]]
        d = push(d, a.data[_flat_index(source_index, a.shape)])
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn vstack(arrays) {
    if len(arrays) == 0 { return Err("warp.vstack requires at least one array") }
    let mut all_data = []
    first_shape := arrays[0].shape
    if len(first_shape) != 1 && len(first_shape) != 2 { return Err("warp.vstack supports 1D or 2D arrays") }
    cols := if len(first_shape) == 1 { first_shape[0] } else { first_shape[1] }
    let mut rows = 0
    for a in arrays {
        if len(a.shape) != len(first_shape) { return Err("warp.vstack arrays must have equal dimensions") }
        if len(first_shape) == 1 && a.shape[0] != cols { return Err("warp.vstack vectors must have equal lengths") }
        if len(first_shape) == 2 && a.shape[1] != cols { return Err("warp.vstack matrices must have equal columns") }
        rows = rows + if len(first_shape) == 1 { 1 } else { a.shape[0] }
        for x in a.data { all_data = push(all_data, x) }
    }
    if len(first_shape) == 1 { array(all_data, [len(arrays), cols]) }
    else { array(all_data, [rows, cols]) }
}

pub fn hstack(arrays) {
    if len(arrays) == 0 { return Err("warp.hstack requires at least one array") }
    let mut all_data = []
    first_shape := arrays[0].shape
    if len(first_shape) != 1 && len(first_shape) != 2 { return Err("warp.hstack supports 1D or 2D arrays") }
    if len(first_shape) == 1 {
        for a in arrays { for x in a.data { all_data = push(all_data, x) } }
        return array(all_data, [len(all_data)])
    }
    rows := first_shape[0]
    let mut cols = 0
    for a in arrays {
        if len(a.shape) != 2 || a.shape[0] != rows { return Err("warp.hstack matrices must have equal rows") }
        cols = cols + a.shape[1]
    }
    let mut r = 0
    while r < rows {
        for a in arrays {
            start := r * a.shape[1]
            stop := start + a.shape[1]
            let mut c = start
            while c < stop { all_data = push(all_data, a.data[c]) c = c + 1 }
        }
        r = r + 1
    }
    array(all_data, [rows, cols])
}

pub fn tile(a, reps) {
    if !_is_arr(a) { return Err("warp.tile expects an array") }
    rep_list := if _wkind(reps) == "int" { [reps] } else { reps }
    if _wkind(rep_list) != "list" || len(rep_list) == 0 { return Err("warp.tile reps must be a positive integer or list") }
    let mut rank = len(a.shape)
    let mut aligned = []
    let mut i = 0
    while i < rank - len(rep_list) { aligned = push(aligned, 1)
        i = i + 1 }
    for rep in rep_list { aligned = push(aligned, rep) }
    if len(aligned) > rank { rank = len(aligned) }
    let mut source_shape = []
    i = 0
    while i < rank - len(a.shape) { source_shape = push(source_shape, 1)
        i = i + 1 }
    for dim in a.shape { source_shape = push(source_shape, dim) }
    if len(aligned) != rank { return Err("warp.tile reps are invalid") }
    let mut out_shape = []
    let mut j = 0
    while j < rank {
        if _wkind(aligned[j]) != "int" || aligned[j] < 0 { return Err("warp.tile reps must be non-negative integers") }
        out_shape = push(out_shape, source_shape[j] * aligned[j])
        j = j + 1
    }
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        let mut source_index = []
        j = 0
        while j < rank { source_index = push(source_index, if source_shape[j] == 0 { 0 } else { out_index[j] % source_shape[j] })
            j = j + 1 }
        d = push(d, a.data[_flat_index(_tail(source_index, rank - len(a.shape)), a.shape)])
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn repeat(a, n) {
    if !_is_arr(a) || _wkind(n) != "int" || n < 0 { return Err("warp.repeat requires a non-negative integer count") }
    let mut d = []
    for x in a.data {
        let mut i = 0
        while i < n { d = push(d, x)
            i = i + 1 }
    }
    array(d, [len(d)])
}

pub fn repeat_axis(a, n, axis) {
    if !_is_arr(a) || _wkind(n) != "int" || n < 0 { return Err("warp.repeat requires a non-negative integer count") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.repeat axis is out of range") }
    let mut out_shape = _copy(a.shape)
    out_shape[normalized] = out_shape[normalized] * n
    let mut d = []
    let mut flat = 0
    total := _prod(out_shape)
    while flat < total {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[normalized] = out_index[normalized] / n
        d = push(d, a.data[_flat_index(source_index, a.shape)])
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn flip(a) {
    if !_is_arr(a) { return Err("warp.flip expects an array") }
    data := a.data
    let mut d = []
    let mut i = len(data) - 1
    while i >= 0 { d = push(d, data[i])
        i = i - 1 }
    array(d, a.shape)
}

pub fn flip_axis(a, axis) {
    if !_is_arr(a) { return Err("warp.flip expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.flip axis is out of range") }
    let mut d = []
    n := _prod(a.shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, a.shape)
        out_index[normalized] = a.shape[normalized] - 1 - out_index[normalized]
        d = push(d, a.data[_flat_index(out_index, a.shape)])
        flat = flat + 1
    }
    array(d, a.shape)
}

pub fn sort(a) {
    // Stable merge sort keeps large array sorting O(n log n).
    array(_merge_sort_values(a.data), a.shape)
}

pub fn argsort(a) {
    data := a.data
    let mut indices = []
    let mut i = 0
    while i < len(data) { indices = push(indices, i)
        i = i + 1 }
    array(_merge_sort_indices(indices, data), a.shape)
}

pub fn unique(a) {
    if len(a.data) == 0 { return array([], [0]) }
    sorted := sort(a)
    data := sorted.data
    let mut d = [data[0]]
    let mut i = 1
    while i < len(data) {
        if data[i] != data[i - 1] { d = push(d, data[i]) }
        i = i + 1
    }
    array(d, [len(d)])
}

// ──────────────────────────────────────────────
// Apply / map
// ──────────────────────────────────────────────

pub fn apply(a, f) { _unaryop(a, f) }

pub fn apply2(a, b, f) { _binop(a, b, f) }

// ──────────────────────────────────────────────
// Boolean / masking
// ──────────────────────────────────────────────

pub fn mask(a, cond_arr) {
    // Return elements where cond_arr != 0
    data := a.data
    if !_is_arr(cond_arr) || len(cond_arr.data) != len(a.data) { return Err("warp.mask expects equal-size arrays") }
    cd := cond_arr.data
    let mut d = []
    let mut i = 0
    while i < len(data) {
        if cd[i] != 0 { d = push(d, data[i]) }
        i = i + 1
    }
    array(d, [len(d)])
}

pub fn count_nonzero(a) {
    let mut c = 0
    for x in a.data { if x != 0 { c = c + 1 } }
    c
}

// ──────────────────────────────────────────────
// Convenience
// ──────────────────────────────────────────────

pub fn to_list(a) { a.data }

pub fn print_(a) {
    s := a.shape
    if len(s) == 1 {
        say(a.data)
    } else if len(s) == 2 {
        rows := s[0]
        cols := s[1]
        let mut r = 0
        while r < rows {
            let mut row_data = []
            let mut c = 0
            while c < cols { row_data = push(row_data, a.data[r * cols + c])
        c = c + 1 }
            say(row_data)
            r = r + 1
        }
    } else {
        say("warp<shape=" + str(s) + " size=" + str(len(a.data)) + ">")
    }
}

pub fn describe(a) {
    data := _data(a)
    {
        "shape": a.shape,
        "size": len(data),
        "min": min_(a),
        "max": max_(a),
        "mean": mean(a),
        "std": std_(a),
        "median": median(a),
    }
}

pub fn allclose(a, b, atol) {
    tol := if atol == null { 1e-8 } else { atol }
    ad := _data(a)
    bd := _data(b)
    if len(ad) != len(bd) { return false }
    if _is_arr(a) && _is_arr(b) && a.shape != b.shape { return false }
    let mut i = 0
    while i < len(ad) {
        if math.abs(ad[i] - bd[i]) > tol + tol * math.abs(bd[i]) { return false }
        i = i + 1
    }
    true
}

pub fn isnan(a) { _unaryop(a, fn(x) { if x != x { 1 } else { 0 } }) }

pub fn isinf(a) { _unaryop(a, fn(x) { if x == 1.0/0.0 || x == -1.0/0.0 { 1 } else { 0 } }) }

pub fn isfinite(a) { _unaryop(a, fn(x) { if x == x && x != 1.0/0.0 && x != -1.0/0.0 { 1 } else { 0 } }) }

pub fn maximum(a, b) { _binop(a, b, fn(x, y) { if x > y { x } else { y } }) }

pub fn minimum(a, b) { _binop(a, b, fn(x, y) { if x < y { x } else { y } }) }

pub fn logical_and(a, b) { _binop(a, b, fn(x, y) { if x != 0 && y != 0 { 1 } else { 0 } }) }

pub fn logical_or(a, b) { _binop(a, b, fn(x, y) { if x != 0 || y != 0 { 1 } else { 0 } }) }

pub fn logical_not(a) { _unaryop(a, fn(x) { if x == 0 { 1 } else { 0 } }) }

pub fn nan_to_num(a, nan_val, posinf, neginf) {
    nv := if nan_val == null { 0.0 } else { nan_val }
    pi := if posinf == null { 1e308 } else { posinf }
    ni := if neginf == null { -1e308 } else { neginf }
    _unaryop(a, fn(x) {
        if x != x { nv }
        else if x == 1.0/0.0 { pi }
        else if x == -1.0/0.0 { ni }
        else { x }
    })
}

// Native execution is opt-in. The provider may target CUDA, ROCm, or MLX;
// the operation/input contract is defined by that provider's manifest.
pub fn accelerator_supported() { accelerator.supported() }

pub fn accelerator_load(path) -> Result[any] { accelerator.load(path) }

pub fn accelerator_run(plugin, operation, input) -> Result[any] {
    accelerator.run(plugin, operation, input)
}

pub fn accelerator_run_tensor(plugin, operation, inputs) -> Result[any] {
    accelerator.run_tensor(plugin, operation, inputs)
}

pub fn accelerator_close(plugin) { accelerator.close(plugin) }

// ──────────────────────────────────────────────
// Internals
// ──────────────────────────────────────────────

fn _wkind(v) {
    if v == null { return "null" }
    s := json.stringify(v)
    if s == "true" || s == "false" { return "bool" }
    if str.starts_with(s, "\"") { return "str" }
    if str.starts_with(s, "[") { return "list" }
    if str.starts_with(s, "{") { return "map" }
    if str.contains(s, ".") || str.contains(s, "e") || str.contains(s, "E") { return "float" }
    "int"
}

fn _valid_shape(shape) {
    if _wkind(shape) != "list" { return false }
    for dim in shape {
        if _wkind(dim) != "int" || dim < 0 { return false }
    }
    true
}

fn _normalize_axis(axis, rank, allow_end) {
    if _wkind(axis) != "int" { return null }
    limit := if allow_end { rank + 1 } else { rank }
    let mut normalized = axis
    if normalized < 0 { normalized = normalized + limit }
    if normalized < 0 || normalized >= limit { return null }
    normalized
}

fn _flat_index(indices, shape) {
    let mut index = 0
    let mut i = 0
    while i < len(shape) {
        stride := _prod(_tail(shape, i + 1))
        index = index + indices[i] * stride
        i = i + 1
    }
    index
}

fn _slice_axis(a, start, stop, axis) {
    let mut out_shape = _copy(a.shape)
    out_shape[axis] = stop - start
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[axis] = source_index[axis] + start
        d = push(d, a.data[_flat_index(source_index, a.shape)])
        flat = flat + 1
    }
    array(d, out_shape)
}

fn _copy(data) {
    let mut result = []
    for value in data { result = push(result, value) }
    result
}

fn _data(a) { if _is_arr(a) { a.data } else { a } }

fn _array_like(data, shape, source) {
    if _is_arr(source) {
        {"_warp": true, "data": data, "shape": shape, "_dtype": dtype(source)}
    } else {
        array(data, shape)
    }
}

fn _valid_dtype(dtype_name) {
    dtype_name == "bool" || dtype_name == "int64" || dtype_name == "float32" || dtype_name == "float64" || dtype_name == "object"
}

fn _infer_dtype(data) {
    if _wkind(data) != "list" || len(data) == 0 { return "float64" }
    let mut found = "bool"
    for value in data {
        kind := _wkind(value)
        if kind == "null" || kind == "str" || kind == "list" || kind == "map" {
            return "object"
        }
        if kind == "float" {
            found = "float64"
        } else if kind == "int" && found == "bool" {
            found = "int64"
        }
    }
    found
}

fn _cast_value(value, dtype_name) {
    if dtype_name == "object" { return value }
    if value == null { return Err("warp dtype conversion does not accept null") }
    kind := _wkind(value)
    if kind != "bool" && kind != "int" && kind != "float" {
        return Err("warp dtype conversion expects numeric values")
    }
    if dtype_name == "bool" { value != 0 }
    else if dtype_name == "int64" { if value < 0 { math.ceil(value) } else { math.floor(value) } }
    else { value + 0.0 }
}

fn _validate_2d(a) -> Result[any] {
    ensure(a != null && _is_arr(a), "expected warp array")?
    ensure(len(a.shape) == 2, "expected 2D array")?
    ensure(len(a.data) == a.shape[0] * a.shape[1], "data/shape mismatch")?
    Ok(null)
}

fn _validate_square(a) -> Result[any] {
    _validate_2d(a)?
    ensure(a.shape[0] == a.shape[1], "expected square matrix")?
    Ok(null)
}

fn _valid_axis_2d(a, axis) {
    a != null && _is_arr(a) && len(a.shape) == 2 && (axis == 0 || axis == 1)
}

fn _is_arr(a) { a != null && len(keys(a)) > 0 && contains(keys(a), "_warp") }

fn _prod(shape) {
    let mut p = 1
    for s in shape { p = p * s }
    p
}

fn _binop(a, b, op) {
    if _is_arr(a) && _is_arr(b) {
        shape := _broadcast_shape(a.shape, b.shape)
        if shape == null { return Err("warp operands could not be broadcast together") }
        let mut d = []
        let mut i = 0
        n := _prod(shape)
        while i < n {
            index := _unravel(i, shape)
            d = push(d, op(_broadcast_value(a, index, shape), _broadcast_value(b, index, shape)))
            i = i + 1
        }
        array(d, shape)
    } else if _is_arr(a) {
        let mut d = []
        let mut i = 0
        while i < len(a.data) { d = push(d, op(a.data[i], b))
        i = i + 1 }
        array(d, a.shape)
    } else if _is_arr(b) {
        let mut d = []
        let mut i = 0
        while i < len(b.data) { d = push(d, op(a, b.data[i]))
        i = i + 1 }
        array(d, b.shape)
    } else { op(a, b) }
}

fn _unaryop(a, op) {
    if !_is_arr(a) { return op(a) }
    data := a.data
    let mut d = []
    let mut i = 0
    while i < len(data) { d = push(d, op(data[i]))
        i = i + 1 }
    array(d, a.shape)
}

fn _operand_shape(value) {
    if _is_arr(value) { value.shape } else { [1] }
}

fn _broadcast_shape(left, right) {
    if left == null || right == null { return null }
    let mut result = []
    let mut li = len(left) - 1
    let mut ri = len(right) - 1
    while li >= 0 || ri >= 0 {
        ld := if li >= 0 { left[li] } else { 1 }
        rd := if ri >= 0 { right[ri] } else { 1 }
        if ld != rd && ld != 1 && rd != 1 { return null }
        result = push(result, if ld > rd { ld } else { rd })
        li = li - 1
        ri = ri - 1
    }
    _reverse_values(result)
}

fn _unravel(flat_index, shape) {
    let mut result = []
    let mut remaining = flat_index
    let mut i = 0
    while i < len(shape) {
        stride := _prod(_tail(shape, i + 1))
        coord := if stride == 0 { 0 } else { remaining / stride }
        remaining = if stride == 0 { 0 } else { remaining % stride }
        result = push(result, coord)
        i = i + 1
    }
    result
}

fn _tail(values, start) {
    let mut result = []
    let mut i = start
    while i < len(values) {
        result = push(result, values[i])
        i = i + 1
    }
    result
}

fn _reverse_values(values) {
    let mut result = []
    let mut i = len(values) - 1
    while i >= 0 {
        result = push(result, values[i])
        i = i - 1
    }
    result
}

fn _list_range(values, start, stop) {
    let mut result = []
    let mut i = start
    while i < stop {
        result = push(result, values[i])
        i = i + 1
    }
    result
}

fn _merge_sort_values(values) {
    if len(values) <= 1 { return _copy(values) }
    mid := len(values) / 2
    left := _merge_sort_values(_list_range(values, 0, mid))
    right := _merge_sort_values(_list_range(values, mid, len(values)))
    _merge_values(left, right)
}

fn _merge_values(left, right) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if left[li] <= right[ri] {
            result = push(result, left[li])
            li = li + 1
        } else {
            result = push(result, right[ri])
            ri = ri + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _merge_sort_indices(indices, values) {
    if len(indices) <= 1 { return _copy(indices) }
    mid := len(indices) / 2
    left := _merge_sort_indices(_list_range(indices, 0, mid), values)
    right := _merge_sort_indices(_list_range(indices, mid, len(indices)), values)
    _merge_index_values(left, right, values)
}

fn _merge_index_values(left, right, values) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if values[left[li]] <= values[right[ri]] {
            result = push(result, left[li])
            li = li + 1
        } else {
            result = push(result, right[ri])
            ri = ri + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _broadcast_value(a, output_index, output_shape) {
    offset := len(output_shape) - len(a.shape)
    let mut flat_index = 0
    let mut i = 0
    while i < len(a.shape) {
        dim := a.shape[i]
        coord := if dim == 1 { 0 } else { output_index[i + offset] }
        stride := _prod(_tail(a.shape, i + 1))
        flat_index = flat_index + coord * stride
        i = i + 1
    }
    a.data[flat_index]
}

fn _operand_value(value, output_index, output_shape) {
    if _is_arr(value) { _broadcast_value(value, output_index, output_shape) }
    else { value }
}

fn _reduce_axis(a, axis, op, init) {
    s := a.shape
    rows := s[0]
    cols := s[1]
    if axis == 0 {
        // reduce rows → one value per column
        let mut d = []
        let mut c = 0
        while c < cols {
            let mut acc = init
            let mut r = 0
            while r < rows { acc = op(acc, a.data[r * cols + c])
        r = r + 1 }
            d = push(d, acc)
            c = c + 1
        }
        array(d, [cols])
    } else {
        // reduce cols → one value per row
        let mut d = []
        let mut r = 0
        while r < rows {
            let mut acc = init
            let mut c = 0
            while c < cols { acc = op(acc, a.data[r * cols + c])
        c = c + 1 }
            d = push(d, acc)
            r = r + 1
        }
        array(d, [rows])
    }
}

fn _remove_axis(shape, axis) {
    let mut result = []
    let mut i = 0
    while i < len(shape) {
        if i != axis { result = push(result, shape[i]) }
        i = i + 1
    }
    result
}

fn _insert_axis_index(index, axis, value) {
    let mut result = []
    let mut i = 0
    while i <= len(index) {
        if i == axis { result = push(result, value) }
        if i < len(index) { result = push(result, index[i]) }
        i = i + 1
    }
    result
}

fn _reduce_axis_nd(a, axis, op, init) {
    _reduce_axis_nd_opts(a, axis, op, init, false)
}

fn _reduce_axis_nd_opts(a, axis, op, init, keepdims) {
    if !_is_arr(a) { return Err("warp reduction expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp reduction axis is out of range") }
    if a.shape[normalized] == 0 { return Err("warp reduction cannot reduce an empty axis") }
    out_shape := _remove_axis(a.shape, normalized)
    output_size := _prod(out_shape)
    let mut d = []
    let mut flat = 0
    while flat < output_size {
        output_index := _unravel(flat, out_shape)
        let mut acc = init
        let mut k = 0
        while k < a.shape[normalized] {
            source_index := _insert_axis_index(output_index, normalized, k)
            acc = op(acc, a.data[_flat_index(source_index, a.shape)])
            k = k + 1
        }
        d = push(d, acc)
        flat = flat + 1
    }
    if keepdims {
        kept_shape := _copy(a.shape)
        kept_shape[normalized] = 1
        array(d, kept_shape)
    } else if len(out_shape) == 0 { d[0] } else { array(d, out_shape) }
}
