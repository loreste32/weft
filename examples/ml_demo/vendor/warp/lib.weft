use math
use accelerator
use tensor

// ndarray-compatible numerical arrays for Weft. Arrays are immutable values:
// operations return a new array and never mutate the caller's data.
//
// Primary storage for supported numeric dtypes is a host packed tensor handle
// (`_tid`). A portable list (`data`) is retained for object dtypes, views that
// need shared list indexing, and as a materialization cache after reads.

// ──────────────────────────────────────────────
// Creation
// ──────────────────────────────────────────────

pub fn array(data, shape) {
    if _wkind(data) != "list" { return Err("warp.array expects a flat data list") }
    s := if shape == null { [len(data)] } else { shape }
    if !_valid_shape(s) { return Err("warp.array expects non-negative integer dimensions") }
    if _prod(s) != len(data) { return Err("warp.array data length does not match shape") }
    _make_array(data, s, _infer_dtype(data))
}

// Logical dtypes follow NumPy's common scalar names. Numeric dtypes pack into
// host tensor storage; object dtype keeps a portable list.
pub fn array_typed(data, shape, dtype_name) {
    if _wkind(data) != "list" { return Err("warp.array_typed expects a flat data list") }
    s := if shape == null { [len(data)] } else { shape }
    if !_valid_shape(s) { return Err("warp.array_typed expects non-negative integer dimensions") }
    if _prod(s) != len(data) { return Err("warp.array_typed data length does not match shape") }
    if !_valid_dtype(dtype_name) { return Err("warp.array_typed received unsupported dtype") }
    let mut casted = []
    for value in data {
        kind := _wkind(value)
        if dtype_name != "object" && (value == null || (kind != "bool" && kind != "int" && kind != "float")) {
            return Err("warp.array_typed expects numeric values for this dtype")
        }
        converted := _cast_value(value, dtype_name)
        if _wkind(converted) == "result" {
            if !converted.ok { return converted }
            casted = push(casted, converted.value)
        } else {
            casted = push(casted, converted)
        }
    }
    _make_array(casted, s, dtype_name)
}

pub fn astype(a, dtype_name) {
    if !_is_arr(a) { return Err("warp.astype expects an array") }
    array_typed(_data(a), a.shape, dtype_name)
}

pub fn dtype(a) {
    if !_is_arr(a) { return _infer_dtype([a]) }
    if a._dtype == null { _infer_dtype(_data(a)) } else { a._dtype }
}

pub fn zeros(shape) { full(shape, 0.0) }

pub fn ones(shape) { full(shape, 1.0) }

pub fn full(shape, value) {
    if !_valid_shape(shape) { return Err("warp.full expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, value)
        i = i + 1 }
    array(d, shape)
}

pub fn zeros_dtype(shape, dtype_name) { full_dtype(shape, 0, dtype_name) }

pub fn ones_dtype(shape, dtype_name) { full_dtype(shape, 1, dtype_name) }

pub fn full_dtype(shape, value, dtype_name) {
    if !_valid_shape(shape) { return Err("warp.full_dtype expects non-negative integer dimensions") }
    if !_valid_dtype(dtype_name) { return Err("warp.full_dtype received unsupported dtype") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n {
        converted := _cast_value(value, dtype_name)
        if _wkind(converted) == "result" {
            if !converted.ok { return converted }
            d = push(d, converted.value)
        } else {
            d = push(d, converted)
        }
        i = i + 1 }
    array_typed(d, shape, dtype_name)
}

pub fn arange(start_or_stop, stop_arg, step_arg) {
    let mut s0 = start_or_stop
    let mut s1 = stop_arg
    let mut st = step_arg
    if s1 == null { s1 = s0
        s0 = 0 }
    if st == null { st = 1 }
    if st == 0 { return Err("warp.arange step cannot be zero") }
    let mut d = []
    let mut v = s0
    if st > 0 {
        while v < s1 { d = push(d, v)
        v = v + st }
    } else {
        while v > s1 { d = push(d, v)
        v = v + st }
    }
    array(d, [len(d)])
}

pub fn linspace(start, stop, n) {
    if _wkind(n) != "int" || n < 1 { return Err("warp.linspace requires a positive integer count") }
    if n == 1 { return array([start + 0.0], [1]) }
    step := (stop - start + 0.0) / (n - 1)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, start + 0.0 + i * step)
        i = i + 1 }
    array(d, [n])
}

pub fn eye(n) {
    if _wkind(n) != "int" || n < 0 { return Err("warp.eye requires a non-negative integer size") }
    let mut d = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n {
            d = push(d, if r == c { 1.0 } else { 0.0 })
            c = c + 1
        }
        r = r + 1
    }
    array(d, [n, n])
}

pub fn diag(a) {
    data := _data(a)
    s := if _is_arr(a) { a.shape } else { [len(data)] }
    if len(s) == 2 {
        rows := s[0]
        cols := s[1]
        n := if rows < cols { rows } else { cols }
        let mut d = []
        let mut i = 0
        while i < n {
            d = push(d, data[i * cols + i])
            i = i + 1
        }
        return array(d, [n])
    }
    n := len(data)
    let mut d = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n {
            d = push(d, if r == c { data[r] } else { 0.0 })
            c = c + 1
        }
        r = r + 1
    }
    array(d, [n, n])
}

pub fn from_list(nested) {
    // [[1,2],[3,4]] → array([1,2,3,4], [2,2])
    if _wkind(nested) != "list" { return Err("warp.from_list expects a list") }
    if len(nested) == 0 { return array([], [0]) }
    first := nested[0]
    if _wkind(first) != "list" { return array(nested, [len(nested)]) }
    // check if first element is a list (2D)
    let mut flat = []
    cols := len(first)
    for row in nested {
        if _wkind(row) != "list" || len(row) != cols { return Err("warp.from_list requires rectangular nested lists") }
        for v in row { flat = push(flat, v) }
    }
    array(flat, [len(nested), cols])
}

pub fn rand(shape) {
    if !_valid_shape(shape) { return Err("warp.rand expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, random.float())
        i = i + 1 }
    array(d, shape)
}

pub fn randn(shape) {
    if !_valid_shape(shape) { return Err("warp.randn expects non-negative integer dimensions") }
    // Box-Muller for normal distribution
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n {
        u1 := random.float()
        u2 := random.float()
        z := math.sqrt(-2.0 * math.log(u1 + 1e-15)) * math.cos(2.0 * 3.141592653589793 * u2)
        d = push(d, z)
        i = i + 1
    }
    array(d, shape)
}

pub fn randint(low, high, shape) {
    if high <= low { return Err("warp.randint requires high greater than low") }
    if !_valid_shape(shape) { return Err("warp.randint expects non-negative integer dimensions") }
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, random.int(low, high - 1))
        i = i + 1 }
    array(d, shape)
}

// ──────────────────────────────────────────────
// Seeded random generators
// ──────────────────────────────────────────────
//
// default_rng(seed) returns an independent deterministic generator modeled on
// np.random.default_rng. The bit stream is NOT NumPy's PCG64 — warp uses a
// combined L'Ecuyer (1988) multiple-recursive generator — so values differ
// from NumPy for the same seed and bit-parity is not a goal. Guarantees:
// same seed → identical sequence across runs and processes; generators are
// independent of each other and of the global `random` stdlib state.
// See docs/COMPATIBILITY.md for the explicit deviation note.

const _warp_rng_states = {}
const _warp_rng_counter = {"next": 0}

// One uniform float in (0, 1) from the combined generator; advances state.
fn _rng_uniform(id) {
    state := _warp_rng_states[id]
    s1 := (40014 * state.s1) % 2147483563
    s2 := (40692 * state.s2) % 2147483399
    state.s1 = s1
    state.s2 = s2
    let mut z = s1 - s2
    if z < 1 { z = z + 2147483562 }
    z / 2147483563.0
}

// One uniform integer in [0, span) without modulo bias (span < 2^31).
fn _rng_below(id, span) {
    math.floor(_rng_uniform(id) * (span + 0.0))
}

fn _rng_seed_state(seed) {
    // Scramble the user seed with a Park–Miller warmup so nearby seeds land
    // on decorrelated streams. All products stay below 2^53, so the runtime's
    // float64 round-trip for integer arithmetic is exact here.
    let mut h = ((seed % 2147483646) + 2147483646) % 2147483646 + 1
    h = (h * 48271) % 2147483647
    h = (h * 48271) % 2147483647
    s1 := (h % 2147483562) + 1
    h = (h * 48271) % 2147483647
    s2 := (h % 2147483398) + 1
    {"s1": s1, "s2": s2}
}

fn _rng_fill_uniform(id, shape) {
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n { d = push(d, _rng_uniform(id))
        i = i + 1 }
    array(d, shape)
}

fn _rng_fill_normal(id, shape) {
    n := _prod(shape)
    let mut d = []
    let mut i = 0
    while i < n {
        u1 := _rng_uniform(id)
        u2 := _rng_uniform(id)
        d = push(d, math.sqrt(-2.0 * math.log(u1)) * math.cos(2.0 * 3.141592653589793 * u2))
        i = i + 1
    }
    array(d, shape)
}

// default_rng(seed) → generator map with methods:
//   random(shape)              uniform floats in [0, 1); shape null → scalar
//   normal(shape)              standard normals (Box–Muller); shape null → scalar
//   integers(low, high, shape) ints in [low, high); high null → [0, low);
//                              shape null → scalar
//   shuffle(list)              new shuffled list (Fisher–Yates)
//   permutation(n)             warp int64 array with a permutation of 0..n-1
//   choice(list, n)            n distinct elements without replacement;
//                              n null → a single element
pub fn default_rng(seed) {
    let mut actual = seed
    if actual == null || _wkind(actual) == "unit" {
        // Unseeded generators draw one entropy hit from the global stdlib RNG.
        actual = random.int(0, 2147483646)
    }
    if _wkind(actual) != "int" { return Err("warp.default_rng expects an integer seed or null") }
    id := _warp_rng_counter.next
    _warp_rng_counter.next = id + 1
    _warp_rng_states[id] = _rng_seed_state(actual)
    // Closures in imported modules cannot reference sibling module functions
    // directly, so bind the helpers as locals for the methods to capture.
    rng_uniform := _rng_uniform
    rng_below := _rng_below
    fill_uniform := _rng_fill_uniform
    fill_normal := _rng_fill_normal
    valid_shape := _valid_shape
    wkind := _wkind
    prod := _prod
    copy_list := _copy
    list_range := _list_range
    make_array := array
    {
        "random": fn(shape) {
            if shape == null || wkind(shape) == "unit" { return rng_uniform(id) }
            if !valid_shape(shape) { return Err("warp.rng.random expects non-negative integer dimensions or null") }
            fill_uniform(id, shape)
        },
        "normal": fn(shape) {
            if shape == null || wkind(shape) == "unit" { return fill_normal(id, [1]).data[0] }
            if !valid_shape(shape) { return Err("warp.rng.normal expects non-negative integer dimensions or null") }
            fill_normal(id, shape)
        },
        "integers": fn(low, high, shape) {
            let mut lo = low
            let mut hi = high
            if hi == null || wkind(hi) == "unit" { hi = lo
                lo = 0 }
            if wkind(lo) != "int" || wkind(hi) != "int" || hi <= lo {
                return Err("warp.rng.integers requires integer bounds with high greater than low")
            }
            span := hi - lo
            if shape == null || wkind(shape) == "unit" { return lo + rng_below(id, span) }
            if !valid_shape(shape) { return Err("warp.rng.integers expects non-negative integer dimensions or null") }
            n := prod(shape)
            let mut d = []
            let mut i = 0
            while i < n { d = push(d, lo + rng_below(id, span))
                i = i + 1 }
            make_array(d, shape)
        },
        "shuffle": fn(items) {
            if wkind(items) != "list" { return Err("warp.rng.shuffle expects a list") }
            let mut out = copy_list(items)
            let mut i = len(out) - 1
            while i >= 1 {
                j := rng_below(id, i + 1)
                tmp := out[i]
                out[i] = out[j]
                out[j] = tmp
                i = i - 1
            }
            out
        },
        "permutation": fn(n) {
            if wkind(n) != "int" || n < 0 { return Err("warp.rng.permutation expects a non-negative integer") }
            let mut items = []
            let mut i = 0
            while i < n { items = push(items, i)
                i = i + 1 }
            i = len(items) - 1
            while i >= 1 {
                j := rng_below(id, i + 1)
                tmp := items[i]
                items[i] = items[j]
                items[j] = tmp
                i = i - 1
            }
            make_array(items, [n])
        },
        "choice": fn(items, n) {
            if wkind(items) != "list" { return Err("warp.rng.choice expects a list") }
            if n == null || wkind(n) == "unit" {
                if len(items) == 0 { return Err("warp.rng.choice cannot draw from an empty list") }
                return items[rng_below(id, len(items))]
            }
            if wkind(n) != "int" || n < 0 || n > len(items) {
                return Err("warp.rng.choice without replacement requires 0 <= n <= len(list)")
            }
            // Partial Fisher–Yates: first n positions of a shuffled copy.
            let mut out = copy_list(items)
            let mut k = 0
            while k < n {
                j := k + rng_below(id, len(out) - k)
                tmp := out[k]
                out[k] = out[j]
                out[j] = tmp
                k = k + 1
            }
            list_range(out, 0, n)
        },
    }
}

// ──────────────────────────────────────────────
// Shape / indexing
// ──────────────────────────────────────────────

pub fn shape(a) { a.shape }

pub fn size(a) { if !_is_arr(a) { len(a) } else { _prod(a.shape) } }

pub fn ndim(a) { len(a.shape) }

// Strides are measured in elements by element_strides and in bytes by
// strides, matching NumPy's public metadata. The portable implementation
// keeps element strides internally so views do not depend on host word size.
pub fn element_strides(a) {
    if !_is_arr(a) { return Err("warp.element_strides expects an array") }
    _copy(a._strides)
}

pub fn strides(a) {
    if !_is_arr(a) { return Err("warp.strides expects an array") }
    itemsize := _itemsize(dtype(a))
    let mut result = []
    for stride in a._strides { result = push(result, stride * itemsize) }
    result
}

pub fn offset(a) {
    if !_is_arr(a) { return Err("warp.offset expects an array") }
    a._offset
}

pub fn is_contiguous(a) {
    _is_arr(a) && a._strides == _contiguous_strides(a.shape)
}

// view creates a zero-copy logical view over the source backing list.
// Strides are measured in elements; negative strides are valid.
pub fn view(a, new_shape, element_strides, view_offset) {
    if !_is_arr(a) { return Err("warp.view expects an array") }
    if !_valid_shape(new_shape) || _wkind(element_strides) != "list" || len(new_shape) != len(element_strides) {
        return Err("warp.view expects matching shape and element strides")
    }
    if _wkind(view_offset) != "int" { return Err("warp.view offset must be an integer") }
    for stride in element_strides { if _wkind(stride) != "int" { return Err("warp.view strides must be integers") } }
    if !_view_in_bounds(new_shape, element_strides, view_offset, len(a.data)) {
        return Err("warp.view exceeds the source storage")
    }
    {"_warp": true, "data": a.data, "shape": new_shape, "_dtype": dtype(a), "_strides": _copy(element_strides), "_offset": view_offset}
}

pub fn contiguous(a) {
    if !_is_arr(a) { return Err("warp.contiguous expects an array") }
    array_typed(_data(a), a.shape, dtype(a))
}

pub fn reshape(a, new_shape) {
    if _wkind(new_shape) != "list" { return Err("warp.reshape expects a shape list") }
    let mut inferred = -1
    let mut known = 1
    let mut unknowns = 0
    for dim in new_shape {
        if _wkind(dim) != "int" || dim < -1 { return Err("warp.reshape dimensions must be non-negative integers or one -1") }
        if dim == -1 { unknowns = unknowns + 1 }
        else { known = known * dim }
    }
    if unknowns > 1 { return Err("warp.reshape allows at most one inferred dimension") }
    let mut target = []
    for dim in new_shape { target = push(target, dim) }
    if unknowns == 1 {
        if known == 0 || size(a) % known != 0 { return Err("warp.reshape cannot infer a dimension") }
        inferred = size(a) / known
        let mut i = 0
        while i < len(target) { if target[i] == -1 { target[i] = inferred }
            i = i + 1 }
    }
if !_valid_shape(target) || _prod(target) != size(a) {
        return Err("warp.reshape shape must preserve the number of elements")
    }
    if is_contiguous(a) { return view(a, target, _contiguous_strides(target), a._offset) }
    _array_like(_data(a), target, a)
}

pub fn flatten(a) { _array_like(_data(a), [size(a)], a) }

pub fn ravel(a) { flatten(a) }

pub fn squeeze(a) {
    let mut s = []
    for dim in a.shape { if dim != 1 { s = push(s, dim) } }
    _array_like(_data(a), s, a)
}

pub fn expand_dims(a, axis) {
    normalized := _normalize_axis(axis, len(a.shape), true)
    if normalized == null { return Err("warp.expand_dims axis is out of range") }
    let mut s = []
    let mut i = 0
    while i <= len(a.shape) {
        if i == normalized { s = push(s, 1) }
        if i < len(a.shape) { s = push(s, a.shape[i]) }
        i = i + 1
    }
    _array_like(_data(a), s, a)
}

// Ensure at least 1-D / 2-D, matching NumPy atleast_1d / atleast_2d.
pub fn atleast_1d(a) {
    if !_is_arr(a) { return array([a], [1]) }
    if len(a.shape) == 0 { return _array_like(_data(a), [1], a) }
    a
}

pub fn atleast_2d(a) {
    if !_is_arr(a) { return array([a], [1, 1]) }
    rank := len(a.shape)
    if rank == 0 { return _array_like(_data(a), [1, 1], a) }
    if rank == 1 { return _array_like(_data(a), [1, a.shape[0]], a) }
    a
}

// Materialize `a` broadcast to `shape` (right-aligned NumPy rules).
pub fn broadcast_to(a, shape) {
    if !_is_arr(a) { return Err("warp.broadcast_to expects an array") }
    if !_valid_shape(shape) { return Err("warp.broadcast_to expects a valid shape") }
    bs := _broadcast_shape(a.shape, shape)
    if bs == null || bs != shape { return Err("warp.broadcast_to cannot broadcast to target shape") }
    let mut d = []
    n := _prod(shape)
    let mut i = 0
    while i < n {
        index := _unravel(i, shape)
        d = push(d, _broadcast_value(a, index, shape))
        i = i + 1
    }
    _array_like(d, shape, a)
}

// Constant pad for 1-D / 2-D (and general N-D). `pad_width` may be:
//   int                → pad both sides of every axis by that amount
//   [before, after]    → same pair applied to every axis
//   [[b0,a0], [b1,a1]] → per-axis pairs
pub fn pad(a, pad_width, constant_value) {
    if !_is_arr(a) { return Err("warp.pad expects an array") }
    cv := if _wkind(constant_value) == "unit" || constant_value == null { 0 } else { constant_value }
    rank := len(a.shape)
    pads := _normalize_pad_width(pad_width, rank)
    if pads == null { return Err("warp.pad received invalid pad_width") }
    let mut out_shape = []
    let mut i = 0
    while i < rank {
        out_shape = push(out_shape, a.shape[i] + pads[i][0] + pads[i][1])
        i = i + 1
    }
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        let mut in_bounds = true
        let mut source_index = []
        let mut ax = 0
        while ax < rank {
            coord := out_index[ax] - pads[ax][0]
            if coord < 0 || coord >= a.shape[ax] {
                in_bounds = false
                break
            }
            source_index = push(source_index, coord)
            ax = ax + 1
        }
        if in_bounds {
            d = push(d, _logical_value_at(a, source_index))
        } else {
            d = push(d, cv)
        }
        flat = flat + 1
    }
    _array_like(d, out_shape, a)
}

pub fn transpose(a, axes) {
    if !_is_arr(a) { return Err("warp.transpose expects an array") }
    let mut rank = len(a.shape)
    axis_arg := if _wkind(axes) == "unit" { null } else { axes }
    let mut order = []
    if axis_arg == null {
        let mut i = rank - 1
        while i >= 0 { order = push(order, i)
            i = i - 1 }
    } else {
        if _wkind(axis_arg) != "list" || len(axis_arg) != rank { return Err("warp.transpose axes must be a permutation") }
        for axis in axis_arg {
            normalized := _normalize_axis(axis, rank, false)
            if normalized == null || contains(order, normalized) { return Err("warp.transpose axes must be a permutation") }
            order = push(order, normalized)
        }
    }
    let mut out_shape = []
    for axis in order { out_shape = push(out_shape, a.shape[axis]) }
    let mut d = []
    n := _prod(out_shape)
    let mut i = 0
    while i < n {
        out_index := _unravel(i, out_shape)
        let mut source_index = []
        let mut j = 0
        while j < rank { source_index = push(source_index, 0)
            j = j + 1 }
        j = 0
        while j < rank { source_index[order[j]] = out_index[j]
            j = j + 1 }
        d = push(d, _logical_value_at(a, source_index))
        i = i + 1
    }
    _array_like(d, out_shape, a)
}

pub fn T(a) {
    s := a.shape
    if len(s) != 2 { return a }
    rows := s[0]
    cols := s[1]
    let mut d = []
    let mut c = 0
    while c < cols {
        let mut r = 0
    while r < rows { d = push(d, _logical_value_at(a, [r, c]))
        r = r + 1 }
        c = c + 1
    }
    array(d, [cols, rows])
}

pub fn transpose_view(a, axes) {
    if !_is_arr(a) { return Err("warp.transpose_view expects an array") }
    order := _transpose_order(len(a.shape), axes)
    if order == null { return Err("warp.transpose_view axes must be a permutation") }
    let mut out_shape = []
    let mut out_strides = []
    for axis in order {
        out_shape = push(out_shape, a.shape[axis])
        out_strides = push(out_strides, a._strides[axis])
    }
    view(a, out_shape, out_strides, a._offset)
}

// NumPy-style indexing selectors. Selectors may be integers (including
// negative indices), rectangular integer index arrays, boolean masks,
// slice selectors, ellipsis() (expands to whole axes), newaxis() (inserts a
// length-1 dimension), or null to select a complete axis. Missing trailing
// selectors are treated as null; advanced index arrays broadcast together.
pub fn index(a, selectors) {
    if !_is_arr(a) || _wkind(selectors) != "list" { return Err("warp.index expects an array and selector list") }
    expanded := _expand_selectors(selectors, len(a.shape), "warp.index")
    if _wkind(expanded) == "str" { return Err(expanded) }
    prepared := _prepare_newaxis(a, expanded)
    source := prepared.array
    sels := prepared.selectors
    let mut specs = []
    let mut axis = 0
    while axis < len(source.shape) {
        selector := if axis < len(sels) { sels[axis] } else { null }
        spec := _index_spec(selector, source.shape[axis])
        if spec == null { return Err("warp.index selector is invalid or out of range") }
        specs = push(specs, spec)
        axis = axis + 1
    }
    for spec in specs {
        if spec.kind == "advanced" { return _index_advanced(source, specs) }
    }
    let mut out_shape = []
    let mut all_scalar = true
    for spec in specs {
        if spec.kind == "scalar" { continue }
        all_scalar = false
        if spec.kind == "all" || spec.kind == "slice" { out_shape = push(out_shape, spec.size) }
        else { out_shape = push(out_shape, len(spec.positions)) }
    }
    let mut values = []
    values = _collect_index_values(source, specs, 0, [], values)
    if all_scalar { return values[0] }
    _array_with_dtype(values, out_shape, dtype(source))
}

pub fn get(a, indices) {
    // get(a, [1, 2]) → element at row 1, col 2
    if len(indices) != len(a.shape) { return Err("warp.get requires one index per dimension") }
    index(a, indices)
}

pub fn set(a, indices, value) {
    if !_is_arr(a) || _wkind(indices) != "list" { return Err("warp.set expects an array and selector list") }
    // NumPy allows fewer selectors than axes (missing trailing axes are
    // fully selected), ellipsis, and newaxis tokens in assignment targets.
    expanded := _expand_selectors(indices, len(a.shape), "warp.set")
    if _wkind(expanded) == "str" { return Err(expanded) }
    prepared := _prepare_newaxis(a, expanded)
    // Targets are computed in the prepared (newaxis-expanded) index space.
    // Inserted axes have length 1, so a flat C-order position in that space
    // addresses the same element of the original storage.
    target_shape := prepared.array.shape
    sels := prepared.selectors
    let mut specs = []
    let mut axis = 0
    while axis < len(target_shape) {
        selector := if axis < len(sels) { sels[axis] } else { null }
        spec := _index_spec(selector, target_shape[axis])
        if spec == null { return Err("warp.set selector is invalid or out of range") }
        specs = push(specs, spec)
        axis = axis + 1
    }
    target := _selection_targets(specs)
    if target == null { return Err("warp.set selectors could not be broadcast together") }
    if _is_arr(value) && _broadcast_shape(value.shape, target.shape) == null {
        return Err("warp.set value could not be broadcast to the selected shape")
    }
    let mut d = _data(a)
    let mut flat = 0
    while flat < len(target.indices) {
        output_index := _unravel(flat, target.shape)
        replacement := if _is_arr(value) { _broadcast_value(value, output_index, target.shape) } else { value }
        d[_flat_index(target.indices[flat], target_shape)] = replacement
        flat = flat + 1
    }
    _array_with_dtype(d, a.shape, dtype(a))
}

pub fn row(a, r) {
    if len(a.shape) != 2 || r < 0 || r >= a.shape[0] { return Err("warp.row expects a valid 2D row") }
    data := _data(a)
    cols := a.shape[1]
    let mut d = []
    let mut c = 0
    while c < cols { d = push(d, data[r * cols + c])
        c = c + 1 }
    array(d, [cols])
}

pub fn col(a, c) {
    if len(a.shape) != 2 || c < 0 || c >= a.shape[1] { return Err("warp.col expects a valid 2D column") }
    data := _data(a)
    rows := a.shape[0]
    cols := a.shape[1]
    let mut d = []
    let mut r = 0
    while r < rows { d = push(d, data[r * cols + c])
        r = r + 1 }
    array(d, [rows])
}

pub fn slice(a, start, stop) {
    source := if len(a.shape) == 1 { a } else { flatten(a) }
    slice_step(source, start, stop, 1)
}

// slice_step applies Python/NumPy slice bounds to a one-dimensional array.
// The result is a strided immutable view and supports negative steps.
pub fn slice_step(a, start, stop, step) {
    if !_is_arr(a) || len(a.shape) != 1 { return Err("warp.slice_step expects a one-dimensional array") }
    bounds := _slice_bounds(a.shape[0], start, stop, step)
    if bounds == null { return Err("warp.slice_step has invalid bounds or a zero step") }
    view_offset := if bounds.count == 0 { a._offset } else { a._offset + bounds.start * a._strides[0] }
    view(a, [bounds.count], [a._strides[0] * bounds.step], view_offset)
}

// slice_axis applies a Python/NumPy slice to one axis of an N-dimensional
// array and returns a zero-copy view whenever the selected storage is valid.
pub fn slice_axis(a, start, stop, step, axis) {
    if !_is_arr(a) { return Err("warp.slice_axis expects an array") }
    normalized_axis := _normalize_axis(axis, len(a.shape), false)
    if normalized_axis == null { return Err("warp.slice_axis axis is out of range") }
    bounds := _slice_bounds(a.shape[normalized_axis], start, stop, step)
    if bounds == null { return Err("warp.slice_axis has invalid bounds or a zero step") }
    let mut shape = _copy(a.shape)
    let mut strides = _copy(a._strides)
    shape[normalized_axis] = bounds.count
    strides[normalized_axis] = strides[normalized_axis] * bounds.step
    view_offset := if bounds.count == 0 { a._offset } else { a._offset + bounds.start * a._strides[normalized_axis] }
    view(a, shape, strides, view_offset)
}

pub fn slice_selector(start, stop, step) {
    {"_slice": true, "start": start, "stop": stop, "step": if step == null { 1 } else { step }}
}

// ellipsis() expands to the number of full axes needed for the remaining
// selectors to consume the array's rank, matching NumPy's `...`. At most one
// ellipsis is allowed per selector list; it may expand to zero axes.
pub fn ellipsis() { {"_ellipsis": true} }

// newaxis() inserts a length-1 dimension at its position, matching NumPy's
// `None` / `np.newaxis`. It consumes no axis, may appear any number of times,
// and composes with integer, slice, advanced, and ellipsis selectors.
pub fn newaxis() { {"_newaxis": true} }

// ──────────────────────────────────────────────
// Element-wise arithmetic
// ──────────────────────────────────────────────

pub fn add(a, b) {
    // Prefer host packed tensors when both operands have native `_tid` storage.
    native := _try_tensor_binop(a, b, "add")
    if native != null { return native }
    _binop(a, b, fn(x, y) { x + y })
}
pub fn sub(a, b) { _binop(a, b, fn(x, y) { x - y }) }
pub fn mul(a, b) {
    native := _try_tensor_binop(a, b, "mul")
    if native != null { return native }
    _binop(a, b, fn(x, y) { x * y })
}
pub fn div(a, b) { _binop(a, b, fn(x, y) { x / y }) }
pub fn mod_(a, b) { _binop(a, b, fn(x, y) { x % y }) }
pub fn neg(a) { _unaryop(a, fn(x) { -x }) }
pub fn abs_(a) { _unaryop(a, fn(x) { math.abs(x) }) }

pub fn pow_(a, p) {
    if _is_arr(p) { _binop(a, p, fn(x, y) { math.pow(x, y) }) }
    else { _unaryop(a, fn(x) { math.pow(x, p) }) }
}

pub fn round_(a, decimals) {
    dec := if decimals == null { 0 } else { decimals }
    factor := math.pow(10, dec)
    _unaryop(a, fn(x) { math.round(x * factor) / factor })
}

pub fn floor_(a) { _unaryop_with_dtype(a, fn(x) { math.floor(x) }, _float_result_dtype(a)) }
pub fn ceil_(a) { _unaryop_with_dtype(a, fn(x) { math.ceil(x) }, _float_result_dtype(a)) }
pub fn clip(a, lo, hi) { _unaryop(a, fn(x) { math.clamp(x, lo, hi) }) }
pub fn sign(a) { _unaryop(a, fn(x) { if x > 0 { 1.0 } else if x < 0 { -1.0 } else { 0.0 } }) }

// ──────────────────────────────────────────────
// Math functions (element-wise)
// ──────────────────────────────────────────────

pub fn sqrt(a) { _unaryop_with_dtype(a, fn(x) { math.sqrt(x) }, "float64") }
pub fn exp(a) { _unaryop_with_dtype(a, fn(x) { math.exp(x) }, "float64") }
pub fn log_(a) { _unaryop_with_dtype(a, fn(x) { math.log(x) }, "float64") }
pub fn log2(a) { _unaryop_with_dtype(a, fn(x) { math.log(x) / math.log(2) }, "float64") }
pub fn log10(a) { _unaryop_with_dtype(a, fn(x) { math.log(x) / math.log(10) }, "float64") }

pub fn sin(a) { _unaryop_with_dtype(a, fn(x) { math.sin(x) }, "float64") }
pub fn cos(a) { _unaryop_with_dtype(a, fn(x) { math.cos(x) }, "float64") }
pub fn tan(a) { _unaryop_with_dtype(a, fn(x) { math.tan(x) }, "float64") }
pub fn asin(a) { _unaryop_with_dtype(a, fn(x) { math.asin(x) }, "float64") }
pub fn acos(a) { _unaryop_with_dtype(a, fn(x) { math.acos(x) }, "float64") }
pub fn atan(a) { _unaryop_with_dtype(a, fn(x) { math.atan(x) }, "float64") }
pub fn atan2(y, x) { _binop_with_dtype(y, x, fn(a, b) { math.atan2(a, b) }, "float64") }

pub fn sinh(a) { _unaryop_with_dtype(a, fn(x) { (math.exp(x) - math.exp(-x)) / 2 }, "float64") }
pub fn cosh(a) { _unaryop_with_dtype(a, fn(x) { (math.exp(x) + math.exp(-x)) / 2 }, "float64") }
pub fn tanh(a) { _unaryop_with_dtype(a, fn(x) {
    if x > 20.0 { return 1.0 }
    if x < -20.0 { return -1.0 }
    e := math.exp(2.0 * x)
    return (e - 1.0) / (e + 1.0)
}, "float64") }

pub fn hypot(x, y) { _binop_with_dtype(x, y, fn(a, b) { math.hypot(a, b) }, _float_pair_dtype(x, y)) }

// expm1(x) = exp(x) - 1, evaluated with a Taylor series near zero where the
// direct form loses precision (NumPy ufunc parity).
pub fn expm1(a) { _unaryop_with_dtype(a, _expm1_scalar, _float_result_dtype(a)) }

fn _expm1_scalar(x) {
    if x != x { return math.nan }
    if x > -0.25 && x < 0.25 {
        // Horner form of sum x^k/k!, k = 1..12; abs error < 1e-15 on |x| < 1/4.
        return x * (1.0 + x * (0.5 + x * (1.0/6.0 + x * (1.0/24.0 + x * (1.0/120.0 + x * (1.0/720.0 + x * (1.0/5040.0 + x * (1.0/40320.0 + x * (1.0/362880.0 + x * (1.0/3628800.0 + x * (1.0/39916800.0 + x / 479001600.0)))))))))))
    }
    math.exp(x) - 1.0
}

// log1p(x) = log(1 + x), accurate for small x via the Cephes ratio trick.
pub fn log1p(a) { _unaryop_with_dtype(a, _log1p_scalar, _float_result_dtype(a)) }

fn _log1p_scalar(x) {
    if x != x { return math.nan }
    u := 1.0 + x
    if u == 1.0 { return x }
    if u < 0.0 { return math.nan }
    if u == 0.0 { return -math.inf }
    x * math.log(u) / (u - 1.0)
}

// floor_divide matches np.floor_divide: floor(a / b). A zero divisor follows
// NumPy's warn-and-continue behavior: for float results ±inf (sign of the
// dividend, NaN for 0/0), for integer results 0. (Weft `/` itself raises on
// division by zero, so it is avoided here.)
pub fn floor_divide(a, b) {
    result_dtype := _promote_dtype(a, b)
    _binop_with_dtype(a, b, fn(x, y) { _floor_div_scalar(x, y, result_dtype) }, result_dtype)
}

fn _floor_div_scalar(x, y, result_dtype) {
    if y == 0 {
        if result_dtype == "float32" || result_dtype == "float64" {
            if x > 0 { return math.inf }
            if x < 0 { return -math.inf }
            return math.nan
        }
        return 0
    }
    math.floor((x + 0.0) / (y + 0.0)) + 0.0
}

// remainder matches np.remainder / np.mod: the result carries the sign of the
// divisor (floored division), unlike Weft's `%` operator (and warp.mod_),
// which truncates toward zero and carries the sign of the dividend.
// Zero divisor: NaN for float results, 0 for integer results (NumPy warning
// semantics).
pub fn remainder(a, b) {
    result_dtype := _promote_dtype(a, b)
    _binop_with_dtype(a, b, fn(x, y) { _remainder_scalar(x, y, result_dtype) }, result_dtype)
}

fn _remainder_scalar(x, y, result_dtype) {
    if y == 0 {
        if result_dtype == "float32" || result_dtype == "float64" { return math.nan }
        return 0
    }
    xf := x + 0.0
    yf := y + 0.0
    let mut r = xf - math.floor(xf / yf) * yf
    // Rounding can land one step off the divisor's sign interval; nudge back.
    if r != 0.0 && ((r < 0.0) != (yf < 0.0)) { r = r + yf }
    r
}

pub fn square(a) { _unaryop(a, fn(x) { x * x }) }

// reciprocal returns 1 / x as a float. Unlike NumPy's integer reciprocal
// (truncating integer division), warp always computes the true reciprocal;
// x == 0 yields +inf (NumPy float behavior; Weft `/` would raise).
pub fn reciprocal(a) {
    _unaryop_with_dtype(a, fn(x) { if x == 0 { math.inf } else { 1.0 / (x + 0.0) } }, _float_result_dtype(a))
}

pub fn deg2rad(a) { _unaryop_with_dtype(a, fn(x) { x * (3.141592653589793 / 180.0) }, _float_result_dtype(a)) }

pub fn rad2deg(a) { _unaryop_with_dtype(a, fn(x) { x * (180.0 / 3.141592653589793) }, _float_result_dtype(a)) }

// copysign(x, y): magnitude of x with the sign of y. Zero y counts as
// positive (Weft cannot distinguish -0.0 from 0.0).
pub fn copysign(x, y) {
    _binop_with_dtype(x, y, fn(a, b) { if b < 0 { -math.abs(a) } else { math.abs(a) } }, _float_pair_dtype(x, y))
}

// rint rounds to the nearest integer with ties to even (NumPy/IEEE banker's
// rounding), returned as a float — unlike math.round, which rounds half away
// from zero.
pub fn rint(a) { _unaryop_with_dtype(a, _rint_scalar, _float_result_dtype(a)) }

fn _rint_scalar(x) {
    if x != x { return math.nan }
    if x == math.inf || x == -math.inf { return x }
    f := math.floor(x)
    diff := x - f
    if diff < 0.5 { return f + 0.0 }
    if diff > 0.5 { return f + 1.0 }
    if f % 2 == 0 { f + 0.0 } else { f + 1.0 }
}

fn _float_pair_dtype(a, b) {
    if _promote_dtype(a, b) == "float32" { "float32" } else { "float64" }
}

// ──────────────────────────────────────────────
// Comparisons (element-wise, return boolean arrays)
// ──────────────────────────────────────────────

pub fn equal(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x == y { 1 } else { 0 } }, "bool") }
pub fn not_equal(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x != y { 1 } else { 0 } }, "bool") }
pub fn less(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x < y { 1 } else { 0 } }, "bool") }
pub fn less_equal(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x <= y { 1 } else { 0 } }, "bool") }
pub fn greater(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x > y { 1 } else { 0 } }, "bool") }
pub fn greater_equal(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x >= y { 1 } else { 0 } }, "bool") }

pub fn where(cond, x, y) {
    cs := _operand_shape(cond)
    xs := _operand_shape(x)
    ys := _operand_shape(y)
    shape := _broadcast_shape(_broadcast_shape(cs, xs), ys)
    if shape == null { return Err("warp.where operands could not be broadcast together") }
    let mut d = []
    let mut i = 0
    n := _prod(shape)
    while i < n {
        index := _unravel(i, shape)
        cv := _operand_value(cond, index, shape)
        xv := _operand_value(x, index, shape)
        yv := _operand_value(y, index, shape)
        d = push(d, if cv { xv } else { yv })
        i = i + 1
    }
    _array_with_dtype(d, shape, _promote_dtype(x, y))
}

pub fn all_(a) {
    for x in _data(a) { if !x { return false } }
    true
}

pub fn any_(a) {
    for x in _data(a) { if x { return true } }
    false
}

// ──────────────────────────────────────────────
// Reductions
// ──────────────────────────────────────────────

pub fn sum(a) {
    let mut s = 0
    for x in _data(a) { s = s + x }
    s
}

pub fn prod(a) {
    let mut s = 1
    for x in _data(a) { s = s * x }
    s
}

pub fn mean(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    sum(a) / (len(data) + 0.0)
}

pub fn var_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    m := mean(a)
    let mut s = 0.0
    for x in data { s = s + (x - m) * (x - m) }
    s / len(data)
}

pub fn std_(a) {
    value := var_(a)
    if value == null { return null }
    math.sqrt(value)
}

// var_opts / std_opts add NumPy's ddof (delta degrees of freedom): the
// divisor is n - ddof instead of n. NumPy's warn-and-continue edge cases are
// mirrored: divisor <= 0 yields +inf, or NaN when the deviation sum is 0.
pub fn var_opts(a, ddof) {
    data := _data(a)
    if len(data) == 0 { return null }
    d := if ddof == null || _wkind(ddof) == "unit" { 0 } else { ddof }
    denom := len(data) - d
    m := mean(a)
    let mut s = 0.0
    for x in data { s = s + (x - m) * (x - m) }
    if denom <= 0 {
        if s == 0.0 { return math.nan }
        return math.inf
    }
    s / denom
}

pub fn std_opts(a, ddof) {
    value := var_opts(a, ddof)
    if value == null { return null }
    math.sqrt(value)
}

pub fn min_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut m = data[0]
    let mut i = 1
    while i < len(data) { if data[i] < m { m = data[i] }
        i = i + 1 }
    m
}

pub fn max_(a) {
    data := _data(a)
    if len(data) == 0 { return null }
    let mut m = data[0]
    let mut i = 1
    while i < len(data) { if data[i] > m { m = data[i] }
        i = i + 1 }
    m
}

// argmin / argmax: flat index when axis is omitted; index along `axis` otherwise.
pub fn argmin(a, axis) {
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    if axis_arg == null {
        data := _data(a)
        if len(data) == 0 { return null }
        let mut mi = 0
        let mut i = 1
        while i < len(data) { if data[i] < data[mi] { mi = i }
            i = i + 1 }
        return mi
    }
    _arg_reduce_axis(a, axis_arg, true)
}

pub fn argmax(a, axis) {
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    if axis_arg == null {
        data := _data(a)
        if len(data) == 0 { return null }
        let mut mi = 0
        let mut i = 1
        while i < len(data) { if data[i] > data[mi] { mi = i }
            i = i + 1 }
        return mi
    }
    _arg_reduce_axis(a, axis_arg, false)
}

// NaN-aware reductions: skip values where x != x.
pub fn nansum(a) {
    let mut s = 0.0
    for x in _data(a) {
        if x == x { s = s + x }
    }
    s
}

pub fn nanmean(a) {
    let mut s = 0.0
    let mut n = 0
    for x in _data(a) {
        if x == x {
            s = s + x
            n = n + 1
        }
    }
    if n == 0 { return math.nan }
    s / (n + 0.0)
}

pub fn cumsum(a) {
    data := _data(a)
    let mut d = []
    let mut s = 0
    for x in data { s = s + x
        d = push(d, s) }
    _array_with_dtype(d, a.shape, if _is_arr(a) { dtype(a) } else { null })
}

pub fn cumprod(a) {
    data := _data(a)
    let mut d = []
    let mut s = 1
    for x in data { s = s * x
        d = push(d, s) }
    _array_with_dtype(d, a.shape, if _is_arr(a) { dtype(a) } else { null })
}

// cumsum_axis / cumprod_axis accumulate along one axis (NumPy axis= form);
// the result keeps the input shape and dtype. Negative axes are accepted.
pub fn cumsum_axis(a, axis) { _cum_axis(a, axis, false) }

pub fn cumprod_axis(a, axis) { _cum_axis(a, axis, true) }

fn _cum_axis(a, axis, is_prod) {
    if !_is_arr(a) { return Err("warp.cumsum_axis/cumprod_axis expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.cumsum_axis/cumprod_axis axis is out of range") }
    data := _data(a)
    let mut d = []
    let mut i = 0
    while i < len(data) { d = push(d, 0)
        i = i + 1 }
    n := a.shape[normalized]
    outer_shape := _remove_axis(a.shape, normalized)
    outer_size := _prod(outer_shape)
    let mut flat = 0
    while flat < outer_size {
        outer_index := _unravel(flat, outer_shape)
        let mut acc = if is_prod { 1 } else { 0 }
        let mut k = 0
        while k < n {
            source_index := _insert_axis_index(outer_index, normalized, k)
            x := _logical_value_at(a, source_index)
            acc = if is_prod { acc * x } else { acc + x }
            d[_flat_index(source_index, a.shape)] = acc
            k = k + 1
        }
        flat = flat + 1
    }
    _array_with_dtype(d, a.shape, dtype(a))
}

pub fn median(a) {
    if len(_data(a)) == 0 { return null }
    sorted := sort(a)
    data := _data(sorted)
    n := len(data)
    if n % 2 == 1 { data[n / 2] }
    else { (data[n / 2 - 1] + data[n / 2]) / 2.0 }
}

pub fn percentile(a, p) {
    if len(_data(a)) == 0 { return null }
    if p < 0 || p > 100 { return Err("warp.percentile requires p between 0 and 100") }
    sorted := sort(a)
    data := _data(sorted)
    n := len(data)
    k := (p / 100.0) * (n - 1)
    lo := math.floor(k)
    hi := math.ceil(k)
    if lo == hi { data[lo] }
    else { data[lo] * (hi - k) + data[hi] * (k - lo) }
}

// ──────────────────────────────────────────────
// Statistics
// ──────────────────────────────────────────────

// np.histogram: bin counts plus edges. `bins` is either a positive integer
// (equal-width bins over `range`, or over the data min/max when range is
// null — with NumPy's 0.5 padding when min == max and (0, 1) for empty data)
// or an explicit non-decreasing edge list. Every bin is half-open
// [edges[i], edges[i+1]) except the last, which also includes its right edge;
// values outside the edge span are ignored, and NaN is never counted.
pub fn histogram(a, bins, range) {
    data := _data(a)
    if _wkind(data) != "list" { return Err("warp.histogram expects an array or flat list") }
    let mut edges = []
    if _wkind(bins) == "int" {
        if bins <= 0 { return Err("warp.histogram bins must be a positive integer") }
        let mut lo = 0.0
        let mut hi = 1.0
        if range != null {
            if _wkind(range) != "list" || len(range) != 2 { return Err("warp.histogram range must be a [min, max] pair") }
            lo = range[0] + 0.0
            hi = range[1] + 0.0
            if !(hi > lo) { return Err("warp.histogram range max must be greater than min") }
        } else if len(data) > 0 {
            lo = min_(data) + 0.0
            hi = max_(data) + 0.0
            if lo == hi { lo = lo - 0.5
                hi = hi + 0.5 }
        }
        edges = _data(linspace(lo, hi, bins + 1))
    } else {
        raw := _data(bins)
        if _wkind(raw) != "list" || len(raw) < 2 { return Err("warp.histogram explicit bins need at least two edges") }
        if !_non_decreasing(raw) { return Err("warp.histogram bins must increase monotonically") }
        for e in raw { edges = push(edges, e + 0.0) }
    }
    nbins := len(edges) - 1
    let mut counts = []
    let mut i = 0
    while i < nbins { counts = push(counts, 0)
        i = i + 1 }
    last_edge := edges[len(edges) - 1]
    for x in data {
        if x >= edges[0] && x <= last_edge {
            if x == last_edge {
                counts[nbins - 1] = counts[nbins - 1] + 1
            } else {
                b := _histogram_bin(edges, x)
                counts[b] = counts[b] + 1
            }
        }
    }
    {"counts": _array_with_dtype(counts, [nbins], "int64"),
     "edges": _array_with_dtype(edges, [len(edges)], "float64")}
}

// First bin index i with x < edges[i+1]; the caller guarantees
// edges[0] <= x < edges[last].
fn _histogram_bin(edges, x) {
    let mut lo = 0
    let mut hi = len(edges) - 2
    while lo < hi {
        mid := (lo + hi) / 2
        if x < edges[mid + 1] { hi = mid } else { lo = mid + 1 }
    }
    lo
}

// np.bincount: occurrence counts of non-negative integers, with output length
// max(x) + 1 (empty for empty input). Negative or non-integer values are an
// explicit Err (NumPy raises ValueError/TypeError).
pub fn bincount(x) {
    data := _data(x)
    if _wkind(data) != "list" { return Err("warp.bincount expects an array or flat list") }
    let mut max_value = -1
    for v in data {
        if _wkind(v) != "int" || v < 0 { return Err("warp.bincount expects non-negative integers") }
        if v > max_value { max_value = v }
    }
    if max_value < 0 { return _array_with_dtype([], [0], "int64") }
    let mut counts = []
    let mut i = 0
    while i <= max_value { counts = push(counts, 0)
        i = i + 1 }
    for v in data { counts[v] = counts[v] + 1 }
    _array_with_dtype(counts, [max_value + 1], "int64")
}

// Sample covariance of two equal-length flat lists with ddof=1. NumPy's
// warn-and-continue edge for fewer than two points yields NaN.
fn _cov_pair(u, v) {
    n := len(u)
    if n < 2 { return math.nan }
    let mut mu = 0.0
    let mut mv = 0.0
    let mut i = 0
    while i < n { mu = mu + u[i]
        mv = mv + v[i]
        i = i + 1 }
    mu = mu / n
    mv = mv / n
    let mut s = 0.0
    i = 0
    while i < n { s = s + (u[i] - mu) * (v[i] - mv)
        i = i + 1 }
    s / (n - 1)
}

// np.cov(x, y): sample covariance with ddof=1. With y null, the scalar
// variance of x; otherwise the 2x2 covariance matrix. NaN when n < 2.
pub fn cov(x, y) {
    xd := _data(x)
    if _wkind(xd) != "list" { return Err("warp.cov expects arrays or flat lists") }
    if y == null { return _cov_pair(xd, xd) }
    yd := _data(y)
    if _wkind(yd) != "list" { return Err("warp.cov expects arrays or flat lists") }
    if len(xd) != len(yd) { return Err("warp.cov expects x and y to have the same length") }
    array([_cov_pair(xd, xd), _cov_pair(xd, yd), _cov_pair(xd, yd), _cov_pair(yd, yd)], [2, 2])
}

// np.corrcoef(x, y): Pearson correlation. With y null, the scalar 1.0 (NaN for
// n < 2 or a constant series); otherwise the 2x2 correlation matrix, clipped
// to [-1, 1] like NumPy. Constant series yield NaN off their diagonal.
pub fn corrcoef(x, y) {
    xd := _data(x)
    if _wkind(xd) != "list" { return Err("warp.corrcoef expects arrays or flat lists") }
    if y == null {
        cxx := _cov_pair(xd, xd)
        return _corr_term(cxx, cxx, cxx)
    }
    yd := _data(y)
    if _wkind(yd) != "list" { return Err("warp.corrcoef expects arrays or flat lists") }
    if len(xd) != len(yd) { return Err("warp.corrcoef expects x and y to have the same length") }
    cxx := _cov_pair(xd, xd)
    cxy := _cov_pair(xd, yd)
    cyy := _cov_pair(yd, yd)
    array([
        _corr_term(cxx, cxx, cxx), _corr_term(cxy, cxx, cyy),
        _corr_term(cxy, cxx, cyy), _corr_term(cyy, cyy, cyy),
    ], [2, 2])
}

// num / sqrt(a * b) with NumPy's NaN-on-degenerate semantics; Weft raises on
// runtime division by zero, so the guard must come first.
fn _corr_term(num, a, b) {
    denom_sq := a * b
    if !(denom_sq > 0.0) { return math.nan }
    _clip_corr(num / math.sqrt(denom_sq))
}

fn _clip_corr(r) {
    if r != r { return math.nan }
    math.clamp(r, -1.0, 1.0)
}

// np.average: weighted mean. weights null gives the plain mean. An empty input
// or weights summing to zero is an Err (NumPy raises ZeroDivisionError), as is
// a weights/data length mismatch (NumPy raises TypeError).
pub fn average(a, weights) {
    data := _data(a)
    if _wkind(data) != "list" { return Err("warp.average expects an array or flat list") }
    if len(data) == 0 { return Err("warp.average weights sum to zero for empty input") }
    if weights == null {
        let mut s = 0.0
        for x in data { s = s + x }
        return s / len(data)
    }
    wd := _data(weights)
    if _wkind(wd) != "list" { return Err("warp.average expects weights as an array or flat list") }
    if len(wd) != len(data) { return Err("warp.average expects weights to match the data length") }
    let mut ws = 0.0
    for w in wd { ws = ws + w }
    if ws == 0 { return Err("warp.average weights sum to zero") }
    let mut s = 0.0
    let mut i = 0
    while i < len(data) { s = s + data[i] * wd[i]
        i = i + 1 }
    s / ws
}

// np.quantile with the default linear interpolation method: position
// q * (n - 1) over the sorted data. q may be a scalar in [0, 1] (→ scalar) or
// a list/array (→ float64 array). Empty input or q outside [0, 1] is an Err.
pub fn quantile(a, q) {
    data := _data(a)
    if _wkind(data) != "list" { return Err("warp.quantile expects an array or flat list") }
    if len(data) == 0 { return Err("warp.quantile expects a non-empty input") }
    sorted_data := _merge_sort_values(data)
    qk := _wkind(q)
    if qk == "int" || qk == "float" { return _quantile_point(sorted_data, q) }
    qd := _data(q)
    if _wkind(qd) != "list" { return Err("warp.quantile expects q to be a scalar or array") }
    let mut d = []
    for value in qd {
        p := _quantile_point(sorted_data, value)
        if _wkind(p) == "result" { return p }
        d = push(d, p)
    }
    array(d, [len(d)])
}

fn _quantile_point(sorted_data, q) {
    if q < 0 || q > 1 { return Err("warp.quantile requires q between 0 and 1") }
    n := len(sorted_data)
    k := q * (n - 1)
    lo := math.floor(k)
    hi := math.ceil(k)
    if lo == hi { sorted_data[lo] + 0.0 }
    else { sorted_data[lo] * (hi - k) + sorted_data[hi] * (k - lo) }
}

// Axis-based reductions. Negative axes are accepted and reductions work for
// every rank, including a rank-1 reduction to a scalar.

pub fn sum_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { acc + x }, 0)
}

pub fn mean_axis(a, axis) {
    if !_is_arr(a) { return Err("warp.mean_axis expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.mean_axis axis is out of range") }
    result := sum_axis(a, normalized)
    n := a.shape[normalized]
    _mean_result(result, a, n)
}

pub fn min_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { if x < acc { x } else { acc } }, 1e308)
}

pub fn max_axis(a, axis) {
    _reduce_axis_nd(a, axis, fn(acc, x) { if x > acc { x } else { acc } }, -1e308)
}

pub fn sum_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { acc + x }, 0, keepdims)
}

pub fn mean_axis_opts(a, axis, keepdims) {
    if !_is_arr(a) { return Err("warp.mean_axis_opts expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.mean_axis_opts axis is out of range") }
    result := sum_axis_opts(a, normalized, keepdims)
    if !_is_arr(result) { return result / (a.shape[normalized] + 0.0) }
    _mean_result(result, a, a.shape[normalized])
}

pub fn min_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { if x < acc { x } else { acc } }, 1e308, keepdims)
}

pub fn max_axis_opts(a, axis, keepdims) {
    _reduce_axis_nd_opts(a, axis, fn(acc, x) { if x > acc { x } else { acc } }, -1e308, keepdims)
}

// Reductions with NumPy's initial= / where= options. `axis` may be null for a
// flat reduction; `initial` seeds the accumulator; `where_mask` (array or flat
// list, broadcast to the input shape) excludes elements where falsey.
// NumPy semantics: sum/prod fall back to their identity (0/1) on an empty
// selection unless initial is given; min/max have no identity, so they raise
// whenever where= is given without initial= (or on an empty selection
// without initial=) — warp mirrors both with an Err.
pub fn sum_opts(a, axis, keepdims, initial, where_mask) {
    _reduce_full(a, axis, keepdims, initial, where_mask, fn(acc, x) { acc + x }, 0, false, "sum")
}

pub fn prod_opts(a, axis, keepdims, initial, where_mask) {
    _reduce_full(a, axis, keepdims, initial, where_mask, fn(acc, x) { acc * x }, 1, false, "prod")
}

pub fn min_opts(a, axis, keepdims, initial, where_mask) {
    _reduce_full(a, axis, keepdims, initial, where_mask, fn(acc, x) { if x < acc { x } else { acc } }, null, true, "min")
}

pub fn max_opts(a, axis, keepdims, initial, where_mask) {
    _reduce_full(a, axis, keepdims, initial, where_mask, fn(acc, x) { if x > acc { x } else { acc } }, null, true, "max")
}

fn _reduce_full(a, axis, keepdims, initial, where_mask, op, identity, needs_identity, name) {
    if !_is_arr(a) { return Err("warp." + name + "_opts expects an array") }
    mask := _where_mask_data(where_mask, a)
    if _wkind(mask) == "result" { return mask }
    keep := keepdims == true
    seed := if initial == null || _wkind(initial) == "unit" { null } else { initial }
    // NumPy requires initial= whenever where= is combined with an
    // identity-less reduction (min/max), even if the selection is non-empty.
    if needs_identity && mask != null && seed == null {
        return Err("warp." + name + "_opts requires initial when a where mask is given")
    }
    axis_arg := if axis == null || _wkind(axis) == "unit" { null } else { axis }
    result_dtype := if dtype(a) == "bool" { "int64" } else { dtype(a) }
    if axis_arg == null {
        result := _reduce_flat_masked(a, mask, op, identity, needs_identity, seed, name)
        if _wkind(result) == "result" { return result }
        if keep {
            let mut ones = []
            let mut i = 0
            while i < len(a.shape) { ones = push(ones, 1)
                i = i + 1 }
            return _array_with_dtype([result], ones, result_dtype)
        }
        return result
    }
    normalized := _normalize_axis(axis_arg, len(a.shape), false)
    if normalized == null { return Err("warp." + name + "_opts axis is out of range") }
    if a.shape[normalized] == 0 { return Err("warp." + name + "_opts cannot reduce an empty axis") }
    out_shape := _remove_axis(a.shape, normalized)
    output_size := _prod(out_shape)
    let mut d = []
    let mut flat = 0
    while flat < output_size {
        outer_index := _unravel(flat, out_shape)
        let mut acc = seed
        let mut seen = seed != null
        let mut k = 0
        while k < a.shape[normalized] {
            source_index := _insert_axis_index(outer_index, normalized, k)
            if mask == null || mask[_flat_index(source_index, a.shape)] {
                x := _logical_value_at(a, source_index)
                if acc == null { acc = x }
                else { acc = op(acc, x) }
                seen = true
            }
            k = k + 1
        }
        if !seen {
            if needs_identity { return Err("warp." + name + "_opts has no identity for an empty selection") }
            acc = identity
        }
        d = push(d, acc)
        flat = flat + 1
    }
    if keep {
        kept_shape := _copy(a.shape)
        kept_shape[normalized] = 1
        _array_with_dtype(d, kept_shape, result_dtype)
    } else if len(out_shape) == 0 { d[0] } else { _array_with_dtype(d, out_shape, result_dtype) }
}

fn _reduce_flat_masked(a, mask, op, identity, needs_identity, seed, name) {
    data := _data(a)
    let mut acc = seed
    let mut seen = seed != null
    let mut i = 0
    while i < len(data) {
        if mask == null || mask[i] {
            if acc == null { acc = data[i] }
            else { acc = op(acc, data[i]) }
            seen = true
        }
        i = i + 1
    }
    if !seen {
        if needs_identity { return Err("warp." + name + "_opts has no identity for an empty selection") }
        acc = identity
    }
    acc
}

// Broadcast a where= mask to the target shape and return it as a flat list of
// truthy values, or null when no mask was given.
fn _where_mask_data(where_mask, a) {
    if where_mask == null || _wkind(where_mask) == "unit" { return null }
    if _is_arr(where_mask) {
        shape := _broadcast_shape(where_mask.shape, a.shape)
        if shape == null || shape != a.shape { return Err("warp where mask could not be broadcast to the input shape") }
        let mut mask = []
        n := _prod(a.shape)
        let mut i = 0
        while i < n {
            mask = push(mask, _broadcast_value(where_mask, _unravel(i, a.shape), a.shape))
            i = i + 1
        }
        return mask
    }
    if _wkind(where_mask) == "list" {
        if len(where_mask) != size(a) { return Err("warp where mask length does not match the input size") }
        return where_mask
    }
    Err("warp where mask expects an array or flat list")
}

// ──────────────────────────────────────────────
// Linear algebra
// ──────────────────────────────────────────────

pub fn dot(a, b) {
    matmul(a, b)
}

pub fn matmul(a, b) {
    sa := a.shape
    sb := b.shape
    // Prefer host packed tensors for 2D matmul when both operands are native.
    if len(sa) == 2 && len(sb) == 2 && _has_tid(a) && _has_tid(b) && sa[1] == sb[0] {
        out := tensor.matmul(a._tid, b._tid)
        if !is_err(out) {
            handle := out?
            values := tensor.to_list(handle)
            tensor.free(handle)?
            if is_err(values) { return values }
            return _make_array(values?, [sa[0], sb[1]], _promote_dtype(a, b))
        }
    }
    if len(sa) == 1 && len(sb) == 1 {
        if sa[0] != sb[0] { return Err("warp.matmul vector lengths do not match") }
        let mut result = 0.0
        let mut i = 0
        while i < sa[0] {
        result = result + _data(a)[i] * _data(b)[i]
            i = i + 1
        }
        return result
    }
    if len(sa) == 2 && len(sb) == 1 {
        if sa[1] != sb[0] { return Err("warp.matmul inner dimensions do not match") }
        rows := sa[0]
        cols := sa[1]
        let mut d = []
        let mut r = 0
        while r < rows {
            let mut result = 0.0
            let mut j = 0
            while j < cols {
        result = result + _data(a)[r * cols + j] * _data(b)[j]
                j = j + 1
            }
            d = push(d, result)
            r = r + 1
        }
        return array(d, [rows])
    }
    if len(sa) == 1 && len(sb) == 2 {
        if sa[0] != sb[0] { return Err("warp.matmul inner dimensions do not match") }
        rows := sb[0]
        cols := sb[1]
        let mut d = []
        let mut c = 0
        while c < cols {
            let mut result = 0.0
            let mut i = 0
            while i < rows {
        result = result + _data(a)[i] * _data(b)[i * cols + c]
                i = i + 1
            }
            d = push(d, result)
            c = c + 1
        }
        return array(d, [cols])
    }
    if len(sa) != 2 || len(sb) != 2 { return Err("warp.matmul supports only 1D and 2D arrays") }
    m := sa[0]
    k := sa[1]
    if k != sb[0] { return Err("warp.matmul inner dimensions do not match") }
    n := sb[1]
    let mut d = []
    let mut r = 0
    while r < m {
        let mut c = 0
        while c < n {
            let mut result = 0.0
            let mut j = 0
            while j < k {
            result = result + _data(a)[r * k + j] * _data(b)[j * n + c]
                j = j + 1
            }
            d = push(d, result)
            c = c + 1
        }
        r = r + 1
    }
    array(d, [m, n])
}

pub fn norm(a) {
    // L2 norm (Euclidean)
    let mut s = 0.0
    for x in _data(a) { s = s + x * x }
    math.sqrt(s)
}

pub fn norm_l1(a) {
    let mut s = 0.0
    for x in _data(a) { s = s + math.abs(x) }
    s
}

pub fn normalize(a) {
    n := norm(a)
    if n == 0 { return a }
    div(a, n)
}

pub fn trace(a) {
    n := a.shape[0]
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + _logical_value_at(a, [i, i])
        i = i + 1 }
    s
}

// ponytail: LU decomposition is O(n^3) pure Weft — fine for n<=50, use mlinfer for larger
fn _lu(a) -> Result[any] {
    raw := _lu_raw(a)
    ensure(!raw.singular, "singular matrix")?
    Ok(raw)
}

// LU decomposition with partial pivoting: PA = LU. Singularity is detected as
// an exactly zero pivot column (after partial pivoting such a column means a
// zero row of U, hence det == 0); the result carries a "singular" flag instead
// of failing so det can report 0 and slogdet can report {0, -inf} for exactly
// singular matrices the way NumPy does. Near-singular matrices (tiny but
// nonzero pivots) factor normally, matching NumPy's LAPACK behavior.
fn _lu_raw(a) {
    n := a.shape[0]
    // copy matrix data into mutable flat array
    let mut m = []
    for x in _data(a) { m = push(m, x + 0.0) }
    // permutation vector
    let mut perm = []
    let mut i = 0
    while i < n { perm = push(perm, i)
        i = i + 1 }
    let mut sign = 1
    // forward elimination
    let mut col = 0
    while col < n {
        // find pivot
        let mut max_val = -1.0
        let mut max_row = col
        let mut r = col
        while r < n {
            v := math.abs(m[r * n + col])
            if v > max_val {
                max_val = v
                max_row = r
            }
            r = r + 1
        }
        if max_val == 0.0 { return {"m": m, "perm": perm, "n": n, "sign": sign, "singular": true} }
        // swap rows
        if max_row != col {
            let mut c = 0
            while c < n {
                tmp := m[col * n + c]
                m[col * n + c] = m[max_row * n + c]
                m[max_row * n + c] = tmp
                c = c + 1
            }
            tmp := perm[col]
            perm[col] = perm[max_row]
            perm[max_row] = tmp
            sign = sign * -1
        }
        // eliminate below pivot
        r = col + 1
        while r < n {
            factor := m[r * n + col] / m[col * n + col]
            m[r * n + col] = factor
            let mut c = col + 1
            while c < n {
                m[r * n + c] = m[r * n + c] - factor * m[col * n + c]
                c = c + 1
            }
            r = r + 1
        }
        col = col + 1
    }
    {"m": m, "perm": perm, "n": n, "sign": sign, "singular": false}
}

fn _lu_solve(lu, b_data) {
    // Forward then back substitution using LU result
    n := lu.n
    m := lu.m
    perm := lu.perm
    // apply permutation to b
    let mut pb = []
    let mut i = 0
    while i < n { pb = push(pb, b_data[perm[i]])
        i = i + 1 }
    // forward substitution (L * y = Pb)
    i = 1
    while i < n {
        let mut s = pb[i]
        let mut j = 0
        while j < i {
            s = s - m[i * n + j] * pb[j]
            j = j + 1
        }
        pb[i] = s
        i = i + 1
    }
    // back substitution (U * x = y)
    i = n - 1
    while i >= 0 {
        let mut s = pb[i]
        let mut j = i + 1
        while j < n {
            s = s - m[i * n + j] * pb[j]
            j = j + 1
        }
        pb[i] = s / m[i * n + i]
        i = i - 1
    }
    pb
}

pub fn det(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "det: matrix must be square 2D")?
    ensure(size(a) == a.shape[0] * a.shape[1], "det: data/shape mismatch")?
    n := a.shape[0]
    d := _data(a)
    if n == 1 { return Ok(d[0]) }
    if n == 2 { return Ok(d[0] * d[3] - d[1] * d[2]) }
    // General case via LU. Exactly singular matrices have determinant 0
    // (NumPy behavior) rather than raising.
    lu := _lu_raw(a)
    if lu.singular { return Ok(0.0) }
    let mut det_val = lu.sign + 0.0
    let mut i = 0
    while i < n {
        det_val = det_val * lu.m[i * n + i]
        i = i + 1
    }
    Ok(det_val)
}

pub fn inv(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "inv: matrix must be square 2D")?
    n := a.shape[0]
    d := _data(a)
    // 2x2 fast path
    if n == 2 {
        dt := d[0] * d[3] - d[1] * d[2] + 0.0
        ensure(dt != 0, "inv: singular matrix")?
        return Ok(array([d[3]/dt, -d[1]/dt, -d[2]/dt, d[0]/dt], [2, 2]))
    }
    // General case: solve A * X = I column by column
    lu := _lu(a)?
    let mut result = []
    let mut col = 0
    while col < n {
        // identity column
        let mut e = []
        let mut i = 0
        while i < n { e = push(e, if i == col { 1.0 } else { 0.0 })
            i = i + 1 }
        x := _lu_solve(lu, e)
        col = col + 1
        // x is one column of the inverse — we'll assemble row-major later
        let mut j = 0
        while j < n { result = push(result, x[j])
            j = j + 1 }
    }
    // result is column-major, transpose to row-major
    let mut row_major = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < n { row_major = push(row_major, result[c * n + r])
            c = c + 1 }
        r = r + 1
    }
    Ok(array(row_major, [n, n]))
}

pub fn solve(a, b) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "solve: A must be square")?
    n := a.shape[0]
    lu := _lu(a)?
    bd := _data(b)
    if len(bd) == n {
        x := _lu_solve(lu, bd)
        return Ok(array(x, b.shape))
    }
    // multiple right-hand sides (n x m matrix)
    ensure(len(b.shape) == 2 && b.shape[0] == n, "solve: B rows must match A")?
    m := b.shape[1]
    // solve each column, then transpose column-major → row-major
    let mut cols = []
    let mut col = 0
    while col < m {
        let mut rhs = []
        let mut i = 0
        while i < n {
            rhs = push(rhs, bd[i * m + col])
            i = i + 1
        }
        x := _lu_solve(lu, rhs)
        cols = push(cols, x)
        col = col + 1
    }
    // assemble row-major from column solutions
    let mut result = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < m {
            result = push(result, cols[c][r])
            c = c + 1
        }
        r = r + 1
    }
    Ok(array(result, [n, m]))
}

// np.linalg.slogdet: {"sign": ±1.0, "logdet": log|det A|} for square A, from
// the LU factorization (sign of the pivot product times the swap parity, sum
// of log|pivots|). An exactly singular matrix yields {"sign": 0.0,
// "logdet": -inf} and a 0x0 matrix yields {"sign": 1.0, "logdet": 0.0},
// matching NumPy.
pub fn slogdet(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "slogdet: matrix must be square 2D")?
    n := a.shape[0]
    if n == 0 { return Ok({"sign": 1.0, "logdet": 0.0}) }
    d := _data(a)
    if n == 1 {
        v := d[0] + 0.0
        if v == 0.0 { return Ok({"sign": 0.0, "logdet": -math.inf}) }
        return Ok({"sign": if v > 0.0 { 1.0 } else { -1.0 }, "logdet": math.log(math.abs(v))})
    }
    lu := _lu_raw(a)
    if lu.singular { return Ok({"sign": 0.0, "logdet": -math.inf}) }
    let mut sign = lu.sign + 0.0
    let mut logdet = 0.0
    let mut i = 0
    while i < n {
        p := lu.m[i * n + i]
        if p < 0.0 { sign = sign * -1.0 }
        logdet = logdet + math.log(math.abs(p))
        i = i + 1
    }
    Ok({"sign": sign, "logdet": logdet})
}

// Matrix rank via row echelon with partial pivoting: the number of pivot
// magnitudes strictly greater than `tol`. Documented deviation from
// np.linalg.matrix_rank, which is SVD-based: pivot magnitudes are not singular
// values, so borderline cases can differ. The default tolerance mirrors
// NumPy's scale, tol = max|a_ij| * max(m, n) * eps(float64), with max|a_ij|
// standing in for the largest singular value; pass an explicit tol to control
// the cutoff directly. Only 2-D inputs are supported (NumPy also accepts 1-D
// and stacks over leading axes; warp does not), and a zero-size dimension is
// an Err, matching NumPy's zero-size reduction error.
pub fn matrix_rank(a, tol) -> Result[any] {
    ensure(a != null && _is_arr(a) && len(a.shape) == 2, "matrix_rank: expects a 2D array")?
    rows := a.shape[0]
    cols := a.shape[1]
    ensure(rows > 0 && cols > 0, "matrix_rank: zero-size array has no rank reduction")?
    let mut threshold = 0.0
    if tol == null || _wkind(tol) == "unit" {
        let mut max_abs = 0.0
        for x in _data(a) {
            if math.abs(x) > max_abs { max_abs = math.abs(x) }
        }
        bigger := if rows > cols { rows } else { cols }
        threshold = max_abs * bigger * 2.220446049250313e-16
    } else {
        ensure(_wkind(tol) == "int" || _wkind(tol) == "float", "matrix_rank: tol must be numeric")?
        ensure(tol >= 0, "matrix_rank: tol must be non-negative")?
        threshold = tol + 0.0
    }
    let mut m = []
    for x in _data(a) { m = push(m, x + 0.0) }
    let mut rank = 0
    let mut row = 0
    let mut col = 0
    while col < cols && row < rows {
        let mut max_val = -1.0
        let mut max_row = row
        let mut r = row
        while r < rows {
            v := math.abs(m[r * cols + col])
            if v > max_val {
                max_val = v
                max_row = r
            }
            r = r + 1
        }
        if max_val > threshold {
            if max_row != row {
                let mut c = col
                while c < cols {
                    tmp := m[row * cols + c]
                    m[row * cols + c] = m[max_row * cols + c]
                    m[max_row * cols + c] = tmp
                    c = c + 1
                }
            }
            r = row + 1
            while r < rows {
                factor := m[r * cols + col] / m[row * cols + col]
                m[r * cols + col] = 0.0
                let mut c = col + 1
                while c < cols {
                    m[r * cols + c] = m[r * cols + c] - factor * m[row * cols + c]
                    c = c + 1
                }
                r = r + 1
            }
            rank = rank + 1
            row = row + 1
        }
        col = col + 1
    }
    Ok(rank)
}

// Condition number, Frobenius variant: ||A||_F * ||A^-1||_F, which equals
// np.linalg.cond(a, "fro"). Documented deviation: this is NOT NumPy's default
// 2-norm condition number (warp has no SVD), and only square inputs are
// supported. An exactly singular matrix yields +inf — NumPy's cond with
// p="fro" raises there, but its 2-norm default returns inf, which warp
// mirrors. A 0x0 matrix is an Err, as in NumPy ("cond is not defined on
// empty arrays").
pub fn cond(a) -> Result[any] {
    ensure(len(a.shape) == 2 && a.shape[0] == a.shape[1], "cond: matrix must be square 2D")?
    ensure(a.shape[0] > 0, "cond: cond is not defined on empty arrays")?
    ai := inv(a)
    if !ai.ok { return Ok(math.inf) }
    Ok(norm(a) * norm(ai.value))
}

pub fn outer(a, b) {
    ad := _data(a)
    bd := _data(b)
    let mut d = []
    for x in ad {
        for y in bd { d = push(d, x * y) }
    }
    array(d, [len(ad), len(bd)])
}

pub fn cross(a, b) {
    // 3D cross product
    ad := _data(a)
    bd := _data(b)
    array([
        ad[1]*bd[2] - ad[2]*bd[1],
        ad[2]*bd[0] - ad[0]*bd[2],
        ad[0]*bd[1] - ad[1]*bd[0],
    ], [3])
}

// ──────────────────────────────────────────────
// Polynomial helpers
// ──────────────────────────────────────────────
// Coefficients are highest-degree first, matching the np.poly* family.
// polyfit solves the least-squares normal equations with the LU solver, so
// well-conditioned low-degree fits agree with NumPy's SVD-based lstsq; badly
// conditioned high-degree fits are out of scope. Unlike NumPy (which warns
// and continues), an underdetermined fit (fewer points than deg + 1) or a
// singular normal matrix is an explicit Err.

pub fn polyfit(x, y, deg) {
    xd := _data(x)
    yd := _data(y)
    if _wkind(xd) != "list" || _wkind(yd) != "list" { return Err("warp.polyfit expects 1-D x and y data") }
    if _wkind(deg) != "int" || deg < 0 { return Err("warp.polyfit expects a non-negative integer degree") }
    if len(xd) != len(yd) { return Err("warp.polyfit expects x and y to have the same length") }
    n := len(xd)
    if n < deg + 1 { return Err("warp.polyfit needs at least deg + 1 points") }
    order := deg + 1
    // Normal equations, highest degree first:
    //   M[i][k] = sum_j x_j^(2*deg - i - k),  r[i] = sum_j y_j * x_j^(deg - i)
    let mut m = []
    let mut r = []
    let mut i = 0
    while i < order {
        let mut k = 0
        while k < order {
            let mut s = 0.0
            let mut j = 0
            while j < n {
                s = s + _ipow(xd[j] + 0.0, 2 * deg - i - k)
                j = j + 1
            }
            m = push(m, s)
            k = k + 1
        }
        let mut rs = 0.0
        let mut j = 0
        while j < n {
            rs = rs + (yd[j] + 0.0) * _ipow(xd[j] + 0.0, deg - i)
            j = j + 1
        }
        r = push(r, rs)
        i = i + 1
    }
    result := solve(array(m, [order, order]), array(r, [order]))
    if _wkind(result) == "result" {
        if !result.ok { return Err("warp.polyfit normal equations are singular") }
        return result.value
    }
    result
}

fn _ipow(base, p) {
    let mut acc = 1.0
    let mut i = 0
    while i < p { acc = acc * base
        i = i + 1 }
    acc
}

// np.polyval: Horner evaluation. x may be a scalar (→ scalar float) or an
// array/list (→ float64 array of the same shape). Empty coefficients give 0.
pub fn polyval(coeffs, x) {
    cs := _data(coeffs)
    if _wkind(cs) != "list" { return Err("warp.polyval expects a 1-D coefficient array or list") }
    xk := _wkind(x)
    if xk == "int" || xk == "float" {
        let mut acc = 0.0
        for c in cs { acc = acc * x + c }
        return acc
    }
    xd := _data(x)
    if _wkind(xd) != "list" { return Err("warp.polyval expects x to be a scalar or array") }
    let mut d = []
    for v in xd {
        let mut acc = 0.0
        for c in cs { acc = acc * v + c }
        d = push(d, acc)
    }
    _array_with_dtype(d, if _is_arr(x) { x.shape } else { [len(d)] }, "float64")
}

// np.polyder: derivative coefficients. A constant (or empty) polynomial has an
// empty derivative, matching NumPy 2.x.
pub fn polyder(coeffs) {
    cs := _data(coeffs)
    if _wkind(cs) != "list" { return Err("warp.polyder expects a 1-D coefficient array or list") }
    n := len(cs)
    if n <= 1 { return array([], [0]) }
    let mut d = []
    let mut i = 0
    while i < n - 1 {
        d = push(d, cs[i] * (n - 1 - i) + 0.0)
        i = i + 1
    }
    array(d, [n - 1])
}

// np.polyint: antiderivative coefficients with integration constant 0
// (highest-degree first, trailing zero constant term).
pub fn polyint(coeffs) {
    cs := _data(coeffs)
    if _wkind(cs) != "list" { return Err("warp.polyint expects a 1-D coefficient array or list") }
    n := len(cs)
    let mut d = []
    let mut i = 0
    while i < n {
        d = push(d, cs[i] / (n - i + 0.0))
        i = i + 1
    }
    d = push(d, 0.0)
    array(d, [n + 1])
}

// Polynomial roots via closed forms for degree <= 2 (leading zero coefficients
// are trimmed, as in np.roots). Returns {"re": array, "im": array} sorted by
// descending real part. A constant polynomial has no roots (empty arrays).
// Degree > 2 is an explicit Err: there is no iterative eigensolver here, and a
// bad one is worse than none.
pub fn roots(coeffs) {
    cs := _data(coeffs)
    if _wkind(cs) != "list" { return Err("warp.roots expects a 1-D coefficient array or list") }
    let mut start = 0
    while start < len(cs) && cs[start] == 0 { start = start + 1 }
    let mut c = []
    let mut i = start
    while i < len(cs) { c = push(c, cs[i])
        i = i + 1 }
    deg := len(c) - 1
    if deg <= 0 { return {"re": array([], [0]), "im": array([], [0])} }
    if deg > 2 { return Err("warp.roots supports degree <= 2 only") }
    if deg == 1 {
        return {"re": array([-c[1] / (c[0] + 0.0)], [1]), "im": array([0.0], [1])}
    }
    a := c[0] + 0.0
    b := c[1] + 0.0
    cc := c[2] + 0.0
    disc := b * b - 4.0 * a * cc
    if disc >= 0.0 {
        s := math.sqrt(disc)
        r1 := (-b + s) / (2.0 * a)
        r2 := (-b - s) / (2.0 * a)
        if r1 >= r2 { return {"re": array([r1, r2], [2]), "im": array([0.0, 0.0], [2])} }
        return {"re": array([r2, r1], [2]), "im": array([0.0, 0.0], [2])}
    }
    re := -b / (2.0 * a)
    im := math.sqrt(-disc) / math.abs(2.0 * a)
    {"re": array([re, re], [2]), "im": array([im, -im], [2])}
}

// ──────────────────────────────────────────────
// Signal / numerical calculus (1D)
// ──────────────────────────────────────────────
// Pure Weft DFT and calculus helpers. Complexity limits:
//   fft_1d / ifft_1d — Cooley–Tukey O(n log n) when n is a power of 2;
//     otherwise naive O(n²) DFT. Practical for small n (power-of-2 up to a
//     few thousand samples; non-power-of-2 preferably n <= 256). Not a
//     BLAS/FFTW substitute.
//   diff / gradient / trapz / fft_freq — O(n).

// 1D DFT. Accepts a real warp array (or flat list) and returns
// {"re": array, "im": array} of the same length (NumPy-compatible unnormalized
// DFT). Complex input may be a map {"re": array|list, "im": array|list}.
pub fn fft_1d(a) {
    parts := _fft_parts(a)
    if is_err(parts) { return parts }
    n := len(parts.re)
    if n == 0 {
        return {"re": array([], [0]), "im": array([], [0])}
    }
    out := if _is_power_of_two(n) {
        _fft_radix2(parts.re, parts.im, false)
    } else {
        _fft_naive(parts.re, parts.im, false)
    }
    {"re": array(out.re, [n]), "im": array(out.im, [n])}
}

// Inverse 1D DFT. re and im are warp arrays or flat lists of equal length.
// Returns {"re": array, "im": array} scaled by 1/n (NumPy ifft convention).
pub fn ifft_1d(re, im) {
    rd := if _is_arr(re) { _data(re) } else if _wkind(re) == "list" { re } else {
        return Err("warp.ifft_1d expects re as array or list")
    }
    id := if _is_arr(im) { _data(im) } else if _wkind(im) == "list" { im } else {
        return Err("warp.ifft_1d expects im as array or list")
    }
    if len(rd) != len(id) { return Err("warp.ifft_1d re/im length mismatch") }
    n := len(rd)
    if n == 0 {
        return {"re": array([], [0]), "im": array([], [0])}
    }
    out := if _is_power_of_two(n) {
        _fft_radix2(rd, id, true)
    } else {
        _fft_naive(rd, id, true)
    }
    {"re": array(out.re, [n]), "im": array(out.im, [n])}
}

// Frequency bin centers in cycles per unit of sample spacing d (np.fft.fftfreq).
// d defaults to 1.0 when null.
pub fn fft_freq(n, d) {
    if _wkind(n) != "int" || n < 0 { return Err("warp.fft_freq requires a non-negative integer n") }
    spacing := if d == null { 1.0 } else { d + 0.0 }
    if spacing == 0.0 { return Err("warp.fft_freq sample spacing d cannot be zero") }
    if n == 0 { return array([], [0]) }
    val := 1.0 / (n * spacing)
    // NumPy: results[:N] = 0..N-1, results[N:] = -n//2 .. -1 where N = (n-1)//2 + 1
    n_pos := (n - 1) / 2 + 1
    let mut d_out = []
    let mut i = 0
    while i < n_pos {
        d_out = push(d_out, i * val)
        i = i + 1
    }
    let mut j = 0 - (n / 2)
    while j < 0 {
        d_out = push(d_out, j * val)
        j = j + 1
    }
    array(d_out, [n])
}

// Real-input 1D DFT (np.fft.rfft): returns the first n//2 + 1 complex bins as
// {"re": array, "im": array}. Input must be a real warp array or flat list.
pub fn rfft(a) {
    if !_is_arr(a) && _wkind(a) != "list" {
        return Err("warp.rfft expects a real array or list")
    }
    data := if _is_arr(a) { _data(a) } else { a }
    n := len(data)
    if n == 0 { return Err("warp.rfft expects a non-empty input") }
    full := fft_1d(data)
    bins := n / 2 + 1
    {
        "re": array(_list_range(_data(full.re), 0, bins), [bins]),
        "im": array(_list_range(_data(full.im), 0, bins), [bins]),
    }
}

// Inverse real DFT (np.fft.irfft). `parts` is {"re", "im"} (arrays or lists)
// holding the n//2 + 1 non-negative frequency bins; `n` is the output length
// (default 2 * (bins - 1), the even-length convention NumPy uses). Returns a
// real warp array of length n.
pub fn irfft(parts, n_arg) {
    if parts == null || _wkind(parts) != "map" || !contains(keys(parts), "re") {
        return Err("warp.irfft expects a {re, im} map")
    }
    rd := if _is_arr(parts.re) { _data(parts.re) } else if _wkind(parts.re) == "list" { parts.re } else {
        return Err("warp.irfft re must be an array or list")
    }
    id := if contains(keys(parts), "im") && parts.im != null {
        if _is_arr(parts.im) { _data(parts.im) } else if _wkind(parts.im) == "list" { parts.im } else {
            return Err("warp.irfft im must be an array or list")
        }
    } else {
        let mut zeros = []
        let mut i = 0
        while i < len(rd) { zeros = push(zeros, 0.0)
            i = i + 1 }
        zeros
    }
    if len(rd) != len(id) { return Err("warp.irfft re/im length mismatch") }
    m := len(rd)
    if m == 0 { return Err("warp.irfft expects a non-empty spectrum") }
    n := if n_arg == null || _wkind(n_arg) == "unit" { 2 * (m - 1) } else { n_arg }
    if _wkind(n) != "int" || n < 1 { return Err("warp.irfft requires a positive integer output length") }
    if m != n / 2 + 1 { return Err("warp.irfft input length must be n//2 + 1") }
    // Rebuild the full length-n spectrum by conjugate symmetry, then invert.
    let mut full_re = _copy(rd)
    let mut full_im = _copy(id)
    let mut k = m
    while k < n {
        full_re = push(full_re, rd[n - k])
        full_im = push(full_im, 0.0 - id[n - k])
        k = k + 1
    }
    out := if _is_power_of_two(n) {
        _fft_radix2(full_re, full_im, true)
    } else {
        _fft_naive(full_re, full_im, true)
    }
    array(out.re, [n])
}

// Real-DFT frequency bins (np.fft.rfftfreq): k / (n * d) for k = 0..n//2.
pub fn rfft_freq(n, d) {
    if _wkind(n) != "int" || n < 1 { return Err("warp.rfft_freq requires a positive integer n") }
    spacing := if d == null { 1.0 } else { d + 0.0 }
    if spacing == 0.0 { return Err("warp.rfft_freq sample spacing d cannot be zero") }
    bins := n / 2 + 1
    val := 1.0 / (n * spacing)
    let mut d_out = []
    let mut i = 0
    while i < bins {
        d_out = push(d_out, i * val)
        i = i + 1
    }
    array(d_out, [bins])
}

// fftshift / ifftshift (np.fft) reorder the flat element sequence, swapping
// the half-ranges; the shape is preserved. For even lengths both are the same
// swap; for odd lengths they are exact inverses.
pub fn fftshift(a) { _fft_shift(a, true) }

pub fn ifftshift(a) { _fft_shift(a, false) }

fn _fft_shift(a, forward) {
    if !_is_arr(a) && _wkind(a) != "list" {
        return Err("warp.fftshift/ifftshift expects an array or list")
    }
    data := if _is_arr(a) { _data(a) } else { a }
    n := len(data)
    if n == 0 {
        if _is_arr(a) { return _array_like([], a.shape, a) }
        return array([], [0])
    }
    start := if forward { (n + 1) / 2 } else { n / 2 }
    let mut d = []
    let mut i = 0
    while i < n {
        d = push(d, data[(i + start) % n])
        i = i + 1
    }
    if _is_arr(a) { return _array_like(d, a.shape, a) }
    array(d, [n])
}

// ── Multi-dimensional FFT ──
// fft2/ifft2 transform the last two axes (np.fft.fft2/ifft2 defaults); fftn/
// ifftn transform every axis, or exactly the listed `axes` (negative indices
// wrap; repeated, non-integer, or out-of-range axes are an Err, matching
// NumPy's exceptions). The input is a real warp array or a complex
// {"re": array, "im": array} map of equal-shaped arrays; the result is
// {"re", "im"} arrays of the same shape. Each axis is transformed by the 1-D
// engine per slice (radix-2 Cooley–Tukey for power-of-2 lengths, naive DFT
// otherwise); the inverse applies its 1/n scale per axis, giving the NumPy
// 1/prod(n_axes) scaling overall.

pub fn fft2(a) {
    parts := _fftn_parts(a, "fft2")
    if is_err(parts) { return parts }
    if len(parts.shape) < 2 { return Err("warp.fft2 expects at least 2-D input") }
    _fftn_core(parts.re, parts.im, parts.shape, [len(parts.shape) - 2, len(parts.shape) - 1], false)
}

pub fn ifft2(a) {
    parts := _fftn_parts(a, "ifft2")
    if is_err(parts) { return parts }
    if len(parts.shape) < 2 { return Err("warp.ifft2 expects at least 2-D input") }
    _fftn_core(parts.re, parts.im, parts.shape, [len(parts.shape) - 2, len(parts.shape) - 1], true)
}

pub fn fftn(a, axes) {
    parts := _fftn_parts(a, "fftn")
    if is_err(parts) { return parts }
    axis_list := _fftn_axes(axes, len(parts.shape), "fftn")
    if is_err(axis_list) { return axis_list }
    _fftn_core(parts.re, parts.im, parts.shape, axis_list, false)
}

pub fn ifftn(a, axes) {
    parts := _fftn_parts(a, "ifftn")
    if is_err(parts) { return parts }
    axis_list := _fftn_axes(axes, len(parts.shape), "ifftn")
    if is_err(axis_list) { return axis_list }
    _fftn_core(parts.re, parts.im, parts.shape, axis_list, true)
}

// Normalize N-D real or complex input into flat C-order re/im float lists plus
// the shape. The lists are copies: the axis transforms mutate them in place,
// and _data may hand back an array's shared backing list.
fn _fftn_parts(a, name) {
    if a != null && _wkind(a) == "map" && !contains(keys(a), "_warp") && contains(keys(a), "re") {
        if !_is_arr(a.re) { return Err("warp." + name + " complex re must be an array") }
        shape := a.re.shape
        let mut im = []
        if contains(keys(a), "im") && a.im != null {
            if !_is_arr(a.im) { return Err("warp." + name + " complex im must be an array") }
            if a.im.shape != shape { return Err("warp." + name + " re/im shape mismatch") }
            im = _copy(_data(a.im))
        } else {
            let mut i = 0
            while i < size(a.re) { im = push(im, 0.0)
                i = i + 1 }
        }
        return {"re": _copy(_data(a.re)), "im": im, "shape": shape}
    }
    if !_is_arr(a) { return Err("warp." + name + " expects an array or {re, im} map of arrays") }
    let mut im = []
    let mut i = 0
    while i < size(a) { im = push(im, 0.0)
        i = i + 1 }
    {"re": _copy(_data(a)), "im": im, "shape": a.shape}
}

// axes null → every axis in order; otherwise a list of distinct valid axes.
fn _fftn_axes(axes, rank, name) {
    if axes == null || _wkind(axes) == "unit" {
        let mut all = []
        let mut i = 0
        while i < rank { all = push(all, i)
            i = i + 1 }
        return all
    }
    if _wkind(axes) != "list" { return Err("warp." + name + " axes must be a list or null") }
    let mut normalized = []
    for axis in axes {
        ax := _normalize_axis(axis, rank, false)
        if ax == null { return Err("warp." + name + " axis is out of range") }
        if contains(normalized, ax) { return Err("warp." + name + " axes must not repeat") }
        normalized = push(normalized, ax)
    }
    normalized
}

fn _fftn_core(re, im, shape, axes, inverse) {
    for axis in axes {
        _fft_axis_slices(re, im, shape, axis, inverse)
    }
    {"re": array(re, shape), "im": array(im, shape)}
}

// Transform every 1-D slice along `axis` in place (re/im are flat C-order).
fn _fft_axis_slices(re, im, shape, axis, inverse) {
    n := shape[axis]
    if n == 0 { return null }
    outer_shape := _remove_axis(shape, axis)
    outer_size := _prod(outer_shape)
    let mut flat = 0
    while flat < outer_size {
        outer_index := _unravel(flat, outer_shape)
        let mut sre = []
        let mut sim = []
        let mut k = 0
        while k < n {
            f := _flat_index(_insert_axis_index(outer_index, axis, k), shape)
            sre = push(sre, re[f])
            sim = push(sim, im[f])
            k = k + 1
        }
        out := if _is_power_of_two(n) {
            _fft_radix2(sre, sim, inverse)
        } else {
            _fft_naive(sre, sim, inverse)
        }
        k = 0
        while k < n {
            f := _flat_index(_insert_axis_index(outer_index, axis, k), shape)
            re[f] = out.re[k]
            im[f] = out.im[k]
            k = k + 1
        }
        flat = flat + 1
    }
    null
}

// 1D discrete difference of order n (default 1), like np.diff.
// Result length is len(a) - n. n may be null (treated as 1).
pub fn diff(a, n_arg) {
    order := if n_arg == null { 1 } else { n_arg }
    if _wkind(order) != "int" || order < 0 {
        return Err("warp.diff requires a non-negative integer order")
    }
    let mut data = if _is_arr(a) { _data(a) } else if _wkind(a) == "list" { a } else {
        return Err("warp.diff expects an array or list")
    }
    if order == 0 { return array(_copy(data), [len(data)]) }
    if order > len(data) {
        return Err("warp.diff order exceeds array length")
    }
    let mut k = 0
    while k < order {
        let mut next = []
        let mut i = 0
        m := len(data) - 1
        while i < m {
            next = push(next, data[i + 1] - data[i])
            i = i + 1
        }
        data = next
        k = k + 1
    }
    array(data, [len(data)])
}

// 1D gradient via central differences (unit spacing), like np.gradient for 1D.
// Endpoints use first-order one-sided differences.
pub fn gradient(a) {
    data := if _is_arr(a) { _data(a) } else if _wkind(a) == "list" { a } else {
        return Err("warp.gradient expects an array or list")
    }
    n := len(data)
    if n == 0 { return array([], [0]) }
    if n == 1 { return array([0.0], [1]) }
    let mut d = []
    // forward difference at start
    d = push(d, data[1] - data[0] + 0.0)
    let mut i = 1
    while i < n - 1 {
        d = push(d, (data[i + 1] - data[i - 1]) / 2.0)
        i = i + 1
    }
    // backward difference at end
    d = push(d, data[n - 1] - data[n - 2] + 0.0)
    array(d, [n])
}

// Trapezoidal rule for 1D integrate. dx defaults to 1.0 when null.
// Returns a scalar (float). Empty/singleton inputs return 0.0.
pub fn trapz(y, dx_arg) {
    data := if _is_arr(y) { _data(y) } else if _wkind(y) == "list" { y } else {
        return Err("warp.trapz expects an array or list")
    }
    dx := if dx_arg == null { 1.0 } else { dx_arg + 0.0 }
    n := len(data)
    if n < 2 { return 0.0 }
    let mut s = 0.0
    let mut i = 0
    while i < n - 1 {
        s = s + (data[i] + data[i + 1]) * 0.5 * dx
        i = i + 1
    }
    s
}

fn _is_power_of_two(n) {
    if _wkind(n) != "int" || n < 1 { return false }
    let mut v = n
    while v > 1 {
        if v % 2 != 0 { return false }
        v = v / 2
    }
    true
}

// Normalize real or complex input into flat re/im float lists.
fn _fft_parts(a) {
    if a != null && _wkind(a) == "map" && contains(keys(a), "re") {
        if !_is_arr(a.re) && _wkind(a.re) != "list" {
            return Err("warp.fft_1d complex re must be array or list")
        }
        rd := if _is_arr(a.re) { _data(a.re) } else { a.re }
        let mut id = []
        if contains(keys(a), "im") && a.im != null {
            if !_is_arr(a.im) && _wkind(a.im) != "list" {
                return Err("warp.fft_1d complex im must be array or list")
            }
            id = if _is_arr(a.im) { _data(a.im) } else { a.im }
        } else {
            let mut i = 0
            while i < len(rd) {
                id = push(id, 0.0)
                i = i + 1
            }
        }
        if len(rd) != len(id) { return Err("warp.fft_1d re/im length mismatch") }
        return {"re": rd, "im": id}
    }
    if !_is_arr(a) && _wkind(a) != "list" {
        return Err("warp.fft_1d expects an array, list, or {re, im} map")
    }
    data := if _is_arr(a) { _data(a) } else { a }
    let mut re = []
    let mut im = []
    for x in data {
        re = push(re, x + 0.0)
        im = push(im, 0.0)
    }
    {"re": re, "im": im}
}

// Naive O(n²) DFT. inverse=true applies conjugate twiddle and 1/n scale.
fn _fft_naive(re, im, inverse) {
    n := len(re)
    sign := if inverse { 1.0 } else { -1.0 }
    scale := if inverse { 1.0 / (n + 0.0) } else { 1.0 }
    two_pi := 2.0 * 3.141592653589793
    let mut out_re = []
    let mut out_im = []
    let mut k = 0
    while k < n {
        let mut sr = 0.0
        let mut si = 0.0
        let mut t = 0
        while t < n {
            th := sign * two_pi * k * t / (n + 0.0)
            c := math.cos(th)
            s := math.sin(th)
            // exp(sign * i * th) * (re + i im)
            sr = sr + re[t] * c - im[t] * s
            si = si + re[t] * s + im[t] * c
            t = t + 1
        }
        out_re = push(out_re, sr * scale)
        out_im = push(out_im, si * scale)
        k = k + 1
    }
    {"re": out_re, "im": out_im}
}

// Iterative radix-2 Cooley–Tukey. O(n log n). inverse uses +angle and 1/n.
fn _fft_radix2(re_in, im_in, inverse) {
    n := len(re_in)
    // bit-reversal copy
    let mut re = []
    let mut im = []
    let mut i = 0
    while i < n {
        re = push(re, re_in[i] + 0.0)
        im = push(im, im_in[i] + 0.0)
        i = i + 1
    }
    // compute log2(n)
    let mut logn = 0
    let mut tmp = n
    while tmp > 1 {
        logn = logn + 1
        tmp = tmp / 2
    }
    // bit-reverse permutation
    i = 0
    while i < n {
        let mut rev = 0
        let mut x = i
        let mut b = 0
        while b < logn {
            rev = rev * 2 + (x % 2)
            x = x / 2
            b = b + 1
        }
        if rev > i {
            tr := re[i]
            re[i] = re[rev]
            re[rev] = tr
            ti := im[i]
            im[i] = im[rev]
            im[rev] = ti
        }
        i = i + 1
    }
    sign := if inverse { 1.0 } else { -1.0 }
    two_pi := 2.0 * 3.141592653589793
    let mut len_ = 2
    while len_ <= n {
        half := len_ / 2
        ang := sign * two_pi / (len_ + 0.0)
        wlen_re := math.cos(ang)
        wlen_im := math.sin(ang)
        let mut start = 0
        while start < n {
            let mut wr = 1.0
            let mut wi = 0.0
            let mut k = 0
            while k < half {
                i0 := start + k
                i1 := i0 + half
                tr := wr * re[i1] - wi * im[i1]
                ti := wr * im[i1] + wi * re[i1]
                re[i1] = re[i0] - tr
                im[i1] = im[i0] - ti
                re[i0] = re[i0] + tr
                im[i0] = im[i0] + ti
                // wr, wi *= wlen
                nwr := wr * wlen_re - wi * wlen_im
                nwi := wr * wlen_im + wi * wlen_re
                wr = nwr
                wi = nwi
                k = k + 1
            }
            start = start + len_
        }
        len_ = len_ * 2
    }
    if inverse {
        scale := 1.0 / (n + 0.0)
        i = 0
        while i < n {
            re[i] = re[i] * scale
            im[i] = im[i] * scale
            i = i + 1
        }
    }
    {"re": re, "im": im}
}

// ──────────────────────────────────────────────
// Manipulation
// ──────────────────────────────────────────────

pub fn concat(a, b) {
    concatenate([a, b], null)
}

pub fn concatenate(arrays, axis) {
    if _wkind(arrays) != "list" || len(arrays) == 0 { return Err("warp.concatenate requires at least one array") }
    first := arrays[0]
    if !_is_arr(first) { return Err("warp.concatenate expects arrays") }
    rank := len(first.shape)
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, rank, false)
    if normalized == null { return Err("warp.concatenate axis is out of range") }
    let mut out_shape = []
    for dim in first.shape { out_shape = push(out_shape, dim) }
    out_shape[normalized] = 0
    for a in arrays {
        if !_is_arr(a) || len(a.shape) != rank { return Err("warp.concatenate arrays must have equal dimensions") }
        let mut i = 0
        while i < rank { if i != normalized && a.shape[i] != first.shape[i] { return Err("warp.concatenate shapes differ outside the concatenation axis") }
            i = i + 1 }
        out_shape[normalized] = out_shape[normalized] + a.shape[normalized]
    }
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        let mut offset = 0
        let mut selected = null
        for a in arrays {
            if out_index[normalized] < offset + a.shape[normalized] {
                selected = a
                break
            }
            offset = offset + a.shape[normalized]
        }
        source_index := _copy(out_index)
        source_index[normalized] = source_index[normalized] - offset
            d = push(d, _logical_value_at(selected, source_index))
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn stack(arrays, axis) {
    if _wkind(arrays) != "list" || len(arrays) == 0 { return Err("warp.stack requires at least one array") }
    rank := len(arrays[0].shape)
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, rank + 1, false)
    if normalized == null { return Err("warp.stack axis is out of range") }
    let mut expanded = []
    for a in arrays { expanded = push(expanded, expand_dims(a, normalized)) }
    concatenate(expanded, normalized)
}

pub fn split(a, sections, axis) {
    if !_is_arr(a) || _wkind(sections) != "int" || sections <= 0 { return Err("warp.split requires a positive integer section count") }
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    normalized := _normalize_axis(if axis_arg == null { 0 } else { axis_arg }, len(a.shape), false)
    if normalized == null || a.shape[normalized] % sections != 0 { return Err("warp.split requires equal sections") }
    width := a.shape[normalized] / sections
    let mut result = []
    let mut i = 0
    while i < sections {
        result = push(result, _slice_axis(a, i * width, (i + 1) * width, normalized))
        i = i + 1
    }
    result
}

pub fn take(a, indices, axis) {
    if !_is_arr(a) || _wkind(indices) != "list" { return Err("warp.take expects an array and index list") }
    axis_arg := if _wkind(axis) == "unit" { null } else { axis }
    if axis_arg == null {
        let mut d = []
        for index in indices {
    normalized_index := _normalize_index(index, size(a))
    if normalized_index == null { return Err("warp.take index is out of range") }
    d = push(d, _data(a)[normalized_index])
        }
        return array(d, [len(d)])
    }
    normalized := _normalize_axis(axis_arg, len(a.shape), false)
    if normalized == null { return Err("warp.take axis is out of range") }
    for index in indices { if _wkind(index) != "int" || index < 0 || index >= a.shape[normalized] { return Err("warp.take index is out of range") } }
    let mut out_shape = _copy(a.shape)
    out_shape[normalized] = len(indices)
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[normalized] = indices[out_index[normalized]]
        d = push(d, _logical_value_at(a, source_index))
        flat = flat + 1
    }
    array(d, out_shape)
}

// put replaces elements at flat (C-order) indices, matching np.put: negative
// indices wrap, values cycle when shorter than indices, duplicate targets are
// written in order so the last write wins, and an out-of-range index is an
// error. Warp arrays are immutable, so put returns a new array with the same
// shape instead of mutating in place.
pub fn put(a, indices, values) {
    if !_is_arr(a) || _wkind(indices) != "list" { return Err("warp.put expects an array and index list") }
    vals := if _is_arr(values) { _data(values) } else if _wkind(values) == "list" { values } else { [values] }
    if len(vals) == 0 && len(indices) > 0 { return Err("warp.put requires at least one value") }
    n := size(a)
    let mut d = _data(a)
    let mut i = 0
    while i < len(indices) {
        idx := _normalize_index(indices[i], n)
        if idx == null { return Err("warp.put index is out of range") }
        d[idx] = vals[i % len(vals)]
        i = i + 1
    }
    _array_with_dtype(d, a.shape, dtype(a))
}

pub fn vstack(arrays) {
    if len(arrays) == 0 { return Err("warp.vstack requires at least one array") }
    let mut all_data = []
    first_shape := arrays[0].shape
    if len(first_shape) != 1 && len(first_shape) != 2 { return Err("warp.vstack supports 1D or 2D arrays") }
    cols := if len(first_shape) == 1 { first_shape[0] } else { first_shape[1] }
    let mut rows = 0
    for a in arrays {
        if len(a.shape) != len(first_shape) { return Err("warp.vstack arrays must have equal dimensions") }
        if len(first_shape) == 1 && a.shape[0] != cols { return Err("warp.vstack vectors must have equal lengths") }
        if len(first_shape) == 2 && a.shape[1] != cols { return Err("warp.vstack matrices must have equal columns") }
        rows = rows + if len(first_shape) == 1 { 1 } else { a.shape[0] }
        for x in _data(a) { all_data = push(all_data, x) }
    }
    if len(first_shape) == 1 { array(all_data, [len(arrays), cols]) }
    else { array(all_data, [rows, cols]) }
}

pub fn hstack(arrays) {
    if len(arrays) == 0 { return Err("warp.hstack requires at least one array") }
    let mut all_data = []
    first_shape := arrays[0].shape
    if len(first_shape) != 1 && len(first_shape) != 2 { return Err("warp.hstack supports 1D or 2D arrays") }
    if len(first_shape) == 1 {
    for a in arrays { for x in _data(a) { all_data = push(all_data, x) } }
        return array(all_data, [len(all_data)])
    }
    rows := first_shape[0]
    let mut cols = 0
    for a in arrays {
        if len(a.shape) != 2 || a.shape[0] != rows { return Err("warp.hstack matrices must have equal rows") }
        cols = cols + a.shape[1]
    }
    let mut r = 0
    while r < rows {
        for a in arrays {
            start := r * a.shape[1]
            stop := start + a.shape[1]
            let mut c = start
        while c < stop { all_data = push(all_data, _data(a)[c]) c = c + 1 }
        }
        r = r + 1
    }
    array(all_data, [rows, cols])
}

pub fn tile(a, reps) {
    if !_is_arr(a) { return Err("warp.tile expects an array") }
    rep_list := if _wkind(reps) == "int" { [reps] } else { reps }
    if _wkind(rep_list) != "list" || len(rep_list) == 0 { return Err("warp.tile reps must be a positive integer or list") }
    let mut rank = len(a.shape)
    let mut aligned = []
    let mut i = 0
    while i < rank - len(rep_list) { aligned = push(aligned, 1)
        i = i + 1 }
    for rep in rep_list { aligned = push(aligned, rep) }
    if len(aligned) > rank { rank = len(aligned) }
    let mut source_shape = []
    i = 0
    while i < rank - len(a.shape) { source_shape = push(source_shape, 1)
        i = i + 1 }
    for dim in a.shape { source_shape = push(source_shape, dim) }
    if len(aligned) != rank { return Err("warp.tile reps are invalid") }
    let mut out_shape = []
    let mut j = 0
    while j < rank {
        if _wkind(aligned[j]) != "int" || aligned[j] < 0 { return Err("warp.tile reps must be non-negative integers") }
        out_shape = push(out_shape, source_shape[j] * aligned[j])
        j = j + 1
    }
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        let mut source_index = []
        j = 0
        while j < rank { source_index = push(source_index, if source_shape[j] == 0 { 0 } else { out_index[j] % source_shape[j] })
            j = j + 1 }
            d = push(d, _logical_value_at(a, _tail(source_index, rank - len(a.shape))))
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn repeat(a, n) {
    if !_is_arr(a) || _wkind(n) != "int" || n < 0 { return Err("warp.repeat requires a non-negative integer count") }
    let mut d = []
    for x in _data(a) {
        let mut i = 0
        while i < n { d = push(d, x)
            i = i + 1 }
    }
    array(d, [len(d)])
}

pub fn repeat_axis(a, n, axis) {
    if !_is_arr(a) || _wkind(n) != "int" || n < 0 { return Err("warp.repeat requires a non-negative integer count") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.repeat axis is out of range") }
    let mut out_shape = _copy(a.shape)
    out_shape[normalized] = out_shape[normalized] * n
    let mut d = []
    let mut flat = 0
    total := _prod(out_shape)
    while flat < total {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[normalized] = out_index[normalized] / n
    d = push(d, _logical_value_at(a, source_index))
        flat = flat + 1
    }
    array(d, out_shape)
}

pub fn flip(a) {
    if !_is_arr(a) { return Err("warp.flip expects an array") }
    data := _data(a)
    let mut d = []
    let mut i = len(data) - 1
    while i >= 0 { d = push(d, data[i])
        i = i - 1 }
    array(d, a.shape)
}

pub fn flip_axis(a, axis) {
    if !_is_arr(a) { return Err("warp.flip expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.flip axis is out of range") }
    let mut d = []
    n := _prod(a.shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, a.shape)
        out_index[normalized] = a.shape[normalized] - 1 - out_index[normalized]
        d = push(d, _logical_value_at(a, out_index))
        flat = flat + 1
    }
    array(d, a.shape)
}

pub fn sort(a) {
    // Stable merge sort keeps large array sorting O(n log n).
    array(_merge_sort_values(_data(a)), a.shape)
}

pub fn argsort(a) {
    data := _data(a)
    let mut indices = []
    let mut i = 0
    while i < len(data) { indices = push(indices, i)
        i = i + 1 }
    array(_merge_sort_indices(indices, data), a.shape)
}

pub fn unique(a) {
    if size(a) == 0 { return array([], [0]) }
    sorted := sort(a)
    data := _data(sorted)
    let mut d = [data[0]]
    let mut i = 1
    while i < len(data) {
        if data[i] != data[i - 1] { d = push(d, data[i]) }
        i = i + 1
    }
    array(d, [len(d)])
}

// unique_opts adds NumPy's return_index / return_counts. The result is a map
// with "values" always present, plus "index" (flat index of each value's first
// occurrence) and "counts" when the matching flag is true.
pub fn unique_opts(a, return_index, return_counts) {
    data := _data(a)
    want_index := return_index == true
    want_counts := return_counts == true
    if len(data) == 0 {
        result := {"values": array([], [0])}
        if want_index { result["index"] = array([], [0]) }
        if want_counts { result["counts"] = array([], [0]) }
        return result
    }
    let mut order = []
    let mut i = 0
    while i < len(data) { order = push(order, i)
        i = i + 1 }
    sorted_order := _merge_sort_indices(order, data)
    let mut values = [data[sorted_order[0]]]
    let mut first_index = [sorted_order[0]]
    let mut counts = [1]
    i = 1
    while i < len(data) {
        v := data[sorted_order[i]]
        if v == values[len(values) - 1] {
            counts[len(counts) - 1] = counts[len(counts) - 1] + 1
        } else {
            values = push(values, v)
            first_index = push(first_index, sorted_order[i])
            counts = push(counts, 1)
        }
        i = i + 1
    }
    result := {"values": array(values, [len(values)])}
    if want_index { result["index"] = array(first_index, [len(first_index)]) }
    if want_counts { result["counts"] = array(counts, [len(counts)]) }
    result
}

// sort_axis / argsort_axis sort each 1-D slice along `axis` with a stable
// merge sort (NumPy kind="stable"), preserving the input shape. argsort_axis
// yields int64 indices into the sorted axis. Negative axes are accepted.
pub fn sort_axis(a, axis) { _sort_along_axis(a, axis, false) }

pub fn argsort_axis(a, axis) { _sort_along_axis(a, axis, true) }

fn _sort_along_axis(a, axis, is_argsort) {
    if !_is_arr(a) { return Err("warp.sort_axis/argsort_axis expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp.sort_axis/argsort_axis axis is out of range") }
    n := a.shape[normalized]
    let mut d = _data(a)
    outer_shape := _remove_axis(a.shape, normalized)
    outer_size := _prod(outer_shape)
    let mut flat = 0
    while flat < outer_size {
        outer_index := _unravel(flat, outer_shape)
        let mut slice_values = []
        let mut k = 0
        while k < n {
            slice_values = push(slice_values, _logical_value_at(a, _insert_axis_index(outer_index, normalized, k)))
            k = k + 1
        }
        if is_argsort {
            let mut idx = []
            k = 0
            while k < n { idx = push(idx, k)
                k = k + 1 }
            sorted_idx := _merge_sort_indices(idx, slice_values)
            k = 0
            while k < n {
                d[_flat_index(_insert_axis_index(outer_index, normalized, k), a.shape)] = sorted_idx[k]
                k = k + 1
            }
        } else {
            sorted_values := _merge_sort_values(slice_values)
            k = 0
            while k < n {
                d[_flat_index(_insert_axis_index(outer_index, normalized, k), a.shape)] = sorted_values[k]
                k = k + 1
            }
        }
        flat = flat + 1
    }
    _array_with_dtype(d, a.shape, if is_argsort { "int64" } else { dtype(a) })
}

// ──────────────────────────────────────────────
// Searching / binning
// ──────────────────────────────────────────────

// np.searchsorted over a 1-D array sorted ascending, with side "left" (first
// index with a[i] >= v) or "right" (first with a[i] > v); null side is
// "left". v may be a scalar (→ int index) or an array/list (→ int64 array of
// the same shape). Like NumPy, the input is assumed sorted: out-of-order data
// is not validated and produces unspecified results.
pub fn searchsorted(a, v, side) {
    data := _data(a)
    if _wkind(data) != "list" { return Err("warp.searchsorted expects a 1-D array or list") }
    s := if side == null { "left" } else { side }
    if s != "left" && s != "right" { return Err("warp.searchsorted side must be \"left\" or \"right\"") }
    vk := _wkind(v)
    if vk == "int" || vk == "float" { return _searchsorted_one(data, v, s) }
    vd := _data(v)
    if _wkind(vd) != "list" { return Err("warp.searchsorted expects v to be a scalar or array") }
    let mut d = []
    for value in vd { d = push(d, _searchsorted_one(data, value, s)) }
    _array_with_dtype(d, if _is_arr(v) { v.shape } else { [len(d)] }, "int64")
}

fn _searchsorted_one(data, v, side) {
    let mut lo = 0
    let mut hi = len(data)
    while lo < hi {
        mid := (lo + hi) / 2
        if data[mid] < v || (side == "right" && data[mid] == v) { lo = mid + 1 } else { hi = mid }
    }
    lo
}

// np.digitize: bin indices for x against monotonic `bins`. With right false
// (default) bins[i-1] <= x < bins[i]; with right true bins[i-1] < x <= bins[i].
// Equal-valued edges are allowed; empty bins map every x to 0 (NumPy); bins
// that are neither non-decreasing nor non-increasing are an Err (NumPy raises
// ValueError). x may be a scalar (→ int) or an array/list (→ int64 array of
// the same shape).
pub fn digitize(x, bins, right) {
    bd := _data(bins)
    if _wkind(bd) != "list" { return Err("warp.digitize expects a 1-D bins array or list") }
    let mut increasing = true
    if !_non_decreasing(bd) {
        if _non_increasing(bd) { increasing = false }
        else { return Err("warp.digitize expects monotonic bins") }
    }
    // NumPy maps digitize onto searchsorted with the opposite side, reversing
    // and mirroring the index for decreasing bins.
    side := if right == true { "left" } else { "right" }
    xk := _wkind(x)
    if xk == "int" || xk == "float" { return _digitize_one(bd, x, side, increasing) }
    xd := _data(x)
    if _wkind(xd) != "list" { return Err("warp.digitize expects x to be a scalar or array") }
    let mut d = []
    for v in xd { d = push(d, _digitize_one(bd, v, side, increasing)) }
    _array_with_dtype(d, if _is_arr(x) { x.shape } else { [len(d)] }, "int64")
}

fn _digitize_one(bd, v, side, increasing) {
    if increasing { return _searchsorted_one(bd, v, side) }
    len(bd) - _searchsorted_one(_reverse_values(bd), v, side)
}

fn _non_decreasing(data) {
    let mut i = 1
    while i < len(data) {
        if data[i] < data[i - 1] { return false }
        i = i + 1
    }
    true
}

fn _non_increasing(data) {
    let mut i = 1
    while i < len(data) {
        if data[i] > data[i - 1] { return false }
        i = i + 1
    }
    true
}

// ──────────────────────────────────────────────
// Apply / map
// ──────────────────────────────────────────────

pub fn apply(a, f) { _unaryop(a, f) }

pub fn apply2(a, b, f) { _binop(a, b, f) }

// ──────────────────────────────────────────────
// Boolean / masking
// ──────────────────────────────────────────────

pub fn mask(a, cond_arr) {
    // Return elements where cond_arr != 0
    data := _data(a)
    if !_is_arr(cond_arr) || size(cond_arr) != size(a) { return Err("warp.mask expects equal-size arrays") }
    cd := _data(cond_arr)
    let mut d = []
    let mut i = 0
    while i < len(data) {
        if cd[i] { d = push(d, data[i]) }
        i = i + 1
    }
    array(d, [len(d)])
}

pub fn count_nonzero(a) {
    let mut c = 0
    for x in _data(a) { if x { c = c + 1 } }
    c
}

// ──────────────────────────────────────────────
// Convenience
// ──────────────────────────────────────────────

pub fn to_list(a) { _data(a) }

pub fn print_(a) {
    s := a.shape
    if len(s) == 1 {
        say(_data(a))
    } else if len(s) == 2 {
        rows := s[0]
        cols := s[1]
        let mut r = 0
        while r < rows {
            let mut row_data = []
            let mut c = 0
            while c < cols { row_data = push(row_data, _logical_value_at(a, [r, c]))
        c = c + 1 }
            say(row_data)
            r = r + 1
        }
    } else {
        say("warp<shape=" + str(s) + " size=" + str(size(a)) + ">")
    }
}

pub fn describe(a) {
    data := _data(a)
    {
        "shape": a.shape,
        "size": len(data),
        "min": min_(a),
        "max": max_(a),
        "mean": mean(a),
        "std": std_(a),
        "median": median(a),
    }
}

// Element-wise closeness: |a-b| <= atol + rtol*|b|. Defaults match NumPy
// (atol=1e-8, rtol=1e-5). NaN compares false (equal_nan=false).
pub fn isclose(a, b, atol, rtol) {
    at := if _wkind(atol) == "unit" || atol == null { 1e-8 } else { atol }
    rt := if _wkind(rtol) == "unit" || rtol == null { 1e-5 } else { rtol }
    _binop_with_dtype(a, b, fn(x, y) {
        if x != x || y != y { 0 }
        else if math.abs(x - y) <= at + rt * math.abs(y) { 1 }
        else { 0 }
    }, "bool")
}

pub fn allclose(a, b, atol) {
    tol := if atol == null { 1e-8 } else { atol }
    ad := _data(a)
    bd := _data(b)
    if len(ad) != len(bd) { return false }
    if _is_arr(a) && _is_arr(b) && a.shape != b.shape { return false }
    let mut i = 0
    while i < len(ad) {
        if math.abs(ad[i] - bd[i]) > tol + tol * math.abs(bd[i]) { return false }
        i = i + 1
    }
    true
}

pub fn isnan(a) { _unaryop_with_dtype(a, fn(x) { if x != x { 1 } else { 0 } }, "bool") }

pub fn isinf(a) { _unaryop_with_dtype(a, fn(x) { if x == math.inf || x == -math.inf { 1 } else { 0 } }, "bool") }

pub fn isfinite(a) { _unaryop_with_dtype(a, fn(x) { if x == x && x != 1.0/0.0 && x != -1.0/0.0 { 1 } else { 0 } }, "bool") }

pub fn maximum(a, b) { _binop(a, b, fn(x, y) { if x > y { x } else { y } }) }

pub fn minimum(a, b) { _binop(a, b, fn(x, y) { if x < y { x } else { y } }) }

pub fn logical_and(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x && y { 1 } else { 0 } }, "bool") }

pub fn logical_or(a, b) { _binop_with_dtype(a, b, fn(x, y) { if x || y { 1 } else { 0 } }, "bool") }

pub fn logical_not(a) { _unaryop_with_dtype(a, fn(x) { if !x { 1 } else { 0 } }, "bool") }

pub fn nan_to_num(a, nan_val, posinf, neginf) {
    nv := if nan_val == null { 0.0 } else { nan_val }
    pi := if posinf == null { 1e308 } else { posinf }
    ni := if neginf == null { -1e308 } else { neginf }
    _unaryop(a, fn(x) {
        if x != x { nv }
        else if x == 1.0/0.0 { pi }
        else if x == -1.0/0.0 { ni }
        else { x }
    })
}

// Native execution is opt-in. The provider may target CUDA, ROCm, or MLX;
// the operation/input contract is defined by that provider's manifest.
pub fn accelerator_supported() { accelerator.supported() }

pub fn accelerator_load(path) -> Result[any] { accelerator.load(path) }

pub fn accelerator_run(plugin, operation, input) -> Result[any] {
    accelerator.run(plugin, operation, input)
}

pub fn accelerator_run_tensor(plugin, operation, inputs) -> Result[any] {
    accelerator.run_tensor(plugin, operation, inputs)
}

/// Execution reporting for the plugin's most recent run: a map with
/// status ("device" | "fallback" | "unavailable" | "unreported"), device,
/// requested_device, fallback, and reported. Providers that omit the fields
/// report status "unreported" and fail conformance; contradictory reports
/// are rejected by the host before they reach here.
pub fn accelerator_last_exec_info(plugin) -> Result[any] { accelerator.last_exec_info(plugin) }

pub fn accelerator_close(plugin) { accelerator.close(plugin) }

// ──────────────────────────────────────────────
// Internals
// ──────────────────────────────────────────────

fn _wkind(v) {
    type_of(v)
}

fn _valid_shape(shape) {
    if _wkind(shape) != "list" { return false }
    for dim in shape {
        if _wkind(dim) != "int" || dim < 0 { return false }
    }
    true
}

fn _normalize_axis(axis, rank, allow_end) {
    if _wkind(axis) != "int" { return null }
    limit := if allow_end { rank + 1 } else { rank }
    let mut normalized = axis
    if normalized < 0 { normalized = normalized + limit }
    if normalized < 0 || normalized >= limit { return null }
    normalized
}

fn _flat_index(indices, shape) {
    let mut index = 0
    let mut i = 0
    while i < len(shape) {
        stride := _prod(_tail(shape, i + 1))
        index = index + indices[i] * stride
        i = i + 1
    }
    index
}

fn _slice_axis(a, start, stop, axis) {
    let mut out_shape = _copy(a.shape)
    out_shape[axis] = stop - start
    let mut d = []
    n := _prod(out_shape)
    let mut flat = 0
    while flat < n {
        out_index := _unravel(flat, out_shape)
        source_index := _copy(out_index)
        source_index[axis] = source_index[axis] + start
        d = push(d, _logical_value_at(a, source_index))
        flat = flat + 1
    }
    array(d, out_shape)
}

fn _copy(data) {
    let mut result = []
    for value in data { result = push(result, value) }
    result
}

fn _make_array(data, shape, dtype_name) {
    if dtype_name != "object" && _tensor_packable(dtype_name) {
        handle := tensor.from_list(dtype_name, shape, data)
        if !is_err(handle) {
            h := handle?
            return {
                "_warp": true,
                "data": data,
                "shape": shape,
                "_dtype": dtype_name,
                "_strides": _contiguous_strides(shape),
                "_offset": 0,
                "_tid": h,
                "_native": true,
            }
        }
    }
    {
        "_warp": true,
        "data": data,
        "shape": shape,
        "_dtype": dtype_name,
        "_strides": _contiguous_strides(shape),
        "_offset": 0,
        "_native": false,
    }
}

fn _tensor_packable(dtype_name) {
    // float16 is deliberately excluded: the native tensor ABI dtype codes are
    // frozen at 1-11, so float16 arrays stay on the portable list path and
    // never reach run_tensor.
    dtype_name == "bool" || dtype_name == "int8" || dtype_name == "int16" || dtype_name == "int32" || dtype_name == "int64" || dtype_name == "uint8" || dtype_name == "uint16" || dtype_name == "uint32" || dtype_name == "uint64" || dtype_name == "float32" || dtype_name == "float64"
}

fn _has_tid(a) {
    _is_arr(a) && contains(keys(a), "_tid") && a._tid != null
}

fn _data(a) {
    if !_is_arr(a) { return a }
    if _has_tid(a) {
        values := tensor.to_list(a._tid)?
        a.data = values
        return values
    }
    if a.data != null { return _flat_values(a) }
    _flat_values(a)
}

pub fn storage_kind(a) {
    if !_is_arr(a) { return "scalar" }
    if _has_tid(a) { "tensor" } else { "list" }
}

pub fn itemsize(a) {
    if !_is_arr(a) { return Err("warp.itemsize expects an array") }
    _itemsize(dtype(a))
}

fn _itemsize(dtype_name) {
    if dtype_name == "bool" { 1 }
    else if dtype_name == "int8" || dtype_name == "uint8" { 1 }
    else if dtype_name == "int16" || dtype_name == "uint16" || dtype_name == "float16" { 2 }
    else if dtype_name == "int32" || dtype_name == "uint32" || dtype_name == "float32" { 4 }
    else if dtype_name == "int64" || dtype_name == "uint64" || dtype_name == "float64" { 8 }
    else { 8 }
}

fn _contiguous_strides(shape) {
    let mut result = []
    let mut stride = 1
    let mut i = len(shape) - 1
    while i >= 0 {
        result = push(result, stride)
        stride = stride * shape[i]
        i = i - 1
    }
    _reverse_values(result)
}

fn _view_in_bounds(shape, strides, view_offset, storage_len) {
    if _wkind(view_offset) != "int" || view_offset < 0 || view_offset > storage_len { return false }
    if len(shape) != len(strides) { return false }
    if _prod(shape) == 0 { return true }
    if view_offset >= storage_len { return false }
    let mut min_index = view_offset
    let mut max_index = view_offset
    let mut i = 0
    while i < len(shape) {
        if _wkind(shape[i]) != "int" || _wkind(strides[i]) != "int" { return false }
        if shape[i] > 0 {
            span := (shape[i] - 1) * strides[i]
            if span < 0 { min_index = min_index + span } else { max_index = max_index + span }
        }
        i = i + 1
    }
    min_index >= 0 && max_index < storage_len
}

fn _storage_index(a, indices) {
    let mut index = a._offset
    let mut i = 0
    while i < len(indices) {
        index = index + indices[i] * a._strides[i]
        i = i + 1
    }
    index
}

fn _logical_value_at(a, indices) { a.data[_storage_index(a, indices)] }

fn _flat_values(a) {
    let mut result = []
    n := _prod(a.shape)
    let mut flat = 0
    while flat < n {
        result = push(result, _logical_value_at(a, _unravel(flat, a.shape)))
        flat = flat + 1
    }
    result
}

fn _normalize_index(index, size) {
    if _wkind(index) != "int" { return null }
    result := if index < 0 { index + size } else { index }
    if result < 0 || result >= size { null } else { result }
}

fn _transpose_order(rank, axes) {
    axis_arg := if _wkind(axes) == "unit" { null } else { axes }
    let mut order = []
    if axis_arg == null {
        let mut i = rank - 1
        while i >= 0 { order = push(order, i) i = i - 1 }
        return order
    }
    if _wkind(axis_arg) != "list" || len(axis_arg) != rank { return null }
    for axis in axis_arg {
        normalized := _normalize_axis(axis, rank, false)
        if normalized == null || contains(order, normalized) { return null }
        order = push(order, normalized)
    }
    order
}

fn _slice_bounds(length, start, stop, step) {
    actual_step := if step == null { 1 } else { step }
    if _wkind(actual_step) != "int" || actual_step == 0 { return null }
    let mut first = 0
    let mut last = length
    if actual_step > 0 {
        first = if start == null { 0 } else { start }
        if _wkind(first) != "int" { return null }
        if first < 0 { first = first + length }
        if first < 0 { first = 0 }
        if first > length { first = length }
        last = if stop == null { length } else { stop }
        if _wkind(last) != "int" { return null }
        if last < 0 { last = last + length }
        if last < 0 { last = 0 }
        if last > length { last = length }
        count := if last <= first { 0 } else { 1 + (last - 1 - first) / actual_step }
        {"start": first, "stop": last, "step": actual_step, "count": count}
    } else {
        first = if start == null { length - 1 } else { start }
        if _wkind(first) != "int" { return null }
        if first < 0 { first = first + length }
        if first < -1 { first = -1 }
        if first >= length { first = length - 1 }
        if stop == null { last = -1 }
        else {
            last = stop
            if _wkind(last) != "int" { return null }
            if last < 0 { last = last + length }
            if last < -1 { last = -1 }
            if last >= length { last = length - 1 }
        }
        count := if first <= last { 0 } else { 1 + (first - 1 - last) / (-actual_step) }
        {"start": first, "stop": last, "step": actual_step, "count": count}
    }
}

fn _is_ellipsis_selector(selector) {
    _wkind(selector) == "map" && contains(keys(selector), "_ellipsis") && selector._ellipsis == true
}

fn _is_newaxis_selector(selector) {
    _wkind(selector) == "map" && contains(keys(selector), "_newaxis") && selector._newaxis == true
}

// Expand an ellipsis selector into the full-axis selections it stands in
// for. Returns the expanded selector list, or an error string when the
// selectors cannot index an array of the given rank (the NumPy IndexError
// cases: more than one ellipsis, or more axis-consuming selectors than
// axes — newaxis consumes none).
fn _expand_selectors(selectors, rank, context) {
    let mut ellipses = 0
    let mut consumed = 0
    for selector in selectors {
        if _is_ellipsis_selector(selector) { ellipses = ellipses + 1 }
        else if !_is_newaxis_selector(selector) { consumed = consumed + 1 }
    }
    if ellipses > 1 { return context + " allows at most one ellipsis selector" }
    if consumed > rank { return context + " has too many selectors" }
    if ellipses == 0 { return selectors }
    fill := rank - consumed
    let mut expanded = []
    for selector in selectors {
        if _is_ellipsis_selector(selector) {
            let mut i = 0
            while i < fill {
                expanded = push(expanded, null)
                i = i + 1
            }
        } else {
            expanded = push(expanded, selector)
        }
    }
    expanded
}

// Realize newaxis selectors as size-1 dimensions: the array is reshaped to
// insert each new axis and the selector at that position becomes a full-axis
// selection. The result is {"array": reshaped, "selectors": aligned}. Size-1
// axes never change the C-order element sequence, so flat positions computed
// against the expanded shape address the original storage unchanged.
fn _prepare_newaxis(a, selectors) {
    let mut source = a
    let mut final = []
    let mut axis = 0
    for selector in selectors {
        if _is_newaxis_selector(selector) {
            let mut new_shape = []
            let mut i = 0
            while i < len(source.shape) {
                if i == axis { new_shape = push(new_shape, 1) }
                new_shape = push(new_shape, source.shape[i])
                i = i + 1
            }
            if axis == len(source.shape) { new_shape = push(new_shape, 1) }
            source = reshape(source, new_shape)
            final = push(final, null)
        } else {
            final = push(final, selector)
        }
        axis = axis + 1
    }
    {"array": source, "selectors": final}
}

fn _index_spec(selector, size) {
    if selector == null { return {"kind": "all", "size": size} }
    if _wkind(selector) == "map" && contains(keys(selector), "_slice") && selector._slice == true {
        bounds := _slice_bounds(size, selector.start, selector.stop, selector.step)
        if bounds == null { return null }
        return {"kind": "slice", "start": bounds.start, "step": bounds.step, "size": bounds.count}
    }
    if _wkind(selector) == "int" {
        normalized := _normalize_index(selector, size)
        if normalized == null { return null }
        return {"kind": "scalar", "value": normalized}
    }
    if _wkind(selector) != "list" { return null }
 if len(selector) == 0 { return {"kind": "advanced", "shape": [0], "values": []} }
 first_kind := _wkind(selector[0])
 if first_kind == "list" {
  info := _index_array_info(selector, size)
  if info == null { return null }
  return {"kind": "advanced", "shape": info.shape, "values": info.values}
 }
    if first_kind != "bool" && first_kind != "int" { return null }
    let mut positions = []
    if first_kind == "bool" {
        let mut i = 0
        for flag in selector {
            if _wkind(flag) != "bool" { return null }
            if flag { positions = push(positions, i) }
            i = i + 1
        }
        if len(selector) != size { return null }
    } else {
        for item in selector {
            if _wkind(item) != "int" { return null }
            normalized := _normalize_index(item, size)
            if normalized == null { return null }
            positions = push(positions, normalized)
        }
    }
 {"kind": "advanced", "shape": [len(positions)], "values": positions}
}

fn _index_array_info(selector, size) {
 if _wkind(selector) != "list" { return null }
 if len(selector) == 0 { return {"shape": [0], "values": []} }
 first_kind := _wkind(selector[0])
 if first_kind == "int" {
  let mut values = []
  for item in selector {
   if _wkind(item) != "int" { return null }
   normalized := _normalize_index(item, size)
   if normalized == null { return null }
   values = push(values, normalized)
  }
  return {"shape": [len(selector)], "values": values}
 }
 if first_kind != "list" { return null }
 first := _index_array_info(selector[0], size)
 if first == null { return null }
 child_shape := first.shape
 let mut values = []
 for row in selector {
  child := _index_array_info(row, size)
  if child == null || !_same_shape(child.shape, child_shape) { return null }
  for value in child.values { values = push(values, value) }
 }
 let mut shape = [len(selector)]
 for dim in child_shape { shape = push(shape, dim) }
 {"shape": shape, "values": values}
}

fn _same_shape(left, right) {
 if _wkind(left) != "list" || _wkind(right) != "list" || len(left) != len(right) { return false }
 let mut i = 0
 while i < len(left) {
  if left[i] != right[i] { return false }
  i = i + 1
 }
 true
}

fn _advanced_index_value(spec, advanced_index, advanced_shape) {
 offset := len(advanced_shape) - len(spec.shape)
 let mut flat = 0
 let mut i = 0
 while i < len(spec.shape) {
  dim := spec.shape[i]
  coord := if dim == 1 { 0 } else { advanced_index[i + offset] }
  flat = flat + coord * _prod(_tail(spec.shape, i + 1))
  i = i + 1
 }
 spec.values[flat]
}

fn _index_coord_segment(index, start, count) {
 let mut result = []
 let mut i = 0
 while i < count {
  result = push(result, index[start + i])
  i = i + 1
 }
 result
}

fn _index_advanced(a, specs) {
 let mut advanced_axes = []
 let mut axis = 0
 while axis < len(specs) {
  if specs[axis].kind == "advanced" { advanced_axes = push(advanced_axes, axis) }
  axis = axis + 1
 }
 if len(advanced_axes) == 0 { return Err("warp.index requires an advanced selector") }
 let mut advanced_shape = []
 for advanced_axis in advanced_axes {
  next_shape := _broadcast_shape(advanced_shape, specs[advanced_axis].shape)
  if next_shape == null { return Err("warp.index advanced selectors could not be broadcast together") }
  advanced_shape = next_shape
 }
 first_advanced := advanced_axes[0]
 last_advanced := advanced_axes[len(advanced_axes) - 1]
 let mut contiguous = true
 axis = first_advanced
 while axis <= last_advanced {
  if specs[axis].kind != "advanced" { contiguous = false }
  axis = axis + 1
 }
 let mut output_shape = []
 if !contiguous { for dim in advanced_shape { output_shape = push(output_shape, dim) } }
 axis = 0
 while axis < len(specs) {
  if contiguous && axis == first_advanced { for dim in advanced_shape { output_shape = push(output_shape, dim) } }
  spec := specs[axis]
  if spec.kind != "scalar" && spec.kind != "advanced" {
   if !contiguous || axis < first_advanced || axis > last_advanced { output_shape = push(output_shape, spec.size) }
  }
  axis = axis + 1
 }
 let mut values = []
 output_count := _prod(output_shape)
 let mut flat = 0
 while flat < output_count {
  output_index := _unravel(flat, output_shape)
  let mut advanced_index = []
  let mut basic_cursor = 0
  if contiguous {
   axis = 0
   while axis < first_advanced { if specs[axis].kind != "scalar" { basic_cursor = basic_cursor + 1 } axis = axis + 1 }
   advanced_index = _index_coord_segment(output_index, basic_cursor, len(advanced_shape))
   basic_cursor = 0
  } else {
   advanced_index = _index_coord_segment(output_index, 0, len(advanced_shape))
   basic_cursor = len(advanced_shape)
  }
  let mut source_index = []
  let mut advanced_consumed = false
  axis = 0
  while axis < len(specs) {
   spec := specs[axis]
   if spec.kind == "scalar" { source_index = push(source_index, spec.value) } else if spec.kind == "advanced" { if contiguous && !advanced_consumed { basic_cursor = basic_cursor + len(advanced_shape) advanced_consumed = true } source_index = push(source_index, _advanced_index_value(spec, advanced_index, advanced_shape)) } else { coordinate := output_index[basic_cursor] basic_cursor = basic_cursor + 1 source_position := if spec.kind == "slice" { spec.start + coordinate * spec.step } else { coordinate } source_index = push(source_index, source_position) }
   axis = axis + 1
  }
  values = push(values, _logical_value_at(a, source_index))
  flat = flat + 1
 }
 _array_with_dtype(values, output_shape, dtype(a))
}

fn _collect_index_values(a, specs, axis, source_index, result) {
    if axis == len(specs) { return push(result, _logical_value_at(a, source_index)) }
    spec := specs[axis]
    if spec.kind == "scalar" {
        next_index := push(_copy(source_index), spec.value)
        return _collect_index_values(a, specs, axis + 1, next_index, result)
    }
    if spec.kind == "all" {
        let mut i = 0
        let mut output = result
        while i < spec.size {
            next_index := push(_copy(source_index), i)
            output = _collect_index_values(a, specs, axis + 1, next_index, output)
            i = i + 1
        }
        return output
    }
    if spec.kind == "slice" {
        let mut output = result
        let mut i = 0
        while i < spec.size {
            next_index := push(_copy(source_index), spec.start + i * spec.step)
            output = _collect_index_values(a, specs, axis + 1, next_index, output)
            i = i + 1
        }
        return output
    }
    let mut output = result
    for position in spec.positions {
        next_index := push(_copy(source_index), position)
        output = _collect_index_values(a, specs, axis + 1, next_index, output)
    }
    output
}

// Return the logical output shape and source coordinates selected by a set of
// selectors. Coordinates are in the array's logical row-major index space, so
// callers can apply immutable updates to contiguous arrays and strided views
// alike after materializing the source values.
fn _selection_targets(specs) {
    for spec in specs {
        if spec.kind == "advanced" { return _advanced_target_map(specs) }
    }
    let mut output_shape = []
    for spec in specs {
        if spec.kind != "scalar" { output_shape = push(output_shape, spec.size) }
    }
    let mut indices = []
    indices = _collect_index_targets(specs, 0, [], indices)
    {"shape": output_shape, "indices": indices}
}

fn _collect_index_targets(specs, axis, source_index, result) {
    if axis == len(specs) { return push(result, _copy(source_index)) }
    spec := specs[axis]
    if spec.kind == "scalar" {
        next_index := push(_copy(source_index), spec.value)
        return _collect_index_targets(specs, axis + 1, next_index, result)
    }
    if spec.kind == "all" {
        let mut i = 0
        let mut output = result
        while i < spec.size {
            next_index := push(_copy(source_index), i)
            output = _collect_index_targets(specs, axis + 1, next_index, output)
            i = i + 1
        }
        return output
    }
    if spec.kind == "slice" {
        let mut i = 0
        let mut output = result
        while i < spec.size {
            next_index := push(_copy(source_index), spec.start + i * spec.step)
            output = _collect_index_targets(specs, axis + 1, next_index, output)
            i = i + 1
        }
        return output
    }
    result
}

// Build source coordinates for NumPy-style broadcasted advanced selectors.
// A null result means that the advanced selector shapes are incompatible.
fn _advanced_target_map(specs) {
    let mut advanced_axes = []
    let mut axis = 0
    while axis < len(specs) {
        if specs[axis].kind == "advanced" { advanced_axes = push(advanced_axes, axis) }
        axis = axis + 1
    }
    if len(advanced_axes) == 0 { return null }
    let mut advanced_shape = []
    for advanced_axis in advanced_axes {
        next_shape := _broadcast_shape(advanced_shape, specs[advanced_axis].shape)
        if next_shape == null { return null }
        advanced_shape = next_shape
    }
    first_advanced := advanced_axes[0]
    last_advanced := advanced_axes[len(advanced_axes) - 1]
    let mut contiguous = true
    axis = first_advanced
    while axis <= last_advanced {
        if specs[axis].kind != "advanced" { contiguous = false }
        axis = axis + 1
    }
    let mut output_shape = []
    if !contiguous { for dim in advanced_shape { output_shape = push(output_shape, dim) } }
    axis = 0
    while axis < len(specs) {
        if contiguous && axis == first_advanced { for dim in advanced_shape { output_shape = push(output_shape, dim) } }
        spec := specs[axis]
        if spec.kind != "scalar" && spec.kind != "advanced" {
            if !contiguous || axis < first_advanced || axis > last_advanced {
                output_shape = push(output_shape, spec.size)
            }
        }
        axis = axis + 1
    }
    let mut indices = []
    output_count := _prod(output_shape)
    let mut flat = 0
    while flat < output_count {
        output_index := _unravel(flat, output_shape)
        let mut advanced_index = []
        let mut basic_cursor = 0
        if contiguous {
            axis = 0
            while axis < first_advanced {
                if specs[axis].kind != "scalar" { basic_cursor = basic_cursor + 1 }
                axis = axis + 1
            }
            advanced_index = _index_coord_segment(output_index, basic_cursor, len(advanced_shape))
            basic_cursor = 0
        } else {
            advanced_index = _index_coord_segment(output_index, 0, len(advanced_shape))
            basic_cursor = len(advanced_shape)
        }
        let mut source_index = []
        let mut advanced_consumed = false
        axis = 0
        while axis < len(specs) {
            spec := specs[axis]
            if spec.kind == "scalar" {
                source_index = push(source_index, spec.value)
            } else if spec.kind == "advanced" {
                if contiguous && !advanced_consumed {
                    basic_cursor = basic_cursor + len(advanced_shape)
                    advanced_consumed = true
                }
                source_index = push(source_index, _advanced_index_value(spec, advanced_index, advanced_shape))
            } else {
                coordinate := output_index[basic_cursor]
                basic_cursor = basic_cursor + 1
                source_position := if spec.kind == "slice" { spec.start + coordinate * spec.step } else { coordinate }
                source_index = push(source_index, source_position)
            }
            axis = axis + 1
        }
        indices = push(indices, _copy(source_index))
        flat = flat + 1
    }
    {"shape": output_shape, "indices": indices}
}

fn _array_like(data, shape, source) {
    if _is_arr(source) {
        {"_warp": true, "data": data, "shape": shape, "_dtype": dtype(source), "_strides": _contiguous_strides(shape), "_offset": 0}
    } else {
        array(data, shape)
    }
}

fn _array_with_dtype(data, shape, dtype_name) {
    if dtype_name == null { return array(data, shape) }
    array_typed(data, shape, dtype_name)
}

fn _mean_result(result, source, count) {
    target_dtype := if dtype(source) == "float32" { "float32" } else { "float64" }
    if !_is_arr(result) { return result / (count + 0.0) }
    let mut data = []
    for value in result.data { data = push(data, value / (count + 0.0)) }
    _array_with_dtype(data, result.shape, target_dtype)
}

fn _scalar_dtype(value) { _infer_dtype([value]) }

fn _float_result_dtype(value) {
    if _is_arr(value) && (dtype(value) == "float32" || dtype(value) == "float16") { dtype(value) } else { "float64" }
}

// _round_float16 rounds a finite float64 to the nearest IEEE 754 binary16
// value (ties to even), matching np.float16(x): magnitudes at or above the
// 65520 midpoint overflow to ±inf, subnormal halves use the 2^-24 quantum,
// and anything below 2^-25 flushes to zero. NaN and ±inf pass through.
fn _round_float16(x) {
    if x != x || math.isinf(x) { return x }
    neg := x < 0
    ax := if neg { -x } else { x }
    if ax == 0.0 { return x }
    let mut result = 0.0
    if ax >= 65520.0 {
        result = math.inf
    } else if ax >= 0.00006103515625 {
        // Normal half range [2^-14, 2^16): find e = floor(log2(ax)) exactly
        // by scaling with powers of two, then round to 10 mantissa bits.
        let mut p = 1.0
        if ax >= 1.0 {
            while p * 2.0 <= ax { p = p * 2.0 }
        } else {
            while p > ax { p = p / 2.0 }
        }
        step := p / 1024.0
        result = _round_half_even(ax / step) * step
        if result >= 65536.0 { result = math.inf }
    } else {
        // Subnormal half quantum 2^-24.
        step := 0.000000059604644775390625
        result = _round_half_even(ax / step) * step
    }
    if neg { -result } else { result }
}

// _round_half_even rounds a non-negative value to the nearest integer,
// breaking exact ties toward the even neighbor. The quotient inputs here are
// exact (power-of-two scaling), so the tie test is exact.
fn _round_half_even(v) {
    f := math.floor(v)
    diff := v - f
    if diff > 0.5 { return f + 1.0 }
    if diff < 0.5 { return f }
    if f / 2.0 == math.floor(f / 2.0) { f } else { f + 1.0 }
}

fn _promote_dtype(left, right) {
    l := if _is_arr(left) { dtype(left) } else { _scalar_dtype(left) }
    r := if _is_arr(right) { dtype(right) } else { _scalar_dtype(right) }
    if l == "object" || r == "object" { return "object" }
    if _is_arr(left) && _is_arr(right) { return _promote_dtype_pair(l, r) }
    // Scalar operands keep weak scalar semantics (float64/int64/bool).
    if l == "float64" || r == "float64" { return "float64" }
    if l == "float32" || r == "float32" { return "float32" }
    // A float16 array combined with an integer or boolean scalar keeps
    // float16, matching NumPy 2.x weak scalar promotion. A float64 scalar
    // still promotes to float64 (same deviation as float32 above).
    if l == "float16" || r == "float16" { return "float16" }
    // uint64 cannot be represented exactly by a signed runtime integer when
    // combined with a signed integer, so promote that pair to float64.
    if (l == "uint64" && _signed_integer_dtype(r)) ||
        (r == "uint64" && _signed_integer_dtype(l)) {
        return "float64"
    }
    left_rank := _dtype_rank(l)
    right_rank := _dtype_rank(r)
    if left_rank >= right_rank { l } else { r }
}

// _promote_dtype_pair mirrors np.promote_types (NumPy 2.x) for two array
// dtypes over the supported set. Keep in sync with promoteDType in
// internal/tensor/ops.go; the conformance dtype fixture locks the full
// 12x12 matrix against the NumPy oracle.
fn _promote_dtype_pair(l, r) {
    if l == r { return l }
    // float64 dominates everything; float32 survives only against bool,
    // float16, and integers of 16 bits or fewer.
    if l == "float64" || r == "float64" { return "float64" }
    if l == "float32" || r == "float32" {
        other := if l == "float32" { r } else { l }
        if other == "int32" || other == "int64" || other == "uint32" || other == "uint64" { return "float64" }
        return "float32"
    }
    // float16 survives only against bool and 8-bit integers; 16-bit integers
    // promote to float32 and wider integers to float64.
    if l == "float16" || r == "float16" {
        other := if l == "float16" { r } else { l }
        if other == "int16" || other == "uint16" { return "float32" }
        if other == "int32" || other == "int64" || other == "uint32" || other == "uint64" { return "float64" }
        return "float16"
    }
    // bool mixed with a non-float dtype adopts the other operand's dtype.
    if l == "bool" { return r }
    if r == "bool" { return l }
    l_signed := _signed_integer_dtype(l)
    r_signed := _signed_integer_dtype(r)
    if l_signed == r_signed {
        if _dtype_width(l) >= _dtype_width(r) { return l }
        return r
    }
    // Mixed sign: the result is the smallest signed dtype wide enough to hold
    // both ranges. A 64-bit unsigned paired with any signed integer overflows
    // int64 and promotes to float64.
    signed := if l_signed { l } else { r }
    unsigned := if l_signed { r } else { l }
    let mut need := _dtype_width(signed)
    unsigned_need := _dtype_width(unsigned) * 2
    if unsigned_need > need { need = unsigned_need }
    if need <= 16 { return "int16" }
    if need <= 32 { return "int32" }
    if need <= 64 { return "int64" }
    "float64"
}

// _dtype_width reports the storage width in bits of an integer dtype.
fn _dtype_width(dtype_name) {
    if dtype_name == "int8" || dtype_name == "uint8" { 8 }
    else if dtype_name == "int16" || dtype_name == "uint16" { 16 }
    else if dtype_name == "int32" || dtype_name == "uint32" { 32 }
    else { 64 }
}

fn _signed_integer_dtype(dtype_name) {
    dtype_name == "int8" || dtype_name == "int16" || dtype_name == "int32" || dtype_name == "int64"
}

fn _dtype_rank(dtype_name) {
    if dtype_name == "bool" { 1 }
    else if dtype_name == "uint8" { 2 }
    else if dtype_name == "int8" { 3 }
    else if dtype_name == "uint16" { 4 }
    else if dtype_name == "int16" { 5 }
    else if dtype_name == "uint32" { 6 }
    else if dtype_name == "int32" { 7 }
    else if dtype_name == "uint64" { 8 }
    else if dtype_name == "int64" { 9 }
    else if dtype_name == "float16" { 10 }
    else if dtype_name == "float32" { 11 }
    else if dtype_name == "float64" { 12 }
    else { 0 }
}

fn _valid_dtype(dtype_name) {
    dtype_name == "bool" || dtype_name == "int8" || dtype_name == "int16" || dtype_name == "int32" || dtype_name == "int64" || dtype_name == "uint8" || dtype_name == "uint16" || dtype_name == "uint32" || dtype_name == "uint64" || dtype_name == "float16" || dtype_name == "float32" || dtype_name == "float64" || dtype_name == "object"
}

fn _infer_dtype(data) {
    if _wkind(data) != "list" || len(data) == 0 { return "float64" }
    let mut found = "bool"
    for value in data {
        kind := _wkind(value)
        if kind == "null" || kind == "str" || kind == "list" || kind == "map" {
            return "object"
        }
        if kind == "float" {
            found = "float64"
        } else if kind == "int" && found == "bool" {
            found = "int64"
        }
    }
    found
}

fn _cast_value(value, dtype_name) {
    if dtype_name == "object" { return value }
    if value == null { return Err("warp dtype conversion does not accept null") }
    kind := _wkind(value)
    if kind != "bool" && kind != "int" && kind != "float" {
        return Err("warp dtype conversion expects numeric values")
    }
    // Coerce bool to 0/1 before numeric casts (Weft forbids bool+int arithmetic).
    num := if kind == "bool" { if value { 1 } else { 0 } } else { value }
    if kind == "float" && (value != value || math.isinf(value)) {
        if dtype_name != "float16" && dtype_name != "float32" && dtype_name != "float64" {
            return Err("warp integer dtype conversion requires a finite value")
        }
    }
    if dtype_name == "bool" {
        if kind == "bool" { value } else { num != 0 }
    } else if dtype_name == "float16" {
        // NumPy float16 cast semantics: round-to-nearest-even to binary16;
        // overflow yields ±inf (NumPy emits a RuntimeWarning, not an error)
        // and tiny magnitudes flush through subnormals to zero.
        _round_float16(num + 0.0)
    } else if dtype_name == "float32" || dtype_name == "float64" {
        num + 0.0
    } else {
        // Range-check the pre-truncation float: math.floor/ceil saturate to
        // the int64 extremes, so checking after truncation would never fire.
        if kind == "float" && (num < -9.223372036854776e18 || num > 9.223372036854776e18) {
            return Err("warp integer dtype conversion is out of int64 range")
        }
        integer := if kind == "float" {
            if num < 0 { math.ceil(num) } else { math.floor(num) }
        } else { num }
        if integer < -9.223372036854776e18 || integer > 9.223372036854776e18 {
            return Err("warp integer dtype conversion is out of int64 range")
        }
        if dtype_name == "int8" {
            if integer < -128 || integer > 127 { return Err("warp int8 conversion is out of range") }
        } else if dtype_name == "int16" {
            if integer < -32768 || integer > 32767 { return Err("warp int16 conversion is out of range") }
        } else if dtype_name == "int32" {
            if integer < -2147483648 || integer > 2147483647 { return Err("warp int32 conversion is out of range") }
        } else if dtype_name == "uint8" {
            if integer < 0 || integer > 255 { return Err("warp uint8 conversion is out of range") }
        } else if dtype_name == "uint16" {
            if integer < 0 || integer > 65535 { return Err("warp uint16 conversion is out of range") }
        } else if dtype_name == "uint32" {
            if integer < 0 || integer > 4294967295 { return Err("warp uint32 conversion is out of range") }
        } else if dtype_name == "uint64" {
            if integer < 0 { return Err("warp uint64 conversion is out of range") }
        } else if dtype_name != "int64" {
            return Err("warp dtype conversion received unsupported dtype")
        }
        integer
    }
}

// Coerce bool operands to 0/1 for arithmetic result dtypes so promotion works.
fn _op_input(value, result_dtype) {
    if result_dtype == "bool" || result_dtype == "object" { return value }
    kind := _wkind(value)
    if kind == "bool" {
        if result_dtype == "float16" || result_dtype == "float32" || result_dtype == "float64" {
            return if value { 1.0 } else { 0.0 }
        }
        return if value { 1 } else { 0 }
    }
    if result_dtype == "float16" || result_dtype == "float32" || result_dtype == "float64" {
        return value + 0.0
    }
    value
}

fn _validate_2d(a) -> Result[any] {
    ensure(a != null && _is_arr(a), "expected warp array")?
    ensure(len(a.shape) == 2, "expected 2D array")?
    ensure(size(a) == a.shape[0] * a.shape[1], "data/shape mismatch")?
    Ok(null)
}

fn _validate_square(a) -> Result[any] {
    _validate_2d(a)?
    ensure(a.shape[0] == a.shape[1], "expected square matrix")?
    Ok(null)
}

fn _valid_axis_2d(a, axis) {
    a != null && _is_arr(a) && len(a.shape) == 2 && (axis == 0 || axis == 1)
}

fn _is_arr(a) { a != null && len(keys(a)) > 0 && contains(keys(a), "_warp") }

fn _prod(shape) {
    let mut p = 1
    for s in shape { p = p * s }
    p
}

fn _binop(a, b, op) { _binop_with_dtype(a, b, op, null) }

// Host-tensor elementwise path for add/mul. Returns a new array on success, or
// null so the caller can fall back to the portable `_binop` implementation.
// Broadcast semantics match tensor.Add/Mul (NumPy right-aligned).
fn _try_tensor_binop(a, b, op_name) {
    if !_has_tid(a) || !_has_tid(b) { return null }
    if op_name != "add" && op_name != "mul" { return null }
    result_dtype := _promote_dtype(a, b)
    if !_tensor_packable(result_dtype) { return null }
    out := if op_name == "add" {
        tensor.add(a._tid, b._tid)
    } else {
        tensor.mul(a._tid, b._tid)
    }
    if is_err(out) { return null }
    handle := out?
    values := tensor.to_list(handle)
    tensor.free(handle)?
    if is_err(values) { return null }
    shape := _broadcast_shape(a.shape, b.shape)
    if shape == null { return null }
    _make_array(values?, shape, result_dtype)
}

// release drops the optional host tensor backing this array. It is useful for
// long-running programs that create many large temporary arrays. The array is
// invalid for further native-backed operations after release; its portable
// data cache remains available for inspection.
pub fn release(a) -> Result[any] {
    if !_is_arr(a) || !_has_tid(a) { return Ok(false) }
    tensor.free(a._tid)?
    a._tid = null
    a._native = false
    Ok(true)
}

fn _binop_with_dtype(a, b, op, forced_dtype) {
    result_dtype := if forced_dtype == null { _promote_dtype(a, b) } else { forced_dtype }
    if _is_arr(a) && _is_arr(b) {
        shape := _broadcast_shape(a.shape, b.shape)
        if shape == null { return Err("warp operands could not be broadcast together") }
        let mut d = []
        let mut i = 0
        n := _prod(shape)
        while i < n {
            index := _unravel(i, shape)
            left := _op_input(_broadcast_value(a, index, shape), result_dtype)
            right := _op_input(_broadcast_value(b, index, shape), result_dtype)
            d = push(d, op(left, right))
            i = i + 1
        }
        _array_with_dtype(d, shape, result_dtype)
    } else if _is_arr(a) {
        let mut d = []
        let mut i = 0
        data := _data(a)
        right := _op_input(b, result_dtype)
        while i < len(data) {
            d = push(d, op(_op_input(data[i], result_dtype), right))
            i = i + 1
        }
        _array_with_dtype(d, a.shape, result_dtype)
    } else if _is_arr(b) {
        let mut d = []
        let mut i = 0
        data := _data(b)
        left := _op_input(a, result_dtype)
        while i < len(data) {
            d = push(d, op(left, _op_input(data[i], result_dtype)))
            i = i + 1
        }
        _array_with_dtype(d, b.shape, result_dtype)
    } else {
        value := op(_op_input(a, result_dtype), _op_input(b, result_dtype))
        if result_dtype == "bool" { value != 0 } else { value }
    }
}

fn _unaryop(a, op) { _unaryop_with_dtype(a, op, null) }

fn _unaryop_with_dtype(a, op, forced_dtype) {
    if !_is_arr(a) {
        value := op(a)
        if forced_dtype == "bool" { return value != 0 }
        return value
    }
    result_dtype := if forced_dtype == null { dtype(a) } else { forced_dtype }
    data := _data(a)
    let mut d = []
    let mut i = 0
    while i < len(data) { d = push(d, op(data[i]))
        i = i + 1 }
    _array_with_dtype(d, a.shape, result_dtype)
}

fn _operand_shape(value) {
    if _is_arr(value) { value.shape } else { [1] }
}

fn _broadcast_shape(left, right) {
    if left == null || right == null { return null }
    let mut result = []
    let mut li = len(left) - 1
    let mut ri = len(right) - 1
    while li >= 0 || ri >= 0 {
        ld := if li >= 0 { left[li] } else { 1 }
        rd := if ri >= 0 { right[ri] } else { 1 }
        if ld != rd && ld != 1 && rd != 1 { return null }
        dimension := if ld == rd { ld } else if ld == 1 { rd } else { ld }
        result = push(result, dimension)
        li = li - 1
        ri = ri - 1
    }
    _reverse_values(result)
}

fn _unravel(flat_index, shape) {
    let mut result = []
    let mut remaining = flat_index
    let mut i = 0
    while i < len(shape) {
        stride := _prod(_tail(shape, i + 1))
        coord := if stride == 0 { 0 } else { remaining / stride }
        remaining = if stride == 0 { 0 } else { remaining % stride }
        result = push(result, coord)
        i = i + 1
    }
    result
}

fn _tail(values, start) {
    let mut result = []
    let mut i = start
    while i < len(values) {
        result = push(result, values[i])
        i = i + 1
    }
    result
}

fn _reverse_values(values) {
    let mut result = []
    let mut i = len(values) - 1
    while i >= 0 {
        result = push(result, values[i])
        i = i - 1
    }
    result
}

fn _list_range(values, start, stop) {
    let mut result = []
    let mut i = start
    while i < stop {
        result = push(result, values[i])
        i = i + 1
    }
    result
}

fn _merge_sort_values(values) {
    if len(values) <= 1 { return _copy(values) }
    mid := len(values) / 2
    left := _merge_sort_values(_list_range(values, 0, mid))
    right := _merge_sort_values(_list_range(values, mid, len(values)))
    _merge_values(left, right)
}

fn _merge_values(left, right) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if left[li] <= right[ri] {
            result = push(result, left[li])
            li = li + 1
        } else {
            result = push(result, right[ri])
            ri = ri + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _merge_sort_indices(indices, values) {
    if len(indices) <= 1 { return _copy(indices) }
    mid := len(indices) / 2
    left := _merge_sort_indices(_list_range(indices, 0, mid), values)
    right := _merge_sort_indices(_list_range(indices, mid, len(indices)), values)
    _merge_index_values(left, right, values)
}

fn _merge_index_values(left, right, values) {
    let mut result = []
    let mut li = 0
    let mut ri = 0
    while li < len(left) && ri < len(right) {
        if values[left[li]] <= values[right[ri]] {
            result = push(result, left[li])
            li = li + 1
        } else {
            result = push(result, right[ri])
            ri = ri + 1
        }
    }
    while li < len(left) {
        result = push(result, left[li])
        li = li + 1
    }
    while ri < len(right) {
        result = push(result, right[ri])
        ri = ri + 1
    }
    result
}

fn _broadcast_value(a, output_index, output_shape) {
    offset := len(output_shape) - len(a.shape)
    let mut flat_index = 0
    let mut i = 0
    while i < len(a.shape) {
        dim := a.shape[i]
        coord := if dim == 1 { 0 } else { output_index[i + offset] }
        stride := _prod(_tail(a.shape, i + 1))
        flat_index = flat_index + coord * stride
        i = i + 1
    }
    if _has_tid(a) {
        data := _data(a)
        return data[flat_index]
    }
    _logical_value_at(a, _unravel(flat_index, a.shape))
}

fn _operand_value(value, output_index, output_shape) {
    if _is_arr(value) { _broadcast_value(value, output_index, output_shape) }
    else { value }
}

fn _reduce_axis(a, axis, op, init) {
    s := a.shape
    rows := s[0]
    cols := s[1]
    if axis == 0 {
        // reduce rows → one value per column
        let mut d = []
        let mut c = 0
        while c < cols {
            let mut acc = init
            let mut r = 0
        while r < rows { acc = op(acc, _logical_value_at(a, [r, c]))
        r = r + 1 }
            d = push(d, acc)
            c = c + 1
        }
        array(d, [cols])
    } else {
        // reduce cols → one value per row
        let mut d = []
        let mut r = 0
        while r < rows {
            let mut acc = init
            let mut c = 0
        while c < cols { acc = op(acc, _logical_value_at(a, [r, c]))
        c = c + 1 }
            d = push(d, acc)
            r = r + 1
        }
        array(d, [rows])
    }
}

fn _remove_axis(shape, axis) {
    let mut result = []
    let mut i = 0
    while i < len(shape) {
        if i != axis { result = push(result, shape[i]) }
        i = i + 1
    }
    result
}

fn _insert_axis_index(index, axis, value) {
    let mut result = []
    let mut i = 0
    while i <= len(index) {
        if i == axis { result = push(result, value) }
        if i < len(index) { result = push(result, index[i]) }
        i = i + 1
    }
    result
}

fn _reduce_axis_nd(a, axis, op, init) {
    _reduce_axis_nd_opts(a, axis, op, init, false)
}

fn _reduce_axis_nd_opts(a, axis, op, init, keepdims) {
    if !_is_arr(a) { return Err("warp reduction expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp reduction axis is out of range") }
    if a.shape[normalized] == 0 { return Err("warp reduction cannot reduce an empty axis") }
    out_shape := _remove_axis(a.shape, normalized)
    output_size := _prod(out_shape)
    let mut d = []
    let mut flat = 0
    while flat < output_size {
        output_index := _unravel(flat, out_shape)
        let mut acc = init
        let mut k = 0
        while k < a.shape[normalized] {
            source_index := _insert_axis_index(output_index, normalized, k)
        acc = op(acc, _logical_value_at(a, source_index))
            k = k + 1
        }
        d = push(d, acc)
        flat = flat + 1
    }
    result_dtype := if dtype(a) == "bool" { "int64" } else { dtype(a) }
    if keepdims {
        kept_shape := _copy(a.shape)
        kept_shape[normalized] = 1
        _array_with_dtype(d, kept_shape, result_dtype)
    } else if len(out_shape) == 0 { d[0] } else { _array_with_dtype(d, out_shape, result_dtype) }
}

// is_min=true → argmin, false → argmax. Returns indices of first extreme along axis.
fn _arg_reduce_axis(a, axis, is_min) {
    if !_is_arr(a) { return Err("warp argmin/argmax expects an array") }
    normalized := _normalize_axis(axis, len(a.shape), false)
    if normalized == null { return Err("warp argmin/argmax axis is out of range") }
    if a.shape[normalized] == 0 { return Err("warp argmin/argmax cannot reduce an empty axis") }
    out_shape := _remove_axis(a.shape, normalized)
    output_size := _prod(out_shape)
    let mut d = []
    let mut flat = 0
    while flat < output_size {
        output_index := _unravel(flat, out_shape)
        let mut best_k = 0
        let mut best_v = _logical_value_at(a, _insert_axis_index(output_index, normalized, 0))
        let mut k = 1
        while k < a.shape[normalized] {
            v := _logical_value_at(a, _insert_axis_index(output_index, normalized, k))
            better := if is_min { v < best_v } else { v > best_v }
            if better {
                best_v = v
                best_k = k
            }
            k = k + 1
        }
        d = push(d, best_k)
        flat = flat + 1
    }
    if len(out_shape) == 0 { d[0] } else { _array_with_dtype(d, out_shape, "int64") }
}

fn _normalize_pad_width(pad_width, rank) {
    if _wkind(pad_width) == "int" {
        if pad_width < 0 { return null }
        let mut pads = []
        let mut i = 0
        while i < rank {
            pads = push(pads, [pad_width, pad_width])
            i = i + 1
        }
        return pads
    }
    if _wkind(pad_width) != "list" { return null }
    // Uniform [before, after] applied to every axis.
    if len(pad_width) == 2 && _wkind(pad_width[0]) == "int" && _wkind(pad_width[1]) == "int" {
        if pad_width[0] < 0 || pad_width[1] < 0 { return null }
        let mut pads = []
        let mut i = 0
        while i < rank {
            pads = push(pads, [pad_width[0], pad_width[1]])
            i = i + 1
        }
        return pads
    }
    // Per-axis [[before, after], ...]
    if len(pad_width) != rank { return null }
    let mut pads = []
    for pair in pad_width {
        if _wkind(pair) != "list" || len(pair) != 2 { return null }
        if _wkind(pair[0]) != "int" || _wkind(pair[1]) != "int" { return null }
        if pair[0] < 0 || pair[1] < 0 { return null }
        pads = push(pads, [pair[0], pair[1]])
    }
    pads
}
