fn load(path) -> Result[any] {
    ensure(path != "", "path required")?
    fs.read(path).context("load")?
}


fn main {
    n := int.parse("nope").unwrap_or(0)
    say("default n=$n")
    r := load("")
    if r.is_err { println("kind=${r.err.kind} msg=${r.err.message}") }
    nested := Err("ENOENT", "fs").context("open db").context("boot")
    say(nested.err.message)
    e := bail("stopped", "user")
    say(e.err.message)
}

