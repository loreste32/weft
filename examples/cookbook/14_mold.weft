use "../../packages/mold/lib.weft" as mold


fn main -> Result[any] {
    Person := mold.model({
        "name": "str!",
        "age": mold.integer({"min": 0, "max": 150})?,
        "tags": ["str"],
        "active": mold.boolean({"default": true})?,
    })?
    p := mold.parse(Person, "{\"name\":\"Ada\",\"age\":36,\"tags\":[\"math\"]}")?
    n := p["name"]
    a := p["age"]
    say("person $n age=$a")
    bad := mold.parse(Person, "{\"age\":-1}")
    if !bad.ok { println("rejected:", json.stringify(mold.errors(bad))) }
    fenced := "```json\n{\"name\":\"Bob\",\"age\":20,\"tags\":[]}\n```"
    b := mold.extract(Person, fenced)?
    say("extracted:", b["name"])
    tp := mold.tool_params(Person)
    say("tool param type:", tp["type"])
    say("name field:", tp["properties"]["name"]["type"])
}

