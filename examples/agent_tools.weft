// Minimal agent: tool + ask — no builders, no classes
fn weather(city) {
    "clear, 21C in " + city
}

fn main() -> Result {
    // llm.ask(prompt, tools) — shortest path to tool-using agent
    let reply = llm.ask("Weather in Paris?", [
        llm.tool("weather", weather, "city weather"),
    ])?
    println(reply)
}
