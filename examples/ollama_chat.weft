fn main -> Result[any] {
    log.info("ollama host", ollama.host())
    models := ollama.list()?
    say("models:", models)
    if len(models) == 0 { cli.die("no models — run: ollama pull llama3.2") }
    reply := ollama.chat({
        "prompt": "In one sentence, what is a weft in weaving?",
        "system": "You answer briefly.",
    })?
    say("reply:", reply)
}

