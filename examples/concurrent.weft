fn main -> Result[any] {
    rs := gather([
        fn() { 1 + 1 },
        fn() { 2 * 3 },
        fn() { 10 - 1 },
    ])?
    say("gather:", rs)
    winner := race([
        fn() {
            time.sleep_ms(50)
            "slow"
        },
        fn() { "fast" },
    ])?
    say("race:", winner)
    ok := timeout(1, fn() { "within" })?
    say("timeout ok:", ok)
    h := spawn(fn(x) { x * 2 }, 21)
    v := h.await()?
    say("spawn await:", v)
    ch := channel(1)
    spawn(fn(c) {
        send(c, 7)
        close(c)
    }, ch)
    say("recv:", recv(ch)?)
    say("concurrent default ok")
}

